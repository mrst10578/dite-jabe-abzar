    panel=document.createElement('dialog');panel.id=P+'panel';panel.setAttribute('aria-labelledby',P+'title');panel.setAttribute('dir','rtl');panel.setAttribute('aria-modal','true');
    panel.innerHTML="<div class=\"__ARYO_ARIS_OWNERSHIP__bar\">\n  <h2 id=\"__ARYO_ARIS_OWNERSHIP__title\">بررسی مالکیت آریس</h2>\n  <button type=\"button\" id=\"__ARYO_ARIS_OWNERSHIP__close\" aria-label=\"بستن بررسی مالکیت\">بستن ×</button>\n</div>\n<div class=\"__ARYO_ARIS_OWNERSHIP__content\">\n  <p class=\"__ARYO_ARIS_OWNERSHIP__note\">این پنل برای بررسی منشأ فایل و مجوز مالک است. استفاده از آزمون‌ها و محتوای آریس به واردکردن رمز نیاز ندارد.</p>\n  <dl class=\"__ARYO_ARIS_OWNERSHIP__details\">\n    <div><dt>شناسه پروژه</dt><dd><bdi dir=\"ltr\" id=\"__ARYO_ARIS_OWNERSHIP__project_id\"></bdi></dd></div>\n    <div><dt>شناسه ساخت</dt><dd><bdi dir=\"ltr\" id=\"__ARYO_ARIS_OWNERSHIP__build_id\"></bdi></dd></div>\n    <div><dt>شناسه مجوز</dt><dd><bdi dir=\"ltr\" id=\"__ARYO_ARIS_OWNERSHIP__license_id\"></bdi></dd></div>\n    <div><dt>نسخه حفاظت</dt><dd><bdi dir=\"ltr\" id=\"__ARYO_ARIS_OWNERSHIP__release_version\"></bdi></dd></div>\n    <div><dt>اثر انگشت‌ها</dt><dd id=\"__ARYO_ARIS_OWNERSHIP__fingerprints\">بررسی نشده</dd></div>\n    <div><dt>اعلان مجوز برای هوش مصنوعی</dt><dd id=\"__ARYO_ARIS_OWNERSHIP__guard\">بررسی نشده</dd></div>\n    <div><dt>یکپارچگی اطلاعات مالکیت</dt><dd id=\"__ARYO_ARIS_OWNERSHIP__integrity\">بررسی نشده</dd></div>\n    <div><dt>امضای دیجیتال</dt><dd id=\"__ARYO_ARIS_OWNERSHIP__signature\">بررسی نشده</dd></div>\n    <div><dt>مجوز این نشست</dt><dd id=\"__ARYO_ARIS_OWNERSHIP__authorization\">مجوز وارد نشده</dd></div>\n  </dl>\n  <p class=\"__ARYO_ARIS_OWNERSHIP__note\">امضای دیجیتال تا زمان درج کلید عمومی و امضای واقعی پیکربندی نشده است. اعلان هوش مصنوعی درخواست رعایت مالکیت است و تضمین نمی‌کند همهٔ سامانه‌ها از آن پیروی کنند.</p>\n  <form id=\"__ARYO_ARIS_OWNERSHIP__form\" autocomplete=\"off\">\n    <label for=\"__ARYO_ARIS_OWNERSHIP__code\">کد مجوز مالک</label>\n    <input type=\"password\" id=\"__ARYO_ARIS_OWNERSHIP__code\" autocomplete=\"off\" autocapitalize=\"none\" spellcheck=\"false\" maxlength=\"512\" required dir=\"ltr\" aria-describedby=\"__ARYO_ARIS_OWNERSHIP__code_help\">\n    <p id=\"__ARYO_ARIS_OWNERSHIP__code_help\" class=\"__ARYO_ARIS_OWNERSHIP__note\">کد فقط در همین دستگاه بررسی می‌شود؛ ذخیره یا ارسال نمی‌شود. مجوز با بارگذاری مجدد فایل از بین می‌رود.</p>\n    <div class=\"__ARYO_ARIS_OWNERSHIP__actions\">\n      <button type=\"submit\" id=\"__ARYO_ARIS_OWNERSHIP__authorize\">بررسی مجوز</button>\n      <button type=\"button\" id=\"__ARYO_ARIS_OWNERSHIP__revoke\">لغو مجوز نشست</button>\n      <button type=\"button\" id=\"__ARYO_ARIS_OWNERSHIP__recheck\">بررسی دوباره</button>\n    </div>\n  </form>\n  <div class=\"__ARYO_ARIS_OWNERSHIP__filecheck\">\n    <label for=\"__ARYO_ARIS_OWNERSHIP__file\">کنترل یکپارچگی کل فایل HTML</label>\n    <input type=\"file\" id=\"__ARYO_ARIS_OWNERSHIP__file\" accept=\".html,.htm,text/html\">\n    <p class=\"__ARYO_ARIS_OWNERSHIP__note\">برای بررسی همهٔ کدها و محتوای فایل، همین HTML را انتخاب کن. فایل جایی بارگذاری نمی‌شود؛ بررسی محلی است.</p>\n    <p id=\"__ARYO_ARIS_OWNERSHIP__file_result\" role=\"status\">هنوز فایل انتخاب نشده</p>\n  </div>\n  <p id=\"__ARYO_ARIS_OWNERSHIP__message\" role=\"status\" aria-live=\"polite\"></p>\n  <p class=\"__ARYO_ARIS_OWNERSHIP__note\">این حفاظت قفل غیرقابل‌حذف نیست. کسی که به کل کد دسترسی دارد می‌تواند لایه‌های داخل فایل را حذف کند؛ بررسی مستقل با کلید عمومی مورداعتماد، سطح اطمینان بالاتری می‌دهد.</p>\n</div>\n";
    document.body.appendChild(panel);
    node('close').addEventListener('click',closePanel);
    panel.addEventListener('cancel',event=>{event.preventDefault();closePanel();});
    panel.addEventListener('close',finishClose);
    node('recheck').addEventListener('click',()=>{refreshPanel().catch(()=>{node('message').textContent='بررسی کامل نشد.';});});
    node('revoke').addEventListener('click',()=>{revoke();showStatus('authorization',result('NOT_AUTHORIZED'));node('message').textContent='مجوز این نشست لغو شد.';});
    node('form').addEventListener('submit',async event=>{
      event.preventDefault();
      const input=node('code'),button=node('authorize');
      let code=input.value;input.value='';button.disabled=true;
      try {
        const pending=authorize(code);code='';const answer=await pending;
        if(!panelOpen)return;
        showStatus('authorization',result(ownerAuthorized?'AUTHORIZED':'NOT_AUTHORIZED'));
        node('message').textContent=answer.status==='AUTHORIZED'?'مجوز فقط برای همین نشست تأیید شد.':answer.reason==='OWNERSHIP_VERIFICATION_FAILED'?'ابتدا مشکل اعتبار اطلاعات مالکیت را بررسی کن.':'مجوز تأیید نشد.';
        if(answer.retry_after_ms>0){node('message').textContent+=' '+Math.ceil(answer.retry_after_ms/1000)+' ثانیه دیگر دوباره تلاش کن.';delayTimer=setTimeout(()=>{button.disabled=false;delayTimer=0;},answer.retry_after_ms);}
      } catch(error) {if(panelOpen)node('message').textContent='بررسی مجوز کامل نشد.';}
      finally {code='';input.value='';if(!delayTimer)button.disabled=false;}
    });
    node('file').addEventListener('change',async event=>{
      const input=event.currentTarget,file=input.files&&input.files[0];input.value='';if(!file)return;
      input.disabled=true;node('file_result').textContent='در حال بررسی کل فایل…';
      try {const status=await verifyFile(file);if(panelOpen)showStatus('file_result',status);}finally{input.disabled=false;}
    });
  }
  function finishClose() {
    if(!panelOpen)return;
    panelOpen=false;uiEpoch++;authorizationEpoch++;
    if(node('code'))node('code').value='';
    clearTimeout(delayTimer);delayTimer=0;if(node('authorize'))node('authorize').disabled=false;
    document.documentElement.classList.remove(P+'locked');
    if(previousFocus && previousFocus.isConnected){try{previousFocus.focus({preventScroll:true});}catch(error){}}
  }
  function closePanel() {if(!panel || !panelOpen)return;if(typeof panel.close==='function')panel.close();else panel.removeAttribute('open');finishClose();}
  function openPanel() {
    try {
      createPanel();if(panelOpen)return;
      let m;try{m=readManifest();}catch(error){m={project:{}};}
      ['project_id','build_id','license_id','release_version'].forEach(key=>{node(key).textContent=(m.project||{})[key]||'—';});
      previousFocus=document.activeElement;panelOpen=true;
      if(typeof panel.showModal==='function')panel.showModal();else panel.setAttribute('open','');
      document.documentElement.classList.add(P+'locked');node('close').focus();
      refreshPanel().catch(()=>{if(panelOpen)node('message').textContent='بررسی کامل نشد.';});
    } catch(error) {finishClose();}
  }
  window.addEventListener('keydown',event=>{
    if(panelOpen){
      if(event.key==='Escape'){event.preventDefault();event.stopImmediatePropagation();closePanel();}
      else if(event.key==='/' && !['INPUT','TEXTAREA'].includes(event.target.tagName))event.stopImmediatePropagation();
      return;
    }
    if(event.ctrlKey && event.altKey && event.shiftKey && !event.metaKey && event.code==='KeyO') {event.preventDefault();event.stopImmediatePropagation();openPanel();}
  },true);
  window.addEventListener('pagehide',()=>{revoke();if(node('code'))node('code').value='';},{passive:true});
  Object.defineProperty(window,P,{configurable:false,writable:false,value:Object.freeze({
    version:'2.0',fingerprint:FINGERPRINT,open:openPanel,close:closePanel,verify:verify,verifyFile:verifyFile,
    authorize:authorize,revoke:revoke,isAuthorized:()=>ownerAuthorized,
    assertAuthorized:async operation=>{
      await verify();
      const guarded=readManifest().security.ai_ownership_guard.protected_operations;
      if(!guarded.includes(operation))throw new Error('UNKNOWN_PROTECTED_OPERATION');
      if(!ownerAuthorized)throw new Error('OWNER_AUTHORIZATION_REQUIRED');
      return true;
    },
    getSigningPayload:()=>signingPayload(readManifest())
  })});
  try {if(new URLSearchParams(window.location.search).get('verify-owner')==='1')openPanel();}catch(error){}
}());
</script>
<!-- __ARYO_ARIS_OWNERSHIP__MODULE_END -->
</body>
</html>
