  async function verifyFile(file) {
    try {
      const expected=jsonNode(P+'file_digest').sha256;
      if (!HEX.test(expected || '')) return fileStatus=result('UNCONFIGURED','MISSING_DOCUMENT_DIGEST');
      if (!file || typeof file.arrayBuffer!=='function' || file.size>134217728) return fileStatus=result('INVALID','INVALID_FILE_OR_SIZE_OVER_128_MIB');
      const bytes=new Uint8Array(await file.arrayBuffer());
      const text=new TextDecoder('utf-8',{fatal:true,ignoreBOM:true}).decode(bytes);
      const normalized=normalizeDocument(text);
