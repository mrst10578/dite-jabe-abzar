    if (!d.public_key || !d.signature || (typeof d.public_key==='string' && PLACEHOLDER.test(d.public_key)) || PLACEHOLDER.test(String(d.signature))) return result('UNCONFIGURED','PUBLIC_KEY_AND_SIGNATURE_NOT_SUPPLIED');
    if (d.algorithm!=='ECDSA-P256-SHA256' || d.public_key_format!=='jwk' || d.signature_encoding!=='base64url-ieee-p1363' || d.signed_payload_version!=='1') return result('INVALID','UNSUPPORTED_SIGNATURE_CONFIGURATION');
    const key=d.public_key;
    if (typeof key!=='object' || key.kty!=='EC' || key.crv!=='P-256' || !present(key.x) || !present(key.y) || 'd' in key) return result('INVALID','INVALID_PUBLIC_KEY');
    if (!(window.crypto && window.crypto.subtle)) return result('UNCONFIGURED','WEB_CRYPTO_UNAVAILABLE');
    try {
