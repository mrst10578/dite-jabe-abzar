<script id="aris-compass-bridge" type="text/plain">(function () {
  'use strict';
  // The original app is preserved; only its embedded navigation joins the host history.
  var host = parent.ArisPsychologyTest;
  history.pushState = function (state) { host.navigate(state, true); };
  history.replaceState = function (state) { host.navigate(state, false); };
  window.addEventListener('aris:compass-suspend', function () {
    if (typeof flushScheduledSave === 'function') flushScheduledSave();
  });
  window.addEventListener('load', function () {
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !event.defaultPrevented && !document.querySelector('.modal.open')) {
        event.preventDefault();
        host.close();
      }
    });
    if (document.documentElement.classList.contains('js-ready') && document.getElementById('unifiedOpenBtn')) host.ready();
  });
}());
</script>
<script id="aris-compass-host">(function () {
  'use strict';
  var dialog = document.getElementById('aris-compass-dialog');
  var frame = document.getElementById('aris-compass-frame');
  var closeButton = document.getElementById('aris-compass-close');
  var loading = document.getElementById('aris-compass-loading');
  var retry = document.getElementById('aris-compass-retry');
  var launch = document.getElementById('aris-psych-test-launch');
  var ready = false, mounting = false, restoring = false, closing = false;
  var savedFocus = null, savedScroll = 0, frameState = { arisView: 'home' };
  var readyTimer = 0, qaCache = null;

  function marker() {
    var value = history.state && history.state.arisCompass;
    return value && value.module === 'v4.3' ? value : null;
  }
  function currentEntry(view, depth) {
    var state = Object.assign({}, history.state || {});
    state.arisCompass = { module: 'v4.3', view: view, depth: depth };
    return state;
  }
  function decodeSource() {
    var encoded = document.getElementById('aris-compass-html').textContent.trim();
    var bytes = Uint8Array.from(atob(encoded), function (ch) { return ch.charCodeAt(0); });
    if (window.TextDecoder) return new TextDecoder('utf-8', { fatal: true }).decode(bytes);
    return decodeURIComponent(Array.prototype.map.call(bytes, function (b) {
      return '%' + ('0' + b.toString(16)).slice(-2);
    }).join(''));
  }
  function setVisibility(open) {
    document.body.classList.toggle('aris-compass-open', open);
    launch.setAttribute('aria-expanded', String(open));
    document.dispatchEvent(new CustomEvent('aris:compass-visibility', { detail: { open: open } }));
  }
  function flushAnswers() {
    try { frame.contentWindow.dispatchEvent(new Event('aris:compass-suspend')); } catch (error) {}
  }
  function hide() {
    if (!dialog.open) return;
    flushAnswers();
    if (typeof dialog.close === 'function') dialog.close();
    else dialog.removeAttribute('open');
    setVisibility(false);
    var target = savedFocus && savedFocus.isConnected ? savedFocus : launch;
    try { target.focus({ preventScroll: true }); } catch (error) { target.focus(); }
    window.scrollTo({ top: savedScroll, behavior: 'instant' });
  }
  function fail() {
    clearTimeout(readyTimer);
    loading.hidden = false;
    loading.querySelector('p').textContent = 'قطب‌نما کامل باز نشد. دوباره تلاش کن.';
    retry.hidden = false;
    frame.hidden = true;
  }
  function mount() {
    if (mounting || ready) return;
    mounting = true;
    loading.hidden = false;
    retry.hidden = true;
    loading.querySelector('p').textContent = 'در حال آماده‌سازی قطب‌نما…';
    try {
      var source = decodeSource();
      var bridge = document.getElementById('aris-compass-bridge').textContent;
      source = source.replace(/<head>/i, '<head><script>' + bridge + '<' + '/script>');
      frame.srcdoc = source;
      readyTimer = window.setTimeout(function () { if (!ready) fail(); }, 20000);
    } catch (error) {
      mounting = false;
      fail();
    }
  }
  function show(pushEntry) {
    if (closing) return;
    if (!dialog.open) {
      savedFocus = document.activeElement;
      savedScroll = window.scrollY;
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
      setVisibility(true);
      closeButton.focus({ preventScroll: true });
    }
    if (pushEntry && !marker()) {
      try { history.pushState(currentEntry(frameState, 1), '', '#aris-compass'); } catch (error) {}
    }
    mount();
  }
  function close() {
    var entry = marker();
    hide();
    if (entry && Number.isInteger(entry.depth) && entry.depth > 0 && entry.depth < history.length) {
      closing = true;
      history.go(-entry.depth);
    } else if (entry) {
      var state = Object.assign({}, history.state);
      delete state.arisCompass;
      history.replaceState(state, '', location.pathname + location.search);
    }
  }
  function navigate(view, push) {
    if (!view || !['home', 'assessment', 'report'].includes(view.arisView)) return;
    frameState = Object.assign({}, view);
    if (restoring || !ready || !dialog.open) return;
    var entry = marker();
    if (!entry) return;
    try {
      if (push) history.pushState(currentEntry(frameState, entry.depth + 1), '', '#aris-compass');
      else history.replaceState(currentEntry(frameState, entry.depth), '', '#aris-compass');
    } catch (error) {}
  }
  function restore(view) {
    if (!ready || !view) return;
    frameState = Object.assign({}, view);
    restoring = true;
    try { frame.contentWindow.dispatchEvent(new PopStateEvent('popstate', { state: frameState })); }
    finally { restoring = false; }
  }
  function onReady() {
    if (!mounting) return;
    mounting = false;
    ready = true;
    clearTimeout(readyTimer);
    frame.hidden = false;
    loading.hidden = true;
    var entry = marker();
    if (entry && entry.view && entry.view.arisView !== 'home') restore(entry.view);
    if (dialog.open) closeButton.focus({ preventScroll: true });
  }
  closeButton.addEventListener('click', close);
  retry.addEventListener('click', function () { mounting = false; ready = false; mount(); });
  dialog.addEventListener('cancel', function (event) { event.preventDefault(); close(); });
  document.addEventListener('keydown', function (event) {
    if (!dialog.open) return;
    if (event.key === 'Escape') { event.preventDefault(); event.stopImmediatePropagation(); close(); }
    else if (event.key === '/') event.stopImmediatePropagation();
  }, true);
  window.addEventListener('popstate', function () {
    closing = false;
    var entry = marker();
    if (entry) { show(false); restore(entry.view); }
    else hide();
  });
  window.addEventListener('pagehide', flushAnswers, { passive: true });
  document.addEventListener('visibilitychange', function () { if (document.hidden) flushAnswers(); });
  window.ArisPsychologyTest = {
    open: function () { show(true); },
    close: close,
    navigate: navigate,
    ready: onReady,
    getQAReport: function () {
      if (!qaCache) qaCache = JSON.parse(document.getElementById('aris-compass-source-qa').textContent);
      return JSON.parse(JSON.stringify(qaCache));
    },
    version: '4.3'
  };
  window.ArisCareerCompass = window.ArisPsychologyTest;
  if (marker()) show(false);
  else if (location.hash === '#aris-compass') {
    history.replaceState(history.state, '', location.pathname + location.search);
    show(true);
  }
}());
</script>
