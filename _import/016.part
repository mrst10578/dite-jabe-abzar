<script data-aris-module="search-and-content">
(function () {
    "use strict";

    /*
     * ARIS COMPLETE MAJOR INDEX
     * بانک پاک‌سازی‌شده از صفحات رشته‌های ارائه‌شده؛ موارد هم‌نام و کپی‌های تکراری ادغام شده‌اند.
     */

    /* Lossless transport only: media pixels, font files and audio are unchanged.
       Image text is restored before a province is mounted, without fetching assets. */
    function decodeArisData(encoded) {
        var binary = window.atob(encoded);
        var bytes = new Uint8Array(binary.length);
        for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
        return JSON.parse(window.pako.inflateRaw(bytes, { to: "string" }));
    }

    var ARIS_COMPACT_IMAGE_ALPHABET = "!#$%()*+,-.0123456789:;=?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_abcdefghijklmnopqrstuvwxyz{|}";
    var compactImageDigits = new Int16Array(128);
    compactImageDigits.fill(-1);
    for (var imageDigit = 0; imageDigit < ARIS_COMPACT_IMAGE_ALPHABET.length; imageDigit++) {
        compactImageDigits[ARIS_COMPACT_IMAGE_ALPHABET.charCodeAt(imageDigit)] = imageDigit;
    }

    function restoreProvinceImage(index) {
        var asset = ARIS_PROVINCE_IMAGES[index];
        var payload = document.getElementById("aris-province-image-" + index);
        if (!asset || !payload) throw new Error("Missing Aris province image");
        var encoded = payload.textContent;
        var length = asset[1];
        if (encoded.length !== Math.ceil(length / 4) * 5) throw new Error("Incomplete Aris province image");
        var bytes = new Uint8Array(length);
        var offset = 0;
        for (var i = 0; i < encoded.length; i += 5) {
            var value = 0;
            for (var j = 0; j < 5; j++) {
                var code = encoded.charCodeAt(i + j);
                var digit = code < 128 ? compactImageDigits[code] : -1;
                if (digit < 0) throw new Error("Invalid Aris province image encoding");
                value = value * 85 + digit;
            }
            if (value > 4294967295) throw new Error("Invalid Aris province image group");
            for (var shift = 24; shift >= 0 && offset < length; shift -= 8) {
                bytes[offset++] = (value >>> shift) & 255;
            }
        }
        var chunks = [];
        for (var start = 0; start < length; start += 16384) {
            chunks.push(String.fromCharCode.apply(null, bytes.subarray(start, start + 16384)));
        }
        return asset[0] + window.btoa(chunks.join(""));
    }

    function restoreProvinceImages(content) {
        return content.replace(/@aris-image:(\d+)@/g, function (match, index) {
            return restoreProvinceImage(Number(index));
        });
    }

    var ARIS_MAJORS = decodeArisData("");

