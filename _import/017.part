    function convertEnglishKeyboard(value) {
        return String(value || "").toLowerCase().split("").map(function (character) {
            return PERSIAN_KEYBOARD_MAP[character] || character;
        }).join("");
    }

    function normalizeText(value) {
        return String(value || "")
            .normalize("NFKC")
            .replace(/[يى]/g, "ی")
            .replace(/[ك]/g, "ک")
            .replace(/[ۀة]/g, "ه")
            .replace(/[ؤ]/g, "و")
            .replace(/[إأٱ]/g, "ا")
            .replace(/[\u064B-\u065F\u0670\u0640]/g, "")
            .replace(/[\u200C\u200D]/g, " ")
            .replace(/[^\p{L}\p{N}\s]/gu, " ")
            .replace(/\s+/g, " ")
            .trim()
            .toLowerCase();
    }

    function compactText(value) {
        return normalizeText(value).replace(/\s+/g, "");
    }

    function tokenize(value) {
        var normalized = normalizeText(value);
        if (!normalized) return [];

        return normalized
            .split(" ")
            .filter(function (token) {
                return token.length > 1 && !STOP_WORDS.has(token);
            });
    }

    function expandTokens(tokens) {
        var expanded = new Set(tokens);

        tokens.forEach(function (token) {
            var compact = compactText(token);
            var alternatives = TOKEN_EQUIVALENTS[token] || TOKEN_EQUIVALENTS[compact] || [];

            alternatives.forEach(function (alternative) {
                tokenize(alternative).forEach(function (item) {
                    expanded.add(item);
                });
            });
        });

        return Array.from(expanded);
    }

    function levenshteinDistance(a, b) {
        if (a === b) return 0;
        if (!a.length) return b.length;
        if (!b.length) return a.length;

        var previousPrevious = null;
        var previous = new Uint16Array(b.length + 1);
        var current = new Uint16Array(b.length + 1);
        var i;
        var j;

        for (j = 0; j <= b.length; j += 1) previous[j] = j;

        for (i = 1; i <= a.length; i += 1) {
            current[0] = i;

            for (j = 1; j <= b.length; j += 1) {
                var cost = a.charAt(i - 1) === b.charAt(j - 1) ? 0 : 1;
                current[j] = Math.min(
                    current[j - 1] + 1,
                    previous[j] + 1,
                    previous[j - 1] + cost
                );

                if (
                    previousPrevious &&
                    i > 1 &&
                    j > 1 &&
                    a.charAt(i - 1) === b.charAt(j - 2) &&
                    a.charAt(i - 2) === b.charAt(j - 1)
                ) {
                    current[j] = Math.min(current[j], previousPrevious[j - 2] + 1);
                }
            }

            var recycled = previousPrevious;
            previousPrevious = previous;
            previous = current;
            current = recycled || new Uint16Array(b.length + 1);
        }

        return previous[b.length];
    }

    function similarityCompact(left, right) {
        var longest = Math.max(left.length, right.length);

        if (!longest) return 1;
        if (Math.abs(left.length - right.length) > Math.max(2, Math.floor(longest * .28))) return 0;

        var compatibleStart =
            left.charAt(0) === right.charAt(0) ||
            left.slice(0, 3) === right.slice(1, 4) ||
            left.slice(1, 4) === right.slice(0, 3) ||
            left.slice(1, 4) === right.slice(1, 4);
        if (!compatibleStart) return 0;

        return 1 - (levenshteinDistance(left, right) / longest);
    }

    function prepareData(items) {
        return items
            .filter(function (item) {
                return item && item.id && item.name;
            })
            .map(function (item) {
                var aliases = Array.isArray(item.aliases) ? item.aliases.slice() : [];
                var concepts = Array.isArray(item.concepts) ? item.concepts : [];
                aliases = aliases.concat(ENGLISH_ALIASES[item.id] || []);

                return Object.assign({}, item, {
                    nameNorm: normalizeText(item.name),
                    nameCompact: compactText(item.name),
                    slugNorm: normalizeText(String(item.slug || "").replace(/-/g, " ")),
                    slugCompact: compactText(String(item.slug || "").replace(/-/g, " ")),
                    aliasesNorm: aliases.map(normalizeText),
                    aliasesCompact: aliases.map(compactText),
                    conceptsNorm: concepts.map(normalizeText),
                    nameTokens: tokenize(item.name),
                    slugTokens: tokenize(String(item.slug || "").replace(/-/g, " ")),
                    aliasTokens: aliases.flatMap(tokenize),
                    conceptTokens: Array.from(new Set(concepts.flatMap(tokenize))).slice(0, 48)
                });
            });
    }

    function createQueryContext(rawQuery) {
        var raw = String(rawQuery || "");
        var query = normalizeText(raw);
        var baseTokens = tokenize(query);

        return {
            raw: raw,
            query: query,
            compactQuery: query.replace(/\s+/g, ""),
            baseTokens: baseTokens,
            baseTokenSet: new Set(baseTokens),
            queryTokens: expandTokens(baseTokens),
            latinLayout: /^[a-z\[\];',\s-]+$/i.test(raw)
        };
    }

    function bestTokenMatch(token, candidates) {
        var best = 0;

        for (var index = 0; index < candidates.length; index += 1) {
            var candidate = candidates[index];
            if (candidate === token) return 1;

            if (candidate.startsWith(token) || token.startsWith(candidate)) {
                var ratio = Math.min(candidate.length, token.length) / Math.max(candidate.length, token.length);
                best = Math.max(best, .78 + (.2 * ratio));
                continue;
            }

            if (token.length >= 4 && candidate.length >= 4) {
                best = Math.max(best, similarityCompact(token, candidate));
            }
        }

        return best;
    }

    function bestConceptMatch(token, candidates) {
        var best = 0;

        for (var index = 0; index < candidates.length; index += 1) {
            var candidate = candidates[index];
            if (candidate === token) return 1;

            if (candidate.startsWith(token) || token.startsWith(candidate)) {
                var ratio = Math.min(candidate.length, token.length) / Math.max(candidate.length, token.length);
                best = Math.max(best, .78 + (.2 * ratio));
            }
        }

        return best;
    }

    function scoreMajor(major, context) {
        var query = context.query;
        var compactQuery = context.compactQuery;
        var baseTokens = context.baseTokens;
        var score = 0;
        var signals = { exact: 0, name: 0, alias: 0, slug: 0, semantic: 0, fuzzy: 0 };

        if (major.nameNorm === query || major.nameCompact === compactQuery) {
            score += 12000;
            signals.exact += 12000;
        } else {
            if (major.nameNorm.startsWith(query) || major.nameCompact.startsWith(compactQuery)) {
                score += 1050;
                signals.name += 1050;
            } else if (query.length >= 2 && (major.nameNorm.includes(query) || major.nameCompact.includes(compactQuery))) {
                score += 860;
                signals.name += 860;
            } else if (major.nameNorm.length >= 4 && (query.includes(major.nameNorm) || compactQuery.includes(major.nameCompact))) {
                score += 760;
                signals.name += 760;
            }
        }

        major.aliasesNorm.forEach(function (alias, index) {
            var aliasCompact = major.aliasesCompact[index];
            if (alias === query || aliasCompact === compactQuery) {
                score += 5000;
                signals.alias += 5000;
            } else if (alias.startsWith(query) || aliasCompact.startsWith(compactQuery)) {
                score += 650;
                signals.alias += 650;
            } else if (query.length >= 2 && (alias.includes(query) || aliasCompact.includes(compactQuery))) {
                score += 470;
                signals.alias += 470;
            } else if (alias.length >= 4 && (query.includes(alias) || compactQuery.includes(aliasCompact))) {
                score += 420;
                signals.alias += 420;
            }
        });

        if (major.slugNorm) {
            if (major.slugNorm === query || major.slugCompact === compactQuery) {
                score += 1100;
                signals.slug += 1100;
            } else if (major.slugNorm.startsWith(query) || major.slugCompact.startsWith(compactQuery)) {
                score += 520;
                signals.slug += 520;
            } else if (query.length >= 3 && (major.slugNorm.includes(query) || major.slugCompact.includes(compactQuery))) {
                score += 380;
                signals.slug += 380;
            }
        }

        major.conceptsNorm.forEach(function (concept) {
            if (concept === query) {
                score += 720;
                signals.semantic += 720;
            } else if (query.length >= 3 && concept.includes(query)) {
                score += 510;
                signals.semantic += 510;
            } else if (concept.length >= 3 && query.includes(concept)) {
                var conceptTokens = tokenize(concept);
                var isGenericSingle = conceptTokens.length === 1 && LOW_SIGNAL_TOKENS.has(conceptTokens[0]);
                var containedPoints = isGenericSingle ? 90 : 470;
                score += containedPoints;
                signals.semantic += containedPoints;
            }
        });

        var matchedBaseTokens = 0;
        context.queryTokens.forEach(function (token) {
            var nameMatch = bestTokenMatch(token, major.nameTokens);
            var aliasMatch = bestTokenMatch(token, major.aliasTokens);
            var slugMatch = bestTokenMatch(token, major.slugTokens);
            var conceptMatch = bestConceptMatch(token, major.conceptTokens);
            var bestMatch = Math.max(nameMatch, aliasMatch, slugMatch, conceptMatch);
            var tokenWeight = LOW_SIGNAL_TOKENS.has(token) ? .35 : 1;

            if (context.baseTokenSet.has(token) && bestMatch >= .76) matchedBaseTokens += 1;
            if (nameMatch >= .76) {
                var namePoints = 190 * nameMatch * tokenWeight;
                score += namePoints;
                signals.name += namePoints;
            }
            if (aliasMatch >= .78) {
                var aliasPoints = 135 * aliasMatch * tokenWeight;
                score += aliasPoints;
                signals.alias += aliasPoints;
            }
            if (slugMatch >= .8) {
                var slugPoints = 120 * slugMatch * tokenWeight;
                score += slugPoints;
                signals.slug += slugPoints;
            }
            if (conceptMatch >= .78) {
                var conceptPoints = 125 * conceptMatch * tokenWeight;
                score += conceptPoints;
                signals.semantic += conceptPoints;
            }
        });

        if (compactQuery.length >= 4) {
            var fullSimilarity = similarityCompact(compactQuery, major.nameCompact);
            if (fullSimilarity >= .64) {
                var fuzzyPoints = 610 * Math.pow(fullSimilarity, 2.2);
                score += fuzzyPoints;
                signals.fuzzy += fuzzyPoints;
            }
        }

        if (baseTokens.length > 1) {
            var coverage = matchedBaseTokens / baseTokens.length;
            score *= .68 + (.32 * Math.min(1, coverage));
        }

        var strongestSignal = "exact";
        Object.keys(signals).forEach(function (signal) {
            if (signals[signal] > signals[strongestSignal]) strongestSignal = signal;
        });

        var reason = "پیشنهاد نزدیک";
        if (strongestSignal === "exact") reason = "تطابق دقیق با نام رشته";
        if (strongestSignal === "name") reason = "تکمیل یا تطابق نام رشته";
        if (strongestSignal === "alias") reason = "تطابق با نام یا عبارت مشابه";
        if (strongestSignal === "slug") reason = "تطابق با شناسه انگلیسی رشته";
        if (strongestSignal === "semantic") reason = "مرتبط با علاقه یا عبارت شما";
        if (/^[a-z\s-]+$/i.test(query) && signals.alias > 200) reason = "تطابق با نام انگلیسی رشته";
        if (strongestSignal === "fuzzy" || (signals.fuzzy > 230 && signals.exact === 0 && signals.name < 300 && signals.alias < 300 && signals.semantic < 300)) {
            reason = "نزدیک‌ترین نتیجه از نظر املا";
        }
        if (signals.exact === 0 && baseTokens.length > 1 && signals.fuzzy > 420) {
            reason = "تطبیق ترکیبی با اصلاح املا";
        }

        return { major: major, score: score, reason: reason, signals: signals };
    }

    function rankMajors(context, minimumScore) {
        return preparedMajors
            .map(function (major) { return scoreMajor(major, context); })
            .filter(function (result) { return result && result.score >= minimumScore; });
    }

    var searchCache = new Map();
    var exactNameIndex = new Map();
    var majorIdIndex = new Map();

    function rebuildSearchIndexes() {
        exactNameIndex.clear();
        majorIdIndex.clear();
        preparedMajors.forEach(function (major) {
            exactNameIndex.set(major.nameNorm, major);
            exactNameIndex.set(major.nameCompact, major);
            majorIdIndex.set(major.id, major);
        });
    }

    function updateBankStatus() {
        bankStatus.textContent = "بانک این نسخه شامل " + preparedMajors.length.toLocaleString("fa-IR") + " صفحه‌ی رشته و راهنمای تخصصیِ پاک‌سازی‌شده است.";
    }

    function updateFilterSummary() {
        var count = activeDomains.size;
        filterCount.textContent = count ? count.toLocaleString("fa-IR") : "همه";
        filterToggle.classList.toggle("has-active-filters", count > 0);
        filterToggle.setAttribute("aria-label", count
            ? "فیلتر حوزه رشته، " + count.toLocaleString("fa-IR") + " حوزه انتخاب شده"
            : "فیلتر حوزه رشته، همه حوزه‌ها");
        clearFilters.hidden = count === 0;
    }

    function setFilterPanelOpen(shouldOpen) {
        filterPanel.hidden = !shouldOpen;
        filterToggle.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
    }

    function renderDomainFilters() {
        var domainCounts = new Map();

        preparedMajors.forEach(function (major) {
            var domain = major.domain || "رشته دانشگاهی";
            domainCounts.set(domain, (domainCounts.get(domain) || 0) + 1);
        });

        Array.from(activeDomains).forEach(function (domain) {
            if (!domainCounts.has(domain)) activeDomains.delete(domain);
        });

        filterOptions.replaceChildren();
        var fragment = document.createDocumentFragment();

        Array.from(domainCounts.entries())
            .sort(function (left, right) { return left[0].localeCompare(right[0], "fa"); })
            .forEach(function (entry) {
                var domain = entry[0];
                var count = entry[1];
                var button = document.createElement("button");
                var label = document.createElement("span");
                var countLabel = document.createElement("span");

                button.type = "button";
                button.className = "filter-chip";
                button.dataset.domain = domain;
                button.setAttribute("aria-pressed", activeDomains.has(domain) ? "true" : "false");
                label.textContent = domain;
                countLabel.className = "filter-chip__count";
                countLabel.textContent = count.toLocaleString("fa-IR");
                button.append(label, countLabel);

                button.addEventListener("click", function () {
                    if (activeDomains.has(domain)) activeDomains.delete(domain);
                    else activeDomains.add(domain);

                    button.setAttribute("aria-pressed", activeDomains.has(domain) ? "true" : "false");
                    updateFilterSummary();
                    updateSearch();
                });

                fragment.appendChild(button);
            });

        filterOptions.appendChild(fragment);
        updateFilterSummary();
    }

    function cacheSearch(key, results) {
        searchCache.set(key, results);
        if (searchCache.size > 40) searchCache.delete(searchCache.keys().next().value);
    }

    function searchMajors(rawQuery, limit, includeRelated) {
        var maximum = Number.isFinite(limit) ? Math.max(0, Math.floor(limit)) : 6;
        if (maximum === 0) return [];

        var context = createQueryContext(rawQuery);
        var correctedContext = context.latinLayout ? createQueryContext(convertEnglishKeyboard(context.raw)) : null;
        if (!context.query && !(correctedContext && correctedContext.query)) return [];

        var cacheKey = [
            context.query,
            correctedContext ? correctedContext.query : "",
            maximum,
            includeRelated ? "related" : "exact"
        ].join("::");
        if (searchCache.has(cacheKey)) return searchCache.get(cacheKey).slice();

        var exactMajor = exactNameIndex.get(context.query) || exactNameIndex.get(context.compactQuery);
        if (exactMajor && !includeRelated) {
            var exactResults = [scoreMajor(exactMajor, context)];
            cacheSearch(cacheKey, exactResults);
            return exactResults.slice();
        }

        var effectiveLength = context.compactQuery.length || (correctedContext ? correctedContext.compactQuery.length : 0);
        var minimumScore = effectiveLength === 1 ? 950 : 115;
        var ranked = context.query ? rankMajors(context, minimumScore) : [];

        if (correctedContext) {
            if (correctedContext.query && correctedContext.query !== context.query) {
                rankMajors(correctedContext, minimumScore).forEach(function (result) {
                    var correctedResult = Object.assign({}, result, {
                        score: result.score * .94,
                        reason: "اصلاح چیدمان صفحه‌کلید فارسی",
                        keyboardCorrected: true
                    });
                    var existingIndex = ranked.findIndex(function (item) { return item.major.id === result.major.id; });
                    if (existingIndex === -1) ranked.push(correctedResult);
                    else if (correctedResult.score > ranked[existingIndex].sc