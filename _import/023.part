<dialog id="aris-compass-dialog" aria-labelledby="aris-compass-title" aria-modal="true">
  <div class="aris-compass-bar">
    <h2 class="aris-compass-bar__title" id="aris-compass-title">قطب‌نمای انتخاب رشته آریس</h2>
    <button class="aris-compass-close" id="aris-compass-close" type="button" aria-label="بازگشت به فایل مادر آریس">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>بازگشت به آریس</span>
    </button>
  </div>
  <div class="aris-compass-stage">
    <div class="aris-compass-loading" id="aris-compass-loading" role="status" aria-live="polite">
      <p>در حال آماده‌سازی قطب‌نما…</p>
      <button class="aris-compass-retry" id="aris-compass-retry" type="button" hidden>تلاش دوباره</button>
    </div>
    <iframe id="aris-compass-frame" title="قطب‌نمای انتخاب رشته آریس؛ آزمون و گزارش" allow="clipboard-write" hidden></iframe>
  </div>
</dialog>
