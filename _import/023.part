" type="audio/mpeg"/>
</audio>
<script data-aris-module="ambient-audio">
(function () {
    "use strict";

    var audio = document.getElementById("ambient-audio");
    var soundToggle = document.getElementById("sound-toggle");
    if (!audio || !soundToggle) return;

    var savedAudioPreference = null;
    try { savedAudioPreference = localStorage.getItem("aris:ambient-audio"); }
    catch (error) { /* Music also works when storage is unavailable. */ }

    var wantsAudio = savedAudioPreference !== "off";
    var playPending = false;
    var playAttempt = 0;
    var unlockArmed = false;
    var unlockEvents = ["pointerup", "touchend", "click", "keydown"];

    // Set the quiet volume before enabling autoplay or requesting playback.
    audio.volume = .14;
    audio.autoplay = wantsAudio;

    function setAudioState(state) {
        soundToggle.dataset.state = state;
        var playing = state === "playing";
        var unavailable = state === "unavailable";
        soundToggle.disabled = unavailable;
        soundToggle.setAttribute("aria-pressed", playing ? "true" : "false");
        soundToggle.setAttribute("aria-label", unavailable ? "موسیقی پس‌زمینه در دسترس نیست" :
            (playing || state === "loading" ? "توقف موسیقی پس‌زمینه" : "پخش موسیقی پس‌زمینه"));
    }

    function rememberAudioPreference(value) {
        savedAudioPreference = value;
        try { localStorage.setItem("aris:ambient-audio", value); }
        catch (error) { /* The sound control does not require storage. */ }
    }

    function setUnlockArmed(armed) {
        if (unlockArmed === armed) return;
        unlockArmed = armed;
        unlockEvents.forEach(function (type) {
            if (armed) document.addEventListener(type, unlockAudio, { passive: true });
            else document.removeEventListener(type, unlockAudio);
        });
    }

    function playbackFailed(error, attempt) {
        if (attempt !== playAttempt) return;
        playPending = false;
        if (!wantsAudio) { setAudioState("paused"); return; }
        if (audio.error || (error && error.name === "NotSupportedError")) {
            setAudioState("unavailable");
            setUnlockArmed(false);
            return;
        }
        setAudioState("ready");
        setUnlockArmed(true);
    }

    function playbackStarted(attempt) {
        if (attempt !== playAttempt) return;
        playPending = false;
        if (!wantsAudio) { audio.pause(); return; }
        if (audio.paused) { setAudioState("ready"); setUnlockArmed(true); return; }
        setAudioState("playing");
        setUnlockArmed(false);
    }

    function tryPlayAudio() {
        if (!wantsAudio || playPending || soundToggle.dataset.state === "unavailable") return;
        if (!audio.paused) { playbackStarted(playAttempt); return; }
        var attempt = ++playAttempt;
        playPending = true;
        setAudioState("loading");
        var playPromise;
        try { playPromise = audio.play(); }
        catch (error) { playbackFailed(error, attempt); return; }
        if (playPromise && typeof playPromise.then === "function") {
            playPromise.then(function () { playbackStarted(attempt); }, function (error) {
                playbackFailed(error, attempt);
            });
        } else {
            playPending = false;
            if (!audio.paused) playbackStarted(attempt);
            else { setAudioState("ready"); setUnlockArmed(true); }
        }
    }

    function unlockAudio(event) {
        if (event.isTrusted === false || !wantsAudio || !audio.paused) return;
        if (event.target && event.target.closest && event.target.closest("#sound-toggle")) return;
        if (event.type === "keydown" && (event.key === "Escape" || event.ctrlKey || event.metaKey || event.altKey)) return;
        // The call stays synchronous inside the gesture, including typing.
        tryPlayAudio();
    }

    audio.addEventListener("playing", function () { playbackStarted(playAttempt); });
    audio.addEventListener("pause", function () {
        // Ignore a stale pause event if a newer play request is already active.
        if (!audio.paused || playPending) return;
        setAudioState(wantsAudio ? "ready" : "paused");
        setUnlockArmed(wantsAudio);
    });
    audio.addEventListener("error", function () {
        playAttempt += 1;
        playPending = false;
        setAudioState("unavailable");
        setUnlockArmed(false);
    }, true);

    soundToggle.addEventListener("click", function () {
        if (soundToggle.disabled) return;
        if (!audio.paused || playPending) {
            wantsAudio = false;
            audio.autoplay = false;
            playAttempt += 1;
            playPending = false;
            rememberAudioPreference("off");
            setUnlockArmed(false);
            audio.pause();
            setAudioState("paused");
        } else {
            wantsAudio = true;
            audio.autoplay = true;
            rememberAudioPreference("on");
            tryPlayAudio();
        }
    });

    if (wantsAudio) {
        setUnlockArmed(true);
        tryPlayAudio();
    } else {
        audio.pause();
        setAudioState("paused");
    }
}());
</script>

