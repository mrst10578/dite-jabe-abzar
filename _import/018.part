ore) ranked[existingIndex] = correctedResult;
                });
            }
        }

        var finalResults = ranked
            .sort(function (a, b) {
                if (b.score !== a.score) return b.score - a.score;
                return a.major.name.localeCompare(b.major.name, "fa");
            })
            .slice(0, maximum);

        cacheSearch(cacheKey, finalResults);
        return finalResults.slice();
    }

    function openPanel() {
        if (typeof setProvincePanelOpen === "function") setProvincePanelOpen(false);
        suggestionPanel.hidden = false;
        searchShell.dataset.open = "true";
        searchInput.setAttribute("aria-expanded", "true");
        document.body.classList.add("search-engaged");
    }

    function closePanel() {
        suggestionPanel.hidden = true;
        setFilterPanelOpen(false);
        searchShell.dataset.open = "false";
        searchInput.setAttribute("aria-expanded", "false");
        document.body.classList.remove("search-engaged");
        resetActiveOption();
    }

    function isTouchSearch() {
        return lastSearchPointerType === "touch" || lastSearchPointerType === "pen" ||
            (!lastSearchPointerType && window.matchMedia && window.matchMedia("(pointer: coarse)").matches);
    }

    function dismissSearchPanel() {
        var focused = document.activeElement;
        closePanel();
        if (!searchShell.contains(focused)) return;
        if (isTouchSearch()) {
            // Never reopen the software keyboard just to close the list.
            if (focused && typeof focused.blur === "function") focused.blur();
        } else {
            restoringSearchFocus = true;
            searchInput.focus({ preventScroll: true });
            restoringSearchFocus = false;
        }
    }

    function resetActiveOption() {
        activeIndex = -1;
        searchInput.removeAttribute("aria-activedescendant");
    }

    function readRecentMajors() {
        try {
            var stored = JSON.parse(localStorage.getItem("aris:recent-majors") || "[]");
            if (!Array.isArray(stored)) return [];

            var seen = new Set();
            return stored.reduce(function (items, item) {
                var id = item && typeof item === "object" ? String(item.id || "") : "";
                var major = majorIdIndex.get(id);
                if (!major || seen.has(id) || items.length >= 4) return items;
                seen.add(id);
                items.push({ id: major.id, name: major.name });
                return items;
            }, []);
        } catch (error) {
            return [];
        }
    }

    function renderRecentMajors() {
        var items = readRecentMajors();
        recentChips.replaceChildren();
        recentSearches.hidden = !items.length;

        items.forEach(function (item) {
            var button = document.createElement("button");
            button.type = "button";
            button.className = "recent-chip";
            button.textContent = item.name;
            button.addEventListener("click", function () {
                var major = majorIdIndex.get(item.id);
                if (major) selectMajor(major);
            });
            recentChips.appendChild(button);
        });
    }

    function rememberMajor(major) {
        try {
            var nextItems = readRecentMajors().filter(function (item) {
                return item.id !== major.id;
            });
            nextItems.unshift({ id: major.id, name: major.name });
            localStorage.setItem("aris:recent-majors", JSON.stringify(nextItems.slice(0, 4)));
        } catch (error) {
            /* جست‌وجو بدون دسترسی به localStorage هم کاملاً کار می‌کند. */
        }
    }

    function setSearchMode(query, results) {
        if (!query) {
            searchMode.textContent = activeDomains.size ? "فیلتر حوزه" : "نام · علاقه · محیط کار";
            return;
        }

        if (results.some(function (result) { return result.keyboardCorrected; })) {
            searchMode.textContent = "اصلاح صفحه‌کلید";
            return;
        }

        if (/^[a-z\s-]+$/i.test(query)) {
            searchMode.textContent = "جست‌وجوی دو‌زبانه";
            return;
        }

        if (results[0] && results[0].reason.indexOf("املا") !== -1) {
            searchMode.textContent = "اصلاح هوشمند املا";
            return;
        }

        var semanticWords = ["کار", "علاقه", "دوست", "کودک", "مردم", "طراحی", "درمان", "آموزش", "حیوان", "عدد"];
        searchMode.textContent = semanticWords.some(function (word) { return query.indexOf(word) !== -1; })
            ? "جست‌وجوی مفهومی"
            : "تطبیق ترکیبی";
    }

    function highlightName(target, name, query) {
        target.textContent = "";
        var candidates = [query].concat(tokenize(query)).filter(Boolean).sort(function (a, b) {
            return b.length - a.length;
        });
        var match = null;
        var matchIndex = -1;

        candidates.some(function (candidate) {
            matchIndex = name.toLocaleLowerCase("fa").indexOf(candidate.toLocaleLowerCase("fa"));
            if (matchIndex >= 0) {
                match = candidate;
                return true;
            }
            return false;
        });

        if (!match) {
            candidates.some(function (candidate) {
                var compactCandidate = compactText(candidate);
                if (compactCandidate.length > 1 && compactText(name).includes(compactCandidate)) {
                    match = name;
                    matchIndex = 0;
                    return true;
                }
                return false;
            });
        }

        if (!match) {
            target.textContent = name;
            return;
        }

        target.appendChild(document.createTextNode(name.slice(0, matchIndex)));
        var mark = document.createElement("mark");
        mark.textContent = name.slice(matchIndex, matchIndex + match.length);
        target.appendChild(mark);
        target.appendChild(document.createTextNode(name.slice(matchIndex + match.length)));
    }

    function renderGuide() {
        panelTitle.textContent = "روش‌های جست‌وجو";
        panelStatus.textContent = "";
        guideState.hidden = false;
        resultsList.hidden = true;
        emptyState.hidden = true;
        panelFoot.hidden = true;
        resultsList.replaceChildren();
        currentResults = [];
        resetActiveOption();
        setSearchMode("", []);
        renderRecentMajors();
        openPanel();
    }

    function renderEmpty(query) {
        panelTitle.textContent = activeDomains.size ? "نتیجه جست‌وجوی فیلترشده" : "نتیجه جست‌وجو";
        panelStatus.textContent = "۰ پیشنهاد";
        guideState.hidden = true;
        resultsList.hidden = true;
        emptyState.hidden = false;
        panelFoot.hidden = false;
        resultsList.replaceChildren();
        currentResults = [];
        resetActiveOption();
        setSearchMode(query, []);
        emptyStateText.textContent = activeDomains.size
            ? "در حوزه‌های انتخاب‌شده نتیجه‌ای پیدا نشد؛ عبارت را تغییر بده یا فیلترها را حذف کن."
            : "عبارت را کوتاه‌تر بنویس، املای دیگری امتحان کن یا علاقه‌ات را با چند کلمه ساده توضیح بده.";
        announcer.textContent = query
            ? "برای عبارت " + query + (activeDomains.size ? " با فیلترهای فعلی" : "") + " پیشنهادی پیدا نشد."
            : "با فیلترهای فعلی پیشنهادی پیدا نشد.";
        openPanel();
    }

    function createResultNode(result, index) {
        var node = resultTemplate.content.firstElementChild.cloneNode(true);
        var major = result.major;

        node.id = "major-option-" + index;
        node.dataset.majorId = major.id;
        node.classList.add("result-reveal");
        node.style.setProperty("--result-order", index);
        if (index === 0) node.classList.add("is-top-result");
        highlightName(node.querySelector(".result-name"), major.name, lastQuery);
        node.querySelector(".result-reason").textContent = result.reason;
        node.querySelector(".result-domain").textContent = major.domain || "رشته دانشگاهی";
        node.setAttribute("aria-label", major.name + "، " + result.reason);

        node.addEventListener("pointerdown", function (event) {
            if (event.pointerType === "mouse") {
                preloadMajorContent(major.id);
                event.preventDefault();
            }
        });

        node.addEventListener("click", function () {
            selectMajor(major);
        });

        node.addEventListener("mousemove", function () {
            setActiveIndex(index, false);
        });

        node.addEventListener("focus", function () {
            preloadMajorContent(major.id);
        }, { once: true });

        return node;
    }

    function renderResults(query, results) {
        lastQuery = query;
        currentResults = results;
        resetActiveOption();
        resultsList.replaceChildren();

        if (!results.length) {
            renderEmpty(query);
            return;
        }

        var fragment = document.createDocumentFragment();
        results.forEach(function (result, index) {
            fragment.appendChild(createResultNode(result, index));
        });

        resultsList.appendChild(fragment);
        panelTitle.textContent = query ? "پیشنهادهای نزدیک" : "رشته‌های حوزه انتخاب‌شده";
        panelStatus.textContent = results.length.toLocaleString("fa-IR") + " پیشنهاد";
        setSearchMode(query, results);
        guideState.hidden = true;
        resultsList.hidden = false;
        emptyState.hidden = true;
        panelFoot.hidden = false;
        announcer.textContent = results.length.toLocaleString("fa-IR") + (query
            ? " پیشنهاد برای " + query
            : " رشته مطابق فیلترهای انتخاب‌شده") + " پیدا شد.";
        openPanel();
    }

    function updateSearch() {
        var query = searchInput.value.trim();
        clearButton.hidden = !query;

        if (!query && activeDomains.size === 0) {
            renderGuide();
            return;
        }

        var results;
        if (query) {
            results = searchMajors(query, activeDomains.size ? preparedMajors.length : 6, activeDomains.size > 0);
        } else {
            results = preparedMajors.map(function (major) {
                return {
                    major: major,
                    score: 0,
                    reason: "در حوزه انتخاب‌شده",
                    signals: { exact: 0, name: 0, alias: 0, slug: 0, semantic: 0, fuzzy: 0 }
                };
            }).sort(function (left, right) {
                return left.major.name.localeCompare(right.major.name, "fa");
            });
        }

        if (activeDomains.size) {
            results = results.filter(function (result) {
                return activeDomains.has(result.major.domain || "رشته دانشگاهی");
            });
        }

        if (query) results = results.slice(0, 12);
        renderResults(query, results);
    }

    function setActiveIndex(nextIndex, shouldScroll) {
        var options = Array.from(resultsList.querySelectorAll(".result-item"));
        if (!options.length) return;

        activeIndex = (nextIndex + options.length) % options.length;

        options.forEach(function (option, index) {
            var isActive = index === activeIndex;
            option.classList.toggle("is-active", isActive);
            option.setAttribute("aria-selected", isActive ? "true" : "false");
        });

        var activeOption = options[activeIndex];
        searchInput.setAttribute("aria-activedescendant", activeOption.id);

        if (shouldScroll) {
            activeOption.scrollIntoView({ block: "nearest" });
        }
    }

    function showToast(message) {
        window.clearTimeout(toastTimer);
        toastText.textContent = message;
        toast.dataset.visible = "true";

        toastTimer = window.setTimeout(function () {
            toast.dataset.visible = "false";
        }, 4200);
    }

    function linkifyTelegramHandles(root) {
        if (!root || !document.createTreeWalker) return;

        var walker = document.createTreeWalker(
            root,
            window.NodeFilter ? window.NodeFilter.SHOW_TEXT : 4
        );
        var matches = [];
        var currentNode;

        while ((currentNode = walker.nextNode())) {
            if (
                currentNode.nodeValue.indexOf("@ArisAcademy") !== -1 &&
                currentNode.parentElement &&
                !currentNode.parentElement.closest("a")
            ) {
                matches.push(currentNode);
            }
        }

        matches.forEach(function (textNode) {
            var parts = textNode.nodeValue.split("@ArisAcademy");
            var fragment = document.createDocumentFragment();

            parts.forEach(function (part, index) {
                if (index) {
                    var link = document.createElement("a");
                    link.className = "aris-telegram-link";
                    link.href = "https://t.me/ArisAcademy";
                    link.target = "_blank";
                    link.rel = "noopener noreferrer";
                    link.setAttribute("dir", "ltr");
                    link.setAttribute("aria-label", "کانال تلگرام آریس آکادمی");
                    link.textContent = "@ArisAcademy";
                    fragment.appendChild(link);
                }
                if (part) fragment.appendChild(document.createTextNode(part));
            });

            textNode.parentNode.replaceChild(fragment, textNode);
        });
    }

    function refreshMajorTables(resetPosition) {
        if (!majorDocument || majorDocument.hidden) return;

        Array.from(majorDocument.querySelectorAll(".aris-table-scroll")).forEach(function (scroller) {
            var shell = scroller.parentElement;
            var guide = null;
            if (shell) {
                for (var childIndex = 0; childIndex < shell.children.length; childIndex += 1) {
                    if (shell.children[childIndex].classList.contains("table-scroll-guide")) {
                        guide = shell.children[childIndex];
                        break;
                    }
                }
            }
            var isScrollable = scroller.scrollWidth > scroller.clientWidth + 2;

            if (shell) shell.classList.toggle("is-scrollable", isScrollable);
            if (guide) guide.hidden = !isScrollable;
            if (isScrollable) {
                scroller.setAttribute("role", "region");
                scroller.setAttribute("tabindex", "0");
                scroller.setAttribute("aria-label", "جدول قابل پیمایش افقی");
                if (resetPosition) scroller.scrollLeft = 0;
            } else {
                scroller.removeAttribute("role");
                scroller.removeAttribute("tabindex");
                scroller.removeAttribute("aria-label");
            }
        });
    }

    function scheduleMajorTableLayout(resetPosition) {
        if (tableLayoutFrame) window.cancelAnimationFrame(tableLayoutFrame);
        tableLayoutFrame = window.requestAnimationFrame(function () {
            tableLayoutFrame = 0;
            refreshMajorTables(Boolean(resetPosition));
        });
    }

    function enhanceMajorTables() {
        Array.from(majorDocument.querySelectorAll(".aris-table-scroll")).forEach(function (scroller, index) {
            var shell = scroller.parentElement;

            if (!shell || !shell.classList.contains("table-wrap")) {
                shell = document.createElement("div");
                shell.className = "aris-table-shell";
                scroller.parentNode.insertBefore(shell, scroller);
                shell.appendChild(scroller);
            }

            scroller.setAttribute("dir", "rtl");

            var table = scroller.querySelector("table");
            if (table) table.setAttribute("dir", "rtl");

            var guide = document.createElement("div");
            var guideId = "aris-table-guide-" + index;
            guide.className = "table-scroll-guide";
            guide.id = guideId;
            guide.hidden = true;

            var guideText = document.createElement("span");
            guideText.textContent = "جدول از سمت راست شروع شده؛ برای دیدن ستون‌های بعدی، افقی بکشید";
            guide.appendChild(guideText);

            var gesture = document.createElement("span");
            gesture.className = "table-scroll-guide__gesture";
            gesture.setAttribute("aria-hidden", "true");
            gesture.textContent = "↔";
            guide.appendChild(gesture);
            shell.insertBefore(guide, scroller);

            var describedBy = (scroller.getAttribute("aria-describedby") || "").split(/\s+/).filter(Boolean);
            describedBy.push(guideId);
            scroller.setAttribute("aria-describedby", describedBy.join(" "));

            function markExplored() {
                shell.classList.add("is-explored");
            }

            scroller.addEventListener("pointerdown", markExplored, { once: true, passive: true });
            scroller.addEventListener("wheel", markExplored, { once: true, passive: true });
            scroller.addEventListener("keydown", function (event) {
                if (event.key === "ArrowLeft" || event.key === "ArrowRight") markExplored();
            });
        });

        scheduleMajorTableLayout(true);
    }


    function findMajorJumpTarget(key) {
        var direct = majorDocument.querySelector('[data-aris-section="' + key + '"]');
        if (direct) return direct;
        if (key !== "market") return null;
        var headings = Array.from(majorDocument.querySelectorAll("h2"));
        var heading = headings.find(function (item) {
            return /بازار کار|محیط کار|فرصت.{0,12}شغلی|درآمد|واقعیت.{0,10}کار/.test(item.textContent || "");
        });
        return heading ? (heading.closest("section") || heading) : null;
    }

    function enhanceMajorNavigation() {
        var nav = majorDocument.querySelector("[data-aris-quick-nav]");
        if (!nav) return;
        var buttons = Array.from(nav.querySelectorAll("[data-aris-jump]"));
        buttons.forEach(function (button) {
            var target = findMajorJumpTarget(button.dataset.arisJump);
            if (!target) {
                button.hidden = true;
                return;
            }
            if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
            button.addEventListener("click", function () {
                buttons.forEach(function (item) { item.classList.toggle("is-active", item === button); });
                var details = target.querySelector(".aris-comparison-details");
                if (details) details.open = true;
                var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
                target.focus({ preventScroll: true });
            });
        });
    }

    /* ARIS INLINE MAJOR LOGIC START */
    function updateMajorHistory(majorId, shouldPush) {
        var nextHash = majorId ? "#major=" + encodeURIComponent(majorId) : "";
        if (window.location.hash === nextHash) return false;
        var baseUrl = window.location.href.split("#")[0];
        var nextUrl = nextHash ? baseUrl + nextHash : baseUrl;

        try {
            if (shouldPush) {
                window.history.pushState({ arisMajorViewer: Boolean(majorId), majorId: majorId || "" }, "", nextUrl);
            } else {
                window.history.replaceState({ arisMajorViewer: Boolean(majorId), majorId: majorId || "" }, "", nextUrl);
            }
            return true;
        } catch (error) {
            window.location.hash = nextHash;
            return true;
        }
    }

    var readingLayoutFrame = 0;
    var readingProgressFrame = 0;

    function updateReadingProgress() {
        readingProgressFrame = 0;
        var bar = document.getElementById("aris-reading-progress");
        if (!bar) return;
        var distance = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        var progress = activeMajorId || activeProvinceId
            ? (distance ? Math.min(1, Math.max(0, window.scrollY / distance)) : 1) : 0;
        bar.style.transform = "scaleX(" + progress.toFixed(4) + ")";
    }

    function scheduleReadingProgress() {
        if (!readingProgressFrame) readingProgressFrame = window.requestAnimationFrame(updateReadingProgress);
    }

    function refreshReadingLayout() {
        if (readingLayoutFrame) return;
        readingLayoutFrame = window.requestAnimationFrame(function () {
            readingLayoutFrame = 0;
            var header = document.querySelector(".site-header");
            var toolbar = activeMajorId ? majorViewer.querySelector(".major-viewer__toolbar")
                : activeProvinceId ? provinceViewer.querySelector(".province-viewer__toolbar") : null;
            var nav = activeMajorId ? majorDocument.querySelector(".aris-quick-nav") : null;
            var rootStyle = document.documentElement.style;
            [["--aris-header-height", header], ["--aris-toolbar-height", toolbar], ["--aris-nav-height", nav]].forEach(function (entry) {
                var height = entry[1] ? Math.ceil(entry[1].getBoundingClientRect().height) : 0;
                if (rootStyle.getPropertyValue(entry[0]) !== height + "px") rootStyle.setProperty(entry[0], height + "px");
            });
            scheduleReadingProgress();
        });
    }

    function restoreSearchFocus(kind) {
        window.requestAnimationFrame(function () {
            if (activeMajorId || activeProvinceId) return;
            var province = kind === "province";
            var section = province ? provinceSearchSection : searchStage;
            var input = province ? provinceSearchInput : searchInput;
            var touch = province ? isTouchProvinceSearch() : isTouchSearch();
            closePanel();
            setProvincePanelOpen(false);
            if (touch) {
                section.setAttribute("tabindex", "-1");
                section.focus({ preventScroll: true });
            } else {
                input.focus({ preventScroll: true });
            }
            section.scrollIntoView({ behavior: "auto", block: "start" });
            refreshReadingLayout();
        });
    }

    function enhanceDossier(root, kind) {
        if (!root || root.querySelector(".aris-dossier-footer")) return;
        // Replace only the old branding block; references and editorial content stay intact.
        root.querySelectorAll(".cta").forEach(function (block) {
            if (/آریس آکادمی \| انتخاب رشته با شناخت مسیر واقعی/.test(block.textContent)) block.remove();
        });
        var isProvince = kind === "province";
        var footer = document.createElement("footer");
        footer.className = "aris-dossier-footer";
        footer.setAttribute("aria-label", "پایان راهنما و همراهی با آریس آکادمی");
        footer.innerHTML = '<div class="aris-footer-main">' +
            '<svg class="aris-footer-mark" viewBox="0 0 120 148" aria-hidden="true"><use href="#aris-sigil-shape"></use></svg>' +
            '<div class="aris-footer-copy"><p class="aris-footer-eyebrow">آریس آکادمی · قدم بعدی تو</p>' +
            '<h2 class="aris-footer-title">شناخت بیشتر، انتخاب مطمئن‌تر.</h2>' +
            '<p class="aris-footer-description">' + (isProvince
                ? 'حالا که محل تحصیل را بهتر می‌شناسی، رشته و شرایط خودت را هم کنار آن بگذار. برای ادامهٔ مسیر انتخاب رشته، راهنماها و اطلاع‌رسانی‌های آریس را در کانال دنبال کن.'
                : 'این راهنما را کنار علاقه‌ها، توانایی‌ها و شرایط خودت بگذار. برای ادامهٔ مسیر انتخاب رشته و شناخت گزینه‌های بعدی، با آریس در کانال همراه شو.') +
            '</p><div class="aris-footer-actions"><a class="aris-footer-join" href="https://t.me/ArisAcademy" target="_blank" rel="noopener noreferrer">عضویت در کانال آریس <span aria-hidden="true">↗</span></a>' +
            '<a class="aris-footer-handle" href="https://t.me/ArisAcademy" target="_blank" rel="noopener noreferrer" aria-label="کانال تلگرام آریس آکادمی"><bdi dir="ltr">@ArisAcademy</bdi></a></div></div></div>' +
            '<div class="aris-footer-bottom"><span class="aris-footer-credit">آریس آکادمی · راهنمای شناخت رشته و محل تحصیل</span>' +
            '<div class="aris-footer-tools"><button type="button" data-aris-footer-action="search">بازگشت به جست‌وجو</button>' +
            '<button type="button" data-aris-footer-action="top">ابتدای راهنما ↑</button></div></div>';
        footer.querySelector('[data-aris-footer-action="search"]').addEventListener("click", function () {
            if (isProvince) requestCloseProvincePage(); else requestCloseMajorPage();
        });
        footer.querySelector('[data-aris-footer-action="top"]').addEventListener("click", function () {
            var viewer = isProvince ? provinceViewer : majorViewer;
            var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            viewer.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
            viewer.focus({ preventScroll: true });
        });
        root.appendChild(footer);
        var sections = Array.from(root.querySelectorAll(isProvince ? ".province-chapter" : "section")).filter(function (section) {
            return isProvince || !root.contains(section.parentElement.closest("section"));
        });
        if (sections.length >= 4) {
            var invite = document.createElement("aside");
            invite.className = "aris-inline-invite";
            invite.setAttribute("aria-label", "ادامهٔ مسیر با آریس");
            invite.innerHTML = '<p><b>انتخاب رشته، یک تصمیم چندبُعدی است.</b>راهنماهای بعدی و اطلاع‌رسانی‌های آریس را در کانال دنبال کن.</p>' +
                '<a href="https://t.me/ArisAcademy" target="_blank" rel="noopener noreferrer">همراه آریس شو <span aria-hidden="true">↗</span></a>';
            sections[Math.floor(sections.length / 2) - 1].insertAdjacentElement("afterend", invite);
        }
    }

    function renderMajorPage(major, shouldPushHistory) {
        if (activeProvinceId) closeProvincePage(false, false, true);
        closePanel();
        setProvincePanelOpen(false);
        var content = getMajorContent(major.id);
        activeMajorId = major.id;
        searchInput.value = major.name;
        clearButton.hidden = false;
        majorViewer.hidden = false;
        majorViewerTitle.textContent = major.name;
        majorViewerDomain.textContent = major.domain || "رشته دانشگاهی";
        majorViewer.setAttribute("aria-label", "معرفی کامل رشته " + major.name);
        document.body.classList.add("has-major-viewer");
        document.title = major.name + " | Aris Academy";

        if (content) {
            majorDocument.innerHTML = content;
            majorDocument.hidden = false;
            majorViewerError.hidden = true;
            enhanceDossier(majorDocument, "major");
            linkifyTelegramHandles(majorDocument);
            enhanceMajorTables();
            enhanceMajorNavigation();
        } else {
            majorDocument.replaceChildren();
            majorDocument.hidden = true;
            majorViewerError.hidden = false;
        }

        var historyChanged = updateMajorHistory(major.id, shouldPushHistory);
        majorHistoryEntry = Boolean(
            (shouldPushHistory && historyChanged) ||
            (window.history.state && window.history.state.arisMajorViewer)
        );
        refreshReadingLayout();
        window.requestAnimationFrame(function () {
            if (activeMajorId !== major.id) return;
            majorViewer.scrollIntoView({ behavior: "auto", block: "start" });
            majorViewer.focus({ preventScroll: true });
        });
    }

    function closeMajorPage(shouldPushHistory, preserveHistory, restoreFocus) {
        var ownsMajorHash = /^#major=/.test(window.location.hash);
        var nextViewIsProvince = /^#province=/.test(window.location.hash);
        activeMajorId = "";
        majorHistoryEntry = false;
        majorViewer.hidden = true;
        majorViewerTitle.textContent = "";
        majorViewerDomain.textContent = "";
        majorDocument.replaceChildren();
        majorDocument.hidden = false;
        majorViewerError.hidden = true;
        document.body.classList.remove("has-major-viewer");
        if (!nextViewIsProvince) document.title = originalDocumentTitle;
        if (!preserveHistory && (ownsMajorHash || shouldPushHistory)) {
            updateMajorHistory("", shouldPushHistory);
        }

        refreshReadingLayout();
        if (restoreFocus !== false) restoreSearchFocus("major");
    }

    function requestCloseMajorPage() {
        // If this viewer created the current history entry, go back to the exact prior page state.
        // Direct hash links did not create an entry here, so they still fall back to an in-place close.
        if (majorHistoryEntry && /^#major=/.test(window.location.hash)) {
            majorRestoreFocusPending = true;
            window.history.back();
            return;
        }
        majorRestoreFocusPending = false;
        closeMajorPage(false, false, true);
    }

    function syncMajorFromLocation() {
        var match = window.location.hash.match(/^#major=(.+)$/);
        if (!match) {
            if (activeMajorId) {
                var restoreFocus = majorRestoreFocusPending && !/^#province=/.test(window.location.hash);
                majorRestoreFocusPending = false;
                closeMajorPage(false, false, restoreFocus);
            }
            return;
        }

        var id = "";
        try { id = decodeURIComponent(match[1]); } catch (error) { id = match[1]; }
        if (id === activeMajorId) return;
        var major = majorIdIndex.get(id);
        if (major) {
            if (activeProvinceId) closeProvincePage(false, false, true);
            renderMajorPage(major, false);
        } else if (activeMajorId) {
            closeMajorPage(false, false, false);
        } else {
            updateMajorHistory("", false);
        }
    }

    function selectMajor(major) {
        if (activeProvinceId) closeProvincePage(false, false, true);
        searchInput.value = major.name;
        clearButton.hidden = false;
        rememberMajor(major);
        closePanel();

        if (typeof window.CustomEvent === "function") {
            window.dispatchEvent(new window.CustomEvent("aris:major-selected", {
                detail: {
                    id: major.id,
                    slug: major.slug,
                    name: major.name,
                    page: major.page || ""
                }
            }));
        }

        announcer.textContent = "معرفی کامل " + major.name + " باز شد.";
        showToast("پرونده کامل «" + major.name + "» باز شد.");
        renderMajorPage(major, true);
    }

    /* ARIS INLINE MAJOR LOGIC END */

    function replaceData(nextItems) {
        if (!Array.isArray(nextItems)) {
            throw new TypeError("ArisSearch.replaceData expects an array.");
        }

        searchCache.clear();
        preparedMajors = prepareData(nextItems);
        rebuildSearchIndexes();
        renderDomainFilters();
        updateBankStatus();

        if (document.activeElement === searchInput) {
            updateSearch();
        }

        return preparedMajors.length;
    }

    preparedMajors = prepareData(ARIS_MAJORS);
    rebuildSearchIndexes();
    renderDomainFilters();
    updateBankStatus();

    majorViewerClose.addEventListener("click", function () {
        requestCloseMajorPage();
    });
    filterToggle.addEventListener("click", function () {
        openPanel();
        setFilterPanelOpen(filterPanel.hidden);
    });
    clearFilters.addEventListener("click", function () {
        activeDomains.clear();
        Array.from(filterOptions.querySelectorAll(".filter-chip")).forEach(function (button) {
            button.setAttribute("aria-pressed", "false");
        });
        updateFilterSummary();
        updateSearch();
        filterToggle.focus();
    });
    window.addEventListener("popstate", syncMajorFromLocation);
    window.addEventListener("hashchange", syncMajorFromLocation);
    window.setTimeout(syncMajorFromLocation, 0);

    panelClose.addEventListener("click", dismissSearchPanel);

    searchInput.addEventListener("focus", function () {
        if (!restoringSearchFocus) updateSearch();
    });

    searchInput.addEventListener("click", function () {
        if (suggestionPanel.hidden) updateSearch();
    });

    searchInput.addEventListener("input", function () {
        if (!isComposing) updateSearch();
    });

    searchInput.addEventListener("compositionstart", function () {
        isComposing = true;
    });

    searchInput.addEventListener("compositionend", function () {
        isComposing = false;
        updateSearch();
    });

    Array.from(document.querySelectorAll(".guide-item[data-query]")).forEach(function (button) {
        button.addEventListener("click", function () {
            searchInput.value = button.dataset.query || "";
            updateSearch();
            searchInput.focus();
        });
    });

    recentClear.addEventListener("click", function () {
        try {
            localStorage.removeItem("aris:recent-majors");
        } catch (error) {
            /* پاک‌سازی در مرورگرهای محدود ممکن است در دسترس نباشد. */
        }
        renderRecentMajors();
        searchInput.focus();
    });

    var searchSpotFrame = 0;
    var searchSpotClientX = 0;
    var searchSpotClientY = 0;
    var searchField = searchForm.querySelector(".search-field");

    function paintSearchSpot() {
        searchSpotFrame = 0;
        var bounds = searchForm.getBoundingClientRect();
        var x = ((searchSpotClientX - bounds.left) / Math.max(1, bounds.width)) * 100;
        var y = ((searchSpotClientY - bounds.top) / Math.max(1, bounds.height)) * 100;
        var spotX = x.toFixed(1) + "%";
        var spotY = y.toFixed(1) + "%";
        searchForm.style.setProperty("--spot-x", spotX);
        searchForm.style.setProperty("--spot-y", spotY);
        searchField.style.setProperty("--spot-x", spotX);
        searchField.style.setProperty("--spot-y", spotY);
    }

    searchForm.addEventListener("pointermove", function (event) {
        searchSpotClientX = event.clientX;
        searchSpotClientY = event.clientY;
        if (!searchSpotFrame) searchSpotFrame = window.requestAnimationFrame(paintSearchSpot);
    }, { passive: true });

    searchForm.addEventListener("pointerleave", function () {
        searchForm.style.setProperty("--spot-x", "50%");
        searchForm.style.setProperty("--spot-y", "50%");
        searchField.style.setProperty("--spot-x", "50%");
        searchField.style.setProperty("--spot-y", "50%");
    }, { passive: true });

    searchInput.addEventListener("keydown", function (event) {
        if (isComposing || event.isComposing || event.keyCode === 229) return;

        if (event.key === "ArrowDown") {
            event.preventDefault();
            if (suggestionPanel.hidden) updateSearch();
            setActiveIndex(activeIndex + 1, true);
            return;
        }

        if (event.key === "ArrowUp") {
            event.preventDefault();
            if (suggestionPanel.hidden) updateSearch();
            setActiveIndex(activeIndex < 0 ? currentResults.length - 1 : activeIndex - 1, true);
            return;
        }

        if (event.key === "Enter" && currentResults.length && (activeIndex >= 0 || searchInput.value.trim())) {
            event.preventDefault();
            var selected = activeIndex >= 0 ? currentResults[activeIndex] : currentResults[0];
            selectMajor(selected.major);
        }
    });

    clearButton.addEventListener("click", function () {
        searchInput.value = "";
        clearButton.hidden = true;
        searchInput.focus();
        updateSearch();
        announcer.textContent = "جست‌وجو پاک شد.";
    });

    searchForm.addEventListener("submit", function (event) {
        event.preventDefault();
        if (isComposing) return;

        if (!searchInput.value.trim()) {
            updateSearch();
        } else if (currentResults.length) {
            var selected = activeIndex >= 0 ? currentResults[activeIndex] : currentResults[0];
            selectMajor(selected.major);
        } else {
            updateSearch();
        }
    });

    document.addEventListener("pointerdown", function (event) {
        lastSearchPointerType = event.pointerType || "";
        if (suggestionPanel.hidden || searchShell.contains(event.target)) return;
        if (isTouchSearch() && document.activeElement === searchInput) {
            searchInput.blur();
        }
    }, { passive: true });

    document.addEventListener("click", function (event) {
        if (suggestionPanel.hidden || searchShell.contains(event.target)) return;
        // Touch results remain available until a selection or explicit close.
        if (event.pointerType === "touch" || event.pointerType === "pen" || isTouchSearch()) return;
        closePanel();
    });

    document.addEventListener("keydown", function (event) {
        var target = event.target;
        var isTyping = target && (
            target.tagName === "INPUT" ||
            target.tagName === "TEXTAREA" ||
            target.isContentEditable
        );

        if (event.key === "Escape" && !suggestionPanel.hidden) {
            event.preventDefault();
            dismissSearchPanel();
            return;
        }

        if (event.key === "Escape" && activeMajorId && !searchShell.contains(target)) {
            event.preventDefault();
            requestCloseMajorPage();
            return;
        }

        if (event.key === "/" && !isTyping) {
            event.preventDefault();
            if (activeMajorId) {
                requestCloseMajorPage();
                return;
            }
            if (activeProvinceId) {
                requestCloseProvincePage();
                return;
            }
            searchInput.focus();
        }
    });


    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    /* ARIS PROVINCE UI START */
    var provinceSearchSection = document.getElementById("province-search-section");
    var provinceSearchForm = document.getElementById("province-search-form");
    var provinceSearchInput = document.getElementById("province-search");
    var provinceSearchClear = document.getElementById("province-search-clear");
    var provinceSuggestionPanel = document.getElementById("province-suggestion-panel");
    var provinceResultsClose = document.getElementById("province-results-close");
    var provinceResults = document.getElementById("province-results");
    var provinceResultsStatus = document.getElementById("province-results-status");
    var provinceEmpty = document.getElementById("province-empty");
    var provinceViewer = document.getElementById("province-viewer");
    var provinceViewerTitle = document.getElementById("province-viewer-title");
    var provinceViewerMeta = document.getElementById("province-viewer-meta");
    var provinceViewerClose = document.getElementById("province-viewer-close");
    var provinceDocument = document.getElementById("province-document");
    var provinceViewerError = document.getElementById("province-viewer-error");
    var preparedProvinces = [];
    var activeProvinceId = "";
    var provinceHistoryEntry = false;
    var lastProvincePointerType = "";
    var provinceRestoreFocusPending = false;
    var provinceComposing = false;
    var provinceCurrentResults = [];
    var provinceActiveIndex = -1;
    var originalProvinceDocumentTitle = document.title;

    function provincePersianNumber(value) {
        return String(value).replace(/\d/g, function (digit) { return "۰۱۲۳۴۵۶۷۸۹".charAt(Number(digit)); });
    }

    function setProvincePanelOpen(open) {
        provinceSuggestionPanel.hidden = !open;
        provinceSearchInput.setAttribute("aria-expanded", open ? "true" : "false");
        if (!open) {
            provinceActiveIndex = -1;
            provinceSearchInput.removeAttribute("aria-activedescendant");
        }
        if (open && typeof closePanel === "function") closePanel();
    }

    function prepareProvinceSearch() {
        preparedProvinces = ARIS_PROVINCES.map(function (province) {
            var values = [province.name, province.center].concat(province.aliases || [], ARIS_PROVINCE_SEARCH_TERMS[province.id] || []).map(normalizeText);
            return {
                province: province,
                values: values,
                compactValues: values.map(compactText),
                indexed: values.join(" "),
                compactIndexed: compactText(values.join(" "))
            };
        });
    }

    function provinceMatchScore(item, normalized, compact) {
        var values = item.values;
        var compactValues = item.compactValues;
        if (values[0] === normalized || (compact && compactValues[0] === compact)) return 0;
        if (values[1] === normalized || (compact && compactValues[1] === compact)) return 1;
        if (values.slice(2).some(function (value, index) {
            return value === normalized || (compact && compactValues[index + 2] === compact);
        })) return 2;
        if (values.some(function (value) {
            return value.indexOf(normalized) === 0;
        }) || (compact && compactValues.some(function (value) {
            return value.indexOf(compact) === 0;
        }))) return 3;
        // Match within one city/university alias; do not join unrelated names or
        // accept a short city name as a prefix of an unrelated query (e.g. ریاضی).
        if (values.some(function (value) { return value.indexOf(normalized) !== -1; }) ||
            (compact && compactValues.some(function (value) { return value.indexOf(compact) !== -1; }))) return 4;
        var words = normalized.split(" ").filter(function (word) { return word !== "دانشگاه" && word !== "شهر"; });
        if (words.length > 1 && values.some(function (value) {
            return words.every(function (word) { return value.indexOf(word) !== -1; });
        })) return 5;
        return 99;
    }

    function provinceMatches(query) {
        var normalized = normalizeText(query);
        if (!normalized) return [];
        normalized = normalized.replace(/^استان\s+/, "").trim();
        if (!normalized) return [];
        var compact = compactText(query);
        compact = compact.replace(/^استان/, "");
        return preparedProvinces
            .map(function (item) {
                return { item: item, score: provinceMatchScore(item, normalized, compact) };
            })
            .filter(function (result) { return result.score < 99; })
            .sort(function (left, right) {
                if (left.score !== right.score) return left.score - right.score;
                return left.item.province.order - right.item.province.order;
            })
            .map(function (result) { return result.item; });
    }

    function setProvinceActiveIndex(index, shouldScroll) {
        var buttons = Array.from(provinceResults.querySelectorAll(".province-result"));
        if (!buttons.length) {
            provinceActiveIndex = -1;
            provinceSearchInput.removeAttribute("aria-activedescendant");
            return;
        }
        provinceActiveIndex = (index + buttons.length) % buttons.length;
        buttons.forEach(function (button, buttonIndex) {
            var selected = buttonIndex === provinceActiveIndex;
            button.setAttribute("aria-selected", selected ? "true" : "false");
            button.classList.toggle("is-active", selected);
        });
        var activeButton = buttons[provinceActiveIndex];
        provinceSearchInput.setAttribute("aria-activedescendant", activeButton.id);
        if (shouldScroll && activeButton && typeof activeButton.scrollIntoView === "function") {
            activeButton.scrollIntoView({ block: "nearest" });
        }
    }

    function isTouchProvinceSearch() {
        return lastProvincePointerType === "touch" || lastProvincePointerType === "pen" ||
            (!lastProvincePointerType && window.matchMedia && window.matchMedia("(pointer: coarse)").matches);
    }

    function renderProvinceResults(query) {
        var trimmed = query.trim();
        provinceResults.replaceChildren();
        provinceCurrentResults = [];
        provinceActiveIndex = -1;
        provinceSearchInput.removeAttribute("aria-activedescendant");
        var browseAll = !trimmed;
        var matches = browseAll ? preparedProvinces.slice() : provinceMatches(trimmed);
        provinceCurrentResults = matches;
        provinceEmpty.hidden = matches.length !== 0;
        provinceResultsStatus.textContent = browseAll
            ? "نام استان، شهر یا دانشگاه را بنویس؛ یا از فهرست انتخاب کن."
            : provincePersianNumber(matches.length) + " نتیجه برای «" + trimmed + "»";
        setProvincePanelOpen(true);

        matches.forEach(function (item, index) {
            var province = item.province;
            var button = document.createElement("button");
            var copy = document.createElement("span");
            var name = document.createElement("span");
            var center = document.createElement("span");
            var arrow = document.createElement("span");
            button.type = "button";
            button.className = "province-result";
            button.setAttribute("role", "option");
            button.id = "province-option-" + index;
            button.setAttribute("aria-selected", "false");
            button.setAttribute("aria-label", "باز کردن راهنمای استان " + province.name);
            copy.className = "province-result__copy";
            name.className = "province-result__name";
            name.textContent = province.name;
            center.className = "province-result__center";
            center.textContent = "مرکز استان: " + province.center;
            arrow.className = "province-result__arrow";
            arrow.setAttribute("aria-hidden", "true");
            arrow.innerHTML = '<svg viewBox="0 0 24 24" fill="none"><path d="M19 12H6m5-5-5 5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
            copy.append(name, center);
            button.append(copy, arrow);
            button.addEventListener("click", function () { selectProvince(province); });
            button.addEventListener("mousemove", function () { setProvinceActiveIndex(index, false); });
            provinceResults.append(button);
        });
        return matches;
    }

    function updateProvinceHistory(provinceId, shouldPush) {
        var nextHash = provinceId ? "#province=" + encodeURIComponent(provinceId) : "";
        if (window.location.hash === nextHash) return false;
        var baseUrl = window.location.href.split("#")[0];
        var nextUrl = nextHash ? baseUrl + nextHash : baseUrl;

        try {
            if (shouldPush) {
                window.history.pushState({ arisProvinceViewer: Boolean(provinceId), provinceId: provinceId || "" }, "", nextUrl);
            } else {
                window.history.replaceState({ arisProvinceViewer: Boolean(provinceId), provinceId: provinceId || "" }, "", nextUrl);
            }
            return true;
        } catch (error) {
            window.location.hash = nextHash;
            return true;
        }
    }


    var provinceDecodeRun = 0;
    var provinceLastScrollAt = 0;

    function queueProvinceImageWork(callback) {
        if (window.requestIdleCallback) {
            window.requestIdleCallback(callback, { timeout: 1200 });
        } else {
            window.setTimeout(function () {
                callback({ didTimeout: false, timeRemaining: function () { return 8; } });
            }, 80);
        }
    }

    function prepareProvinceImages(provinceId) {
        var run = ++provinceDecodeRun;
        var images = Array.from(provinceDocument.querySelectorAll("img"));
        images.forEach(function (image, index) {
            image.decoding = "async";
            image.loading = index === 0 ? "eager" : "lazy";
            if (index === 0) image.fetchPriority = "high";
        });

        if (images[0] && images[0].decode) images[0].decode().catch(function () {});
        var index = 1;
        function decodeNext() {
            if (run !== provinceDecodeRun || activeProvinceId !== provinceId || index >= images.length) return;
            if (Date.now() - provinceLastScrollAt < 180) {
                queueProvinceImageWork(decodeNext);
                return;
            }
            var image = images[index++];
            var decoded = image.decode ? image.decode() : Promise.resolve();
            Promise.resolve(decoded).catch(function () {}).then(function () {
                queueProvinceImageWork(decodeNext);
            });
        }
        queueProvinceImageWork(decodeNext);
    }

    function renderProvincePage(province, shouldPushHistory) {
        if (activeMajorId) closeMajorPage(false, true, false);
        closePanel();
        activeProvinceId = province.id;
        provinceSearchInput.value = province.name;
        provinceSearchClear.hidden = false;
        setProvincePanelOpen(false);
        var content = getProvinceContent(province.id);
        provinceViewer.hidden = false;
        provinceViewerTitle.textContent = province.name;
        provinceViewerMeta.textContent = "مرکز: " + province.center + " · راهنمای یکپارچه استان";
        provinceViewer.setAttribute("aria-label", "راهنمای یکپارچه استان " + province.name);
        document.body.classList.add("has-province-viewer");
        document.title = "استان " + province.name + " | Aris Academy";

        if (content) {
            // Preserve full-resolution media, but let the browser decode it cooperatively.
            provinceDocument.innerHTML = content;
            provinceDocument.hidden = false;
            provinceViewerError.hidden = true;
            enhanceDossier(provinceDocument, "province");
            prepareProvinceImages(province.id);
        } else {
            provinceDocument.replaceChildren();
            provinceDocument.hidden = true;
            provinceViewerError.hidden = false;
        }

        var historyChanged = updateProvinceHistory(province.id, Boolean(shouldPushHistory));
        provinceHistoryEntry = Boolean(
            (shouldPushHistory && historyChanged) ||
            (window.history.state && window.history.state.arisProvinceViewer)
        );
        announcer.textContent = "راهنمای استان " + province.name + " باز شد.";
        refreshReadingLayout();
        window.requestAnimationFrame(function () {
            if (activeProvinceId !== province.id) return;
            provinceViewer.scrollIntoView({ behavior: "auto", block: "start" });
            provinceViewer.focus({ preventScroll: true });
        });
    }

    function selectProvince(province) {
        if (activeMajorId) closeMajorPage(false, true, false);
        renderProvincePage(province, true);
    }

    function closeProvincePage(restoreFocus, shouldPushHistory, preserveHistory) {
        var ownsProvinceHash = /^#province=/.test(window.location.hash);
        var nextViewIsMajor = /^#major=/.test(window.location.hash);
        provinceDecodeRun += 1;
        activeProvinceId = "";
        provinceHistoryEntry = false;
        provinceViewer.hidden = true;
        provinceViewerTitle.textContent = "";
        provinceViewerMeta.textContent = "";
        provinceDocument.replaceChildren();
        provinceDocument.hidden = false;
        provinceViewerError.hidden = true;
        document.body.classList.remove("has-province-viewer");
        if (!nextViewIsMajor) document.title = originalProvinceDocumentTitle;
        if (!preserveHistory && (ownsProvinceHash || shouldPushHistory)) {
            updateProvinceHistory("", Boolean(shouldPushHistory));
        }
        refreshReadingLayout();
        if (restoreFocus) restoreSearchFocus("province");
    }

    function requestCloseProvincePage() {
        // Match the major viewer: consume the UI-created history entry instead of leaving a duplicate base entry.
        if (provinceHistoryEntry && /^#province=/.test(window.location.hash)) {
            provinceRestoreFocusPending = true;
            window.history.back();
            return;
        }
        provinceRestoreFocusPending = false;
        closeProvincePage(true, false);
    }

    function syncProvinceFromLocation() {
        var match = window.location.hash.match(/^#province=(.+)$/);
        if (!match) {
            if (activeProvinceId) {
                var restoreFocus = provinceRestoreFocusPending && !/^#major=/.test(window.location.hash);
                provinceRestoreFocusPending = false;
                closeProvincePage(restoreFocus, false, false);
            }
            return;
        }

        var id = "";
        try { id = decodeURIComponent(match[1]); } catch (error) { id = match[1]; }
        if (id === activeProvinceId) return;
        var province = ARIS_PROVINCES.find(function (item) { return item.id === id; });
        if (province) {
            if (activeMajorId) closeMajorPage(false, true, false);
            renderProvincePage(province, false);
        } else if (activeProvinceId) {
            closeProvincePage(false, false, false);
        } else {
            updateProvinceHistory("", false);
        }
    }

    provinceSearchInput.addEventListener("input", function () {
        provinceSearchClear.hidden = !provinceSearchInput.value;
        if (!provinceComposing) renderProvinceResults(provinceSearchInput.value);
    });
    provinceSearchInput.addEventListener("compositionstart", function () {
        provinceComposing = true;
    });
    provinceSearchInput.addEventListener("compositionend", function () {
        provinceComposing = false;
        renderProvinceResults(provinceSearchInput.value);
    });
    provinceSearchInput.addEventListener("focus", function () {
        renderProvinceResults(provinceSearchInput.value);
    });
    provinceSearchInput.addEventListener("click", function () {
        if (provinceSuggestionPanel.hidden) renderProvinceResults(provinceSearchInput.value);
    });
    provinceSearchInput.addEventListener("keydown", function (event) {
        if (provinceComposing || event.isComposing || event.keyCode === 229) return;
        if (event.key === "ArrowDown") {
            event.preventDefault();
            if (provinceSuggestionPanel.hidden) renderProvinceResults(provinceSearchInput.value);
            setProvinceActiveIndex(provinceActiveIndex + 1, true);
        } else if (event.key === "ArrowUp") {
            event.preventDefault();
            if (provinceSuggestionPanel.hidden) renderProvinceResults(provinceSearchInput.value);
            setProvinceActiveIndex(provinceActiveIndex < 0 ? provinceCurrentResults.length - 1 : provinceActiveIndex - 1, true);
        } else if (event.key === "Enter") {
            event.preventDefault();
            submitProvinceSearch();
        } else if (event.key === "Escape" && provinceSearchInput.value) {
            event.preventDefault();
            provinceSearchInput.value = "";
            provinceSearchClear.hidden = true;
            renderProvinceResults("");
        } else if (event.key === "Escape") {
            event.preventDefault();
            setProvincePanelOpen(false);
        }
    });
    function submitProvinceSearch() {
        if (provinceComposing) return;
        var selected = !provinceSuggestionPanel.hidden && provinceActiveIndex >= 0
            ? provinceCurrentResults[provinceActiveIndex] : null;
        if (!selected && !provinceSearchInput.value.trim()) {
            renderProvinceResults("");
            return;
        }
        var match = selected || provinceMatches(provinceSearchInput.value)[0];
        if (match) selectProvince(match.province);
        else renderProvinceResults(provinceSearchInput.value);
    }
    provinceSearchForm.addEventListener("submit", function (event) {
        event.preventDefault();
        submitProvinceSearch();
    });
    provinceSearchClear.addEventListener("click", function () {
        provinceSearchInput.value = "";
        provinceSearchClear.hidden = true;
        renderProvinceResults("");
        provinceSearchInput.focus();
    });
    provinceResultsClose.addEventListener("click", function () {
        setProvincePanelOpen(false);
    });
    provinceSearchForm.addEventListener("pointermove", function (event) {
        var rect = provinceSearchForm.getBoundingClientRect();
        provinceSearchForm.style.setProperty("--province-spot-x", (event.clientX - rect.left) + "px");
        provinceSearchForm.style.setProperty("--province-spot-y", (event.clientY - rect.top) + "px");
    }, { passive: true });
    provinceViewerClose.addEventListener("click", requestCloseProvincePage);
    document.addEventListener("pointerdown", function (event) {
        lastProvincePointerType = event.pointerType || "";
        if (provinceSuggestionPanel.hidden || provinceSearchSection.contains(event.target)) return;
        if (isTouchProvinceSearch() && document.activeElement === provinceSearchInput) {
            provinceSearchInput.blur();
        }
    }, { passive: true });
    document.addEventListener("click", function (event) {
        if (provinceSuggestionPanel.hidden || provinceSearchSection.contains(event.target)) return;
        if (event.detail === 0) {
            setProvincePanelOpen(false);
            return;
        }
        if (event.pointerType === "touch" || event.pointerType === "pen" || isTouchProvinceSearch()) return;
        setProvincePanelOpen(false);
    });
    document.addEventListener("keydown", function (event) {
        if (event.defaultPrevented) return;
        if (event.key === "Escape" && !provinceSuggestionPanel.hidden) {
            event.preventDefault();
            setProvincePanelOpen(false);
        } else if (event.key === "Escape" && activeProvinceId && !provinceSearchSection.contains(event.target)) {
            event.preventDefault();
            requestCloseProvincePage();
        }
    });
    window.addEventListener("popstate", syncProvinceFromLocation);
    window.addEventListener("hashchange", syncProvinceFromLocation);
    prepareProvinceSearch();
    setProvincePanelOpen(false);
    window.setTimeout(syncProvinceFromLocation, 0);
    /* ARIS PROVINCE UI END */
























    window.ArisSearch = Object.freeze({
        search: function (query, limit) {
            return searchMajors(query, limit).map(function (result) {
                return {
                    id: result.major.id,
                    slug: result.major.slug,
                    name: result.major.name,
                    domain: result.major.domain,
                    reason: result.reason,
                    score: Math.round(result.score),
                    page: result.major.page || ""
                };
            });
        },
        normalize: normalizeText,
        replaceData: replaceData
    });
    window.addEventListener("resize", function () {
        if (activeMajorId) scheduleMajorTableLayout(false);
        refreshReadingLayout();
    }, { passive: true });
    window.addEventListener("scroll", function () {
        provinceLastScrollAt = Date.now();
        scheduleReadingProgress();
    }, { passive: true });
    majorDocument.addEventListener("toggle", function () {
        if (activeMajorId) scheduleMajorTableLayout(false);
        refreshReadingLayout();
    }, true);
    if (window.ResizeObserver) {
        var readingObserver = new window.ResizeObserver(refreshReadingLayout);
        readingObserver.observe(document.querySelector(".site-header"));
        readingObserver.observe(majorViewer.querySelector(".major-viewer__toolbar"));
        readingObserver.observe(provinceViewer.querySelector(".province-viewer__toolbar"));
    }
    if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(function () {
            if (activeMajorId) scheduleMajorTableLayout(false);
            refreshReadingLayout();
        });
    }
    document.querySelector(".site-header .brand-lockup").addEventListener("click", function (event) {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        if (activeMajorId) closeMajorPage(false, false, false);
        if (activeProvinceId) closeProvincePage(false, false, false);
        closePanel();
        setProvincePanelOpen(false);
        var hero = document.querySelector(".main > .hero");
        hero.setAttribute("tabindex", "-1");
        hero.focus({ preventScroll: true });
        window.scrollTo({ top: 0, behavior: "auto" });
    });
    document.querySelector(".skip-link").addEventListener("click", function (event) {
        event.preventDefault();
        var target = activeMajorId ? majorViewer : activeProvinceId ? provinceViewer : document.getElementById("main-content");
        target.focus({ preventScroll: true });
        target.scrollIntoView({ behavior: "auto", block: "start" });
    });
    refreshReadingLayout();
    document.documentElement.classList.remove("no-js");
}());
</script>
<script data-aris-module="motion-effects">
(function () {
    "use strict";

    var motionPreference = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)");
    var reduceMotion = motionPreference && motionPreference.matches;
    var canvas = document.getElementById("starfield");
    var context = canvas && canvas.getContext ? canvas.getContext("2d") : null;
    var stars = [];
    var viewportWidth = 0;
    var viewportHeight = 0;
    var pointerX = 0;
    var pointerY = 0;
    var targetPointerX = 0;
    var targetPointerY = 0;
    var animationFrame = 0;
    var lastPaintTime = 0;
    var canvasDensity = 0;
    var resizeFrame = 0;
    var pointerFrame = 0;
    var latestPointerX = 0;
    var latestPointerY = 0;
    var lastReadingScroll = -Infinity;
    var heroSigil = document.querySelector(".hero-sigil");

    window.addEventListener("scroll", function () {
        lastReadingScroll = window.performance ? window.performance.now() : 0;
    }, { passive: true });

    function createStars() {
        var areaCount = Math.round((viewportWidth * viewportHeight) / 6200);
        var minimum = viewportWidth < 700 ? 88 : 112;
        var maximum = viewportWidth < 700 ? 148 : 240;
        var count = Math.max(minimum, Math.min(maximum, areaCount));
        stars = Array.from({ length: count }, function (_, index) {
            return stars[index] || {
                x: Math.random(),
                y: Math.random(),
                radius: index % 23 === 0 ? 2.1 : (index % 11 === 0 ? 1.55 : .45 + (Math.random() * .85)),
                alpha: .3 + (Math.random() * .6),
                phase: Math.random() * Math.PI * 2,
                speed: .0005 + (Math.random() * .00135),
                depth: .25 + (Math.random() * .75),
                gold: index % 5 === 0
            };
        });
    }

    function resizeCanvas() {
        if (!context) return;
        var density = Math.min(window.devicePixelRatio || 1, 1.6);
        var sky = canvas.parentElement;
        var nextWidth = sky.clientWidth || window.innerWidth;
        var nextHeight = sky.clientHeight || window.innerHeight;
        if (viewportWidth === nextWidth && viewportHeight === nextHeight && canvasDensity === density) return;
        viewportWidth = nextWidth;
        viewportHeight = nextHeight;
        canvasDensity = density;
        canvas.width = Math.round(viewportWidth * density);
        canvas.height = Math.round(viewportHeight * density);
        canvas.style.width = viewportWidth + "px";
        canvas.style.height = viewportHeight + "px";
        context.setTransform(density, 0, 0, density, 0, 0);
        createStars();
        drawStars(window.performance ? window.performance.now() : 0);
    }

    function drawStars(time) {
        if (!context) return;
        context.clearRect(0, 0, viewportWidth, viewportHeight);
        pointerX += (targetPointerX - pointerX) * .035;
        pointerY += (targetPointerY - pointerY) * .035;

        var searchEngaged = document.body.classList.contains("search-engaged");

        for (var index = 0; index < stars.length; index += 1) {
            var star = stars[index];
            var pulse = reduceMotion ? 1 : .71 + (Math.sin((time * star.speed) + star.phase) * .29);
            var alpha = Math.min(1, Math.max(.14, star.alpha * pulse * (searchEngaged ? 1.08 : 1)));
            var x = (star.x * viewportWidth) + (pointerX * star.depth * 9);
            var y = (star.y * viewportHeight) + (pointerY * star.depth * 7);
            var color = star.gold ? "229, 182, 62" : "255, 248, 231";

            if (star.radius > 1.2) {
                var halo = context.createRadialGradient(x, y, 0, x, y, star.radius * 5);
                halo.addColorStop(0, "rgba(" + color + "," + (alpha * .2) + ")");
                halo.addColorStop(1, "rgba(" + color + ",0)");
                context.fillStyle = halo;
                context.fillRect(x - star.radius * 5, y - star.radius * 5, star.radius * 10, star.radius * 10);
            }

            context.beginPath();
            context.arc(x, y, star.radius, 0, Math.PI * 2);
            context.fillStyle = "rgba(" + color + "," + alpha + ")";
            context.fill();

            if (star.radius > 1.2) {
                context.beginPath();
                context.moveTo(x - 4, y);
                context.lineTo(x + 4, y);
                context.moveTo(x, y - 4);
                context.lineTo(x, y + 4);
                context.strokeStyle = "rgba(" + color + "," + (alpha * .45) + ")";
                context.lineWidth = .55;
                context.stroke();
            }
        }
    }

    function animateStars(time) {
        if (document.hidden || reduceMotion) { animationFrame = 0; return; }
        var reading = document.body.classList.contains("has-major-viewer") || document.body.classList.contains("has-province-viewer");
        // Retain the painted sky during scrolling; do not clear or rebuild its canvas.
        var scrolling = reading && time - lastReadingScroll < 160;
        if (!scrolling && (!lastPaintTime || time - lastPaintTime >= 1000 / (reading ? 15 : 30))) {
            drawStars(time);
            lastPaintTime = time;
        }
        animationFrame = window.requestAnimationFrame(animateStars);
    }

    function syncSkyMotion() {
        window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        lastPaintTime = 0;
        if (document.hidden || document.body.classList.contains("aris-compass-open")) return;
        drawStars(window.performance ? window.performance.now() : 0);
        if (!reduceMotion) animationFrame = window.requestAnimationFrame(animateStars);
    }

    function queueCanvasResize() {
        if (resizeFrame) return;
        resizeFrame = window.requestAnimationFrame(function () {
            resizeFrame = 0;
            resizeCanvas();
        });
    }

    function updatePointerMotion() {
        pointerFrame = 0;
        targetPointerX = (latestPointerX / Math.max(1, viewportWidth)) - .5;
        targetPointerY = (latestPointerY / Math.max(1, viewportHeight)) - .5;

        if (heroSigil) {
            heroSigil.style.setProperty("--sigil-x", (targetPointerX * 11).toFixed(2) + "px");
            heroSigil.style.setProperty("--sigil-y", (targetPointerY * 6).toFixed(2) + "px");
        }
    }

    if (context) {
        resizeCanvas();
        window.addEventListener("resize", queueCanvasResize, { passive: true });
        window.addEventListener("pointermove", function (event) {
            if (reduceMotion || event.pointerType !== "mouse") return;
            latestPointerX = event.clientX;
            latestPointerY = event.clientY;
            if (!pointerFrame) pointerFrame = window.requestAnimationFrame(updatePointerMotion);
        }, { passive: true });

        document.documentElement.addEventListener("mouseleave", function () {
            targetPointerX = 0;
            targetPointerY = 0;
            if (heroSigil) {
                heroSigil.style.setProperty("--sigil-x", "0px");
                heroSigil.style.setProperty("--sigil-y", "0px");
            }
        });

        syncSkyMotion();
        document.addEventListener("visibilitychange", syncSkyMotion);
        document.addEventListener("aris:compass-visibility", syncSkyMotion);
        if (motionPreference && motionPreference.addEventListener) {
            motionPreference.addEventListener("change", function (event) {
                reduceMotion = event.matches;
                targetPointerX = targetPointerY = pointerX = pointerY = 0;
                if (heroSigil) {
                    heroSigil.style.setProperty("--sigil-x", "0px");
                    heroSigil.style.setProperty("--sigil-y", "0px");
                }
                syncSkyMotion();
            });
        }
    }

}());
</script>
