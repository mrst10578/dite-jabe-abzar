,linear-gradient(180deg,#090a08,#050605)!important;color:#f5f0e5!important;font-family:\"Vazirmatn\",Tahoma,\"Segoe UI\",sans-serif!important;overflow-x:hidden}\nbody:before,.progress,.share-section,.footer{display:none!important}.aris-article-shell{width:min(100%,1020px);margin:0 auto;padding:clamp(14px,3.5vw,34px)}\n.aris-article-tools{position:relative;margin:0 0 16px;padding:16px;border:1px solid rgba(229,182,62,.26);border-radius:18px;background:linear-gradient(145deg,rgba(25,25,20,.96),rgba(14,15,12,.98));box-shadow:0 18px 50px rgba(0,0,0,.26)}\n.aris-article-tools__row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:start}.aris-article-search{position:relative}.aris-article-search__field{position:relative}.aris-article-search input{width:100%;height:46px;padding:0 14px 0 88px;border:1px solid rgba(229,182,62,.2);border-radius:12px;background:#090a08;color:#fff8e7;outline:0;font-size:15px}.aris-article-search input:focus{border-color:#e5b63e;box-shadow:0 0 0 4px rgba(229,182,62,.11)}.aris-article-search__submit{position:absolute;inset:5px auto 5px 5px;min-width:76px;border:0;border-radius:9px;background:linear-gradient(145deg,#f2ca64,#bd8720);color:#171108;font-weight:800;cursor:pointer}.aris-article-search__meta{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:29px;margin-top:5px}.aris-article-search-status{color:#aaa292;font-size:11px}.aris-article-search-nav{display:flex;gap:4px}.aris-article-search-nav[hidden]{display:none}.aris-article-search-nav button{min-width:34px;height:28px;border:1px solid rgba(229,182,62,.2);border-radius:8px;background:rgba(229,182,62,.06);color:#e7c873;cursor:pointer}.aris-search-hit{padding:0 2px;border-radius:4px;background:#80651d;color:#fff8dc}.aris-search-hit.is-current{background:#ffd66d;color:#171108;box-shadow:0 0 0 3px rgba(255,214,109,.18)}\n.aris-toc{min-width:170px}.aris-toc summary{min-height:46px;display:flex;align-items:center;justify-content:center;padding:8px 14px;border:1px solid rgba(143,164,115,.28);border-radius:12px;color:#c8d9aa;background:rgba(102,115,74,.08);cursor:pointer;font-size:13px}.aris-toc[open] summary{border-radius:12px 12px 0 0}.aris-toc__list{display:grid;gap:3px;max-height:280px;overflow:auto;margin:0;padding:10px;border:1px solid rgba(143,164,115,.24);border-top:0;border-radius:0 0 12px 12px;background:#0b0d0a;list-style:none}.aris-toc__list a{display:block;padding:8px 9px;border-radius:8px;color:#d7d0c1;text-decoration:none;font-size:12px;line-height:1.7}.aris-toc__list a:hover{color:#ffe09a;background:rgba(229,182,62,.07)}\n.aris-validity{display:flex;align-items:flex-start;gap:10px;margin-top:12px;padding:12px 13px;border:1px solid rgba(229,182,62,.22);border-radius:12px;background:rgba(229,182,62,.055);color:#d8cfbc;font-size:12px;line-height:1.9}.aris-validity b{flex:0 0 auto;color:#f0c65d}.aris-validity--stable{border-color:rgba(143,164,115,.23);background:rgba(102,115,74,.06)}.aris-validity--stable b{color:#b7c995}\n#mainContent{display:block!important;width:100%!important;max-width:none!important;margin:0!important;padding:0!important;color:#f5f0e5!important}#mainContent,#mainContent button,#mainContent input,#mainContent select,#mainContent textarea,#mainContent a{font-family:\"Vazirmatn\",Tahoma,\"Segoe UI\",sans-serif!important}\n#mainContent>.intro:first-child{margin-top:0!important}#mainContent .intro,#mainContent .section,#mainContent .compare-section{border:1px solid rgba(229,182,62,.2)!important;border-radius:20px!important;background:linear-gradient(145deg,rgba(21,22,18,.98),rgba(13,14,12,.99))!important;box-shadow:0 16px 44px rgba(0,0,0,.22)!important}\n#mainContent .term,#mainContent .mistake,#mainContent .principle,#mainContent .professor-card,#mainContent .benefit-card,#mainContent .compare-card,#mainContent .compare-side,#mainContent .research-box,#mainContent .summary-row,#mainContent .mini-compare>div,#mainContent .map-card{border-color:rgba(143,164,115,.22)!important;background:rgba(102,115,74,.055)!important;color:#f1ecdf!important;box-shadow:none!important}\n#mainContent .term{padding:20px 30px 20px 20px!important}\n#mainContent .section-intro,#mainContent .topic-note,#mainContent .editorial-note,#mainContent .example{border-color:rgba(229,182,62,.2)!important;background:rgba(229,182,62,.055)!important;color:#e1d9c9!important}\n#mainContent .visual-summary,#mainContent .final-note,#mainContent .formula-box,#mainContent .subgroup-label{background:linear-gradient(145deg,#172017,#0d120e)!important;border:1px solid rgba(143,164,115,.24)!important;color:#f5f0e5!important}\n#mainContent h2,#mainContent h3,#mainContent h4,#mainContent b,#mainContent strong{color:#edc96f!important}#mainContent p,#mainContent li,#mainContent small,#mainContent .university,#mainContent .section-kicker,#mainContent .intro-kicker{color:#ddd6c9!important}#mainContent p,#mainContent li{font-size:clamp(17px,2.1vw,19px)!important;line-height:2.05!important}#mainContent h2{font-size:clamp(24px,4vw,33px)!important;line-height:1.55!important}#mainContent h3{font-size:clamp(19px,3vw,23px)!important;line-height:1.7!important}\n#mainContent .section-head{border-bottom-color:rgba(229,182,62,.18)!important}#mainContent .section-no,#mainContent .intro-badge,#mainContent .num{color:#f3cf75!important}#mainContent .section-no{background:#26321f!important}#mainContent a{color:#e7c46c!important}#mainContent [id]{scroll-margin-top:18px}\n.aris-related{margin:24px 0 10px;padding:20px;border:1px solid rgba(143,164,115,.25);border-radius:20px;background:linear-gradient(145deg,rgba(20,24,18,.97),rgba(12,14,11,.99))}.aris-related__eyebrow{margin:0;color:#9eb183;font-size:12px}.aris-related h2{margin:5px 0 15px;color:#f0cb72;font-size:22px}.aris-related__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.aris-related button{padding:14px;border:1px solid rgba(229,182,62,.18);border-radius:13px;background:rgba(229,182,62,.04);color:#f4eee1;text-align:right;cursor:pointer;font-size:14px;line-height:1.8}.aris-related button:hover{border-color:rgba(229,182,62,.5);background:rgba(229,182,62,.08)}\n@media(max-width:620px){.aris-article-shell{padding:10px}.aris-article-tools{padding:12px;border-radius:15px}.aris-article-tools__row{grid-template-columns:1fr}.aris-toc{min-width:0}.aris-related__grid{grid-template-columns:1fr}#mainContent .intro,#mainContent .section,#mainContent .compare-section{padding:20px 15px!important;border-radius:16px!important}#mainContent .term{padding:18px 25px 18px 17px!important}#mainContent p,#mainContent li{font-size:17px!important;line-height:2!important}}\n</style><style data-aris-reader-refinement=\"17\">\n/* Shell 17: compact collapsible in-article search + softer highlight card. */\n.aris-search-disclosure{\n  width:100%;\n  min-height:42px;\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:10px;\n  padding:8px 12px;\n  border:1px solid rgba(224,169,47,.18);\n  border-radius:11px;\n  background:rgba(224,169,47,.04);\n  color:#d9bd83;\n  cursor:pointer;\n  font:inherit;\n  font-size:.8rem;\n  font-weight:700;\n}\n.aris-search-disclosure::after{\n  content:\"⌕\";\n  color:#e0a92f;\n  font-size:1rem;\n}\n.aris-search-disclosure[aria-expanded=\"true\"]{\n  border-color:rgba(224,169,47,.34);\n  background:rgba(224,169,47,.075);\n}\n.aris-search-disclosure[aria-expanded=\"true\"]::after{\n  content:\"×\";\n}\n.aris-search-disclosure + .aris-article-search{\n  margin-top:10px;\n}\n.aris-article-search[hidden]{\n  display:none!important;\n}\n.aris-article-tools__row{\n  gap:9px!important;\n}\n.aris-validity{\n  padding:10px 12px!important;\n  border-color:rgba(224,169,47,.13)!important;\n  background:rgba(224,169,47,.025)!important;\n}\n.aris-validity b{\n  font-size:.75rem!important;\n}\n.aris-validity span{\n  font-size:.76rem!important;\n  line-height:1.85!important;\n}\n.intro-badge{\n  border-color:#cbb37b!important;\n  background:radial-gradient(circle at 50% 34%,#eee0bb,#d8c59b)!important;\n}\n.intro-badge b{\n  color:#153c2b!important;\n}\n.intro-badge span{\n  color:#735d2d!important;\n}\n@media(max-width:560px){\n  .aris-search-disclosure{\n    min-height:40px;\n    padding:7px 10px;\n    font-size:.76rem;\n  }\n  .aris-validity{\n    padding:9px 10px!important;\n  }\n}\n</style></head><body><h1 class=\"aris-doc-title-sr\" style=\"position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0\">امکان یا ضرورت ادامه تحصیل؟</h1><div class=\"aris-article-shell\"><aside aria-label=\"ابزارهای مطالعه\" class=\"aris-article-tools\"><div class=\"aris-article-tools__row\"><button aria-controls=\"aris-article-search-form\" aria-expanded=\"false\" class=\"aris-search-disclosure\" type=\"button\">جست‌وجو داخل همین مطلب</button><form class=\"aris-article-search\" hidden=\"\" id=\"aris-article-search-form\" role=\"search\"><div class=\"aris-article-search__field\"><input aria-label=\"جست‌وجو داخل مطلب\" autocomplete=\"off\" id=\"aris-article-search-input\" placeholder=\"جست‌وجو داخل همین مطلب…\" type=\"search\"/><button class=\"aris-article-search__submit\" type=\"submit\">پیدا کن</button></div><div class=\"aris-article-search__meta\"><span aria-live=\"polite\" class=\"aris-article-search-status\" id=\"aris-article-search-status\"></span><span class=\"aris-article-search-nav\" hidden=\"\" id=\"aris-article-search-nav\"><button aria-label=\"نتیجه قبلی\" id=\"aris-search-prev\" type=\"button\">↑</button><button aria-label=\"نتیجه بعدی\" id=\"aris-search-next\" type=\"button\">↓</button></span></div></form><details class=\"aris-toc\"><summary>در این راهنما</summary><ol class=\"aris-toc__list\"><li><a href=\"#aris-article-section-1\">اجازه ادامه تحصیل با نیاز به ادامه تحصیل فرق دارد</a></li><li><a href=\"#aris-article-section-2\">امکان ادامه تحصیل یا ضرورت ادامه تحصیل؟</a></li><li><a href=\"#aris-article-section-3\">۱. امکان ادامه تحصیل یعنی چه؟</a></li><li><a href=\"#aris-article-section-4\">۲. ضرورت ادامه تحصیل یعنی چه؟</a></li><li><a href=\"#aris-article-section-5\">۳. حالت اول؛ ورود به بازار کار با کارشناسی</a></li><li><a href=\"#aris-article-section-6\">۴. حالت دوم؛ کارشناسی قابل‌استفاده است</a></li><li><a href=\"#aris-article-section-7\">۵. حالت سوم؛ مسیر اصلی به تحصیلات تکمیلی وابسته است</a></li><li><a href=\"#aris-article-section-8\">۶. مجوز حرفه‌ای چه نقشی دارد؟</a></li><li><a href=\"#aris-article-section-9\">۷. یک مثال ساده</a></li><li><a href=\"#aris-article-section-10\">۸. ادامه تحصیل در علوم پایه</a></li><li><a href=\"#aris-article-section-11\">۹. ادامه تحصیل در مهندسی و کامپیوتر</a></li><li><a href=\"#aris-article-section-12\">۱۰. ادامه تحصیل در رشته‌های حرفه‌ای</a></li><li><a href=\"#aris-article-section-13\">۱۱. هزینه ادامه تحصیل</a></li><li><a href=\"#aris-article-section-14\">۱۲. اشتباه رایج؛ تغییر رشته در مقطع بالاتر</a></li><li><a href=\"#aris-article-section-15\">۱۳. چگونه ضرورت ادامه تحصیل را بررسی کنیم؟</a></li><li><a href=\"#aris-article-section-16\">۱۴. سؤال‌های لازم قبل از انتخاب</a></li><li><a href=\"#aris-article-section-17\">۱۵. جمع‌بندی این بخش</a></li></ol></details></div><div class=\"aris-validity aris-validity--stable\"><b>نوع محتوا</b><span>این مطلب ماهیت آموزشی و مفهومی دارد؛ برای تصمیم نهایی، آن را با شرایط شخصی و اطلاعات رسمی روز ترکیب کن.</span></div></aside><main id=\"mainContent\"><section class=\"intro split-intro\" id=\"guide-intro\"><div class=\"intro-grid\"><div><span class=\"intro-kicker\">مقدمه</span><h2 id=\"aris-article-section-1\">اجازه ادامه تحصیل با نیاز به ادامه تحصیل فرق دارد</h2><p>بسیاری از رشته‌ها مسیر تحصیلات تکمیلی دارند؛ اما وجود این مسیر به معنی ضروری‌بودن آن برای همه دانشجویان نیست. ملاک اصلی، شغل هدف، مجوزهای حرفه‌ای و ارزش واقعی مدرک کارشناسی در بازار کار است.</p><p>این راهنما سه حالت رایج رشته‌ها، نقش مجوز حرفه‌ای، هزینه زمانی و مالی ادامه تحصیل و سؤال‌های ضروری پیش از انتخاب رشته را بررسی می‌کند.</p></div><div class=\"intro-badge\"><b>۱۵</b><span>موضوع کاربردی</span></div></div><div class=\"intro-points\"><span><i>۱</i>ارزش مدرک کارشناسی</span><span><i>۲</i>نیاز شغل به مدرک بالاتر</span><span><i>۳</i>مجوز فعالیت مستقل</span></div></section><section class=\"section searchable-section\" data-icon=\"booklet\" id=\"further-study\"><div class=\"section-head\"><div class=\"section-no\">۱</div><div><span class=\"section-kicker\">دو مفهوم شبیه اما متفاوت</span><h2 id=\"aris-article-section-2\">امکان ادامه تحصیل یا ضرورت ادامه تحصیل؟</h2></div></div><p class=\"section-intro\">این دو عبارت شبیه‌اند، اما یکی از یک فرصت آموزشی و دیگری از نیاز واقعی مسیر شغلی صحبت می‌کند.</p><div class=\"terms\"><article class=\"term guide-topic\" id=\"term-1\"><h3 id=\"aris-article-section-3\"><span class=\"num\">۱.</span> امکان ادامه تحصیل یعنی چه؟</h3><p>یعنی پس از پایان یک مقطع، از نظر آموزشی اجازه داری در مقطع بالاتر همان رشته یا رشته‌های مرتبط شرکت کن. این یک امکان قانونی و آموزشی است و الزاماً به معنی نیاز بازار کار به مدرک بالاتر نیست.</p></article><article class=\"term guide-topic\" id=\"term-2\"><h3 id=\"aris-article-section-4\"><span class=\"num\">۲.</span> ضرورت ادامه تحصیل یعنی چه؟</h3><p>یعنی برای رسیدن به شغل یا موقعیت حرفه‌ای موردنظر، مدرک فعلی معمولاً کافی نیست. دلایل رایج:</p><ul><li>محدودبودن بازار کار کارشناسی</li><li>نیاز مجوز حرفه‌ای به مدرک بالاتر</li><li>نیاز پژوهش تخصصی به ارشد یا دکتری</li><li>نیاز تدریس دانشگاهی به مدرک بالاتر</li><li>ترجیح تحصیلات تکمیلی توسط کارفرما</li><li>شکل‌گیری تخصص اصلی در مقاطع بالاتر</li><li>نبود امکان فعالیت مستقل با کارشناسی</li></ul></article><article class=\"term guide-topic\" id=\"term-3\"><h3 id=\"aris-article-section-5\"><span class=\"num\">۳.</span> حالت اول؛ ورود به بازار کار با کارشناسی</h3><p>در بعضی رشته‌ها می‌توان پس از کارشناسی و با کسب مهارت وارد بازار کار شد. در این مسیرها مهارت، کارآموزی و نمونه‌کار گاهی از مدرک بالاتر مهم‌ترند؛ مانند بخشی از حوزه‌های مهندسی، کامپیوتر، حسابداری، طراحی و مدیریت.</p></article><article class=\"term guide-topic\" id=\"term-4\"><h3 id=\"aris-article-section-6\"><span class=\"num\">۴.</span> حالت دوم؛ کارشناسی قابل‌استفاده است</h3><p>فرد می‌تواند با کارشناسی کار کند، اما مدرک بالاتر فرصت‌های تخصصی‌تر، درآمد بیشتر یا سمت‌های بالاتر را در دسترس قرار می‌دهد. ادامه تحصیل الزام مطلق نیست، اما دامنه انتخاب‌ها را بیشتر می‌کند.</p></article><article class=\"term guide-topic\" id=\"term-5\"><h3 id=\"aris-article-section-7\"><span class=\"num\">۵.</span> حالت سوم؛ مسیر اصلی به تحصیلات تکمیلی وابسته است</h3><p>در بعضی رشته‌های علوم پایه، پژوهشی یا حرفه‌ای، فرصت‌های تخصصی عمدتاً در مقاطع بالاتر قرار دارند. هدف‌هایی مانند فعالیت دانشگاهی، پژوهش تخصصی یا خدمات مستقل می‌توانند به ارشد، دکتری یا دوره تخصصی نیاز داشته باشند.</p></article><article class=\"term guide-topic\" id=\"term-6\"><h3 id=\"aris-article-section-8\"><span class=\"num\">۶.</span> مجوز حرفه‌ای چه نقشی دارد؟</h3><p>در بعضی رشته‌ها فقط مدرک کافی نیست و شرایط دیگری لازم است:</p><ul><li>قبولی در آزمون حرفه‌ای</li><li>دریافت پروانه فعالیت</li><li>گذراندن کارآموزی</li><li>داشتن سابقه کار</li><li>عضویت در سازمان حرفه‌ای</li><li>تأیید صلاحیت علمی یا اخلاقی</li></ul><div class=\"topic-note\"><span>نکته</span><p>سه سؤال جدا بپرس: آیا می‌توانم فارغ‌التحصیل شوم؟ آیا می‌توانم وارد بازار کار شوم؟ آیا اجازه فعالیت مستقل دارم؟</p></div></article><article class=\"term guide-topic\" id=\"term-7\"><h3 id=\"aris-article-section-9\"><span class=\"num\">۷.</span> یک مثال ساده</h3><p>ممکن است کارشناسی یک رشته برای استخدام به‌عنوان کارشناس کافی باشد، اما تأسیس دفتر، ارائه خدمات مستقل یا دریافت پروانه به مدرک بالاتر و قبولی در آزمون نیاز داشته باشد.</p></article><article class=\"term guide-topic\" id=\"term-8\"><h3 id=\"aris-article-section-10\"><span class=\"num\">۸.</span> ادامه تحصیل در علوم پایه</h3><p>اگر هدفتان پژوهش دانشگاهی، آزمایشگاه تخصصی یا عضویت در هیئت علمی است، مسیر معمولاً تا مقاطع بالاتر ادامه دارد. از ابتدا طول مسیر رسیدن به شغل هدف را در نظر بگیر.</p></article><article class=\"term guide-topic\" id=\"term-9\"><h3 id=\"aris-article-section-11\"><span class=\"num\">۹.</span> ادامه تحصیل در مهندسی و کامپیوتر</h3><p>در بسیاری از حوزه‌ها ورود به بازار کار با کارشناسی ممکن است؛ به شرط داشتن مهارت عملی، نرم‌افزار، پروژه و سابقه کارآموزی. گاهی کارشناسی ماهر از کارشناسی ارشد بدون تجربه موفق‌تر است.</p></article><article class=\"term guide-topic\" id=\"term-10\"><h3 id=\"aris-article-section-12\"><span class=\"num\">۱۰.</span> ادامه تحصیل در رشته‌های حرفه‌ای</h3><p>برای رسیدن به بعضی عنوان‌های حرفه‌ای، آزمون یا مقطع بالاتر لازم است. بررسی کن مدرک کارشناسی چه اختیارات شغلی ایجاد می‌کند و هدف اصلی چه مراحل دیگری دارد.</p></article><article class=\"term guide-topic\" id=\"term-11\"><h3 id=\"aris-article-section-13\"><span class=\"num\">۱۱.</span> هزینه ادامه تحصیل</h3><ul><li>چند سال زمان بیشتر</li><li>دیرتر واردشدن به بازار کار تمام‌وقت</li><li>هزینه زندگی دانشجویی</li><li>هزینه آزمون‌ها و منابع</li><li>احتمال تحصیل در شهر دیگر</li><li>فشار روانی و تحصیلی</li><li>نامشخص‌بودن نتیجه آزمون مقطع بالاتر</li><li>ازدست‌دادن بعضی فرصت‌های شغلی</li></ul></article><article class=\"term guide-topic\" id=\"term-12\"><h3 id=\"aris-article-section-14\"><span class=\"num\">۱۲.</span> اشتباه رایج؛ تغییر رشته در مقطع بالاتر</h3><p>انتخاب رشته‌ای که دوستش نداری با امید تغییر رشته در کارشناسی ارشد پرریسک است:</p><ul><li>ممکن است رشته مقصد تغییر رشته را نپذیرد</li><li>ممکن است پیش‌نیاز مشخص داشته باشد</li><li>ظرفیت آزمون محدود است</li><li>قبولی در مقطع بالاتر قطعی نیست</li><li>باید چند سال رشته‌ای را بخوان که دوست نداری</li></ul></article><article class=\"term guide-topic\" id=\"term-13\"><h3 id=\"aris-article-section-15\"><span class=\"num\">۱۳.</span> چگونه ضرورت ادامه تحصیل را بررسی کنیم؟</h3><ul><li>آگهی‌های استخدام رشته</li><li>مدرک موردنیاز کارفرماها</li><li>شرایط دریافت مجوز</li><li>تجربه فارغ‌التحصیلان</li><li>بازار کار کارشناسی</li><li>ظرفیت مقاطع بالاتر</li><li>زمان رسیدن به شغل هدف</li><li>درآمد کارشناسی و تحصیلات تکمیلی</li><li>هزینه ادامه تحصیل</li></ul></article><article class=\"term guide-topic\" id=\"term-14\"><h3 id=\"aris-article-section-16\"><span class=\"num\">۱۴.</span> سؤال‌های لازم قبل از انتخاب</h3><ul><li>با کارشناسی چه شغل‌هایی می‌توان داشت؟</li><li>برای فعالیت مستقل چه مجوزی لازم است؟</li><li>ارشد ضروری است یا فقط امتیاز؟</li><li>چند سال تا شغل هدف فاصله دارم؟</li><li>هزینه ادامه تحصیل چقدر است؟</li><li>اگر در مقطع بالاتر قبول نشوم مدرک فعلی چه کاربردی دارد؟</li><li>آیا حاضر هستم چند سال دیگر دانشجو بمانم؟</li></ul></article><article class=\"term guide-topic\" id=\"term-15\"><h3 id=\"aris-article-section-17\"><span class=\"num\">۱۵.</span> جمع‌بندی این بخش</h3><div class=\"formula-box\">امکان ادامه تحصیل = اجازه تحصیل در مقطع بالاتر | ضرورت ادامه تحصیل = نیاز واقعی شغل هدف به مدرک بالاتر</div></article></div></section></main>\n<section aria-label=\"مرز اعتبار مثال‌ها\" class=\"section aris-scope-note\"><h2>مرز اعتبار مثال‌های این راهنما</h2><p>مثال‌های این صفحه برای تشخیص تفاوت «امکان ادامه تحصیل» و «نیاز واقعی به مدرک بالاتر» هستند. حداقل مدرک، مجوز حرفه‌ای و مسیر معمول ورود به هر شغل می‌تواند با رشته و زمان تغییر کند؛ برای شغل مشخص، مرجع حرفه‌ای همان حوزه و آگهی‌های روز را جدا بررسی کن.</p></section><section aria-label=\"کنترل نهایی راهنما\" class=\"section aris-standard-close\"><h2>قبل از تصمیم درباره ادامه تحصیل</h2><div class=\"terms\"><article class=\"term\"><h3>خطای رایج</h3><p>فرض اینکه چون ادامه تحصیل ممکن است، پس برای موفقیت شغلی حتماً لازم است؛ یا برعکس، نادیده‌گرفتن رشته‌هایی که مسیر اصلی‌شان به مدرک بالاتر وابسته است.</p></article><article class=\"term\"><h3>جمع‌بندی</h3><p>بین «می‌توانم ادامه بدهم» و «برای هدفم باید ادامه بدهم» فرق بگذار.</p></article><article class=\"term\"><h3>اقدام بعدی</h3><p>برای شغل هدف، حداقل مدرک، مجوز و مسیر معمول ورود را از منابع معتبر بررسی و بعد تصمیم بگیر.</p></article></div></section><section class=\"aris-related\"><p class=\"aris-related__eyebrow\">قدم بعدی</p><h2>راهنماهای مرتبط</h2><div class=\"aris-related__grid\"><button data-related-guide=\"maharathaye-janebi-reshtehaye-daneshgahi\" type=\"button\">مهارت‌های جانبی رشته‌های دانشگاهی <span aria-hidden=\"true\">←</span></button><button data-related-guide=\"bartarin-ostadan-iran\" type=\"button\">۲۰۰ استاد شاخص ایران برای شناخت مسیرهای علمی <span aria-hidden=\"true\">←</span></button></div></section></div><script>\n(function(){\nvar form=document.getElementById('aris-article-search-form'),input=document.getElementById('aris-article-search-input'),status=document.getElementById('aris-article-search-status'),nav=document.getElementById('aris-article-search-nav'),previous=document.getElementById('aris-search-prev'),next=document.getElementById('aris-search-next'),hits=[],current=-1,lastQuery='';\nfunction normalize(value){return String(value||'').toLowerCase().replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/[أإ]/g,'ا').replace(/ة/g,'ه').replace(/\\u200c/g,' ')}\nfunction clearHits(){document.querySelectorAll('mark.aris-search-hit').forEach(function(mark){var parent=mark.parentNode;parent.replaceChild(document.createTextNode(mark.textContent),mark);parent.normalize()});hits=[];current=-1;if(nav)nav.hidden=true}\nfunction collect(query){var root=document.getElementById('mainContent'),walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode:function(node){var parent=node.parentElement;return parent&&!parent.closest('script,style,mark.aris-search-hit')&&normalize(node.nodeValue).indexOf(query)>-1?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_REJECT}}),nodes=[],node;while((node=walker.nextNode())&&nodes.length<200)nodes.push(node);nodes.forEach(function(textNode){if(hits.length>=200)return;var source=textNode.nodeValue,normalized=normalize(source),from=0,index,fragment=document.createDocumentFragment();while((index=normalized.indexOf(query,from))>-1&&hits.length<200){if(index>from)fragment.appendChild(document.createTextNode(source.slice(from,index)));var mark=document.createElement('mark');mark.className='aris-search-hit';mark.textContent=source.slice(index,index+query.length);fragment.appendChild(mark);hits.push(mark);from=index+query.length}if(from<source.length)fragment.appendChild(document.createTextNode(source.slice(from)));textNode.parentNode.replaceChild(fragment,textNode)})}\nfunction show(index){if(!hits.length)return;hits.forEach(function(hit){hit.classList.remove('is-current')});current=(index+hits.length)%hits.length;hits[current].classList.add('is-current');hits[current].scrollIntoView({behavior:'smooth',block:'center'});status.textContent=hits.length+' نتیجه · '+(current+1)+' از '+hits.length;if(nav)nav.hidden=false}\nfunction runSearch(){var query=normalize(input.value.trim());if(!query){clearHits();lastQuery='';status.textContent='یک واژه یا عبارت بنویس.';return}if(query===lastQuery&&hits.length){show(current+1);return}clearHits();lastQuery=query;collect(query);if(hits.length)show(0);else status.textContent='عبارتی با این عنوان در مطلب پیدا نشد.'}\nif(form&&input){form.addEventListener('submit',function(event){event.preventDefault();runSearch()});input.addEventListener('input',function(){if(!input.value.trim()){clearHits();lastQuery='';status.textContent=''}});if(previous)previous.addEventListener('click',function(){show(current-1)});if(next)next.addEventListener('click',function(){show(current+1)})}\ndocument.querySelectorAll('[data-related-guide]').forEach(function(button){button.addEventListener('click',function(){parent.postMessage({type:'aris-guide-open',id:button.dataset.relatedGuide},'*')})});\n}());\n<\/script><script data-aris-search-disclosure=\"17\">\n(function(){\n  var disclosure=document.querySelector('.aris-search-disclosure');\n  var form=document.getElementById('aris-article-search-form');\n  if(!disclosure||!form)return;\n  disclosure.addEventListener('click',function(){\n    var open=disclosure.getAttribute('aria-expanded')==='true';\n    disclosure.setAttribute('aria-expanded',String(!open));\n    form.hidden=open;\n    if(!open){\n      var input=document.getElementById('aris-article-search-input');\n      setTimeout(function(){if(input)input.focus({preventScroll:true})},0);\n    }\n  });\n}());\n<\/script></body></html>","keywords":["ادامه تحصیل","کارشناسی ارشد","دکتری","مدرک بالاتر","تحصیلات تکمیلی"]},{"id":"tarh-niroye-ensani-vezarat-behdasht","title":"طرح نیروی انسانی وزارت بهداشت","eyebrow":"رشته‌های علوم پزشکی","category":"reality","categoryLabel":"واقعیت تحصیل","description":"طرح اجباری و اختیاری، رشته‌های مشمول، مدت، حقوق، محل خدمت، معافیت و ارتباط طرح با سربازی و ادامه تحصیل را کامل بخوانید.","minutes":9,"words":1580,"dynamic":true,"document":"<!doctype html>\n<html dir=\"rtl\" lang=\"fa\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width,initial-scale=1,viewport-fit=cover\" name=\"viewport\"/><title>طرح نیروی انسانی وزارت بهداشت</title><style>\n    :root{--ink:#17211d;--muted:#64726b;--paper:#fbfaf6;--card:#fff;--green:#12372a;--green2:#245943;--mint:#dfece4;--gold:#e0a92f;--line:#dce4df;--shadow:0 16px 42px rgba(18,55,42,.09)}\n    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:linear-gradient(180deg,#eff5f1 0,#fbfaf6 520px);color:var(--ink);font-family:Tahoma,\"Vazirmatn\",\"Segoe UI\",sans-serif;line-height:2}\n    button,input{font:inherit}.progress{position:fixed;inset:0 0 auto;z-index:99;height:4px;background:transparent}.progress span{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--gold),#f2cf79)}\n    .hero{position:relative;overflow:hidden;background:var(--green);color:white;padding:72px 24px 102px}.hero:before,.hero:after{content:\"\";position:absolute;border-radius:50%;background:rgba(255,255,255,.045)}.hero:before{width:360px;height:360px;left:-100px;top:-160px}.hero:after{width:240px;height:240px;right:-80px;bottom:-100px}.hero-inner{position:relative;max-width:1120px;margin:auto}.eyebrow{display:inline-flex;gap:8px;align-items:center;padding:7px 13px;border:1px solid rgba(255,255,255,.22);border-radius:999px;color:#dfece4;font-size:.85rem}.eyebrow:before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--gold)}h1{max-width:830px;margin:22px 0 12px;font-size:clamp(2rem,5vw,4.1rem);line-height:1.35;letter-spacing:-.04em}.lead{max-width:790px;margin:0;color:#d6e3dc;font-size:1.08rem}.hero-stats{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.hero-stats span{padding:7px 13px;border-radius:10px;background:rgba(255,255,255,.09);font-size:.88rem}\n    .layout{max-width:1180px;margin:-58px auto 80px;padding:0 22px;display:grid;grid-template-columns:285px minmax(0,1fr);gap:28px;align-items:start}.sidebar{position:sticky;top:20px;background:var(--card);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);padding:18px}.sidebar h2{font-size:1rem;margin:0 0 12px}.search{position:relative;margin-bottom:14px}.search input{width:100%;border:1px solid var(--line);border-radius:12px;background:#f8faf8;padding:10px 38px 10px 10px;outline:none;color:var(--ink)}.search input:focus{border-color:var(--green2);box-shadow:0 0 0 3px rgba(36,89,67,.1)}.search:before{content:\"⌕\";position:absolute;right:13px;top:4px;font-size:1.35rem;color:var(--muted)}.count{font-size:.78rem;color:var(--muted);margin:-6px 2px 10px}.nav{display:grid;gap:4px;max-height:58vh;overflow:auto;padding-left:4px}.nav a{color:#415049;text-decoration:none;border-radius:10px;padding:7px 9px;font-size:.85rem;line-height:1.6}.nav a:hover{background:var(--mint);color:var(--green)}.toplink{display:block;text-align:center;margin-top:12px;padding:8px;border-top:1px solid var(--line);color:var(--green2);text-decoration:none;font-size:.84rem}\n    main{min-width:0}.intro,.section{background:var(--card);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.intro{padding:28px 30px;margin-bottom:24px}.intro p{margin:0}.section{padding:30px;margin-bottom:24px}.section-head{display:flex;align-items:flex-start;gap:15px;margin-bottom:20px;padding-bottom:18px;border-bottom:1px solid var(--line)}.section-no{flex:0 0 auto;display:grid;place-items:center;width:44px;height:44px;border-radius:14px;background:var(--green);color:white;font-weight:700}.section h2{margin:0;font-size:1.45rem;line-height:1.6}.section-kicker{font-size:.8rem;color:var(--muted)}.terms{display:grid;gap:14px}.term{position:relative;border:1px solid var(--line);border-radius:16px;padding:19px 20px;background:linear-gradient(135deg,#fff,#fbfcfb)}.term:hover{border-color:#b7cbc0;box-shadow:0 8px 24px rgba(18,55,42,.06)}.term h3{margin:0 0 6px;color:var(--green);font-size:1.05rem;line-height:1.7}.term h3 .num{display:inline-block;min-width:32px;color:var(--gold);font-variant-numeric:tabular-nums}.term p{margin:5px 0}.term ul{margin:7px 0 0;padding-right:22px}.example{margin-top:10px!important;padding:10px 13px;border-right:3px solid var(--gold);background:#fff8e7;border-radius:10px;color:#544825;font-size:.93rem}.simple{color:var(--green2);font-weight:700}.hidden{display:none!important}.empty{display:none;background:#fff;border:1px dashed #b7c6bd;border-radius:18px;padding:30px;text-align:center;color:var(--muted)}mark{background:#ffe59e;border-radius:4px;padding:0 2px}\n    .mistakes{counter-reset:mistake;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.mistake{counter-increment:mistake;border:1px solid var(--line);border-radius:15px;padding:17px;background:#fff}.mistake h3{margin:0 0 5px;font-size:1rem}.mistake h3:before{content:counter(mistake,\"persian\") \". \";color:var(--gold)}.mistake p{margin:0;color:#3f4c46;font-size:.93rem}.principles{display:grid;gap:10px;counter-reset:principle}.principle{counter-increment:principle;display:flex;gap:13px;align-items:flex-start;padding:14px;border-radius:14px;background:#f4f8f5}.principle:before{content:counter(principle,\"persian\");display:grid;place-items:center;flex:0 0 34px;height:34px;border-radius:10px;background:var(--green);color:#fff;font-weight:700}.final-note{margin-top:22px;padding:18px 20px;border-radius:16px;background:var(--green);color:#eef7f1;font-size:1.05rem}.footer{text-align:center;color:var(--muted);padding:10px 20px 42px;font-size:.82rem}\n    .mobile-tools{display:none}.copy-toast{position:fixed;z-index:120;left:50%;bottom:28px;transform:translate(-50%,20px);padding:9px 16px;background:#17211d;color:white;border-radius:999px;opacity:0;pointer-events:none;transition:.25s}.copy-toast.show{opacity:1;transform:translate(-50%,0)}\n    @media(max-width:900px){.layout{grid-template-columns:1fr;margin-top:-54px}.sidebar{position:relative;top:0}.nav{grid-template-columns:repeat(2,minmax(0,1fr));max-height:none}.toplink{display:none}.hero{padding-top:54px}.mistakes{grid-template-columns:1fr}}\n    @media(max-width:560px){body{line-height:1.9}.hero{padding:42px 18px 86px}h1{font-size:2rem}.lead{font-size:.98rem}.layout{padding:0 12px;gap:16px}.sidebar,.intro,.section{border-radius:18px}.section,.intro{padding:21px 17px}.nav{grid-template-columns:1fr 1fr}.nav a{font-size:.78rem;padding:6px}.term{padding:16px 14px}.section-head{gap:10px}.section-no{width:38px;height:38px;border-radius:12px}.section h2{font-size:1.2rem}}\n    @media print{body{background:#fff}.progress,.sidebar{display:none}.hero{padding:30px;background:#fff;color:#111;border-bottom:2px solid #111}.hero .lead,.eyebrow{color:#333}.layout{display:block;margin:0;padding:0}.intro,.section{box-shadow:none;border:0;border-radius:0;break-inside:auto}.term{break-inside:avoid}.section{break-before:page}.hero-stats{color:#111}.final-note{background:#eee;color:#111}.footer{display:none}}\n  \n  .guide-intro{overflow:hidden}.guide-map{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin-top:23px}.map-card{display:grid;grid-template-columns:38px minmax(0,1fr);gap:12px;align-items:center;padding:15px;border:1px solid rgba(25,89,65,.12);border-radius:16px;background:linear-gradient(145deg,#fff,#f5f8f5);color:inherit;text-decoration:none;font-family:Tahoma,Arial,sans-serif;transition:.2s}.map-card:hover{transform:translateY(-2px);border-color:rgba(181,128,24,.42);box-shadow:0 12px 28px rgba(14,53,37,.08)}.map-card>span{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:linear-gradient(145deg,#173d2e,#091f16);color:#f6c64d;font-weight:600}.map-card b{display:block;color:#173d2e;font-size:.9rem;font-weight:600;line-height:1.7}.map-card small{display:block;color:#718078;font-size:.73rem;line-height:1.6}.decision-strip{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 22px;padding:20px 22px;border:1px solid rgba(245,187,53,.23);border-radius:22px;background:linear-gradient(140deg,#091a12,#123525);color:#fff;box-shadow:0 18px 42px rgba(9,32,22,.14)}.decision-strip div{display:grid;gap:2px}.decision-strip span{color:#dcae3d;font:600 .66rem Tahoma}.decision-strip b{font-size:.82rem}.decision-strip small{color:#8fa197;font-size:.68rem}.decision-strip i{width:32px;height:1px;background:linear-gradient(90deg,transparent,#c9982c,transparent)}.section-intro{margin:-3px 0 19px;padding:13px 15px;border-radius:13px;background:#f6f2e7;color:#66726b;font-size:.88rem;line-height:1.9}.guide-topic .term-body-inner>p{margin:7px 0}.guide-topic ul,.guide-topic ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px 18px;margin:13px 0;padding:0;list-style:none}.guide-topic li{position:relative;padding-right:18px;color:#536159;font-size:.9rem;line-height:1.9}.guide-topic ul li:before{content:\"\";position:absolute;right:2px;top:.86em;width:6px;height:6px;border-radius:50%;background:#d5a52f;box-shadow:0 0 0 3px rgba(213,165,47,.12)}.guide-topic ol{counter-reset:item}.guide-topic ol li{counter-increment:item}.guide-topic ol li:before{content:counter(item,decimal);position:absolute;right:0;top:.26em;color:#a87816;font-weight:700;font-size:.74rem}.guide-topic .long-list{grid-template-columns:repeat(3,minmax(0,1fr))}.topic-note{display:flex;align-items:flex-start;gap:10px;margin-top:13px;padding:13px 14px;border:1px solid rgba(197,143,29,.2);border-radius:13px;background:#fff8e8}.topic-note span{flex:0 0 auto;padding:3px 8px;border-radius:7px;background:#dfaa31;color:#251904;font:700 .7rem Tahoma}.topic-note p{margin:0!important;color:#5e563f}.guide-topic .example{display:grid;grid-template-columns:auto 1fr;gap:9px;align-items:start}.guide-topic .example b{color:#a06e13}.guide-topic blockquote{margin:12px 0 0;padding:17px 18px;border:1px solid rgba(28,88,65,.14);border-right:4px solid #1c5841;border-radius:14px;background:#f3f8f5;color:#173d2e;font-weight:700;line-height:2}.formula-box{margin-top:13px;padding:18px;border-radius:14px;background:linear-gradient(135deg,#0b2419,#174a35);color:#f7d474;text-align:center;font-weight:800;line-height:2;box-shadow:inset 0 1px rgba(255,255,255,.06)}.mini-compare{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:13px}.mini-compare>div{padding:15px;border:1px solid rgba(27,82,62,.13);border-radius:14px;background:#f7faf8}.mini-compare>div>b{display:block;padding-bottom:8px;color:#173d2e;border-bottom:1px solid #dde8e1}.mini-compare ul{grid-template-columns:1fr;margin-bottom:0}.section-count:after{content:\" موضوع\"}\n  @media(max-width:700px){.guide-map{grid-template-columns:1fr}.decision-strip{display:grid;grid-template-columns:1fr 1fr}.decision-strip i{display:none}.guide-topic ul,.guide-topic ol,.guide-topic .long-list{grid-template-columns:1fr}.mini-compare{grid-template-columns:1fr}.map-card{grid-template-columns:40px minmax(0,1fr)}.map-card b{font-size:.86rem}.decision-strip div{padding:8px;border-bottom:1px solid rgba(255,255,255,.06)}}\n.split-intro{overflow:hidden}.split-intro .intro-grid>div:first-child{max-width:730px}.split-intro .intro-grid p{margin:8px 0 0;line-height:2;color:#647169}.intro-points{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:22px}.intro-points span{display:flex;align-items:center;gap:9px;padding:12px 13px;border:1px solid rgba(28,88,65,.12);border-radius:13px;background:linear-gradient(145deg,#fff,#f4f8f5);color:#355247;font:500 .78rem Tahoma,Arial,sans-serif}.intro-points i{display:grid;place-items:center;flex:0 0 auto;width:26px;height:26px;border-radius:8px;background:#123b2b;color:#f2c655;font-style:normal;font-weight:600}@media(max-width:620px){.intro-points{grid-template-columns:1fr}.split-intro .intro-grid{display:block}.split-intro .intro-badge{margin-top:18px}}\n\n\n    :root{\n      --aris-black:#050706;--aris-black-2:#0b100d;--aris-green:#0d2c20;--aris-green-2:#173f2e;\n      --aris-emerald:#2e7653;--aris-gold:#f5bb35;--aris-gold-2:#ffdf7d;--aris-gold-dark:#9a6610;\n      --aris-ivory:#f8f4e9;--aris-paper:#fffdf8;--aris-ink:#18211c;--aris-line:#e4dcc7;\n      --gold-gradient:linear-gradient(135deg,#8d5b09 0%,#f2af1f 27%,#fff0a5 49%,#e19a0d 68%,#8c5908 100%);\n    }\n    body{background:\n      radial-gradient(circle at 13% 8%,rgba(230,173,38,.09),transparent 24rem),\n      linear-gradient(180deg,#07100c 0 690px,var(--aris-ivory) 690px 100%);color:var(--aris-ink)}\n    body:before{content:\"\";position:fixed;inset:0;z-index:-1;opacity:.32;pointer-events:none;background-image:linear-gradient(rgba(17,61,43,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(17,61,43,.035) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,transparent 400px,#000 780px)}\n    .progress{height:5px;background:#0a1711}.progress span{position:relative;background:var(--gold-gradient);box-shadow:0 0 14px rgba(245,187,53,.85)}\n    .hero{min-height:690px;padding:0 24px 120px;background:\n      radial-gradient(circle at 78% 43%,rgba(245,187,53,.16),transparent 21rem),\n      radial-gradient(circle at 18% 20%,rgba(41,116,80,.2),transparent 26rem),\n      linear-gradient(135deg,#030504 0%,#08110d 45%,#0b2118 100%);border-bottom:1px solid rgba(245,187,53,.3)}\n    .hero:before{width:640px;height:640px;left:-260px;top:-320px;border:1px solid rgba(245,187,53,.1);background:repeating-radial-gradient(circle,transparent 0 28px,rgba(245,187,53,.025) 29px 30px)}\n    .hero:after{width:580px;height:580px;right:-180px;bottom:-350px;border:1px solid rgba(245,187,53,.13);background:repeating-radial-gradient(circle,transparent 0 38px,rgba(245,187,53,.025) 39px 40px)}\n    .hero-grid{position:absolute;inset:0;opacity:.2;pointer-events:none;background-image:linear-gradient(rgba(255,220,115,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(255,220,115,.09) 1px,transparent 1px);background-size:68px 68px;mask-image:linear-gradient(90deg,transparent,#000 35%,#000 70%,transparent)}\n    .brandbar{position:relative;z-index:4;max-width:1180px;margin:auto;min-height:96px;display:flex;align-items:center;justify-content:space-between;gap:26px;border-bottom:1px solid rgba(245,187,53,.15)}\n    .brand-banner{display:block;width:min(420px,48vw);max-height:70px;object-fit:contain;object-position:right center;filter:drop-shadow(0 0 12px rgba(245,187,53,.2))}\n    .channel-link{display:inline-flex;align-items:center;gap:9px;color:#f9eac0;text-decoration:none;padding:10px 14px;border:1px solid rgba(245,187,53,.26);border-radius:999px;background:rgba(255,255,255,.035);font-size:.86rem;transition:.25s}.channel-link:hover{border-color:var(--aris-gold);background:rgba(245,187,53,.1);transform:translateY(-2px)}.channel-link b{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:var(--gold-gradient);color:#171006}\n    .hero-inner{display:grid;grid-template-columns:minmax(0,1.14fr) minmax(330px,.86fr);gap:60px;align-items:center;padding-top:72px}\n    .hero-copy{position:relative;z-index:2}.hero .eyebrow{border-color:rgba(245,187,53,.34);background:rgba(245,187,53,.06);color:#f8deb0;backdrop-filter:blur(10px)}.hero .eyebrow:before{box-shadow:0 0 16px var(--aris-gold)}\n    .hero h1{max-width:790px;margin-top:20px;font-size:clamp(2.25rem,4.6vw,4.7rem);line-height:1.28;background:linear-gradient(180deg,#fff 0,#fbf5e7 62%,#d9c9a0 100%);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 18px 55px rgba(0,0,0,.28)}\n    .hero .lead{max-width:720px;color:#bdc9c2;font-size:1.08rem}.hero .lead strong{color:var(--aris-gold-2)}\n    .hero-actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:26px}.hero-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:11px 18px;border-radius:12px;text-decoration:none;font-weight:700;font-size:.92rem;transition:.25s}.hero-btn.primary{background:var(--gold-gradient);color:#171006;box-shadow:0 12px 34px rgba(226,159,21,.2),inset 0 1px rgba(255,255,255,.55)}.hero-btn.primary:hover{transform:translateY(-3px);box-shadow:0 17px 38px rgba(226,159,21,.3)}.hero-btn.secondary{color:#dce7e0;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.035)}.hero-btn.secondary:hover{border-color:rgba(245,187,53,.45);color:#fff}\n    .hero-stats{gap:9px;margin-top:30px}.hero-stats span{position:relative;padding:8px 13px 8px 14px;color:#d0dbd4;border:1px solid rgba(255,255,255,.085);background:rgba(255,255,255,.035);backdrop-filter:blur(8px)}.hero-stats span:before{content:\"\";display:inline-block;width:5px;height:5px;margin-left:7px;border-radius:50%;background:var(--aris-gold);box-shadow:0 0 9px var(--aris-gold)}\n    .hero-visual{position:relative;display:grid;place-items:center;min-height:410px}.logo-stage{position:relative;display:grid;place-items:center;width:min(390px,34vw);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(245,187,53,.13),rgba(13,44,32,.1) 55%,transparent 70%)}\n    .logo-stage:before,.logo-stage:after{content:\"\";position:absolute;border-radius:50%;border:1px solid rgba(245,187,53,.27)}.logo-stage:before{inset:4%;box-shadow:0 0 55px rgba(245,187,53,.09),inset 0 0 45px rgba(245,187,53,.06)}.logo-stage:after{inset:-8%;border-style:dashed;animation:orbit 34s linear infinite}\n    .hero-logo{position:relative;z-index:2;width:78%;aspect-ratio:1;object-fit:cover;border-radius:50%;mix-blend-mode:screen;filter:contrast(1.08) drop-shadow(0 17px 45px rgba(0,0,0,.6)) drop-shadow(0 0 18px rgba(245,187,53,.18))}\n    .spark{position:absolute;z-index:3;width:8px;height:8px;background:var(--aris-gold-2);transform:rotate(45deg);box-shadow:0 0 17px 5px rgba(245,187,53,.34);animation:pulse 2.8s ease-in-out infinite}.spark.s1{top:11%;right:14%}.spark.s2{bottom:17%;left:10%;animation-delay:-1.2s}.spark.s3{top:45%;left:-2%;width:5px;height:5px;animation-delay:-2s}\n    .orbit-label{position:absolute;z-index:5;padding:7px 12px;border:1px solid rgba(245,187,53,.24);border-radius:999px;background:rgba(5,11,8,.8);color:#e9e3d2;font-size:.78rem;box-shadow:0 10px 28px rgba(0,0,0,.32);backdrop-filter:blur(8px)}.orbit-label.l1{top:18%;right:-5%}.orbit-label.l2{bottom:14%;right:5%}.orbit-label.l3{top:45%;left:-7%}.orbit-label:before{content:\"✦\";color:var(--aris-gold);margin-left:6px}\n    @keyframes orbit{to{transform:rotate(360deg)}}@keyframes pulse{50%{opacity:.35;transform:rotate(45deg) scale(.55)}}\n    .layout{max-width:1210px;margin:-68px auto 90px;grid-template-columns:300px minmax(0,1fr);gap:30px}.sidebar{top:18px;border-color:rgba(245,187,53,.24);border-radius:24px;padding:0;overflow:hidden;background:linear-gradient(160deg,#0a1510,#08100d);box-shadow:0 28px 70px rgba(6,21,14,.22),inset 0 1px rgba(255,255,255,.04)}\n    .mini-brand{position:relative;display:flex;align-items:center;gap:12px;padding:18px 18px 15px;border-bottom:1px solid rgba(245,187,53,.14);overflow:hidden}.mini-brand:after{content:\"\";position:absolute;width:90px;height:90px;left:-28px;top:-44px;border-radius:50%;background:rgba(245,187,53,.08);filter:blur(5px)}.mini-mark{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:var(--gold-gradient);color:#151006;font-family:Georgia,serif;font-size:1.65rem;font-weight:700;box-shadow:0 9px 24px rgba(230,168,34,.22)}.mini-brand strong{display:block;color:#fff;font-family:Georgia,Tahoma,serif;letter-spacing:.04em}.mini-brand small{display:block;color:#8fa197;font-size:.7rem;line-height:1.4}.sidebar-content{padding:16px}.sidebar h2{color:#f3ead1}.search input{border-color:rgba(255,255,255,.09);background:rgba(255,255,255,.045);color:#fff}.search input::placeholder{color:#73857b}.search input:focus{border-color:var(--aris-gold);box-shadow:0 0 0 3px rgba(245,187,53,.09)}.search:before{color:var(--aris-gold)}.count{color:#778a7f}.nav{padding-left:5px}.nav a{position:relative;color:#9eb0a6;padding:8px 11px;border:1px solid transparent}.nav a:hover{color:#fff;background:rgba(245,187,53,.07);border-color:rgba(245,187,53,.12);padding-right:15px}.nav a:before{content:\"\";display:inline-block;width:4px;height:4px;border-radius:50%;margin-left:8px;background:#466556}.nav a:hover:before{background:var(--aris-gold);box-shadow:0 0 8px var(--aris-gold)}.toplink{color:#ddbd67;border-color:rgba(245,187,53,.12)}\n    .intro,.section{position:relative;border:1px solid var(--aris-line);background:rgba(255,253,248,.96);box-shadow:0 20px 55px rgba(30,50,39,.08);overflow:hidden}.intro:before,.section:before{content:\"\";position:absolute;inset:0 auto auto 0;width:160px;height:3px;background:var(--gold-gradient)}.intro{padding:30px 32px;border-radius:24px}.intro-grid{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:24px;align-items:center}.intro-kicker{display:inline-flex;align-items:center;gap:8px;color:var(--aris-gold-dark);font-size:.76rem;font-weight:700;letter-spacing:.04em}.intro-kicker:before{content:\"\";width:22px;height:1px;background:var(--aris-gold)}.intro h2{margin:5px 0 7px;color:var(--aris-green);font-size:1.28rem}.intro p{color:#59655e}.intro-badge{position:relative;display:grid;place-items:center;min-height:118px;border:1px solid #eadcb9;border-radius:18px;background:radial-gradient(circle at 50% 35%,#fff7db,#f3e7c7);text-align:center;overflow:hidden}.intro-badge:before{content:\"A\";position:absolute;color:rgba(154,102,16,.07);font:700 8rem/1 Georgia}.intro-badge b{position:relative;display:block;font-size:2rem;color:var(--aris-green);line-height:1.2}.intro-badge span{position:relative;color:#89703a;font-size:.75rem}\n    .section{padding:31px;border-radius:24px}.section-head{position:relative;align-items:center;margin-bottom:22px;padding-bottom:20px;border-color:#ebe4d3}.section-no{position:relative;width:52px;height:52px;border-radius:16px;background:linear-gradient(145deg,var(--aris-green-2),#081c13);color:var(--aris-gold-2);border:1px solid rgba(245,187,53,.28);box-shadow:0 10px 24px rgba(13,44,32,.18)}.section-no:after{content:\"\";position:absolute;inset:5px;border:1px solid rgba(245,187,53,.13);border-radius:11px}.section h2{color:var(--aris-green);letter-spacing:-.015em}.section-kicker{color:#9a7a2f;font-weight:700}.section-head:after{content:\"ARIS ACADEMY\";position:absolute;left:0;bottom:18px;color:#cbbf9f;font:600 .64rem/1 Georgia,serif;letter-spacing:.16em}\n    .terms{gap:12px}.term{padding:20px 21px 20px 20px;border-color:#e6dfcf;border-radius:17px;background:linear-gradient(135deg,#fffefb,#faf7ef);box-shadow:0 5px 18px rgba(19,49,34,.025);transition:.25s}.term:before{content:\"\";position:absolute;right:0;top:18px;bottom:18px;width:3px;border-radius:3px;background:linear-gradient(var(--aris-gold-2),var(--aris-gold-dark));opacity:.65}.term:hover{transform:translateY(-2px);border-color:#d7c38d;box-shadow:0 14px 34px rgba(31,54,42,.08)}.term h3{color:var(--aris-green);font-size:1.08rem}.term h3 .num{min-width:39px;color:var(--aris-gold-dark);font-weight:800}.term p{color:#414d46}.example{position:relative;margin-top:12px!important;padding:12px 16px!important;border:0!important;border-radius:12px!important;background:linear-gradient(90deg,#fff4ce,#faf1d8)!important;color:#544625!important}.example:before{content:\"✦\";color:#ad730c;margin-left:7px}.simple{color:var(--aris-green)}\n    .mistakes{gap:13px}.mistake{position:relative;border-color:#e7ddc6;background:linear-gradient(145deg,#fffefa,#faf5e9);overflow:hidden;transition:.25s}.mistake:hover{transform:translateY(-3px);border-color:#d6be82;box-shadow:0 12px 30px rgba(32,52,41,.07)}.mistake:after{content:counter(mistake,\"persian\");position:absolute;left:9px;bottom:-15px;color:rgba(24,63,45,.055);font:700 5rem/1 Tahoma}.mistake h3:before{display:inline-grid;place-items:center;width:28px;height:28px;margin-left:7px;border-radius:9px;background:#f7e7b6;color:#805308}\n    .principle{border:1px solid #e4dcc8;background:linear-gradient(90deg,#f9f3e4,#fffdf8)}.principle:before{background:linear-gradient(145deg,var(--aris-green-2),#07170f);color:var(--aris-gold-2);border:1px solid rgba(245,187,53,.25)}.final-note{position:relative;background:linear-gradient(135deg,#081a12,#123a29);border:1px solid rgba(245,187,53,.28);color:#f2ede0;box-shadow:0 18px 40px rgba(8,31,21,.18);overflow:hidden}.final-note:after{content:\"A\";position:absolute;left:18px;top:-28px;color:rgba(245,187,53,.07);font:700 8rem/1 Georgia}\n    .footer{position:relative;padding:54px 20px 46px;background:linear-gradient(180deg,#07100c,#020302);color:#7e9286;border-top:1px solid rgba(245,187,53,.18)}.footer-brand{display:block;width:min(460px,80vw);max-height:90px;object-fit:contain;margin:0 auto 18px;filter:drop-shadow(0 0 13px rgba(245,187,53,.12))}.footer p{margin:0}.footer:before{content:\"\";position:absolute;top:0;left:50%;width:min(620px,75vw);height:1px;transform:translateX(-50%);background:var(--gold-gradient);box-shadow:0 0 18px rgba(245,187,53,.35)}\n    .copy-toast{border:1px solid rgba(245,187,53,.4);background:#07130d;color:#fae5aa;box-shadow:0 14px 35px rgba(0,0,0,.28)}\n    @media(max-width:1000px){.hero-inner{grid-template-columns:1fr 330px;gap:22px}.logo-stage{width:320px}.layout{grid-template-columns:275px minmax(0,1fr)}}\n    @media(max-width:900px){body{background:linear-gradient(180deg,#07100c 0 950px,var(--aris-ivory) 950px)}.hero{min-height:auto;padding-bottom:120px}.brandbar{min-height:84px}.hero-inner{grid-template-columns:1fr;padding-top:52px}.hero-copy{text-align:center}.hero h1,.hero .lead{margin-left:auto;margin-right:auto}.hero-actions,.hero-stats{justify-content:center}.hero-visual{min-height:340px}.logo-stage{width:310px}.layout{grid-template-columns:1fr}.sidebar{position:relative}.section-head:after{display:none}}\n    @media(max-width:560px){body{background:linear-gradient(180deg,#07100c 0 900px,var(--aris-ivory) 900px)}.hero{padding:0 16px 105px}.brandbar{min-height:74px}.brand-banner{width:64vw;max-height:54px}.channel-link{padding:8px 10px;font-size:.74rem}.channel-link span{display:none}.hero-inner{padding-top:42px}.hero h1{font-size:2.15rem}.hero .lead{font-size:.95rem}.logo-stage{width:250px}.orbit-label{font-size:.68rem;padding:5px 8px}.orbit-label.l1{right:-4%}.orbit-label.l3{left:-5%}.intro-grid{grid-template-columns:1fr}.intro-badge{min-height:88px;grid-template-columns:auto auto;gap:7px}.layout{margin-top:-55px}.section{padding:22px 16px}.section-no{width:43px;height:43px}.term{padding:17px 15px}.mini-brand{padding:15px}.nav{grid-template-columns:1fr 1fr}}\n    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}}\n    @media print{body{background:#fff}.brandbar,.hero-visual,.hero-actions,.hero-grid{display:none}.hero{min-height:0;padding:26px;background:#fff}.hero h1{color:#111;-webkit-text-fill-color:#111;text-shadow:none}.hero .lead{color:#333}.section-head:after{display:none}.section:before,.intro:before{display:none}}\n  \n\n    \n    \n    body,button,input,select{font-family:\"ArisSans\",Tahoma,\"Segoe UI\",sans-serif}.mini-mark,.mini-brand strong{font-family:Georgia,\"ArisSans\",serif}\n    .hero-logo{width:88%;border-radius:0;object-fit:contain;mix-blend-mode:normal}\n    .skip-link{position:fixed;z-index:300;right:16px;top:-60px;padding:10px 16px;border-radius:0 0 12px 12px;background:var(--aris-gold);color:#161005;text-decoration:none;font-weight:800;transition:.2s}.skip-link:focus{top:0}\n    :focus-visible{outline:3px solid rgba(245,187,53,.65);outline-offset:3px}\n    .search-tools{display:grid;grid-template-columns:1fr auto;gap:8px;margin:-4px 0 12px}.category-filter{min-width:0;border:1px solid rgba(255,255,255,.09);border-radius:10px;background:#101a15;color:#cad6cf;padding:7px 9px;font-size:.76rem}.clear-search{display:grid;place-items:center;width:36px;border:1px solid rgba(255,255,255,.09);border-radius:10px;background:rgba(255,255,255,.04);color:#d8c27d;cursor:pointer}.clear-search:disabled{opacity:.35;cursor:default}\n    .nav a.active{color:#fff;background:linear-gradient(90deg,rgba(245,187,53,.14),rgba(245,187,53,.035));border-color:rgba(245,187,53,.25);box-shadow:inset -3px 0 var(--aris-gold),0 7px 20px rgba(0,0,0,.12)}.nav a.active:before{background:var(--aris-gold);box-shadow:0 0 10px var(--aris-gold)}\n    .section-no{padding:0}.section-no svg{position:relative;z-index:1;width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.icon-index{position:absolute;z-index:2;left:-5px;bottom:-6px;display:grid;place-items:center;min-width:20px;height:20px;padding:0 4px;border-radius:7px;background:var(--gold-gradient);color:#161006;border:2px solid #fffdf8;font-size:.62rem;font-weight:900;box-shadow:0 4px 10px rgba(0,0,0,.16)}\n    .section-count{display:inline-block;margin-right:7px;padding:2px 8px;border-radius:999px;background:#f5ead0;color:#76540d;font-size:.68rem;font-weight:700}\n    .content-tools{position:sticky;z-index:15;top:10px;display:flex;align-items:center;justify-content:space-between;gap:14px;margin:0 0 18px;padding:10px 12px;border:1px solid rgba(218,197,144,.8);border-radius:15px;background:rgba(255,253,248,.9);box-shadow:0 10px 30px rgba(21,47,34,.09);backdrop-filter:blur(14px)}.content-tools-label{display:flex;align-items:center;gap:9px;color:#526159;font-size:.8rem}.content-tools-label:before{content:\"✦\";color:var(--aris-gold-dark)}.content-tools-actions{display:flex;gap:7px}.mini-btn{border:1px solid #e0d2af;border-radius:10px;background:#fffaf0;color:#624c1d;padding:7px 11px;cursor:pointer;font-size:.76rem;font-weight:700;transition:.2s}.mini-btn:hover{border-color:#bc9135;background:#f8ebc9;transform:translateY(-1px)}\n    .term{padding:0!important;overflow:hidden}.term:before{top:12px;bottom:12px}.term-head{position:relative;display:flex;align-items:center;gap:12px;padding:17px 18px 17px 16px;cursor:pointer;user-select:none}.term-head:hover{background:linear-gradient(90deg,rgba(246,225,170,.2),transparent)}.term h3{flex:1;margin:0!important}.term-actions{display:flex;align-items:center;gap:7px}.term-link{display:grid;place-items:center;width:34px;height:34px;border:1px solid #e8dcc0;border-radius:10px;background:#fffaf0;color:#85610f;cursor:pointer;opacity:.72;transition:.2s}.term-link:hover{opacity:1;border-color:#c79b3d;background:#f9e8ba}.term-link svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.term-chevron{position:relative;display:block;width:28px;height:28px;border-radius:9px;background:#f1e7ce}.term-chevron:before,.term-chevron:after{content:\"\";position:absolute;left:8px;right:8px;top:13px;height:2px;border-radius:2px;background:#765712;transition:.25s}.term-chevron:after{transform:rotate(90deg)}.term[data-open=\"true\"] .term-chevron:after{transform:rotate(0)}.term[data-open=\"true\"] .term-head{background:linear-gradient(90deg,rgba(245,225,170,.24),transparent)}\n    .term-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .3s ease}.term[data-open=\"true\"] .term-body{grid-template-rows:1fr}.term-body-inner{min-height:0;overflow:hidden;padding:0 20px}.term[data-open=\"true\"] .term-body-inner{padding:0 20px 18px;border-top:1px solid #eee6d5}.term-body-inner>p:first-child,.term-body-inner>ul:first-child{margin-top:14px}.term-nav{display:flex;justify-content:space-between;gap:10px;margin-top:15px;padding-top:12px;border-top:1px dashed #dfd4ba}.term-nav button{border:0;background:transparent;color:#7e641f;cursor:pointer;font-size:.75rem}.term-nav button:disabled{opacity:.25;cursor:default}.term-nav button:hover:not(:disabled){color:var(--aris-green);text-decoration:underline}\n    .term-result-section{display:none;margin-right:7px;padding:2px 7px;border-radius:999px;background:#e5eee8;color:#305c46;font-size:.66rem;font-weight:700}.is-searching .term:not(.hidden) .term-result-section{display:inline-block}.term.search-match{border-color:#cda84e;box-shadow:0 10px 28px rgba(151,103,12,.1)}mark{color:inherit;background:#ffe39a;box-shadow:0 0 0 2px #ffe39a;border-radius:4px}\n    .section.reveal{opacity:0;transform:translateY(18px)}.section.reveal.visible{opacity:1;transform:none;transition:opacity .55s ease,transform .55s ease}\n    .share-panel{position:relative;margin:24px 0;padding:28px;border-radius:24px;border:1px solid rgba(245,187,53,.27);background:radial-gradient(circle at 10% 20%,rgba(245,187,53,.12),transparent 14rem),linear-gradient(135deg,#07130d,#102e21);color:#fff;overflow:hidden;box-shadow:0 22px 55px rgba(6,24,16,.17)}.share-panel:after{content:\"A\";position:absolute;left:20px;top:-38px;color:rgba(245,187,53,.06);font:700 11rem/1 Georgia}.share-panel h2{position:relative;margin:0 0 4px;color:#fff;font-size:1.25rem}.share-panel p{position:relative;margin:0;color:#9fb1a7;font-size:.9rem}.share-actions{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:9px;margin-top:18px}.share-action{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(245,187,53,.22);border-radius:12px;background:rgba(255,255,255,.045);color:#f5ead0;padding:10px 14px;text-decoration:none;cursor:pointer;font:700 .82rem Tahoma,sans-serif;transition:.2s}.share-action.primary{background:var(--gold-gradient);color:#171006;border:0}.share-action:hover{transform:translateY(-2px);border-color:rgba(245,187,53,.6)}.share-action svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n    .mobile-bar,.mobile-sheet,.sheet-backdrop{display:none}.mobile-bar{position:fixed;z-index:90;right:10px;left:10px;bottom:10px;height:62px;align-items:center;justify-content:space-around;border:1px solid rgba(245,187,53,.3);border-radius:18px;background:rgba(5,15,10,.94);box-shadow:0 15px 45px rgba(0,0,0,.35);backdrop-filter:blur(16px)}.mobile-action{display:grid;place-items:center;gap:2px;min-width:58px;border:0;background:transparent;color:#a9bbb1;font-size:.66rem;cursor:pointer}.mobile-action svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.mobile-action:hover,.mobile-action.active{color:var(--aris-gold-2)}.reading-percent{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:conic-gradient(var(--aris-gold) var(--read),rgba(255,255,255,.1) 0);position:relative}.reading-percent:after{content:\"\";position:absolute;inset:4px;border-radius:50%;background:#09140f}.reading-percent b{position:relative;z-index:1;color:#fff;font-size:.62rem;direction:ltr}\n    .sheet-backdrop{position:fixed;z-index:98;inset:0;background:rgba(0,0,0,.52);backdrop-filter:blur(3px)}.mobile-sheet{position:fixed;z-index:99;right:10px;left:10px;bottom:82px;max-height:min(72vh,620px);padding:17px;border:1px solid rgba(245,187,53,.27);border-radius:22px;background:linear-gradient(160deg,#0b1812,#07100c);box-shadow:0 25px 70px rgba(0,0,0,.5);overflow:auto;transform:translateY(30px);opacity:0;transition:.24s}.mobile-sheet.open{display:block;transform:none;opacity:1}.sheet-backdrop.open{display:block}.sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px}.sheet-head strong{color:#fff}.sheet-close{display:grid;place-items:center;width:34px;height:34px;border:1px solid rgba(255,255,255,.1);border-radius:10px;background:rgba(255,255,255,.05);color:#fff;cursor:pointer}.mobile-search{width:100%;margin-bottom:12px;border:1px solid rgba(245,187,53,.2);border-radius:12px;background:rgba(255,255,255,.055);color:#fff;padding:10px 12px}.mobile-sheet .nav{max-height:none;grid-template-columns:1fr 1fr}\n    .copy-toast{bottom:88px}\n    @media(max-width:900px){.mobile-bar{display:flex}.footer{padding-bottom:118px}.content-tools{top:6px}.sidebar .nav{display:none}.sidebar .toplink{display:none}}\n    @media(max-width:560px){.content-tools-label{display:none}.content-tools{justify-content:center}.content-tools-actions{width:100%}.mini-btn{flex:1}.term-head{padding:15px 14px}.term h3{font-size:.98rem}.term-link{width:32px;height:32px}.term-body-inner,.term[data-open=\"true\"] .term-body-inner{padding-left:15px;padding-right:15px}.share-actions{display:grid;grid-template-columns:1fr}.share-action{justify-content:center}.section-count{display:block;width:max-content;margin:4px 0 0}.mobile-sheet .nav{grid-template-columns:1fr}}\n    @media print{.mobile-bar,.mobile-sheet,.sheet-backdrop,.content-tools,.share-panel,.term-link,.term-nav{display:none!important}.term-body{display:block!important}.term-body-inner{overflow:visible!important;padding:0 20px 18px!important}.term-chevron{display:none}.term{break-inside:avoid}}\n  \n\n    .mini-mark svg{width:33px;height:33px;fill:none;stroke:#1a1305;stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round}\n    .hero-logo{width:92%}.orbit-labels{display:contents}.orbit-label{white-space:nowrap}.orbit-label.l1{top:7%;right:-24%}.orbit-label.l2{right:-20%;bottom:5%}.orbit-label.l3{top:47%;left:-25%}.orbit-label:after{content:\"\";position:absolute;top:50%;width:24px;height:1px;background:linear-gradient(90deg,rgba(245,187,53,.12),rgba(245,187,53,.72))}.orbit-label.l1:after,.orbit-label.l2:after{left:-24px}.orbit-label.l3:after{right:-24px;transform:rotate(180deg)}\n    .search-tools{grid-template-columns:1fr auto auto}.clear-search,.favorites-filter{display:grid;place-items:center;min-width:36px;border:1px solid rgba(255,255,255,.09);border-radius:10px;background:rgba(255,255,255,.04);color:#d8c27d;cursor:pointer}.favorites-filter{padding:0 9px;grid-auto-flow:column;gap:4px}.favorites-filter.active{color:#161005;background:var(--gold-gradient);border-color:transparent}.favorites-filter b{font-size:.66rem}\n    .term-favorite{display:grid;place-items:center;width:34px;height:34px;border:1px solid #e8dcc0;border-radius:10px;background:#fffaf0;color:#a59670;cursor:pointer;opacity:.72;transition:.2s;font-size:1.1rem}.term-favorite:hover{opacity:1;border-color:#c79b3d;background:#f9e8ba}.term-favorite[aria-pressed=\"true\"]{opacity:1;color:#9b6500;background:#ffe5a0;border-color:#c8962d;text-shadow:0 1px #fff}\n    .related-box{margin-top:15px;padding:12px 13px;border:1px solid #e5dac0;border-radius:13px;background:#fbf7ec}.related-box strong{display:block;margin-bottom:7px;color:#516158;font-size:.75rem}.related-links{display:flex;flex-wrap:wrap;gap:6px}.related-link{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:#e7efe9;color:#27553f;text-decoration:none;font-size:.7rem;font-weight:700}.related-link:before{content:\"↗\";color:#a97814}.related-link:hover{background:#d7e7dc;color:#153e2b}\n    .compare-section{position:relative;margin:0 0 20px;padding:28px;border:1px solid var(--aris-line);border-radius:24px;background:linear-gradient(150deg,#fffdf8,#f6efdc);box-shadow:0 18px 48px rgba(30,50,39,.07);overflow:hidden}.compare-section:before{content:\"\";position:absolute;right:-55px;top:-80px;width:180px;height:180px;border:1px solid rgba(160,111,19,.13);border-radius:50%;box-shadow:0 0 0 28px rgba(160,111,19,.035),0 0 0 56px rgba(160,111,19,.025)}.compare-head{position:relative;display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:17px}.compare-head h2{margin:0;color:var(--aris-green);font-size:1.25rem}.compare-head p{margin:0;color:#78847d;font-size:.78rem}.compare-grid{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.compare-card{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;padding:14px;border:1px solid #e7dbc0;border-radius:15px;background:rgba(255,255,255,.72)}.compare-side b{display:block;color:#173c2b;font-size:.85rem}.compare-side span{display:block;color:#66736b;font-size:.72rem;line-height:1.75}.compare-vs{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--gold-gradient);color:#241705;font-size:.62rem;font-weight:900}.compare-card a{color:inherit;text-decoration:none}.compare-card a:hover b{color:#9a6811}\n    .mobile-favorites{width:100%;margin:-3px 0 12px;padding:9px;border:1px solid rgba(245,187,53,.2);border-radius:11px;background:rgba(245,187,53,.06);color:#e7cf8e;cursor:pointer}.mobile-favorites.active{background:var(--gold-gradient);color:#151006}\n    .resume-badge{position:fixed;z-index:89;left:18px;bottom:22px;display:none;align-items:center;gap:9px;padding:10px 13px;border:1px solid rgba(245,187,53,.3);border-radius:13px;background:#09150f;color:#ecdfbc;box-shadow:0 16px 40px rgba(0,0,0,.28);font-size:.76rem}.resume-badge.show{display:flex}.resume-badge button{border:0;border-radius:8px;background:var(--gold-gradient);color:#171006;padding:5px 8px;cursor:pointer;font-weight:700}.resume-badge .dismiss{background:transparent;color:#a6b6ad;padding:3px}\n    @media(max-width:768px){.compare-grid{grid-template-columns:1fr}.resume-badge{bottom:84px;left:10px;right:10px;justify-content:center}}\n    @media(max-width:900px){.logo-stage{margin-bottom:58px}.orbit-labels{position:absolute;z-index:6;right:-7%;left:-7%;bottom:-54px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.orbit-label.l1,.orbit-label.l2,.orbit-label.l3{position:relative;inset:auto;display:flex;align-items:center;justify-content:center;min-width:0;width:100%;transform:none;padding:7px 6px;text-align:center}.orbit-label:after{display:none}}\n    @media(max-width:390px){.orbit-labels{right:-10%;left:-10%;gap:8px}.orbit-label{font-size:.62rem!important;padding:6px 4px!important}}\n    @media(max-width:560px){.term-favorite{width:32px;height:32px}.compare-section{padding:22px 16px}.compare-head{display:block}.compare-head p{margin-top:3px}.compare-card{grid-template-columns:1fr}.compare-vs{width:auto;height:22px;border-radius:7px}.related-links{display:grid}.related-link{justify-content:center}}\n    @media(max-width:390px){.hero h1{font-size:1.9rem}.brand-banner{width:61vw}.channel-link{padding:7px}.layout{padding:0 9px}.term-head{gap:7px}.term-actions{gap:4px}.term-link,.term-favorite{width:29px;height:29px}.term-chevron{width:25px;height:25px}.mobile-bar{right:6px;left:6px;bottom:6px}.compare-card{padding:12px}}\n    @media(min-width:1440px){.layout{max-width:1260px}.hero-inner,.brandbar{max-width:1240px}.section{padding:34px}.term h3{font-size:1.11rem}}\n    @media print{.compare-section{break-inside:avoid}.term-favorite,.related-box,.resume-badge{display:none!important}}\n  \n\nhtml{scroll-padding-top:22px;background:#070806;color-scheme:dark}body{min-width:0;margin:0;background:radial-gradient(circle at 50% -10%,rgba(229,182,62,.09),transparent 28rem),linear-gradient(180deg,#090a08,#050605)!important;color:#f5f0e5!important;font-family:\"Vazirmatn\",Tahoma,\"Segoe UI\",sans-serif!important;overflow-x:hidden}\nbody:before,.progress,.share-section,.footer{display:none!important}.aris-article-shell{width:min(100%,1020px);margin:0 auto;padding:clamp(14px,3.5vw,34px)}\n.aris-article-tools{position:relative;margin:0 0 16px;padding:16px;border:1px solid rgba(229,182,62,.26);border-radius:18px;background:linear-gradient(145deg,rgba(25,25,20,.96),rgba(14,15,12,.98));box-shadow:0 18px 50px rgba(0,0,0,.26)}\n.aris-article-tools__row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:start}.aris-article-search{position:relative}.aris-article-search__field{position:relative}.aris-article-search input{width:100%;height:46px;padding:0 14px 0 88px;border:1px solid rgba(229,182,62,.2);border-radius:12px;background:#090a08;color:#fff8e7;outline:0;font-size:15px}.aris-article-search input:focus{border-color:#e5b63e;box-shadow:0 0 0 4px rgba(229,182,62,.11)}.aris-article-search__submit{position:absolute;inset:5px auto 5px 5px;min-width:76px;border:0;border-radius:9px;background:linear-gradient(145deg,#f2ca64,#bd8720);color:#171108;font-weight:800;cursor:pointer}.aris-article-search__meta{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:29px;margin-top:5px}.aris-article-search-status{color:#aaa292;font-size:11px}.aris-article-search-nav{display:flex;gap:4px}.aris-article-search-nav[hidden]{display:none}.aris-article-search-nav button{min-width:34px;height:28px;border:1px solid rgba(229,182,62,.2);border-radius:8px;background:rgba(229,182,62,.06);color:#e7c873;cursor:pointer}.aris-search-hit{padding:0 2px;border-radius:4px;background:#80651d;color:#fff8dc}.aris-search-hit.is-current{background:#ffd66d;color:#171108;box-shadow:0 0 0 3px rgba(255,214,109,.18)}\n.aris-toc{min-width:170px}.aris-toc summary{min-height:46px;display:flex;align-items:center;justify-content:center;padding:8px 14px;border:1px solid rgba(143,164,115,.28);border-radius:12px;color:#c8d9aa;background:rgba(102,115,74,.08);cursor:pointer;font-size:13px}.aris-toc[open] summary{border-radius:12px 12px 0 0}.aris-toc__list{display:grid;gap:3px;max-height:280px;overflow:auto;margin:0;padding:10px;border:1px solid rgba(143,164,115,.24);border-top:0;border-radius:0 0 12px 12px;background:#0b0d0a;list-style:none}.aris-toc__list a{display:block;padding:8px 9px;border-radius:8px;color:#d7d0c1;text-decoration:none;font-size:12px;line-height:1.7}.aris-toc__list a:hover{color:#ffe09a;background:rgba(229,182,62,.07)}\n.aris-validity{display:flex;align-items:flex-start;gap:10px;margin-top:12px;padding:12px 13px;border:1px solid rgba(229,182,62,.22);border-radius:12px;background:rgba(229,182,62,.055);color:#d8cfbc;font-size:12px;line-height:1.9}.aris-validity b{flex:0 0 auto;color:#f0c65d}.aris-validity--stable{border-color:rgba(143,164,115,.23);background:rgba(102,115,74,.06)}.aris-validity--stable b{color:#b7c995}\n#mainContent{display:block!important;width:100%!important;max-width:none!important;margin:0!important;padding:0!important;color:#f5f0e5!important}#mainContent,#mainContent button,#mainContent input,#mainContent select,#mainContent textarea,#mainContent a{font-family:\"Vazirmatn\",Tahoma,\"Segoe UI\",sans-serif!important}\n#mainContent>.intro:first-child{margin-top:0!important}#mainContent .intro,#mainContent .section,#mainContent .compare-section{border:1px solid rgba(229,182,62,.2)!important;border-radius:20px!important;background:linear-gradient(145deg,rgba(21,22,18,.98),rgba(13,14,12,.99))!important;box-shadow:0 16px 44px rgba(0,0,0,.22)!important}\n#mainContent .term,#mainContent .mistake,#mainContent .principle,#mainContent .professor-card,#mainContent .benefit-card,#mainContent .compare-card,#mainContent .compare-side,#mainContent .research-box,#mainContent .summary-row,#mainContent .mini-compare>div,#mainContent .map-card{border-color:rgba(143,164,115,.22)!important;background:rgba(102,115,74,.055)!important;color:#f1ecdf!important;box-shadow:none!important}\n#mainContent .term{padding:20px 30px 20px 20px!important}\n#mainContent .section-intro,#mainContent .topic-note,#mainContent .editorial-note,#mainContent .example{border-color:rgba(229,182,62,.2)!important;background:rgba(229,182,62,.055)!important;color:#e1d9c9!important}\n#mainContent .visual-summary,#mainContent .final-note,#mainContent .formula-box,#mainContent .subgroup-label{background:linear-gradient(145deg,#172017,#0d120e)!important;border:1px solid rgba(143,164,115,.24)!important;color:#f5f0e5!important}\n#mainContent h2,#mainContent h3,#mainContent h4,#mainContent b,#mainContent strong{color:#edc96f!important}#mainContent p,#mainContent li,#mainContent small,#mainContent .university,#mainContent .section-kicker,#mainContent .intro-kicker{color:#ddd6c9!important}#mainContent p,#mainContent li{font-size:clamp(17px,2.1vw,19px)!important;line-height:2.05!important}#mainContent h2{font-size:clamp(24px,4vw,33px)!important;line-height:1.55!important}#mainContent h3{font-size:clamp(19px,3vw,23px)!important;line-height:1.7!important}\n#mainContent .section-head{border-bottom-color:rgba(229,182,62,.18)!important}#mainContent .section-no,#mainContent .intro-badge,#mainContent .num{color:#f3cf75!important}#mainContent .section-no{background:#26321f!important}#mainContent a{color:#e7c46c!important}#mainContent [id]{scroll-margin-top:18px}\n.aris-related{margin:24px 0 10px;padding:20px;border:1px solid rgba(143,164,115,.25);border-radius:20px;background:linear-gradient(145deg,rgba(20,24,18,.97),rgba(12,14,11,.99))}.aris-related__eyebrow{margin:0;color:#9eb183;font-size:12px}.aris-related h2{margin:5px 0 15px;color:#f0cb72;font-size:22px}.aris-related__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.aris-related button{padding:14px;border:1px solid rgba(229,182,62,.18);border-radius:13px;background:rgba(229,182,62,.04);color:#f4eee1;text-align:right;cursor:pointer;font-size:14px;line-height:1.8}.aris-related button:hover{border-color:rgba(229,182,62,.5);background:rgba(229,182,62,.08)}\n@media(max-width:620px){.aris-article-shell{padding:10px}.aris-article-tools{padding:12px;border-radius:15px}.aris-article-tools__row{grid-template-columns:1fr}.aris-toc{min-width:0}.aris-related__grid{grid-template-columns:1fr}#mainContent .intro,#mainContent .section,#mainContent .compare-section{padding:20px 15px!important;border-radius:16px!important}#mainContent .term{padding:18px 25px 18px 17px!important}#mainContent p,#mainContent li{font-size:17px!important;line-height:2!important}}\n\n.aris-source-standard{margin:24px 0 4px;padding:18px 20px;border:1px solid rgba(30,84,64,.16);border-radius:17px;background:linear-gradient(145deg,#f4f8f5,#fffaf0);box-shadow:0 10px 28px rgba(18,55,42,.05)}\n.aris-source-standard h2{margin:0 0 8px!important;color:#173d2e!important;font-size:1.02rem!important}.aris-source-standard p{margin:5px 0!important;color:#5d6b64;font-size:.86rem;line-height:1.9}.aris-source-meta{display:flex;flex-wrap:wrap;gap:7px;margin:10px 0 12px}.aris-source-meta span{padding:5px 9px;border-radius:8px;background:#123b2b;color:#f5d16b;font-size:.72rem}.aris-source-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.aris-source-links a{display:inline-flex;align-items:center;gap:5px;padding:7px 10px;border:1px solid rgba(28,88,65,.16);border-radius:9px;background:#fff;color:#1c5841;text-decoration:none;font-size:.78rem}.aris-source-links a:hover{border-color:#c89b33;color:#8a6414}.aris-source-warning{margin-top:12px!important;padding:10px 12px;border-right:3px solid #d2a432;border-radius:10px;background:#fff7df!important;color:#5f542f!important}\n\n</style><style>\n.aris-source-docs{display:grid;gap:10px;margin:14px 0}.aris-source-doc{padding:13px 14px;border:1px solid rgba(28,88,65,.13);border-radius:12px;background:#f8faf8}.aris-source-doc b{display:block;color:#174a35;font-size:.84rem}.aris-source-doc p{margin:4px 0!important;color:#5e6b64;font-size:.78rem;line-height:1.85}.aris-source-doc a{display:inline-flex;margin-top:7px;color:#9b6d15;text-decoration:none;font-size:.74rem;font-weight:700}.aris-source-note{margin-top:10px!important;padding:10px 12px;border-radius:10px;background:#fff8e8;color:#65583a!important;font-size:.78rem!important}\n</style><style data-aris-reader-refinement=\"17\">\n/* Shell 17: compact collapsible in-article search + softer highlight card. */\n.aris-search-disclosure{\n  width:100%;\n  min-height:42px;\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:10px;\n  padding:8px 12px;\n  border:1px solid rgba(224,169,47,.18);\n  border-radius:11px;\n  background:rgba(224,169,47,.04);\n  color:#d9bd83;\n  cursor:pointer;\n  font:inherit;\n  font-size:.8rem;\n  font-weight:700;\n}\n.aris-search-disclosure::after{\n  content:\"⌕\";\n  color:#e0a92f;\n  font-size:1rem;\n}\n.aris-search-disclosure[aria-expanded=\"true\"]{\n  border-color:rgba(224,169,47,.34);\n  background:rgba(224,169,47,.075);\n}\n.aris-search-disclosure[aria-expanded=\"true\"]::after{\n  content:\"×\";\n}\n.aris-search-disclosure + .aris-article-search{\n  margin-top:10px;\n}\n.aris-article-search[hidden]{\n  display:none!important;\n}\n.aris-article-tools__row{\n  gap:9px!important;\n}\n.aris-validity{\n  padding:10px 12px!important;\n  border-color:rgba(224,169,47,.13)!important;\n  background:rgba(224,169,47,.025)!important;\n}\n.aris-validity b{\n  font-size:.75rem!important;\n}\n.aris-validity span{\n  font-size:.76rem!important;\n  line-height:1.85!important;\n}\n.intro-badge{\n  border-color:#cbb37b!important;\n  background:radial-gradient(circle at 50% 34%,#eee0bb,#d8c59b)!important;\n}\n.intro-badge b{\n  color:#153c2b!important;\n}\n.intro-badge span{\n  color:#735d2d!important;\n}\n@media(max-width:560px){\n  .aris-search-disclosure{\n    min-height:40px;\n    padding:7px 10px;\n    font-size:.76rem;\n  }\n  .aris-validity{\n    padding:9px 10px!important;\n  }\n}\n</style></head><body><h1 class=\"aris-doc-title-sr\" style=\"position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0\">طرح نیروی انسانی وزارت بهداشت</h1><div class=\"aris-article-shell\"><aside aria-label=\"ابزارهای مطالعه\" class=\"aris-article-tools\"><div class=\"aris-article-tools__row\"><button aria-controls=\"aris-article-search-form\" aria-expanded=\"false\" class=\"aris-search-disclosure\" type=\"button\">جست‌وجو داخل همین مطلب</button><form class=\"aris-article-search\" hidden=\"\" id=\"aris-article-search-form\" role=\"search\"><div class=\"aris-article-search__field\"><input aria-label=\"جست‌وجو داخل مطلب\" autocomplete=\"off\" id=\"aris-article-search-input\" placeholder=\"جست‌وجو داخل همین مطلب…\" type=\"search\"/><button class=\"aris-article-search__submit\" type=\"submit\">پیدا کن</button></div><div class=\"aris-article-search__meta\"><span aria-live=\"polite\" class=\"aris-article-search-status\" id=\"aris-article-search-status\"></span><span class=\"aris-article-search-nav\" hidden=\"\" id=\"aris-article-search-nav\"><button aria-label=\"نتیجه قبلی\" id=\"aris-search-prev\" type=\"button\">↑</button><button aria-label=\"نتیجه بعدی\" id=\"aris-search-next\" type=\"button\">↓</button></span></div></form><details class=\"aris-toc\"><summary>در این راهنما</summary><ol class=\"aris-toc__list\"><li><a href=\"#aris-article-section-1\">انتخاب رشته علوم پزشکی بدون شناخت طرح کامل نیست</a></li><li><a href=\"#aris-article-section-2\">طرح نیروی انسانی وزارت بهداشت</a></li><li><a href=\"#aris-article-section-3\">۱. طرح نیروی انسانی چیست؟</a></li><li><a href=\"#aris-article-section-4\">۲. اهداف طرح نیروی انسانی</a></li><li><a href=\"#aris-article-section-5\">۳. طرح اجباری چیست؟</a></li><li><a href=\"#aris-article-section-6\">۴. طرح اختیاری چیست؟</a></li><li><a href=\"#aris-article-section-7\">۵. تفاوت طرح اجباری و اختیاری</a></li><li><a href=\"#aris-article-section-8\">۶. رشته‌های دارای طرح اجباری</a></li><li><a href=\"#aris-article-section-9\">۷. تاریخ مشمول‌شدن بعضی رشته‌ها</a></li><li><a href=\"#aris-article-section-10\">۸. نمونه رشته‌های طرح اختیاری</a></li><li><a href=\"#aris-article-section-11\">۹. مدت طرح چقدر است؟</a></li><li><a href=\"#aris-article-section-12\">۱۰. آیا طرح حقوق دارد؟</a></li><li><a href=\"#aris-article-section-13\">۱۱. آیا محل طرح را خود فرد انتخاب می‌کند؟</a></li><li><a href=\"#aris-article-section-14\">۱۲. آیا طرح فقط در مناطق محروم است؟</a></li><li><a href=\"#aris-article-section-15\">۱۳. مهلت ثبت‌نام طرح</a></li><li><a href=\"#aris-article-section-16\">۱۴. طرح و ادامه تحصیل</a></li><li><a href=\"#aris-article-section-17\">۱۵. آیا با ادامه تحصیل، طرح حذف می‌شود؟</a></li><li><a href=\"#aris-article-section-18\">۱۶. طرح و سربازی چه تفاوتی دارند؟</a></li></ol></details></div><div class=\"aris-validity\"><b>اطلاعات متغیر</b><span>رشته‌های مشمول، مدت، معافیت و شرایط طرح ممکن است تغییر کند؛ مرجع نهایی مقررات رسمی وزارت بهداشت است.</span></div></aside><main id=\"mainContent\"><section class=\"intro split-intro\" id=\"guide-intro\"><div class=\"intro-grid\"><div><span class=\"intro-kicker\">مقدمه</span><h2 id=\"aris-article-section-1\">انتخاب رشته علوم پزشکی بدون شناخت طرح کامل نیست</h2><p>طرح نیروی انسانی بخشی از مسیر حرفه‌ای بعضی فارغ‌التحصیلان علوم پزشکی است و می‌تواند بر محل زندگی، زمان شروع کار، ادامه تحصیل و برنامه‌های چند سال آینده اثر بگذارد.</p><p>در این راهنما تفاوت طرح اجباری و اختیاری، رشته‌های مشمول، مدت و حقوق، شیوه تعیین محل خدمت، معافیت‌ها و مهم‌ترین سؤال‌هایی که باید پیش از انتخاب بپرس توضیح داده شده است.</p></div><div class=\"intro-badge\"><b>۲۲</b><span>موضوع کاربردی</span></div></div><div class=\"intro-points\"><span><i>۱</i>اجباری یا اختیاری</span><span><i>۲</i>مدت و محل خدمت</span><span><i>۳</i>حقوق، معافیت و ادامه تحصیل</span></div></section><section class=\"section searchable-section\" data-icon=\"commitments\" id=\"health-service\"><div class=\"section-head\"><div class=\"section-no\">۱</div><div><span class=\"section-kicker\">قبل از انتخاب علوم پزشکی</span><h2 id=\"aris-article-section-2\">طرح نیروی انسانی وزارت بهداشت</h2></div></div><p class=\"section-intro\">پیش از انتخاب رشته‌های علوم پزشکی باید بدان طرح چیست، کدام رشته‌ها مشمول‌اند و محل، مدت و شرایط خدمت چگونه تعیین می‌شود.</p><div class=\"terms\"><article class=\"term guide-topic\" id=\"term-1\"><h3 id=\"aris-article-section-3\"><span class=\"num\">۱.</span> طرح نیروی انسانی چیست؟</h3><p>نام رسمی آن «خدمات موضوع قانون خدمت پزشکان و پیراپزشکان» است. بعضی فارغ‌التحصیلان علوم پزشکی پس از تحصیل در مراکز موردنیاز وزارت بهداشت خدمت می‌کنند.</p><p>طرح با کارآموزی و کارورزی متفاوت است؛ در طرح فرد فارغ‌التحصیل شده و به‌عنوان نیروی ارائه‌دهنده خدمت فعالیت می‌کند.</p></article><article class=\"term guide-topic\" id=\"term-2\"><h3 id=\"aris-article-section-4\"><span class=\"num\">۲.</span> اهداف طرح نیروی انسانی</h3><ul><li>تأمین نیرو در بیمارستان‌ها و مراکز درمانی</li><li>تأمین نیروی مراکز بهداشت</li><li>توزیع بهتر نیروی انسانی</li><li>تقویت خدمات مناطق کم‌برخوردار</li><li>کسب تجربه عملی توسط فارغ‌التحصیل</li><li>کاهش تمرکز نیروها در شهرهای بزرگ</li></ul></article><article class=\"term guide-topic\" id=\"term-3\"><h3 id=\"aris-article-section-5\"><span class=\"num\">۳.</span> طرح اجباری چیست؟</h3><p>در طرح اجباری، رشته در گروه موردنیاز قرار دارد. فارغ‌التحصیل بدون معافیت باید وضعیت خود را مشخص کند و خدمات قانونی را انجام دهد.</p><p>بی‌علاقگی، پایین‌بودن حقوق یا نامناسب‌بودن شهر، تکلیف قانونی را از بین نمی‌برد. تأخیر در تعیین تکلیف می‌تواند اضافه‌خدمت یا محدودیت قانونی ایجاد کند.</p></article><article class=\"term guide-topic\" id=\"term-4\"><h3 id=\"aris-article-section-6\"><span class=\"num\">۴.</span> طرح اختیاری چیست؟</h3><p>در طرح اختیاری، فارغ‌التحصیل تکلیف قانونی برای انجام طرح ندارد؛ اما می‌تواند در صورت اعلام نیاز و وجود ظرفیت داوطلبانه ثبت‌نام کند.</p><ul><li>انجام‌ندادن آن تخلف نیست</li><li>شروع آن به نیاز دانشگاه بستگی دارد</li><li>ثبت‌نام به معنی پذیرش قطعی نیست</li></ul><div class=\"topic-note\"><span>نکته</span><p>اختیاری‌بودن به معنی انتخاب آزادانه هر شهر یا بیمارستان نیست؛ انتخاب از میان محل‌های دارای نیاز انجام می‌شود.</p></div></article><article class=\"term guide-topic\" id=\"term-5\"><h3 id=\"aris-article-section-7\"><span class=\"num\">۵.</span> تفاوت طرح اجباری و اختیاری</h3><div class=\"mini-compare\"><div><b>طرح اجباری</b><ul><li>برای مشمول بدون معافیت الزامی است</li><li>رشته در گروه موردنیاز قرار دارد</li><li>تعیین تکلیف در مهلت مقرر لازم است</li><li>محل خدمت براساس نیاز تعیین می‌شود</li><li>انجام‌ندادن پیامد قانونی دارد</li></ul></div><div><b>طرح اختیاری</b><ul><li>اصل انجام آن الزامی نیست</li><li>ثبت‌نام فقط با تمایل فرد انجام می‌شود</li><li>پذیرش به ظرفیت وابسته است</li><li>انجام‌ندادن جریمه ندارد</li><li>فرد پذیرفته‌شده حقوق و سابقه خدمت دارد</li></ul></div></div></article><article class=\"term guide-topic\" id=\"term-6\"><h3 id=\"aris-article-section-8\"><span class=\"num\">۶.</span> رشته‌های دارای طرح اجباری</h3><p>براساس فهرست رشته‌های موردنیاز تصویب‌شده در اردیبهشت ۱۴۰۳:</p><ol class=\"long-list\"><li>پزشکی</li><li>دندان‌پزشکی</li><li>داروسازی</li><li>پرستاری</li><li>هوشبری</li><li>اتاق عمل</li><li>فوریت‌های پزشکی</li><li>علوم آزمایشگاهی</li><li>پرتوشناسی تشخیصی یا رادیولوژی</li><li>مامایی</li><li>تغذیه</li><li>بهداشت عمومی</li><li>بینایی‌سنجی</li><li>شنوایی‌سنجی</li><li>گفتاردرمانی</li><li>کاردرمانی</li><li>فیزیوتراپی</li><li>فناوری اطلاعات سلامت</li><li>اپیدمیولوژی</li><li>مدیریت خدمات بهداشتی و درمانی</li><li>انفورماتیک پزشکی</li><li>اقتصاد سلامت</li><li>اقتصاد بهداشت</li><li>مددکاری اجتماعی برای فارغ‌التحصیلان دانشگاه‌های علوم پزشکی</li></ol></article><article class=\"term guide-topic\" id=\"term-7\"><h3 id=\"aris-article-section-9\"><span class=\"num\">۷.</span> تاریخ مشمول‌شدن بعضی رشته‌ها</h3><p>از اول آبان ۱۴۰۲:</p><ul><li>مامایی</li><li>تغذیه</li><li>بهداشت عمومی</li><li>بینایی‌سنجی</li><li>شنوایی‌سنجی</li><li>گفتاردرمانی</li><li>کاردرمانی</li><li>فیزیوتراپی</li><li>فناوری اطلاعات سلامت</li></ul><div class=\"topic-note\"><span>نکته</span><p>از اول خرداد ۱۴۰۳: اپیدمیولوژی، مدیریت خدمات بهداشتی و درمانی، انفورماتیک پزشکی، اقتصاد سلامت، اقتصاد بهداشت و مددکاری اجتماعی فارغ‌التحصیل دانشگاه علوم پزشکی.</p></div></article><article class=\"term guide-topic\" id=\"term-8\"><h3 id=\"aris-article-section-10\"><span class=\"num\">۸.</span> نمونه رشته‌های طرح اختیاری</h3><ul><li>آمار زیستی</li><li>آموزش بهداشت و آموزش پزشکی</li><li>ارگونومی</li><li>اعضای مصنوعی و وسایل کمکی</li><li>انگل‌شناسی و ایمنی‌شناسی پزشکی</li><li>بهداشت خانواده، محیط و ایمنی مواد غذایی</li><li>بیوتکنولوژی پزشکی و بیوشیمی بالینی</li><li>تکنولوژی پرتودرمانی و پزشکی هسته‌ای</li><li>تکنولوژی گردش خون</li><li>حشره‌شناسی پزشکی و مبارزه با ناقلین</li><li>رادیوبیولوژی و حفاظت پرتویی</li><li>روان‌شناسی بالینی</li><li>ژنتیک انسانی</li><li>سم‌شناسی</li><li>علوم تشریح و علوم و صنایع غذایی</li><li>فارماکولوژی</li><li>فناوری تصویربرداری پزشکی</li><li>فیزیولوژی و فیزیک پزشکی</li><li>قارچ‌شناسی و میکروب‌شناسی پزشکی</li><li>کتابداری و اطلاع‌رسانی پزشکی</li><li>مهندسی بهداشت حرفه‌ای و مهندسی پزشکی</li><li>نانوفناوری پزشکی</li><li>هماتولوژی و ویروس‌شناسی پزشکی</li></ul></article><article class=\"term guide-topic\" id=\"term-9\"><h3 id=\"aris-article-section-11\"><span class=\"num\">۹.</span> مدت طرح چقدر است؟</h3><ul><li>مقطع کاردانی: حداکثر ۱۲ ماه</li><li>مقطع کارشناسی و بالاتر: حداکثر ۲۴ ماه</li></ul><div class=\"topic-note\"><span>نکته</span><p>سابقه قابل‌کسر، معافیت و ضریب منطقه می‌تواند مدت واقعی حضور را کمتر کند. خدمت در بعضی مناطق با ضریب محاسبه می‌شود.</p></div></article><article class=\"term guide-topic\" id=\"term-10\"><h3 id=\"aris-article-section-12\"><span class=\"num\">۱۰.</span> آیا طرح حقوق دارد؟</h3><p>بله. طرح کار رایگان یا کارآموزی نیست. برای فرد حکم صادر می‌شود و حقوق و مزایا براساس مقررات اداری محاسبه می‌شود. عوامل مؤثر:</p><ul><li>رشته و مدرک</li><li>شهر و منطقه خدمت</li><li>تعداد شیفت و اضافه‌کار</li><li>تأهل و فرزند</li><li>کسورات بیمه</li><li>نوع مرکز درمانی</li><li>مقررات دانشگاه علوم پزشکی محل خدمت</li></ul></article><article class=\"term guide-topic\" id=\"term-11\"><h3 id=\"aris-article-section-13\"><span class=\"num\">۱۱.</span> آیا محل طرح را خود فرد انتخاب می‌کند؟</h3><p>فرد می‌تواند از میان محل‌های اعلام‌شده اولویت ثبت کند، اما تصمیم نهایی به نیاز، ظرفیت دانشگاه‌ها و فرایند توزیع بستگی دارد. شهر محل زندگی، محل تحصیل یا بیمارستان دلخواه تضمین‌شده نیست.</p></article><article class=\"term guide-topic\" id=\"term-12\"><h3 id=\"aris-article-section-14\"><span class=\"num\">۱۲.</span> آیا طرح فقط در مناطق محروم است؟</h3><p>خیر؛ طرح در مناطق موردنیاز انجام می‌شود. محل خدمت می‌تواند شامل این موارد باشد:</p><ul><li>بیمارستان</li><li>مرکز بهداشت و خانه بهداشت</li><li>درمانگاه و مرکز جامع سلامت</li><li>آزمایشگاه</li><li>مرکز فوریت‌های پزشکی</li><li>واحدهای اداری یا اطلاعات سلامت</li></ul></article><article class=\"term guide-topic\" id=\"term-13\"><h3 id=\"aris-article-section-15\"><span class=\"num\">۱۳.</span> مهلت ثبت‌نام طرح</h3><p>مشمول رشته اجباری باید پس از فراغت از تحصیل برای ثبت‌نام و تعیین تکلیف اقدام کند. تأخیر غیرموجه می‌تواند اضافه‌خدمت ایجاد کند. برای نظام‌وظیفه، بارداری، فرزند خردسال یا بیماری تأییدشده مقررات جداگانه وجود دارد.</p></article><article class=\"term guide-topic\" id=\"term-14\"><h3 id=\"aris-article-section-16\"><span class=\"num\">۱۴.</span> طرح و ادامه تحصیل</h3><p>در بسیاری از رشته‌ها ادامه تحصیل بدون فاصله ممکن است. اگر فرد هنگام طرح در مقطع بالاتر پذیرفته شود، با طی فرایند رسمی می‌تواند طرح را متوقف کند. پزشکی، دندان‌پزشکی، داروسازی، دستیاری تخصصی و بعضی رشته‌ها شرایط جداگانه دارند.</p></article><article class=\"term guide-topic\" id=\"term-15\"><h3 id=\"aris-article-section-17\"><span class=\"num\">۱۵.</span> آیا با ادامه تحصیل، طرح حذف می‌شود؟</h3><p>همیشه نه. اگر خدمات یک مقطع کامل و گواهی پایان صادر شده باشد، ممکن است در مقطع بالاتر همان خدمت تکرار نشود؛ اما طرح انجام‌نشده یا ناقص می‌تواند بعد از مقطع بالاتر باقی بماند.</p></article><article class=\"term guide-topic\" id=\"term-16\"><h3 id=\"aris-article-section-18\"><span class=\"num\">۱۶.</span> طرح و سربازی چه تفاوتی دارند؟</h3><ul><li>سربازی براساس قانون نظام‌وظیفه است</li><li>طرح براساس قانون خدمت پزشکان و پیراپزشکان است</li></ul><div class=\"topic-note\"><span>نکته</span><p>برای بعضی فارغ‌التحصیلان مرد، خدمت نظام‌وظیفه واجد شرایط می‌تواند از مدت خدمات پزشکی کسر شود؛ اما این دو یکی نیستند.</p></div></article><article class=\"term guide-topic\" id=\"term-17\"><h3><span class=\"num\">۱۷.</span> طرح با تعهد خدمت چه فرقی دارد؟</h3><p>طرح به رشته و نیاز وزارت بهداشت مربوط است؛ تعهد خدمت معمولاً از نوع پذیرش، سهمیه یا کدرشته‌محل خاص ایجاد می‌شود. ممکن است یک فرد هم طرح و هم تعهد خدمت داشته باشد.</p></article><article class=\"term guide-topic\" id=\"term-18\"><h3><span class=\"num\">۱۸.</span> آیا می‌توان طرح را خرید؟</h3><p>به‌طور عمومی نباید روی خرید طرح حساب کرد. انجام‌ندادن طرح اجباری فقط با معافیت قانونی یا مجوز رسمی ممکن است. انتخاب رشته با تصور حذف طرح در برابر پرداخت پول، تصمیم مطمئنی نیست.</p></article><article class=\"term guide-topic\" id=\"term-19\"><h3><span class=\"num\">۱۹.</span> معافیت از طرح</h3><p>برخی افراد می‌توانند از تمام یا بخشی از خدمات معاف شوند یا کسر خدمت بگیرند. زمینه‌های رایج:</p><ul><li>شرایط ایثارگری</li><li>بعضی شرایط خانوادگی یا پزشکی</li><li>خدمت نظام‌وظیفه واجد شرایط</li><li>استخدام رسمی در مراکز مشخص</li><li>انجام قبلی خدمات در مقطع دیگر</li><li>قوانین حمایت از خانواده</li><li>بعضی شرایط تحصیل خارج از کشور</li><li>مقررات استعدادهای درخشان</li></ul><div class=\"topic-note\"><span>نکته</span><p>معافیت خودکار نیست؛ درخواست، بررسی مدارک و صدور گواهی رسمی لازم است.</p></div></article><article class=\"term guide-topic\" id=\"term-20\"><h3><span class=\"num\">۲۰.</span> آیا طرح سابقه کار محسوب می‌شود؟</h3><p>اگر طرح رسمی و همراه با حکم و گواهی باشد، مدت آن می‌تواند سابقه فعالیت محسوب شود. نحوه محاسبه برای استخدام، بازنشستگی، بیمه یا آزمون‌های مختلف ضوابط مخصوص خود را دارد.</p></article><article class=\"term guide-topic\" id=\"term-21\"><h3><span class=\"num\">۲۱.</span> مهم‌ترین سؤال‌ها قبل از انتخاب رشته دارای طرح</h3><ul><li>طرح رشته اجباری است یا اختیاری؟</li><li>مدت اسمی آن چقدر است؟</li><li>محل‌های احتمالی خدمت کجاست؟</li><li>توان زندگی در شهر دیگری را دارم؟</li><li>شرایط شیفت و محیط کار چگونه است؟</li><li>رشته تعهد خدمت هم دارد؟</li><li>ادامه تحصیل پیش از پایان طرح ممکن است؟</li><li>حقوق و مزایا چگونه محاسبه می‌شود؟</li><li>شرایط معافیت یا کسر خدمت دارم؟</li><li>اگر شهر دلخواهم ظرفیت نداشت، جای دیگری خدمت می‌کنم؟</li></ul></article><article class=\"term guide-topic\" id=\"term-22\"><h3><span class=\"num\">۲۲.</span> جمع‌بندی این بخش</h3><p>طرح اختیاری یعنی اصل انجام آن اجباری نیست؛ نه اینکه آسان‌تر باشد. طرح اجباری نیز کار رایگان یا اعزام قطعی به دورافتاده‌ترین نقطه نیست. محل، مدت و حقوق به رشته، ظرفیت و نیاز مراکز علوم پزشکی بستگی دارد.</p></article></div></section><section aria-label=\"کنترل نهایی راهنما\" class=\"section aris-standard-close\"><h2>قبل از انتخاب رشته‌های مشمول طرح</h2><div class=\"terms\"><article class=\"term\"><h3>خطای رایج</h3><p>انتخاب رشته دارای طرح با این فرض که جزئیات محل، مدت یا امکان معافیت بعداً حتماً مطابق میل تو حل می‌شود.</p></article><article class=\"term\"><h3>جمع‌بندی</h3><p>طرح بخشی از واقعیت مسیر حرفه‌ای بعضی رشته‌هاست و باید قبل از انتخاب، همراه با شرایط همان سال دیده شود.</p></article><article class=\"term\"><h3>اقدام بعدی</h3><p>برای رشته موردنظر، وضعیت طرح و استثناهای احتمالی را از مرجع رسمی همان سال بررسی و نتیجه را کنار انتخاب ثبت کن.</p></article></div></section><section aria-label=\"منابع و اعتبار اطلاعات\" class=\"aris-source-standard\"><h2>منابع و اعتبار اطلاعات</h2><div class=\"aris-source-meta\"><span>آخرین بازبینی: ۱۷ شهریور ۱۴۰۵</span><span>مرجع: سند رسمی + سامانه اجرایی</span><span>اطلاعات متغیر</span></div><p>منابع این راهنما به دو دسته تفکیک شده‌اند: سند سالانه‌ای که باید برای مقررات همان سال خوانده شود، و سامانه/مرجع رسمی‌ای که مسیر اجرایی یا اطلاعات روز را ارائه می‌کند.</p><div class=\"aris-source-docs\"><div class=\"aris-source-doc\"><b>سامانه رشد و طرح نیروی انسانی وزارت بهداشت</b><p>ثبت‌نام، وضعیت و فرایندهای اجرایی طرح</p><a href=\"https://tarhreg.behdasht.gov.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">ورود مستقیم به سامانه طرح ↗</a><small class=\"aris-source-type\">لینک مستقیم سامانه</small></div><div class=\"aris-source-doc\"><b>وزارت بهداشت، درمان و آموزش پزشکی</b><p>اطلاعیه‌ها و مقررات بالادستی مرتبط با رشته‌های علوم پزشکی</p><a href=\"https://behdasht.gov.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">درگاه رسمی وزارت بهداشت ↗</a><small class=\"aris-source-type\">مرجع رسمی</small></div></div><p class=\"aris-source-note\">اگر فایل یا اطلاعیه سالانه در درگاه رسمی جابه‌جا شده بود، عنوان دقیق سند بالا را در همان مرجع رسمی پیدا کن. لینک سامانه‌های اجرایی تا حد امکان مستقیم است؛ لینک انتشار دفترچه‌ها ممکن است سال‌به‌سال تغییر کند.</p></section>\n</main>\n<section class=\"aris-related\"><p class=\"aris-related__eyebrow\">قدم بعدی</p><h2>راهنماهای مرتبط</h2><div class=\"aris-related__grid\"><button data-related-guide=\"hazine-vaghei-tahsil\" type=\"button\">هزینه واقعی تحصیل <span aria-hidden=\"true\">←</span></button><button data-related-guide=\"maharathaye-janebi-reshtehaye-daneshgahi\" type=\"button\">مهارت‌های جانبی رشته‌های دانشگاهی <span aria-hidden=\"true\">←</span></button></div></section></div><script>\n(function(){\nvar form=document.getElementById('aris-article-search-form'),input=document.getElementById('aris-article-search-input'),status=document.getElementById('aris-article-search-status'),nav=document.getElementById('aris-article-search-nav'),previous=document.getElementById('aris-search-prev'),next=document.getElementById('aris-search-next'),hits=[],current=-1,lastQuery='';\nfunction normalize(value){return String(value||'').toLowerCase().replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/[أإ]/g,'ا').replace(/ة/g,'ه').replace(/\\u200c/g,' ')}\nfunction clearHits(){document.querySelectorAll('mark.aris-search-hit').forEach(function(mark){var parent=mark.parentNode;parent.replaceChild(document.createTextNode(mark.textContent),mark);parent.normalize()});hits=[];current=-1;if(nav)nav.hidden=true}\nfunction collect(query){var root=document.getElementById('mainContent'),walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode:function(node){var parent=node.parentElement;return parent&&!parent.closest('script,style,mark.aris-search-hit')&&normalize(node.nodeValue).indexOf(query)>-1?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_REJECT}}),nodes=[],node;while((node=walker.nextNode())&&nodes.length<200)nodes.push(node);nodes.forEach(function(textNode){if(hits.length>=200)return;var source=textNode.nodeValue,normalized=normalize(source),from=0,index,fragment=document.createDocumentFragment();while((index=normalized.indexOf(query,from))>-1&&hits.length<200){if(index>from)fragment.appendChild(document.createTextNode(source.slice(from,index)));var mark=document.createElement('mark');mark.className='aris-search-hit';mark.textContent=source.slice(index,index+query.length);fragment.appendChild(mark);hits.push(mark);from=index+query.length}if(from<source.length)fragment.appendChild(document.createTextNode(source.slice(from)));textNode.parentNode.replaceChild(fragment,textNode)})}\nfunction show(index){if(!hits.length)return;hits.forEach(function(hit){hit.classList.remove('is-current')});current=(index+hits.length)%hits.length;hits[current].classList.add('is-current');hits[current].scrollIntoView({behavior:'smooth',block:'center'});status.textContent=hits.length+' نتیجه · '+(current+1)+' از '+hits.length;if(nav)nav.hidden=false}\nfunction runSearch(){var query=normalize(input.value.trim());if(!query){clearHits();lastQuery='';status.textContent='یک واژه یا عبارت بنویس.';return}if(query===lastQuery&&hits.length){show(current+1);return}clearHits();lastQuery=query;collect(query);if(hits.length)show(0);else status.textContent='عبارتی با این عنوان در مطلب پیدا نشد.'}\nif(form&&input){form.addEventListener('submit',function(event){event.preventDefault();runSearch()});input.addEventListener('input',function(){if(!input.value.trim()){clearHits();lastQuery='';status.textContent=''}});if(previous)previous.addEventListener('click',function(){show(current-1)});if(next)next.addEventListener('click',function(){show(current+1)})}\ndocument.querySelectorAll('[data-related-guide]').forEach(function(button){button.addEventListener('click',function(){parent.postMessage({type:'aris-guide-open',id:button.dataset.relatedGuide},'*')})});\n}());\n<\/script><script data-aris-search-disclosure=\"17\">\n(function(){\n  var disclosure=document.querySelector('.aris-search-disclosure');\n  var form=document.getElementById('aris-article-search-form');\n  if(!disclosure||!form)return;\n  disclosure.addEventListener('click',function(){\n    var open=disclosure.getAttribute('aria-expanded')==='true';\n    disclosure.setAttribute('aria-expanded',String(!open));\n    form.hidden=open;\n    if(!open){\n      var input=document.getElementById('aris-article-search-input');\n      setTimeout(function(){if(input)input.focus({preventScroll:true})},0);\n    }\n  });\n}());\n<\/script></body></html>","keywords":["طرح","طرح اجباری","نیروی انسانی","وزارت بهداشت","علوم پزشکی","تعهد خدمت"]},{"id":"maharathaye-janebi-reshtehaye-daneshgahi","title":"مهارت‌های جانبی رشته‌های دانشگاهی","eyebrow":"آمادگی شغلی","category":"future","categoryLabel":"مسیر علمی و شغلی","description":"مهارت‌های عمومی و تخصصی موردنیاز رشته‌های پزشکی، مهندسی، کامپیوتر، انسانی، مدیریت، هنر، معماری و زبان را بشناسید.","minutes":5,"words":918,"dynamic":false,"document":"<!doctype html>\n<html dir=\"rtl\" lang=\"fa\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width,initial-scale=1,viewport-fit=cover\" name=\"viewport\"/><title>مهارت‌های جانبی رشته‌های دانشگاهی</title><style>\n    :root{--ink:#17211d;--muted:#64726b;--paper:#fbfaf6;--card:#fff;--green:#12372a;--green2:#245943;--mint:#dfece4;--gold:#e0a92f;--line:#dce4df;--shadow:0 16px 42px rgba(18,55,42,.09)}\n    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:linear-gradient(180deg,#eff5f1 0,#fbfaf6 520px);color:var(--ink);font-family:Tahoma,\"Vazirmatn\",\"Segoe UI\",sans-serif;line-height:2}\n    button,input{font:inherit}.progress{position:fixed;inset:0 0 auto;z-index:99;height:4px;background:transparent}.progress span{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--gold),#f2cf79)}\n    .hero{position:relative;overflow:hidden;background:var(--green);color:white;padding:72px 24px 102px}.hero:before,.hero:after{content:\"\";position:absolute;border-radius:50%;background:rgba(255,255,255,.045)}.hero:before{width:360px;height:360px;left:-100px;top:-160px}.hero:after{width:240px;height:240px;right:-80px;bottom:-100px}.hero-inner{position:relative;max-width:1120px;margin:auto}.eyebrow{display:inline-flex;gap:8px;align-items:center;padding:7px 13px;border:1px solid rgba(255,255,255,.22);border-radius:999px;color:#dfece4;font-size:.85rem}.eyebrow:before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--gold)}h1{max-width:830px;margin:22px 0 12px;font-size:clamp(2rem,5vw,4.1rem);line-height:1.35;letter-spacing:-.04em}.lead{max-width:790px;margin:0;color:#d6e3dc;font-size:1.08rem}.hero-stats{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.hero-stats span{padding:7px 13px;border-radius:10px;background:rgba(255,255,255,.09);font-size:.88rem}\n    .layout{max-width:1180px;margin:-58px auto 80px;padding:0 22px;display:grid;grid-template-columns:285px minmax(0,1fr);gap:28px;align-items:start}.sidebar{position:sticky;top:20px;background:var(--card);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);padding:18px}.sidebar h2{font-size:1rem;margin:0 0 12px}.search{position:relative;margin-bottom:14px}.search input{width:100%;border:1px solid var(--line);border-radius:12px;background:#f8faf8;padding:10px 38px 10px 10px;outline:none;color:var(--ink)}.search input:focus{border-color:var(--green2);box-shadow:0 0 0 3px rgba(36,89,67,.1)}.search:before{content:\"⌕\";position:absolute;right:13px;top:4px;font-size:1.35rem;color:var(--muted)}.count{font-size:.78rem;color:var(--muted);margin:-6px 2px 10px}.nav{display:grid;gap:4px;max-height:58vh;overflow:auto;padding-left:4px}.nav a{color:#415049;text-decoration:none;border-radius:10px;padding:7px 9px;font-size:.85rem;line-height:1.6}.nav a:hover{background:var(--mint);color:var(--green)}.toplink{display:block;text-align:center;margin-top:12px;padding:8px;border-top:1px solid var(--line);color:var(--green2);text-decoration:none;font-size:.84rem}\n    main{min-width:0}.intro,.section{background:var(--card);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.intro{padding:28px 30px;margin-bottom:24px}.intro p{margin:0}.section{padding:30px;margin-bottom:24px}.section-head{display:flex;align-items:flex-start;gap:15px;margin-bottom:20px;padding-bottom:18px;border-bottom:1px solid var(--line)}.section-no{flex:0 0 auto;display:grid;place-items:center;width:44px;height:44px;border-radius:14px;background:var(--green);color:white;font-weight:700}.section h2{margin:0;font-size:1.45rem;line-height:1.6}.section-kicker{font-size:.8rem;color:var(--muted)}.terms{display:grid;gap:14px}.term{position:relative;border:1px solid var(--line);border-radius:16px;padding:19px 20px;background:linear-gradient(135deg,#fff,#fbfcfb)}.term:hover{border-color:#b7cbc0;box-shadow:0 8px 24px rgba(18,55,42,.06)}.term h3{margin:0 0 6px;color:var(--green);font-size:1.05rem;line-height:1.7}.term h3 .num{display:inline-block;min-width:32px;color:var(--gold);font-variant-numeric:tabular-nums}.term p{margin:5px 0}.term ul{margin:7px 0 0;padding-right:22px}.example{margin-top:10px!important;padding:10px 13px;border-right:3px solid var(--gold);background:#fff8e7;border-radius:10px;color:#544825;font-size:.93rem}.simple{color:var(--green2);font-weight:700}.hidden{display:none!important}.empty{display:none;background:#fff;border:1px dashed #b7c6bd;border-radius:18px;padding:30px;text-align:center;color:var(--muted)}mark{background:#ffe59e;border-radius:4px;padding:0 2px}\n    .mistakes{counter-reset:mistake;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.mistake{counter-increment:mistake;border:1px solid var(--line);border-radius:15px;padding:17px;background:#fff}.mistake h3{margin:0 0 5px;font-size:1rem}.mistake h3:before{content:counter(mistake,\"persian\") \". \";color:var(--gold)}.mistake p{margin:0;color:#3f4c46;font-size:.93rem}.principles{display:grid;gap:10px;counter-reset:principle}.principle{counter-increment:principle;display:flex;gap:13px;align-items:flex-start;padding:14px;border-radius:14px;background:#f4f8f5}.principle:before{content:counter(principle,\"persian\");display:grid;place-items:center;flex:0 0 34px;height:34px;border-radius:10px;background:var(--green);color:#fff;font-weight:700}.final-note{margin-top:22px;padding:18px 20px;border-radius:16px;background:var(--green);color:#eef7f1;font-size:1.05rem}.footer{text-align:center;color:var(--muted);padding:10px 20px 42px;font-size:.82rem}\n    .mobile-tools{display:none}.copy-toast{position:fixed;z-index:120;left:50%;bottom:28px;transform:translate(-50%,20px);padding:9px 16px;background:#17211d;color:white;border-radius:999px;opacity:0;pointer-events:none;transition:.25s}.copy-toast.show{opacity:1;transform:translate(-50%,0)}\n    @media(max-width:900px){.layout{grid-template-columns:1fr;margin-top:-54px}.sidebar{position:relative;top:0}.nav{grid-template-columns:repeat(2,minmax(0,1fr));max-height:none}.toplink{display:none}.hero{padding-top:54px}.mistakes{grid-template-columns:1fr}}\n    @media(max-width:560px){body{line-height:1.9}.hero{padding:42px 18px 86px}h1{font-size:2rem}.lead{font-size:.98rem}.layout{padding:0 12px;gap:16px}.sidebar,.intro,.section{border-radius:18px}.section,.intro{padding:21px 17px}.nav{grid-template-columns:1fr 1fr}.nav a{font-size:.78rem;padding:6px}.term{padding:16px 14px}.section-head{gap:10px}.section-no{width:38px;height:38px;border-radius:12px}.section h2{font-size:1.2rem}}\n    @media print{body{background:#fff}.progress,.sidebar{display:none}.hero{padding:30px;background:#fff;color:#111;border-bottom:2px solid #111}.hero .lead,.eyebrow{color:#333}.layout{display:block;margin:0;padding:0}.intro,.section{box-shadow:none;border:0;border-radius:0;break-inside:auto}.term{break-inside:avoid}.section{break-before:page}.hero-stats{color:#111}.final-note{background:#eee;color:#111}.footer{display:none}}\n  \n  .guide-intro{overflow:hidden}.guide-map{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin-top:23px}.map-card{display:grid;grid-template-columns:38px minmax(0,1fr);gap:12px;align-items:center;padding:15px;border:1px solid rgba(25,89,65,.12);border-radius:16px;background:linear-gradient(145deg,#fff,#f5f8f5);color:inherit;text-decoration:none;font-family:Tahoma,Arial,sans-serif;transition:.2s}.map-card:hover{transform:translateY(-2px);border-color:rgba(181,128,24,.42);box-shadow:0 12px 28px rgba(14,53,37,.08)}.map-card>span{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:linear-gradient(145deg,#173d2e,#091f16);color:#f6c64d;font-weight:600}.map-card b{display:block;color:#173d2e;font-size:.9rem;font-weight:600;line-height:1.7}.map-card small{display:block;color:#718078;font-size:.73rem;line-height:1.6}.decision-strip{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 22px;padding:20px 22px;border:1px solid rgba(245,187,53,.23);border-radius:22px;background:linear-gradient(140deg,#091a12,#123525);color:#fff;box-shadow:0 18px 42px rgba(9,32,22,.14)}.decision-strip div{display:grid;gap:2px}.decision-strip span{color:#dcae3d;font:600 .66rem Tahoma}.decision-strip b{font-size:.82rem}.decision-strip small{color:#8fa197;font-size:.68rem}.decision-strip i{width:32px;height:1px;background:linear-gradient(90deg,transparent,#c9982c,transparent)}.section-intro{margin:-3px 0 19px;padding:13px 15px;border-radius:13px;background:#f6f2e7;color:#66726b;font-size:.88rem;line-height:1.9}.guide-topic .term-body-inner>p{margin:7px 0}.guide-topic ul,.guide-topic ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px 18px;margin:13px 0;padding:0;list-style:none}.guide-topic li{position:relative;padding-right:18px;color:#536159;font-size:.9rem;line-height:1.9}.guide-topic ul li:before{content:\"\";position:absolute;right:2px;top:.86em;width:6px;height:6px;border-radius:50%;background:#d5a52f;box-shadow:0 0 0 3px rgba(213,165,47,.12)}.guide-topic ol{counter-reset:item}.guide-topic ol li{counter-increment:item}.guide-topic ol li:before{content:counter(item,decimal);position:absolute;right:0;top:.26em;color:#a87816;font-weight:700;font-size:.74rem}.guide-topic .long-list{grid-template-columns:repeat(3,minmax(0,1fr))}.topic-note{display:flex;align-items:flex-start;gap:10px;margin-top:13px;padding:13px 14px;border:1px solid rgba(197,143,29,.2);border-radius:13px;background:#fff8e8}.topic-note span{flex:0 0 auto;padding:3px 8px;border-radius:7px;background:#dfaa31;color:#251904;font:700 .7rem Tahoma}.topic-note p{margin:0!important;color:#5e563f}.guide-topic .example{display:grid;grid-template-columns:auto 1fr;gap:9px;align-items:start}.guide-topic .example b{color:#a06e13}.guide-topic blockquote{margin:12px 0 0;padding:17px 18px;border:1px solid rgba(28,88,65,.14);border-right:4px solid #1c5841;border-radius:14px;background:#f3f8f5;color:#173d2e;font-weight:700;line-height:2}.formula-box{margin-top:13px;padding:18px;border-radius:14px;background:linear-gradient(135deg,#0b2419,#174a35);color:#f7d474;text-align:center;font-weight:800;line-height:2;box-shadow:inset 0 1px rgba(255,255,255,.06)}.mini-compare{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:13px}.mini-compare>div{padding:15px;border:1px solid rgba(27,82,62,.13);border-radius:14px;background:#f7faf8}.mini-compare>div>b{display:block;padding-bottom:8px;color:#173d2e;border-bottom:1px solid #dde8e1}.mini-compare ul{grid-template-columns:1fr;margin-bottom:0}.section-count:after{content:\" موضوع\"}\n  @media(max-width:700px){.guide-map{grid-template-columns:1fr}.decision-strip{display:grid;grid-template-columns:1fr 1fr}.decision-strip i{display:none}.guide-topic ul,.guide-topic ol,.guide-topic .long-list{grid-template-columns:1fr}.mini-compare{grid-template-columns:1fr}.map-card{grid-template-columns:40px minmax(0,1fr)}.map-card b{font-size:.86rem}.decision-strip div{padding:8px;border-bottom:1px solid rgba(255,255,255,.06)}}\n.split-intro{overflow:hidden}.split-intro .intro-grid>div:first-child{max-width:730px}.split-intro .intro-grid p{margin:8px 0 0;line-height:2;color:#647169}.intro-points{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:22px}.intro-points span{display:flex;align-items:center;gap:9px;padding:12px 13px;border:1px solid rgba(28,88,65,.12);border-radius:13px;background:linear-gradient(145deg,#fff,#f4f8f5);color:#355247;font:500 .78rem Tahoma