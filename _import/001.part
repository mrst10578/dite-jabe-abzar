h:640px){.course-modes{grid-template-columns:1fr}}.course-mode{padding:16px;border-radius:19px;border:1px solid var(--line);background:rgba(255,255,255,.03)}.course-mode small{display:block;color:var(--muted);font-size:11px}.course-mode h3{margin:3px 0 5px;font-size:17px}.course-mode b{display:block;color:var(--accent);font-size:12px}.course-mode p{margin:5px 0 0;color:var(--muted);font-size:11px}.course-mode-note{margin-top:10px;padding:11px 13px;border-radius:14px;border:1px solid rgba(255,216,122,.14);background:rgba(255,216,122,.04);font-size:11px;color:#eadfc6}.scope-static{margin-top:12px;display:grid;gap:7px}.scope-static div{padding:9px 11px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.025);font-size:11px;color:var(--muted)}.scope-static b{color:var(--accent)}\n\n.workflow{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.workflow-step{position:relative;padding:15px;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.03);min-height:142px}.workflow-step:not(:last-child):after{content:\"←\";position:absolute;left:-10px;top:46%;color:var(--accent);font-weight:950}.workflow-step small{display:block;color:var(--accent);font-size:11px;font-weight:950}.workflow-step h3{font-size:16px;margin:4px 0 5px}.workflow-step p{font-size:11px;color:var(--muted);margin:0}.status-strip{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}.status-pill{display:inline-flex;align-items:center;min-height:36px;padding:6px 10px;border-radius:999px;border:1px solid var(--line);background:rgba(255,216,122,.045);font-size:11px;font-weight:900}.status-pill strong{color:var(--accent)}\n.free-capacity{margin-top:12px;padding:14px 15px;border-radius:16px;border:1px solid rgba(255,216,122,.16);background:rgba(255,216,122,.045);font-size:12px;color:#eadfc6}.free-capacity strong{color:#fff}.seat-example{margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:10px}.seat-card{padding:14px;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,.028)}.seat-card h3{font-size:15px;margin:0 0 6px}.seat-card p{font-size:11px;color:var(--muted);margin:0}.seat-math{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.seat-math span{padding:5px 8px;border-radius:10px;background:rgba(255,216,122,.055);border:1px solid rgba(255,216,122,.12);font-size:11px;font-weight:900;color:#f6e6bb}\n.reference-accordion{margin-top:14px;border:1px solid var(--line);border-radius:20px;background:rgba(255,255,255,.025);overflow:hidden}.reference-accordion details+details{border-top:1px solid var(--line)}.reference-accordion summary{cursor:pointer;list-style:none;padding:14px 16px;font-weight:950;color:#f5e8c7;display:flex;align-items:center;justify-content:space-between;gap:12px}.reference-accordion summary::-webkit-details-marker{display:none}.reference-accordion summary:after{content:\"+\";color:var(--accent);font-size:20px;line-height:1}.reference-accordion details[open] summary:after{content:\"−\"}.reference-body{padding:0 16px 16px}.geo-table{width:100%;border-collapse:collapse}.geo-table th,.geo-table td{padding:9px 10px;border-bottom:1px solid var(--line);text-align:right;vertical-align:top;font-size:11px}.geo-table th{color:var(--gold-soft);width:110px}.geo-table tr:last-child>*{border-bottom:0}\n.special-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.special-card{padding:18px;border-radius:20px;border:1px solid var(--line);background:rgba(255,255,255,.03)}.special-card h3{font-size:18px;margin:0 0 7px}.special-card p,.special-card li{font-size:11px;color:var(--muted)}.special-card ul{margin:8px 0 0;padding-right:18px}.special-card strong{color:#fff}.special-card.city{border-color:rgba(255,216,122,.2);background:rgba(255,216,122,.045)}.special-card.veteran{border-color:rgba(221,193,112,.2);background:rgba(221,193,112,.045)}.stop-box{margin-top:12px;padding:15px;border-radius:17px;border:1px solid rgba(255,155,155,.2);background:rgba(255,155,155,.055)}.stop-box h3{font-size:17px;margin:0 0 6px;color:#ffd0d0}.stop-box p{font-size:11px;color:#e7c9c5;margin:0}.stop-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.stop-tags span{padding:5px 8px;border-radius:999px;border:1px solid rgba(255,155,155,.16);background:rgba(255,155,155,.045);font-size:10px;color:#ffd3cd;font-weight:900}\n.example-matrix{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.example-card2{padding:16px;border-radius:18px;border:1px solid var(--line);background:rgba(255,255,255,.03)}.example-card2 small{display:block;color:var(--accent);font-size:10px;font-weight:950}.example-card2 h3{font-size:16px;margin:4px 0 7px}.example-card2 dl{display:grid;gap:5px;margin:0}.example-card2 dl div{display:flex;justify-content:space-between;gap:12px;font-size:11px}.example-card2 dt{color:var(--muted)}.example-card2 dd{margin:0;font-weight:900}.yes{color:var(--success)}.no{color:var(--danger)}\n.tool-exclusions{margin-top:10px;padding:11px 12px;border-radius:14px;border:1px solid rgba(255,155,155,.16);background:rgba(255,155,155,.045);font-size:11px;color:#e9cbc6}.tool-exclusions strong{color:#ffd0d0}\n@media(max-width:960px){.workflow{grid-template-columns:1fr 1fr}.workflow-step:not(:last-child):after{display:none}.example-matrix{grid-template-columns:1fr 1fr}}\n@media(max-width:640px){.workflow,.special-grid,.example-matrix,.seat-example{grid-template-columns:1fr}.workflow-step{min-height:0}.geo-table th{width:78px}.reference-body{padding-inline:10px}.geo-table th,.geo-table td{padding:8px 7px;font-size:10.5px}}\n.footer{padding:18px 0 54px;padding-bottom:calc(54px + constant(safe-area-inset-bottom));padding-bottom:calc(54px + env(safe-area-inset-bottom));margin-top:12px;position:relative;z-index:1;border:0}.footer-card{position:relative;overflow:hidden;border:1px solid rgba(255,216,122,.17);border-radius:30px;background:linear-gradient(145deg,rgba(20,14,7,.88),rgba(6,4,2,.92));box-shadow:0 22px 70px rgba(0,0,0,.42),inset 0 1px 0 rgba(255,235,189,.05);padding:24px}.footer-card:before{content:\"\";position:absolute;width:340px;height:340px;left:-130px;bottom:-180px;border-radius:50%;background:radial-gradient(circle,rgba(255,216,122,.12),transparent 68%);pointer-events:none}.footer-main{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:22px}.footer-brand{display:flex;align-items:center;gap:13px}.footer-mark{width:54px;height:54px;flex:0 0 54px;display:grid;place-items:center;border-radius:18px;border:1px solid rgba(255,216,122,.22);background:linear-gradient(145deg,#1a1207,#0b0703);color:var(--accent);font-size:29px;font-weight:950;box-shadow:0 10px 30px rgba(200,132,27,.14)}.footer-title{display:flex;align-items:center;gap:7px;font-size:16px;font-weight:950}.footer-title span{color:rgba(255,216,122,.45)}.footer-brand p{margin:2px 0 0;color:var(--muted);font-size:11px}.footer-actions{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}.footer-actions a,.footer-actions button{min-height:44px;border-radius:13px;border:1px solid rgba(255,216,122,.14);background:rgba(255,216,122,.045);color:#f5e9c9;padding:8px 11px;font-size:10px;font-weight:900;cursor:pointer}.footer-actions a:hover,.footer-actions button:hover{background:rgba(255,216,122,.1)}.footer-meta{position:relative;z-index:2;display:flex;justify-content:space-between;gap:12px;margin-top:18px;padding-top:13px;border-top:1px solid rgba(255,216,122,.1);color:#b9a986;font-size:11px}.footer-constellation{position:absolute;inset:0;pointer-events:none;opacity:.6}.footer-constellation i{position:absolute;width:3px;height:3px;border-radius:50%;background:#ffe6a4;box-shadow:0 0 9px rgba(255,216,122,.55)}.footer-constellation i:nth-child(1){left:8%;top:22%}.footer-constellation i:nth-child(2){left:17%;top:38%}.footer-constellation i:nth-child(3){left:25%;top:18%}.footer-constellation i:nth-child(4){left:34%;top:33%}.footer-constellation i:nth-child(5){left:43%;top:15%}.footer-constellation:before,.footer-constellation:after{content:\"\";position:absolute;height:1px;background:linear-gradient(90deg,transparent,rgba(255,216,122,.16),transparent);transform-origin:left center}.footer-constellation:before{width:190px;left:9%;top:29%;transform:rotate(-3deg)}.footer-constellation:after{width:155px;left:25%;top:24%;transform:rotate(7deg)}\n@media(max-width:800px){.compare-desktop{display:none}.compare-mobile{display:grid}}\n@media(max-width:760px){.nav-inner{min-height:68px;gap:10px}.brand-mark{width:46px;height:46px;flex-basis:46px}.brand-title{font-size:13px}.brand-text small{display:none}.page-chip{display:none}.icon-btn{width:44px;min-width:44px;padding:0}.icon-btn span:last-child{display:none}.nav-actions .print{display:none}.footer-main{align-items:flex-start;flex-direction:column}.footer-actions{justify-content:flex-start}.footer-meta{flex-direction:column}.footer-card{padding:19px}.footer-title{font-size:14px}}\n@media(max-width:350px){.brand-fa{display:none}.brand-divider{display:none}.brand-title{font-size:13px}.nav-inner{gap:7px}}\n\n</style>\n\n<style data-aris-reader-integration>\n  html{scroll-padding-top:18px}\n  body{min-height:100vh}\n  .hero{padding-top:42px}\n  .hero-grid{align-items:start}\n  .section:first-of-type{padding-top:26px}\n  @media(max-width:640px){.hero{padding-top:30px}}\n</style>\n</head>\n<body>\n<div class=\"starfield\" aria-hidden=\"true\"><i class=\"star hot\" style=\"--x:42.56%;--y:24.54%;--s:1.1px;--d:4.28s;--delay:-4.42s;--o:0.38\"></i><i class=\"star\" style=\"--x:41.54%;--y:53.68%;--s:1.8px;--d:4.01s;--delay:-2.03s;--o:0.41\"></i><i class=\"star\" style=\"--x:74.62%;--y:13.81%;--s:0.9px;--d:7.03s;--delay:-5.79s;--o:0.33\"></i><i class=\"star\" style=\"--x:21.37%;--y:1.03%;--s:2.1px;--d:4.15s;--delay:-0.89s;--o:0.58\"></i><i class=\"star\" style=\"--x:95.85%;--y:50.08%;--s:0.9px;--d:5.68s;--delay:-1.45s;--o:0.64\"></i><i class=\"star\" style=\"--x:69.31%;--y:44.59%;--s:1.8px;--d:6.48s;--delay:-5.47s;--o:0.51\"></i><i class=\"star\" style=\"--x:76.28%;--y:70.93%;--s:1.8px;--d:5.47s;--delay:-4.87s;--o:0.57\"></i><i class=\"star hot\" style=\"--x:25.44%;--y:73.4%;--s:1.1px;--d:4.21s;--delay:-2.83s;--o:0.65\"></i><i class=\"star\" style=\"--x:53.31%;--y:57.79%;--s:2.1px;--d:3.95s;--delay:-3.19s;--o:0.41\"></i><i class=\"star\" style=\"--x:40.03%;--y:40.0%;--s:0.9px;--d:5.53s;--delay:-2.56s;--o:0.5\"></i><i class=\"star\" style=\"--x:74.22%;--y:54.87%;--s:1.1px;--d:4.56s;--delay:-0.81s;--o:0.46\"></i><i class=\"star\" style=\"--x:89.34%;--y:41.37%;--s:2.1px;--d:6.27s;--delay:-5.72s;--o:0.55\"></i><i class=\"star\" style=\"--x:62.23%;--y:41.16%;--s:0.9px;--d:3.83s;--delay:-5.63s;--o:0.68\"></i><i class=\"star\" style=\"--x:14.53%;--y:7.14%;--s:1.1px;--d:3.8s;--delay:-2.51s;--o:0.63\"></i><i class=\"star hot\" style=\"--x:30.27%;--y:69.5%;--s:1.8px;--d:4.94s;--delay:-2.01s;--o:0.28\"></i><i class=\"star\" style=\"--x:30.76%;--y:96.73%;--s:1.1px;--d:4.87s;--delay:-1.71s;--o:0.49\"></i><i class=\"star\" style=\"--x:57.74%;--y:13.01%;--s:1.4px;--d:6.89s;--delay:-2.92s;--o:0.35\"></i><i class=\"star\" style=\"--x:29.08%;--y:15.04%;--s:2.1px;--d:5.36s;--delay:-5.94s;--o:0.32\"></i><i class=\"star\" style=\"--x:61.34%;--y:7.6%;--s:0.9px;--d:5.75s;--delay:-0.45s;--o:0.52\"></i><i class=\"star\" style=\"--x:79.52%;--y:44.2%;--s:1.8px;--d:6.95s;--delay:-2.47s;--o:0.35\"></i><i class=\"star\" style=\"--x:37.26%;--y:23.26%;--s:1.8px;--d:6.99s;--delay:-3.5s;--o:0.69\"></i><i class=\"star hot\" style=\"--x:48.58%;--y:23.7%;--s:2.1px;--d:7.11s;--delay:-1.6s;--o:0.58\"></i><i class=\"star\" style=\"--x:73.75%;--y:78.72%;--s:2.1px;--d:6.83s;--delay:-5.3s;--o:0.52\"></i><i class=\"star\" style=\"--x:8.88%;--y:74.97%;--s:1.8px;--d:3.9s;--delay:-4.09s;--o:0.3\"></i></div>\n<main id=\"contentStart\" tabindex=\"-1\">\n<section class=\"hero\">\n  <div class=\"container hero-grid\">\n    <div class=\"reveal\">\n      <span class=\"eyebrow\"><i></i> یک قانون مهم در چینش انتخاب‌ها</span>\n      <h1>بومی‌گزینی؛<br><span class=\"gradient\">اولویت مکانی، نه تضمین قبولی</span></h1>\n      <p>بومی‌گزینی یعنی در بعضی کدرشته‌محل‌ها، بخشی از ظرفیت برای داوطلبان بومی همان <strong>استان، ناحیه یا قطب</strong> در نظر گرفته می‌شود. بومی بودن می‌تواند مزیت نسبی ایجاد کند؛ اما <strong>رتبه در سهمیه، ظرفیت، سهمیه‌های مؤثر و رقابت</strong> همچنان تعیین‌کننده‌اند.</p>\n      <div class=\"hero-cta\"><a class=\"btn primary\" href=\"#nativeProvinceRule\">بومی من کجاست؟</a><a class=\"btn secondary\" href=\"#types\">۴ نوع گزینش</a></div>\n    </div>\n    <aside class=\"scope-card reveal\" aria-labelledby=\"scopeTitle\">\n      <div class=\"scope-head\"><span>نقشه ذهنی بومی‌گزینی</span><span class=\"version-pill\">مرجع تقسیم‌بندی ۱۴۰۴</span></div>\n      <h2 id=\"scopeTitle\">از استان تا کل کشور</h2>\n      <p><span class=\"interaction-copy\">هرچه دایره بزرگ‌تر می‌شود، دامنه بومی وسیع‌تر است. از دکمه‌های زیر، سطح موردنظر را انتخاب کن.</span><span class=\"fallback-copy\">هرچه دامنه از استان به ناحیه، قطب و کشور گسترش پیدا می‌کند، محدوده جغرافیایی گزینش وسیع‌تر می‌شود.</span></p>\n      <div class=\"scope-visual interactive-only\" id=\"scopeVisual\" aria-hidden=\"true\">\n        <div class=\"scope-ring\" data-scope=\"national\"><span>کشور</span></div