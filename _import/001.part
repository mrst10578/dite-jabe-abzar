h:768px){.compare-grid{grid-template-columns:1fr}.resume-badge{bottom:84px;left:10px;right:10px;justify-content:center}}\n    @media(max-width:900px){.logo-stage{margin-bottom:58px}.orbit-labels{position:absolute;z-index:6;right:-7%;left:-7%;bottom:-54px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.orbit-label.l1,.orbit-label.l2,.orbit-label.l3{position:relative;inset:auto;display:flex;align-items:center;justify-content:center;min-width:0;width:100%;transform:none;padding:7px 6px;text-align:center}.orbit-label:after{display:none}}\n    @media(max-width:390px){.orbit-labels{right:-10%;left:-10%;gap:8px}.orbit-label{font-size:.62rem!important;padding:6px 4px!important}}\n    @media(max-width:560px){.term-favorite{width:32px;height:32px}.compare-section{padding:22px 16px}.compare-head{display:block}.compare-head p{margin-top:3px}.compare-card{grid-template-columns:1fr}.compare-vs{width:auto;height:22px;border-radius:7px}.related-links{display:grid}.related-link{justify-content:center}}\n    @media(max-width:390px){.hero h1{font-size:1.9rem}.brand-banner{width:61vw}.channel-link{padding:7px}.layout{padding:0 9px}.term-head{gap:7px}.term-actions{gap:4px}.term-link,.term-favorite{width:29px;height:29px}.term-chevron{width:25px;height:25px}.mobile-bar{right:6px;left:6px;bottom:6px}.compare-card{padding:12px}}\n    @media(min-width:1440px){.layout{max-width:1260px}.hero-inner,.brandbar{max-width:1240px}.section{padding:34px}.term h3{font-size:1.11rem}}\n    @media print{.compare-section{break-inside:avoid}.term-favorite,.related-box,.resume-badge{display:none!important}}\n  \n\nhtml{scroll-padding-top:22px;background:#070806;color-scheme:dark}body{min-width:0;margin:0;background:radial-gradient(circle at 50% -10%,rgba(229,182,62,.09),transparent 28rem),linear-gradient(180deg,#090a08,#050605)!important;color:#f5f0e5!important;font-family:\"Vazirmatn\",Tahoma,\"Segoe UI\",sans-serif!important;overflow-x:hidden}\nbody:before,.progress,.share-section,.footer{display:none!important}.aris-article-shell{width:min(100%,1020px);margin:0 auto;padding:clamp(14px,3.5vw,34px)}\n.aris-article-tools{position:relative;margin:0 0 16px;padding:16px;border:1px solid rgba(229,182,62,.26);border-radius:18px;background:linear-gradient(145deg,rgba(25,25,20,.96),rgba(14,15,12,.98));box-shadow:0 18px 50px rgba(0,0,0,.26)}\n.aris-article-tools__row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:start}.aris-article-search{position:relative}.aris-article-search__field{position:relative}.aris-article-search input{width:100%;height:46px;padding:0 14px 0 88px;border:1px solid rgba(229,182,62,.2);border-radius:12px;background:#090a08;color:#fff8e7;outline:0;font-size:15px}.aris-article-search input:focus{border-color:#e5b63e;box-shadow:0 0 0 4px rgba(229,182,62,.11)}.aris-article-search__submit{position:absolute;inset:5px auto 5px 5px;min-width:76px;border:0;border-radius:9px;background:linear-gradient(145deg,#f2ca64,#bd8720);color:#171108;font-weight:800;cursor:pointer}.aris-article-search__meta{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:29px;margin-top:5px}.aris-article-search-status{color:#aaa292;font-size:11px}.aris-article-search-nav{display:flex;gap:4px}.aris-article-search-nav[hidden]{display:none}.aris-article-search-nav button{min-width:34px;height:28px;border:1px solid rgba(229,182,62,.2);border-radius:8px;background:rgba(229,182,62,.06);color:#e7c873;cursor:pointer}.aris-search-hit{padding:0 2px;border-radius:4px;background:#80651d;color:#fff8dc}.aris-search-hit.is-current{background:#ffd66d;color:#171108;box-shadow:0 0 0 3px rgba(255,214,109,.18)}\n.aris-toc{min-width:170px}.aris-toc summary{min-height:46px;display:flex;align-items:center;justify-content:center;padding:8px 14px;border:1px solid rgba(143,164,115,.28);border-radius:12px;color:#c8d9aa;background:rgba(102,115,74,.08);cursor:pointer;font-size:13px}.aris-toc[open] summary{border-radius:12px 12px 0 0}.aris-toc__list{display:grid;gap:3px;max-height:280px;overflow:auto;margin:0;padding:10px;border:1px solid rgba(143,164,115,.24);border-top:0;border-radius:0 0 12px 12px;background:#0b0d0a;list-style:none}.aris-toc__list a{display:block;padding:8px 9px;border-radius:8px;color:#d7d0c1;text-decoration:none;font-size:12px;line-height:1.7}.aris-toc__list a:hover{color:#ffe09a;background:rgba(229,182,62,.07)}\n.aris-validity{display:flex;align-items:flex-start;gap:10px;margin-top:12px;padding:12px 13px;border:1px solid rgba(229,182,62,.22);border-radius:12px;background:rgba(229,182,62,.055);color:#d8cfbc;font-size:12px;line-height:1.9}.aris-validity b{flex:0 0 auto;color:#f0c65d}.aris-validity--stable{border-color:rgba(143,164,115,.23);background:rgba(102,115,74,.06)}.aris-validity--stable b{color:#b7c995}\n#mainContent{display:block!important;width:100%!important;max-width:none!important;margin:0!important;padding:0!important;color:#f5f0e5!important}#mainContent,#mainContent button,#mainContent input,#mainContent select,#mainContent textarea,#mainContent a{font-family:\"Vazirmatn\",Tahoma,\"Segoe UI\",sans-serif!important}\n#mainContent>.intro:first-child{margin-top:0!important}#mainContent .intro,#mainContent .section,#mainContent .compare-section{border:1px solid rgba(229,182,62,.2)!important;border-radius:20px!important;background:linear-gradient(145deg,rgba(21,22,18,.98),rgba(13,14,12,.99))!important;box-shadow:0 16px 44px rgba(0,0,0,.22)!important}\n#mainContent .term,#mainContent .mistake,#mainContent .principle,#mainContent .professor-card,#mainContent .benefit-card,#mainContent .compare-card,#mainContent .compare-side,#mainContent .research-box,#mainContent .summary-row,#mainContent .mini-compare>div,#mainContent .map-card{border-color:rgba(143,164,115,.22)!important;background:rgba(102,115,74,.055)!important;color:#f1ecdf!important;box-shadow:none!important}\n#mainContent .term{padding:20px 30px 20px 20px!important}\n#mainContent .section-intro,#mainContent .topic-note,#mainContent .editorial-note,#mainContent .example{border-color:rgba(229,182,62,.2)!important;background:rgba(229,182,62,.055)!important;color:#e1d9c9!important}\n#mainContent .visual-summary,#mainContent .final-note,#mainContent .formula-box,#mainContent .subgroup-label{background:linear-gradient(145deg,#172017,#0d120e)!important;border:1px solid rgba(143,164,115,.24)!important;color:#f5f0e5!important}\n#mainContent h2,#mainContent h3,#mainContent h4,#mainContent b,#mainContent strong{color:#edc96f!important}#mainContent p,#mainContent li,#mainContent small,#mainContent .university,#mainContent .section-kicker,#mainContent .intro-kicker{color:#ddd6c9!important}#mainContent p,#mainContent li{font-size:clamp(17px,2.1vw,19px)!important;line-height:2.05!important}#mainContent h2{font-size:clamp(24px,4vw,33px)!important;line-height:1.55!important}#mainContent h3{font-size:clamp(19px,3vw,23px)!important;line-height:1.7!important}\n#mainContent .section-head{border-bottom-color:rgba(229,182,62,.18)!important}#mainContent .section-no,#mainContent .intro-badge,#mainContent .num{color:#f3cf75!important}#mainContent .section-no{background:#26321f!important}#mainContent a{color:#e7c46c!important}#mainContent [id]{scroll-margin-top:18px}\n.aris-related{margin:24px 0 10px;padding:20px;border:1px solid rgba(143,164,115,.25);border-radius:20px;background:linear-gradient(145deg,rgba(20,24,18,.97),rgba(12,14,11,.99))}.aris-related__eyebrow{margin:0;color:#9eb183;font-size:12px}.aris-related h2{margin:5px 0 15px;color:#f0cb72;font-size:22px}.aris-related__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.aris-related button{padding:14px;border:1px solid rgba(229,182,62,.18);border-radius:13px;background:rgba(229,182,62,.04);color:#f4eee1;text-align:right;cursor:pointer;font-size:14px;line-height:1.8}.aris-related button:hover{border-color:rgba(229,182,62,.5);background:rgba(229,182,62,.08)}\n@media(max-width:620px){.aris-article-shell{padding:10px}.aris-article-tools{padding:12px;border-radius:15px}.aris-article-tools__row{grid-template-columns:1fr}.aris-toc{min-width:0}.aris-related__grid{grid-template-columns:1fr}#mainContent .intro,#mainContent .section,#mainContent .compare-section{padding:20px 15px!important;border-radius:16px!important}#mainContent .term{padding:18px 25px 18px 17px!important}#mainContent p,#mainContent li{font-size:17px!important;line-height:2!important}}\n\n.aris-source-standard{margin:24px 0 4px;padding:18px 20px;border:1px solid rgba(30,84,64,.16);border-radius:17px;background:linear-gradient(145deg,#f4f8f5,#fffaf0);box-shadow:0 10px 28px rgba(18,55,42,.05)}\n.aris-source-standard h2{margin:0 0 8px!important;color:#173d2e!important;font-size:1.02rem!important}.aris-source-standard p{margin:5px 0!important;color:#5d6b64;font-size:.86rem;line-height:1.9}.aris-source-meta{display:flex;flex-wrap:wrap;gap:7px;margin:10px 0 12px}.aris-source-meta span{padding:5px 9px;border-radius:8px;background:#123b2b;color:#f5d16b;font-size:.72rem}.aris-source-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.aris-source-links a{display:inline-flex;align-items:center;gap:5px;padding:7px 10px;border:1px solid rgba(28,88,65,.16);border-radius:9px;background:#fff;color:#1c5841;text-decoration:none;font-size:.78rem}.aris-source-links a:hover{border-color:#c89b33;color:#8a6414}.aris-source-warning{margin-top:12px!important;padding:10px 12px;border-right:3px solid #d2a432;border-radius:10px;background:#fff7df!important;color:#5f542f!important}\n\n</style><style>\n.professor-verification-notice{margin:18px 0 2px;padding:16px 18px;border:1px solid rgba(196,143,29,.22);border-radius:15px;background:linear-gradient(145deg,#fff8e8,#fffdf7)}\n.professor-verification-notice strong{display:block;color:#8b5f12;margin-bottom:5px}\n.professor-verification-notice p{margin:0;color:#5d594d;line-height:1.95}\n.university-label{display:inline-flex;margin-left:7px;padding:2px 7px;border-radius:7px;background:#edf5f0;color:#2f6a50;font-size:.72rem;font-weight:700}\n.professor-source-row{display:flex;flex-wrap:wrap;align-items:center;gap:7px 9px;margin-top:13px;padding-top:12px;border-top:1px solid rgba(28,88,65,.1)}\n.professor-source-link{display:inline-flex;align-items:center;min-height:34px;padding:6px 10px;border-radius:9px;text-decoration:none;font-size:.76rem;font-weight:700;transition:.2s}\n.professor-source-link.official{background:#133c2c;color:#fff}\n.professor-source-link.verify{border:1px solid rgba(21,80,58,.18);background:#f4f8f5;color:#18513a}\n.professor-source-link:hover{transform:translateY(-1px)}\n.professor-source-domain{margin-inline-start:auto;color:#7b867f;font-size:.68rem}\n.professor-methodology{margin:15px 0;padding:15px 17px;border-radius:14px;background:#f4f8f5;border:1px solid rgba(28,88,65,.12)}\n.professor-methodology strong{display:block;color:#174a35;margin-bottom:6px}\n.professor-methodology ul{grid-template-columns:1fr!important;margin:8px 0 0!important}\n.professor-institution-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:12px}\n.professor-institution-grid a{display:flex;flex-direction:column;gap:2px;padding:10px 12px;border:1px solid rgba(28,88,65,.12);border-radius:11px;background:#fff;color:#174a35;text-decoration:none;font-size:.8rem}\n.professor-institution-grid small{color:#7c8b83;font-size:.66rem}\n@media(max-width:700px){\n  .professor-source-row{display:grid;grid-template-columns:1fr}\n  .professor-source-domain{margin:0}\n  .professor-institution-grid{grid-template-columns:1fr}\n}\n</style><style>.directory-usage-note{margin:18px 0;padding:16px 18px;border-radius:15px;background:linear-gradient(135deg,#0d2d20,#174a35);color:#fff;border:1px solid rgba(224,169,47,.28)}.directory-usage-note strong{display:block;color:#f3c95d;margin-bottom:4px}.directory-usage-note p{margin:0;color:#dbe7e0;line-height:1.95}</style><style data-aris-reader-refinement=\"17\">\n/* Shell 17: compact collapsible in-article search + softer highlight card. */\n.aris-search-disclosure{\n  width:100%;\n  min-height:42px;\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:10px;\n  padding:8px 12px;\n  border:1px solid rgba(224,169,47,.18);\n  border-radius:11px;\n  background:rgba(224,169,47,.04);\n  color:#d9bd83;\n  cursor:pointer;\n  font:inherit;\n  font-size:.8rem;\n  font-weight:700;\n}\n.aris-search-disclosure::after{\n  content:\"⌕\";\n  color:#e0a92f;\n  font-size:1rem;\n}\n.aris-search-disclosure[aria-expanded=\"true\"]{\n  border-color:rgba(224,169,47,.34);\n  background:rgba(224,169,47,.075);\n}\n.aris-search-disclosure[aria-expanded=\"true\"]::after{\n  content:\"×\";\n}\n.aris-search-disclosure + .aris-article-search{\n  margin-top:10px;\n}\n.aris-article-search[hidden]{\n  display:none!important;\n}\n.aris-article-tools__row{\n  gap:9px!important;\n}\n.aris-validity{\n  padding:10px 12px!important;\n  border-color:rgba(224,169,47,.13)!important;\n  background:rgba(224,169,47,.025)!important;\n}\n.aris-validity b{\n  font-size:.75rem!important;\n}\n.aris-validity span{\n  font-size:.76rem!important;\n  line-height:1.85!important;\n}\n.intro-badge{\n  border-color:#cbb37b!important;\n  background:radial-gradient(circle at 50% 34%,#eee0bb,#d8c59b)!important;\n}\n.intro-badge b{\n  color:#153c2b!important;\n}\n.intro-badge span{\n  color:#735d2d!important;\n}\n@media(max-width:560px){\n  .aris-search-disclosure{\n    min-height:40px;\n    padding:7px 10px;\n    font-size:.76rem;\n  }\n  .aris-validity{\n    padding:9px 10px!important;\n  }\n}\n</style></head><body><h1 class=\"aris-doc-title-sr\" style=\"position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0\">دایرکتوری ۲۰۰ استاد و پژوهشگر شاخص ایران</h1><div class=\"aris-article-shell\"><aside aria-label=\"ابزارهای مطالعه\" class=\"aris-article-tools\"><div class=\"aris-article-tools__row\"><button aria-controls=\"aris-article-search-form\" aria-expanded=\"false\" class=\"aris-search-disclosure\" type=\"button\">جست‌وجو داخل همین مطلب</button><form class=\"aris-article-search\" hidden=\"\" id=\"aris-article-search-form\" role=\"search\"><div class=\"aris-article-search__field\"><input aria-label=\"جست‌وجو داخل مطلب\" autocomplete=\"off\" id=\"aris-article-search-input\" placeholder=\"جست‌وجو داخل همین مطلب…\" type=\"search\"/><button class=\"aris-article-search__submit\" type=\"submit\">پیدا کن</button></div><div class=\"aris-article-search__meta\"><span aria-live=\"polite\" class=\"aris-article-search-status\" id=\"aris-article-search-status\"></span><span class=\"aris-article-search-nav\" hidden=\"\" id=\"aris-article-search-nav\"><button aria-label=\"نتیجه قبلی\" id=\"aris-search-prev\" type=\"button\">↑</button><button aria-label=\"نتیجه بعدی\" id=\"aris-search-next\" type=\"button\">↓</button></span></div></form><details class=\"aris-toc\"><summary>در این راهنما</summary><ol class=\"aris-toc__list\"><li><a href=\"#aris-article-section-1\">این فهرست چه کمکی به انتخاب مسیر تو می‌کند؟</a></li><li><a href=\"#aris-article-section-2\">پزشکی، سلامت عمومی و علوم وابسته</a></li><li><a href=\"#aris-article-section-3\">داروسازی، زیست‌فناوری و زیست‌پزشکی</a></li><li><a href=\"#aris-article-section-4\">پرستاری و علوم مراقبتی</a></li><li><a href=\"#aris-article-section-5\">مهندسی عمران، معدن و محیط‌زیست</a></li><li><a href=\"#aris-article-section-6\">مهندسی مکانیک و انرژی</a></li><li><a href=\"#aris-article-section-7\">مهندسی برق و قدرت</a></li><li><a href=\"#aris-article-section-8\">کامپیوتر، هوش مصنوعی و مهندسی صنایع</a></li><li><a href=\"#aris-article-section-9\">شیمی، مواد و نانوفناوری</a></li><li><a href=\"#aris-article-section-10\">ریاضی و فیزیک</a></li><li><a href=\"#aris-article-section-11\">مدیریت، اقتصاد و حسابداری</a></li><li><a href=\"#aris-article-section-12\">روان‌شناسی و علوم تربیتی</a></li><li><a href=\"#aris-article-section-13\">حقوق، علوم سیاسی و ارتباطات</a></li><li><a href=\"#aris-article-section-14\">زبان، ادبیات، تاریخ و فلسفه</a></li><li><a href=\"#aris-article-section-15\">علوم اجتماعی، جغرافیا، شهر و جمعیت</a></li><li><a href=\"#aris-article-section-16\">معماری، شهرسازی و هنر</a></li><li><a href=\"#aris-article-section-17\">کشاورزی، صنایع غذایی، تغذیه و شیلات</a></li><li><a href=\"#aris-article-section-18\">علوم ورزشی</a></li></ol></details></div><div class=\"aris-validity\"><b>اطلاعات متغیر</b><span>وابستگی دانشگاهی و وضعیت فعالیت استادان ممکن است تغییر کند؛ پیش از تصمیم، صفحه رسمی دانشگاه یا استاد را بررسی کن.</span></div></aside><main id=\"mainContent\">\n<section class=\"intro professor-intro\" id=\"why\">\n<div class=\"intro-grid\">\n<div><span class=\"intro-kicker\">قبل از شروع</span><h2 id=\"aris-article-section-1\">این فهرست چه کمکی به انتخاب مسیر تو می‌کند؟</h2><p>شناخت استادان و حوزه کاری‌شان، نقشه‌ای از مسیرهای واقعی دانشگاه و پژوهش پیش روی تو می‌گذارد.</p><div class=\"directory-usage-note\"><strong>این صفحه را از اول تا آخر نخوان.</strong><p>این یک دایرکتوری مرجع است، نه مقاله خطی. اول حوزه‌ای را که برایت سؤال ایجاد کرده پیدا کن، چند نفر را در همان بخش ببین، سپس وابستگی و فعالیت روز آن‌ها را با لینک‌های رسمی همان کارت بررسی کن.</p></div></div>\n<div class=\"intro-badge\"><b>۲۰۰</b><span>استاد در ۱۷ حوزه</span></div>\n</div>\n<div class=\"benefit-grid\"><article class=\"benefit-card\"><span>۱</span><h3>کشف شاخه‌های واقعی</h3><p>با مسیرهایی فراتر از عنوان‌های کلی رشته‌ها آشنا شو؛ از آمار زیستی و سلامت عمومی تا دارورسانی، هوش مصنوعی و شهرسازی.</p></article><article class=\"benefit-card\"><span>۲</span><h3>شناخت علایق خودت</h3><p>مقایسه حوزه‌ها کمک می‌کند بفهم به درمان، آزمایشگاه، تحلیل داده، طراحی، سیاست‌گذاری یا ارتباط مستقیم با مردم نزدیک‌تری.</p></article><article class=\"benefit-card\"><span>۳</span><h3>مقایسه دانشگاه‌ها</h3><p>حضور چند پژوهشگر فعال در یک موضوع می‌تواند سرنخی برای شناخت گروه علمی، آزمایشگاه و شبکه پژوهشی آن دانشگاه باشد.</p></article><article class=\"benefit-card\"><span>۴</span><h3>برنامه‌ریزی تحصیلی</h3><p>مسیرهای کارشناسی ارشد، دکتری، تخصص، موضوع پژوهش و مهارت‌هایی را که بعداً به آن‌ها نیاز داری زودتر کشف کن.</p></article><article class=\"benefit-card\"><span>۵</span><h3>پیداکردن استاد و آزمایشگاه</h3><p>نام‌ها نقطه شروعی برای جست‌وجوی استاد راهنما، آزمایشگاه، فرصت همکاری پژوهشی، کارآموزی و پایان‌نامه هستند.</p></article><article class=\"benefit-card\"><span>۶</span><h3>انتخاب رشته واقع‌بینانه‌تر</h3><p>اگر عنوانی را دوست داری اما با شیوه کار رایج آن راحت نیستی، شاخه‌های نزدیک و مناسب‌تر را پیدا کن.</p></article><article class=\"benefit-card\"><span>۷</span><h3>آماده‌شدن برای تحقیق بیشتر</h3><p>با جست‌وجوی نام هر استاد می‌توانی مقاله‌ها، پروژه‌ها، آزمایشگاه و مسیر دانشجویان آن حوزه را دقیق‌تر بررسی کن.</p></article></div>\n<div class=\"editorial-note\"><b>نکته مهم</b><p>شهرت یا تعداد مقالات یک استاد به‌تنهایی دلیل انتخاب رشته یا دانشگاه نیست. از این معرفی‌ها برای کشف مسیرها و محدودکردن انتخاب‌ها استفاده کن و تصمیم نهایی را با بررسی سرفصل دروس، بازار کار، علاقه و توانایی شخصی، شرایط دانشگاه و وضعیت فعلی استاد بگیر.</p></div>\n</section><section class=\"section\" id=\"selection-criteria\"><h2>این فهرست رتبه‌بندی نیست</h2><p>واژه «شاخص» در این راهنما به معنی رتبه اول، بهترین استاد کشور یا برتری قطعی نسبت به دیگران نیست. هدف، ساختن یک نقشه متنوع از حوزه‌های علمی است تا داوطلب بتواند شاخه‌ها، دانشگاه‌ها و مسیرهای پژوهشی را کشف کند.</p><div class=\"terms\"><article class=\"term\"><h3>معیار ورود به فهرست</h3><p>داشتن حوزه تخصصی روشن، وابستگی دانشگاهی یا پژوهشی قابل بررسی و امکان استفاده از نام فرد به‌عنوان نقطه شروع برای شناخت یک مسیر علمی. ترتیب اسامی هیچ معنای رتبه‌بندی ندارد.</p></article><article class=\"term\"><h3>چطور هر نام را بررسی کن؟</h3><p>حوزه تخصصی نوشته‌شده کنار هر فرد را نقطه شروع بگیر؛ سپس صفحه رسمی دانشگاه، گروه آموزشی، آزمایشگاه یا پروفایل علمی به‌روز او را بررسی کن. اگر وابستگی دانشگاهی تغییر کرده باشد، مرجع رسمی روز اولویت دارد.</p></article><article class=\"term\"><h3>چه چیزی از این فهرست نتیجه نگیرید؟</h3><p>حضور یک استاد به‌تنهایی کیفیت کل دانشگاه، تضمین دسترسی دانشجوی کارشناسی به او، شانس پذیرش، بازار کار یا مناسب‌بودن رشته برای تو را ثابت نمی‌کند.</p></article></div><div class=\"professor-verification-notice\">\n<strong>قاعده اعتبارسنجی آریس</strong>\n<p>وابستگی دانشگاهیِ نوشته‌شده در هر کارت برای آشنایی اولیه است و ممکن است با گذر زمان تغییر کند. برای هر نام، دو مسیر گذاشته شده: ورود به وب‌سایت رسمی نهاد و جست‌وجوی همان نام فقط در دامنه رسمی آن نهاد. اگر نام یا وابستگی را در منبع رسمی پیدا نکردی، آن را قطعی فرض نکن.</p>\n</div></section>\n<section class=\"section searchable-section\" data-icon=\"karname\" id=\"medicine\">\n<div class=\"section-head\"><div class=\"section-no\">۱</div><div><span class=\"section-kicker\">حوزه تخصصی</span><h2 id=\"aris-article-section-2\">پزشکی، سلامت عمومی و علوم وابسته</h2></div></div>\n<div class=\"terms\"><article class=\"term professor-card\" id=\"term-1\">\n<h3><span class=\"num\">۱.</span> انوشیروان کاظم‌نژاد</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تربیت مدرس</p>\n<p>پژوهشگر آمار زیستی با تمرکز بر طراحی مطالعات پزشکی و تحلیل داده‌های سلامت است. این مسیر برای علاقه‌مندان به ریاضی، احتمال، برنامه‌نویسی و تبدیل داده به تصمیم‌های پزشکی مناسب است.</p>\n<div aria-label=\"منابع راستی‌آزمایی انوشیروان کاظم‌نژاد\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://modares.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amodares.ac.ir+%22%D8%A7%D9%86%D9%88%D8%B4%DB%8C%D8%B1%D9%88%D8%A7%D9%86+%DA%A9%D8%A7%D8%B8%D9%85%E2%80%8C%D9%86%DA%98%D8%A7%D8%AF%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">modares.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-2\">\n<h3><span class=\"num\">۲.</span> رویا کلیشادی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی اصفهان</p>\n<p>در پزشکی کودکان و پیشگیری از بیماری‌های غیرواگیر کودکان فعالیت دارد. این مسیر برای افراد صبور و علاقه‌مند به سلامت کودکان، پیشگیری و ارتباط با بیمار مناسب است.</p>\n<div aria-label=\"منابع راستی‌آزمایی رویا کلیشادی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://mui.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amui.ac.ir+%22%D8%B1%D9%88%DB%8C%D8%A7+%DA%A9%D9%84%DB%8C%D8%B4%D8%A7%D8%AF%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">mui.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-3\">\n<h3><span class=\"num\">۳.</span> نزیلا صراف‌زادگان</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی اصفهان</p>\n<p>پژوهشگر قلب و پیشگیری با تمرکز بر بیماری‌های قلبی‌عروقی در سطح جامعه است. حوزه او به پزشکی پیشگیری، اپیدمیولوژی و سلامت عمومی نزدیک است.</p>\n<div aria-label=\"منابع راستی‌آزمایی نزیلا صراف‌زادگان\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://mui.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amui.ac.ir+%22%D9%86%D8%B2%DB%8C%D9%84%D8%A7+%D8%B5%D8%B1%D8%A7%D9%81%E2%80%8C%D8%B2%D8%A7%D8%AF%DA%AF%D8%A7%D9%86%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">mui.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-4\">\n<h3><span class=\"num\">۴.</span> مصطفی قربانی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی البرز</p>\n<p>در اپیدمیولوژی و سلامت قلبی‌متابولیک کودکان فعالیت دارد. برای علاقه‌مندان به آمار، سلامت کودکان، پیشگیری و تحلیل داده‌های پزشکی مناسب است.</p>\n<div aria-label=\"منابع راستی‌آزمایی مصطفی قربانی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://abzums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Aabzums.ac.ir+%22%D9%85%D8%B5%D8%B7%D9%81%DB%8C+%D9%82%D8%B1%D8%A8%D8%A7%D9%86%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">abzums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-5\">\n<h3><span class=\"num\">۵.</span> جلال عربلو</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی ایران</p>\n<p>پژوهشگر سلامت عمومی و سیاست‌گذاری سلامت با تمرکز بر ارزیابی فناوری‌ها و اقتصاد سلامت است. این حوزه اثربخشی و مقرون‌به‌صرفه‌بودن روش‌های درمانی را بررسی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی جلال عربلو\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://iums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Aiums.ac.ir+%22%D8%AC%D9%84%D8%A7%D9%84+%D8%B9%D8%B1%D8%A8%D9%84%D9%88%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">iums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-6\">\n<h3><span class=\"num\">۶.</span> مازیار مرادی‌لاکه</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی ایران</p>\n<p>در سلامت جهانی، عدالت در سلامت و سیاست‌گذاری فعالیت دارد. این مسیر برای علاقه‌مندان به سلامت عمومی، مسائل اجتماعی، آمار و سیاست‌گذاری مناسب است.</p>\n<div aria-label=\"منابع راستی‌آزمایی مازیار مرادی‌لاکه\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://iums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Aiums.ac.ir+%22%D9%85%D8%A7%D8%B2%DB%8C%D8%A7%D8%B1+%D9%85%D8%B1%D8%A7%D8%AF%DB%8C%E2%80%8C%D9%84%D8%A7%DA%A9%D9%87%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">iums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-7\">\n<h3><span class=\"num\">۷.</span> علی بیجانی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی بابل</p>\n<p>پژوهشگر اپیدمیولوژی با تمرکز بر سالمندی و مطالعات جمعیتی است. حوزه کاری او به سلامت سالمندان و تغییرات جمعیتی مربوط می‌شود.</p>\n<div aria-label=\"منابع راستی‌آزمایی علی بیجانی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://mubabol.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amubabol.ac.ir+%22%D8%B9%D9%84%DB%8C+%D8%A8%DB%8C%D8%AC%D8%A7%D9%86%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">mubabol.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-8\">\n<h3><span class=\"num\">۸.</span> محمد اصغری جعفرآبادی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تبریز</p>\n<p>در آمار زیستی، مدل‌سازی و روش‌های آماری سلامت فعالیت دارد. برای علاقه‌مندان به ریاضی، آمار، نرم‌افزارهای تحلیلی و پژوهش پزشکی مناسب است.</p>\n<div aria-label=\"منابع راستی‌آزمایی محمد اصغری جعفرآبادی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tbzmed.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atbzmed.ac.ir+%22%D9%85%D8%AD%D9%85%D8%AF+%D8%A7%D8%B5%D8%BA%D8%B1%DB%8C+%D8%AC%D8%B9%D9%81%D8%B1%D8%A2%D8%A8%D8%A7%D8%AF%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tbzmed.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-9\">\n<h3><span class=\"num\">۹.</span> باقر لاریجانی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تهران</p>\n<p>در غدد و بیماری‌های متابولیک با تمرکز بر دیابت، پوکی استخوان و اخلاق پزشکی فعالیت دارد. این مسیر پزشکی بالینی را با پژوهش و موضوعات اخلاقی ترکیب می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی باقر لاریجانی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atums.ac.ir+%22%D8%A8%D8%A7%D9%82%D8%B1+%D9%84%D8%A7%D8%B1%DB%8C%D8%AC%D8%A7%D9%86%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-10\">\n<h3><span class=\"num\">۱۰.</span> رضا ملک‌زاده</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تهران</p>\n<p>پژوهشگر بیماری‌های گوارشی، کبد و سرطان‌های دستگاه گوارش است. این حوزه ترکیبی از درمان بالینی و پژوهش درباره عوامل خطر بیماری‌هاست.</p>\n<div aria-label=\"منابع راستی‌آزمایی رضا ملک‌زاده\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atums.ac.ir+%22%D8%B1%D8%B6%D8%A7+%D9%85%D9%84%DA%A9%E2%80%8C%D8%B2%D8%A7%D8%AF%D9%87%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-11\">\n<h3><span class=\"num\">۱۱.</span> صدف سپانلو</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تهران</p>\n<p>در اپیدمیولوژی بیماری‌های گوارشی و بررسی بار بیماری‌ها فعالیت دارد. این زمینه میزان مرگ، ناتوانی و هزینه ناشی از بیماری‌ها را بررسی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی صدف سپانلو\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atums.ac.ir+%22%D8%B5%D8%AF%D9%81+%D8%B3%D9%BE%D8%A7%D9%86%D9%84%D9%88%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-12\">\n<h3><span class=\"num\">۱۲.</span> علیرضا استقامتی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تهران</p>\n<p>در غدد و متابولیسم با تمرکز بر دیابت و اختلالات متابولیک فعالیت دارد. این زمینه با تشخیص، درمان و پیگیری بیماران مزمن سروکار دارد.</p>\n<div aria-label=\"منابع راستی‌آزمایی علیرضا استقامتی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atums.ac.ir+%22%D8%B9%D9%84%DB%8C%D8%B1%D8%B6%D8%A7+%D8%A7%D8%B3%D8%AA%D9%82%D8%A7%D9%85%D8%AA%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-13\">\n<h3><span class=\"num\">۱۳.</span> فرشاد فرزادفر</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تهران</p>\n<p>پژوهشگر اپیدمیولوژی و سنجه‌های سلامت با تمرکز بر بار بیماری‌ها و بیماری‌های غیرواگیر است. نتایج این حوزه در برنامه‌ریزی نظام سلامت کاربرد دارد.</p>\n<div aria-label=\"منابع راستی‌آزمایی فرشاد فرزادفر\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atums.ac.ir+%22%D9%81%D8%B1%D8%B4%D8%A7%D8%AF+%D9%81%D8%B1%D8%B2%D8%A7%D8%AF%D9%81%D8%B1%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-14\">\n<h3><span class=\"num\">۱۴.</span> محمد عبداللهی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تهران</p>\n<p>در سم‌شناسی و داروشناسی با تمرکز بر ایمنی دارو، استرس اکسیداتیو و اثر مواد شیمیایی فعالیت دارد. این مسیر بیشتر آزمایشگاهی و پژوهشی است.</p>\n<div aria-label=\"منابع راستی‌آزمایی محمد عبداللهی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atums.ac.ir+%22%D9%85%D8%AD%D9%85%D8%AF+%D8%B9%D8%A8%D8%AF%D8%A7%D9%84%D9%84%D9%87%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-15\">\n<h3><span class=\"num\">۱۵.</span> محمدعلی منصورنیا</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تهران</p>\n<p>پژوهشگر اپیدمیولوژی و روش‌شناسی با تمرکز بر استنباط علّی و روش‌های آماری است. این حوزه رابطه واقعی علت و پیامدهای سلامتی را بررسی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی محمدعلی منصورنیا\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atums.ac.ir+%22%D9%85%D8%AD%D9%85%D8%AF%D8%B9%D9%84%DB%8C+%D9%85%D9%86%D8%B5%D9%88%D8%B1%D9%86%DB%8C%D8%A7%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-16\">\n<h3><span class=\"num\">۱۶.</span> وفا رحیمی‌موقر</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تهران</p>\n<p>در جراحی اعصاب و علوم اعصاب با تمرکز بر آسیب‌های نخاعی و پیامدهای عصبی فعالیت دارد. این زمینه ترکیبی از پزشکی بالینی، جراحی، توان‌بخشی و پژوهش است.</p>\n<div aria-label=\"منابع راستی‌آزمایی وفا رحیمی‌موقر\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atums.ac.ir+%22%D9%88%D9%81%D8%A7+%D8%B1%D8%AD%DB%8C%D9%85%DB%8C%E2%80%8C%D9%85%D9%88%D9%82%D8%B1%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-17\">\n<h3><span class=\"num\">۱۷.</span> محمود رفیعیان کوپایی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی شهرکرد</p>\n<p>در داروشناسی گیاهی، گیاهان دارویی و پزشکی مکمل فعالیت دارد. حوزه او اثرات درمانی و ایمنی ترکیبات طبیعی را به‌صورت علمی بررسی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی محمود رفیعیان کوپایی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://skums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Askums.ac.ir+%22%D9%85%D8%AD%D9%85%D9%88%D8%AF+%D8%B1%D9%81%DB%8C%D8%B9%DB%8C%D8%A7%D9%86+%DA%A9%D9%88%D9%BE%D8%A7%DB%8C%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">skums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-18\">\n<h3><span class=\"num\">۱۸.</span> فریدون عزیزی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی شهید بهشتی</p>\n<p>در غدد و متابولیسم با تمرکز بر تیروئید، دیابت و مطالعات جمعیتی فعالیت دارد. زمینه او پزشکی بالینی را با پژوهش‌های بزرگ جمعیتی ترکیب می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی فریدون عزیزی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://sbmu.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Asbmu.ac.ir+%22%D9%81%D8%B1%DB%8C%D8%AF%D9%88%D9%86+%D8%B9%D8%B2%DB%8C%D8%B2%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">sbmu.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-19\">\n<h3><span class=\"num\">۱۹.</span> محمدرضا زالی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی شهید بهشتی</p>\n<p>پژوهشگر و پزشک بیماری‌های گوارشی و کبد است. این تخصص با تشخیص و درمان بیماری‌های دستگاه گوارش و پژوهش‌های بالینی ارتباط دارد.</p>\n<div aria-label=\"منابع راستی‌آزمایی محمدرضا زالی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://sbmu.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Asbmu.ac.ir+%22%D9%85%D8%AD%D9%85%D8%AF%D8%B1%D8%B6%D8%A7+%D8%B2%D8%A7%D9%84%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">sbmu.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-20\">\n<h3><span class=\"num\">۲۰.</span> امیرحسین صاحبکار</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی مشهد</p>\n<p>در داروشناسی و سلامت عمومی با تمرکز بر التهاب و اختلالات متابولیک فعالیت دارد. این زمینه اثر داروها و ترکیبات مختلف بر بیماری‌های مزمن را بررسی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی امیرحسین صاحبکار\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://mums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amums.ac.ir+%22%D8%A7%D9%85%DB%8C%D8%B1%D8%AD%D8%B3%DB%8C%D9%86+%D8%B5%D8%A7%D8%AD%D8%A8%DA%A9%D8%A7%D8%B1%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">mums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-21\">\n<h3><span class=\"num\">۲۱.</span> حسین حسین‌زاده</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی مشهد</p>\n<p>پژوهشگر داروشناسی با تمرکز بر داروهای گیاهی و نوروفارماکولوژی است. حوزه او اثر داروها و ترکیبات طبیعی بر مغز و دستگاه عصبی را بررسی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی حسین حسین‌زاده\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://mums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amums.ac.ir+%22%D8%AD%D8%B3%DB%8C%D9%86+%D8%AD%D8%B3%DB%8C%D9%86%E2%80%8C%D8%B2%D8%A7%D8%AF%D9%87%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">mums.ac.ir</span></div></article></div>\n</section>\n<section class=\"section searchable-section\" data-icon=\"admission\" id=\"pharma\">\n<div class=\"section-head\"><div class=\"section-no\">۲</div><div><span class=\"section-kicker\">حوزه تخصصی</span><h2 id=\"aris-article-section-3\">داروسازی، زیست‌فناوری و زیست‌پزشکی</h2></div></div>\n<div class=\"terms\"><article class=\"term professor-card\" id=\"term-22\">\n<h3><span class=\"num\">۲۲.</span> حسین بهاروند</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> پژوهشگاه رویان</p>\n<p>در زیست‌شناسی سلول‌های بنیادی، تمایز سلولی و ارگانوئیدها فعالیت دارد. این حوزه از بخش‌های مهم پزشکی بازساختی و فناوری‌های سلولی است.</p>\n<div aria-label=\"منابع راستی‌آزمایی حسین بهاروند\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://www.royan.org/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Aroyan.org+%22%D8%AD%D8%B3%DB%8C%D9%86+%D8%A8%D9%87%D8%A7%D8%B1%D9%88%D9%86%D8%AF%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">royan.org</span></div></article>\n<article class=\"term professor-card\" id=\"term-23\">\n<h3><span class=\"num\">۲۳.</span> ایمان حلوایی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تربیت مدرس</p>\n<p>پژوهشگر جنین‌شناسی بالینی و آندرولوژی با تمرکز بر ناباروری و زیست‌شناسی تولیدمثل است. این مسیر به آزمایشگاه‌های جنین‌شناسی و مراکز درمان ناباروری نزدیک است.</p>\n<div aria-label=\"منابع راستی‌آزمایی ایمان حلوایی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://modares.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amodares.ac.ir+%22%D8%A7%DB%8C%D9%85%D8%A7%D9%86+%D8%AD%D9%84%D9%88%D8%A7%DB%8C%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">modares.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-24\">\n<h3><span class=\"num\">۲۴.</span> سامان حسین‌خانی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تربیت مدرس</p>\n<p>در زیست‌فناوری با تمرکز بر مهندسی پروتئین و زیست‌تابی فعالیت دارد. این زمینه از پروتئین‌ها و سامانه‌های زیستی برای طراحی ابزارهای پژوهشی و تشخیصی استفاده می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی سامان حسین‌خانی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://modares.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amodares.ac.ir+%22%D8%B3%D8%A7%D9%85%D8%A7%D9%86+%D8%AD%D8%B3%DB%8C%D9%86%E2%80%8C%D8%AE%D8%A7%D9%86%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">modares.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-25\">\n<h3><span class=\"num\">۲۵.</span> سیدعباس شجاع‌الساداتی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تربیت مدرس</p>\n<p>پژوهشگر نانوزیست‌فناوری با تمرکز بر تخمیر و فرایندهای زیستی است. حوزه او میان زیست‌شناسی، مهندسی و تولید صنعتی محصولات زیستی قرار دارد.</p>\n<div aria-label=\"منابع راستی‌آزمایی سیدعباس شجاع‌الساداتی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://modares.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amodares.ac.ir+%22%D8%B3%DB%8C%D8%AF%D8%B9%D8%A8%D8%A7%D8%B3+%D8%B4%D8%AC%D8%A7%D8%B9%E2%80%8C%D8%A7%D9%84%D8%B3%D8%A7%D8%AF%D8%A7%D8%AA%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">modares.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-26\">\n<h3><span class=\"num\">۲۶.</span> جمشیدخان چمنی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تهران</p>\n<p>در بیوفیزیک و بررسی برهم‌کنش و ساختار پروتئین‌ها فعالیت دارد. این رشته رفتار مولکول‌های زیستی را با مفاهیم فیزیک و شیمی مطالعه می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی جمشیدخان چمنی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://ut.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Aut.ac.ir+%22%D8%AC%D9%85%D8%B4%DB%8C%D8%AF%D8%AE%D8%A7%D9%86+%DA%86%D9%85%D9%86%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">ut.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-27\">\n<h3><span class=\"num\">۲۷.</span> علی‌اکبر موسوی موحدی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تهران</p>\n<p>پژوهشگر شیمی زیستی و بیوفیزیک با تمرکز بر ساختار و عملکرد پروتئین‌هاست. این مسیر میان شیمی، زیست‌شناسی مولکولی و فیزیک پیوند ایجاد می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی علی‌اکبر موسوی موحدی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://ut.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Aut.ac.ir+%22%D8%B9%D9%84%DB%8C%E2%80%8C%D8%A7%DA%A9%D8%A8%D8%B1+%D9%85%D9%88%D8%B3%D9%88%DB%8C+%D9%85%D9%88%D8%AD%D8%AF%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">ut.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-28\">\n<h3><span class=\"num\">۲۸.</span> بهزاد برادران</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تبریز</p>\n<p>در ایمنی‌شناسی پزشکی با تمرکز بر پاسخ ایمنی و روش‌های درمان سرطان فعالیت دارد. این زمینه نقش سیستم ایمنی در ایجاد یا کنترل بیماری‌ها را بررسی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی بهزاد برادران\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tbzmed.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atbzmed.ac.ir+%22%D8%A8%D9%87%D8%B2%D8%A7%D8%AF+%D8%A8%D8%B1%D8%A7%D8%AF%D8%B1%D8%A7%D9%86%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tbzmed.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-29\">\n<h3><span class=\"num\">۲۹.</span> حامد همیشه‌کار</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تبریز</p>\n<p>پژوهشگر داروسازی با تمرکز بر فرمولاسیون و سامانه‌های دارورسانی است. حوزه او به طراحی شکل مناسب دارو و رساندن مؤثر آن به بافت هدف مربوط می‌شود.</p>\n<div aria-label=\"منابع راستی‌آزمایی حامد همیشه‌کار\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tbzmed.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atbzmed.ac.ir+%22%D8%AD%D8%A7%D9%85%D8%AF+%D9%87%D9%85%DB%8C%D8%B4%D9%87%E2%80%8C%DA%A9%D8%A7%D8%B1%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tbzmed.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-30\">\n<h3><span class=\"num\">۳۰.</span> حسین صمدی کافیل</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تبریز</p>\n<p>در میکروب‌شناسی پزشکی با تمرکز بر میکروب‌ها، ایمنی و ژنتیک فعالیت دارد. این حوزه عوامل عفونی و ارتباط آن‌ها با بیماری‌های انسانی را بررسی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی حسین صمدی کافیل\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tbzmed.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atbzmed.ac.ir+%22%D8%AD%D8%B3%DB%8C%D9%86+%D8%B5%D9%85%D8%AF%DB%8C+%DA%A9%D8%A7%D9%81%DB%8C%D9%84%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tbzmed.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-31\">\n<h3><span class=\"num\">۳۱.</span> فاطمه آتیابی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تهران</p>\n<p>پژوهشگر نانودارو و سامانه‌های نوین دارورسانی است. این رشته از فناوری نانو برای افزایش اثربخشی و هدفمندکردن داروها استفاده می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی فاطمه آتیابی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atums.ac.ir+%22%D9%81%D8%A7%D8%B7%D9%85%D9%87+%D8%A2%D8%AA%DB%8C%D8%A7%D8%A8%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-32\">\n<h3><span class=\"num\">۳۲.</span> نیما رضایی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی تهران</p>\n<p>در ایمنی‌شناسی پزشکی با تمرکز بر ژنتیک، سیستم ایمنی و بیماری‌های کودکان فعالیت دارد. زمینه او ارتباط اختلالات ژنتیکی و عملکرد سیستم ایمنی را بررسی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی نیما رضایی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://tums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Atums.ac.ir+%22%D9%86%DB%8C%D9%85%D8%A7+%D8%B1%D8%B6%D8%A7%DB%8C%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">tums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-33\">\n<h3><span class=\"num\">۳۳.</span> بهاره صالحی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی شهید بهشتی</p>\n<p>در زیست‌پزشکی با تمرکز بر پژوهش‌های نانو و اخلاق پژوهش فعالیت دارد. این زمینه زیست‌شناسی، فناوری و اصول مسئولانه پژوهش را کنار هم قرار می‌دهد.</p>\n<div aria-label=\"منابع راستی‌آزمایی بهاره صالحی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://sbmu.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Asbmu.ac.ir+%22%D8%A8%D9%87%D8%A7%D8%B1%D9%87+%D8%B5%D8%A7%D9%84%D8%AD%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">sbmu.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-34\">\n<h3><span class=\"num\">۳۴.</span> حامد میرزایی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی کاشان</p>\n<p>پژوهشگر زیست‌پزشکی سرطان با تمرکز بر نشانگرهای زیستی و زیست‌شناسی سرطان است. این حوزه مولکول‌های قابل استفاده برای تشخیص یا پیش‌بینی بیماری را بررسی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی حامد میرزایی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://kaums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Akaums.ac.ir+%22%D8%AD%D8%A7%D9%85%D8%AF+%D9%85%DB%8C%D8%B1%D8%B2%D8%A7%DB%8C%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">kaums.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-35\">\n<h3><span class=\"num\">۳۵.</span> محمد رمضانی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه علوم پزشکی مشهد</p>\n<p>در داروسازی با تمرکز بر دارورسانی و ژن‌رسانی فعالیت دارد. این زمینه سامانه‌هایی برای رساندن دارو یا ماده ژنتیکی به سلول و بافت هدف طراحی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی محمد رمضانی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://mums.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amums.ac.ir+%22%D9%85%D8%AD%D9%85%D8%AF+%D8%B1%D9%85%D8%B6%D8%A7%D9%86%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">mums.ac.ir</span></div></article></div>\n</section>\n<section class=\"section searchable-section\" data-icon=\"commitments\" id=\"nursing\">\n<div class=\"section-head\"><div class=\"section-no\">۳</div><div><span class=\"section-kicker\">حوزه تخصصی</span><h2 id=\"aris-article-section-4\">پرستاری و علوم مراقبتی</h2></div></div>\n<div class=\"terms\"><article class=\"term professor-card\" id=\"term-36\">\n<h3><span class=\"num\">۳۶.</span> عیسی محمدی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تربیت مدرس</p>\n<p>پژوهشگر پرستاری با تمرکز بر مراقبت از بیماران مبتلا به بیماری‌های مزمن است. این حوزه به پیگیری طولانی‌مدت، آموزش بیمار و افزایش کیفیت زندگی توجه دارد.</p>\n<div aria-label=\"منابع راستی‌آزمایی عیسی محمدی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://modares.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amodares.ac.ir+%22%D8%B9%DB%8C%D8%B3%DB%8C+%D9%85%D8%AD%D9%85%D8%AF%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">modares.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-37\">\n<h3><span class=\"num\">۳۷.</span> فضل‌الله احمدی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تربیت مدرس</p>\n<p>در پرستاری، مراقبت بالینی و پژوهش‌های کیفی فعالیت دارد. پژوهش کیفی تجربه بیماران، خانواده‌ها و کادر درمان را بررسی می‌کند.</p>\n<div aria-label=\"منابع راستی‌آزمایی فضل‌الله احمدی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://modares.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amodares.ac.ir+%22%D9%81%D8%B6%D9%84%E2%80%8C%D8%A7%D9%84%D9%84%D9%87+%D8%A7%D8%AD%D9%85%D8%AF%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">modares.ac.ir</span></div></article></div>\n</section>\n<section class=\"section searchable-section\" data-icon=\"boomi\" id=\"civil\">\n<div class=\"section-head\"><div class=\"section-no\">۴</div><div><span class=\"section-kicker\">حوزه تخصصی</span><h2 id=\"aris-article-section-5\">مهندسی عمران، معدن و محیط‌زیست</h2></div></div>\n<div class=\"terms\"><article class=\"term professor-card\" id=\"term-38\">\n<h3><span class=\"num\">۳۸.</span> نیازمحمد محمودی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> پژوهشگاه رنگ</p>\n<p>پژوهشگر نانوفناوری محیطی با تمرکز بر جذب آلاینده‌ها و تصفیه فاضلاب است.</p>\n<div aria-label=\"منابع راستی‌آزمایی نیازمحمد محمودی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://icrc.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Aicrc.ac.ir+%22%D9%86%DB%8C%D8%A7%D8%B2%D9%85%D8%AD%D9%85%D8%AF+%D9%85%D8%AD%D9%85%D9%88%D8%AF%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">icrc.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-39\">\n<h3><span class=\"num\">۳۹.</span> علیرضا نظام‌زاده اجئیه</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه آزاد اسلامی واحد شهرضا</p>\n<p>در شیمی محیطی با تمرکز بر فوتوکاتالیز و روش‌های حذف آلاینده فعالیت دارد.</p>\n<div aria-label=\"منابع راستی‌آزمایی علیرضا نظام‌زاده اجئیه\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://shahreza.iau.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Ashahreza.iau.ir+%22%D8%B9%D9%84%DB%8C%D8%B1%D8%B6%D8%A7+%D9%86%D8%B8%D8%A7%D9%85%E2%80%8C%D8%B2%D8%A7%D8%AF%D9%87+%D8%A7%D8%AC%D8%A6%DB%8C%D9%87%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">shahreza.iau.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-40\">\n<h3><span class=\"num\">۴۰.</span> حبیب‌الله یونسی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تربیت مدرس</p>\n<p>پژوهشگر مهندسی محیط‌زیست با تمرکز بر تصفیه فاضلاب و فرایندهای زیست‌الکتروشیمیایی است.</p>\n<div aria-label=\"منابع راستی‌آزمایی حبیب‌الله یونسی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://modares.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amodares.ac.ir+%22%D8%AD%D8%A8%DB%8C%D8%A8%E2%80%8C%D8%A7%D9%84%D9%84%D9%87+%DB%8C%D9%88%D9%86%D8%B3%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">modares.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-41\">\n<h3><span class=\"num\">۴۱.</span> سیدحمیدرضا صادقی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تربیت مدرس</p>\n<p>در آبخیزداری، فرسایش خاک و مدیریت حوزه‌های آبخیز فعالیت دارد.</p>\n<div aria-label=\"منابع راستی‌آزمایی سیدحمیدرضا صادقی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://modares.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amodares.ac.ir+%22%D8%B3%DB%8C%D8%AF%D8%AD%D9%85%DB%8C%D8%AF%D8%B1%D8%B6%D8%A7+%D8%B5%D8%A7%D8%AF%D9%82%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">modares.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-42\">\n<h3><span class=\"num\">۴۲.</span> سیدمحمد موسوی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تربیت مدرس</p>\n<p>پژوهشگر مهندسی شیمی و زیست‌فناوری محیطی با تمرکز بر فرایندهای زیستی تصفیه است.</p>\n<div aria-label=\"منابع راستی‌آزمایی سیدمحمد موسوی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://modares.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amodares.ac.ir+%22%D8%B3%DB%8C%D8%AF%D9%85%D8%AD%D9%85%D8%AF+%D9%85%D9%88%D8%B3%D9%88%DB%8C%22\" rel=\"noopener noreferrer\" target=\"_blank\">جست‌وجوی نام در دامنه رسمی ↗</a><span class=\"professor-source-domain\" dir=\"ltr\">modares.ac.ir</span></div></article>\n<article class=\"term professor-card\" id=\"term-43\">\n<h3><span class=\"num\">۴۳.</span> غلامرضا موسوی</h3>\n<p class=\"university\"><span class=\"university-label\">وابستگی درج‌شده</span> دانشگاه تربیت مدرس</p>\n<p>در مهندسی محیط‌زیست با تمرکز بر کیفیت آب‌وهوا و فناوری‌های تصفیه فعالیت دارد.</p>\n<div aria-label=\"منابع راستی‌آزمایی غلامرضا موسوی\" class=\"professor-source-row\"><a class=\"professor-source-link official\" href=\"https://modares.ac.ir/\" rel=\"noopener noreferrer\" target=\"_blank\">سایت رسمی نهاد ↗</a><a class=\"professor-source-link verify\" href=\"https://www.google.com/search?q=site%3Amodares.ac.ir+%22%D8%B