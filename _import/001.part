:580px;right:-180px;bottom:-350px;border:1px solid rgba(245,187,53,.13);background:repeating-radial-gradient(circle,transparent 0 38px,rgba(245,187,53,.025) 39px 40px)}\n    .hero-grid{position:absolute;inset:0;opacity:.2;pointer-events:none;background-image:linear-gradient(rgba(255,220,115,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(255,220,115,.09) 1px,transparent 1px);background-size:68px 68px;mask-image:linear-gradient(90deg,transparent,#000 35%,#000 70%,transparent)}\n    .brandbar{position:relative;z-index:4;max-width:1180px;margin:auto;min-height:96px;display:flex;align-items:center;justify-content:space-between;gap:26px;border-bottom:1px solid rgba(245,187,53,.15)}\n    .brand-banner{display:block;width:min(420px,48vw);max-height:70px;object-fit:contain;object-position:right center;filter:drop-shadow(0 0 12px rgba(245,187,53,.2))}\n    .channel-link{display:inline-flex;align-items:center;gap:9px;color:#f9eac0;text-decoration:none;padding:10px 14px;border:1px solid rgba(245,187,53,.26);border-radius:999px;background:rgba(255,255,255,.035);font-size:.86rem;transition:.25s}.channel-link:hover{border-color:var(--aris-gold);background:rgba(245,187,53,.1);transform:translateY(-2px)}.channel-link b{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:var(--gold-gradient);color:#171006}\n    .hero-inner{display:grid;grid-template-columns:minmax(0,1.14fr) minmax(330px,.86fr);gap:60px;align-items:center;padding-top:72px}\n    .hero-copy{position:relative;z-index:2}.hero .eyebrow{border-color:rgba(245,187,53,.34);background:rgba(245,187,53,.06);color:#f8deb0;backdrop-filter:blur(10px)}.hero .eyebrow:before{box-shadow:0 0 16px var(--aris-gold)}\n    .hero h1{max-width:790px;margin-top:20px;font-size:clamp(2.25rem,4.6vw,4.7rem);line-height:1.28;background:linear-gradient(180deg,#fff 0,#fbf5e7 62%,#d9c9a0 100%);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 18px 55px rgba(0,0,0,.28)}\n    .hero .lead{max-width:720px;color:#bdc9c2;font-size:1.08rem}.hero .lead strong{color:var(--aris-gold-2)}\n    .hero-actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:26px}.hero-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:11px 18px;border-radius:12px;text-decoration:none;font-weight:700;font-size:.92rem;transition:.25s}.hero-btn.primary{background:var(--gold-gradient);color:#171006;box-shadow:0 12px 34px rgba(226,159,21,.2),inset 0 1px rgba(255,255,255,.55)}.hero-btn.primary:hover{transform:translateY(-3px);box-shadow:0 17px 38px rgba(226,159,21,.3)}.hero-btn.secondary{color:#dce7e0;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.035)}.hero-btn.secondary:hover{border-color:rgba(245,187,53,.45);color:#fff}\n    .hero-stats{gap:9px;margin-top:30px}.hero-stats span{position:relative;padding:8px 13px 8px 14px;color:#d0dbd4;border:1px solid rgba(255,255,255,.085);background:rgba(255,255,255,.035);backdrop-filter:blur(8px)}.hero-stats span:before{content:\"\";display:inline-block;width:5px;height:5px;margin-left:7px;border-radius:50%;background:var(--aris-gold);box-shadow:0 0 9px var(--aris-gold)}\n    .hero-visual{position:relative;display:grid;place-items:center;min-height:410px}.logo-stage{position:relative;display:grid;place-items:center;width:min(390px,34vw);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(245,187,53,.13),rgba(13,44,32,.1) 55%,transparent 70%)}\n    .logo-stage:before,.logo-stage:after{content:\"\";position:absolute;border-radius:50%;border:1px solid rgba(245,187,53,.27)}.logo-stage:before{inset:4%;box-shadow:0 0 55px rgba(245,187,53,.09),inset 0 0 45px rgba(245,187,53,.06)}.logo-stage:after{inset:-8%;border-style:dashed;animation:orbit 34s linear infinite}\n    .hero-logo{position:relative;z-index:2;width:78%;aspect-ratio:1;object-fit:cover;border-radius:50%;mix-blend-mode:screen;filter:contrast(1.08) drop-shadow(0 17px 45px rgba(0,0,0,.6)) drop-shadow(0 0 18px rgba(245,187,53,.18))}\n    .spark{position:absolute;z-index:3;width:8px;height:8px;background:var(--aris-gold-2);transform:rotate(45deg);box-shadow:0 0 17px 5px rgba(245,187,53,.34);animation:pulse 2.8s ease-in-out infinite}.spark.s1{top:11%;right:14%}.spark.s2{bottom:17%;left:10%;animation-delay:-1.2s}.spark.s3{top:45%;left:-2%;width:5px;height:5px;animation-delay:-2s}\n    .orbit-label{position:absolute;z-index:5;padding:7px 12px;border:1px solid rgba(245,187,53,.24);border-radius:999px;background:rgba(5,11,8,.8);color:#e9e3d2;font-size:.78rem;box-shadow:0 10px 28px rgba(0,0,0,.32);backdrop-filter:blur(8px)}.orbit-label.l1{top:18%;right:-5%}.orbit-label.l2{bottom:14%;right:5%}.orbit-label.l3{top:45%;left:-7%}.orbit-label:before{content:\"✦\";color:var(--aris-gold);margin-left:6px}\n    @keyframes orbit{to{transform:rotate(360deg)}}@keyframes pulse{50%{opacity:.35;transform:rotate(45deg) scale(.55)}}\n    .layout{max-width:1210px;margin:-68px auto 90px;grid-template-columns:300px minmax(0,1fr);gap:30px}.sidebar{top:18px;border-color:rgba(245,187,53,.24);border-radius:24px;padding:0;overflow:hidden;background:linear-gradient(160deg,#0a1510,#08100d);box-shadow:0 28px 70px rgba(6,21,14,.22),inset 0 1px rgba(255,255,255,.04)}\n    .mini-brand{position:relative;display:flex;align-items:center;gap:12px;padding:18px 18px 15px;border-bottom:1px solid rgba(245,187,53,.14);overflow:hidden}.mini-brand:after{content:\"\";position:absolute;width:90px;height:90px;left:-28px;top:-44px;border-radius:50%;background:rgba(245,187,53,.08);filter:blur(5px)}.mini-mark{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:var(--gold-gradient);color:#151006;font-family:Georgia,serif;font-size:1.65rem;font-weight:700;box-shadow:0 9px 24px rgba(230,168,34,.22)}.mini-brand strong{display:block;color:#fff;font-family:Georgia,Tahoma,serif;letter-spacing:.04em}.mini-brand small{display:block;color:#8fa197;font-size:.7rem;line-height:1.4}.sidebar-content{padding:16px}.sidebar h2{color:#f3ead1}.search input{border-color:rgba(255,255,255,.09);background:rgba(255,255,255,.045);color:#fff}.search input::placeholder{color:#73857b}.search input:focus{border-color:var(--aris-gold);box-shadow:0 0 0 3px rgba(245,187,53,.09)}.search:before{color:var(--aris-gold)}.count{color:#778a7f}.nav{padding-left:5px}.nav a{position:relative;color:#9eb0a6;padding:8px 11px;border:1px solid transparent}.nav a:hover{color:#fff;background:rgba(245,187,53,.07);border-color:rgba(245,187,53,.12);padding-right:15px}.nav a:before{content:\"\";display:inline-block;width:4px;height:4px;border-radius:50%;margin-left:8px;background:#466556}.nav a:hover:before{background:var(--aris-gold);box-shadow:0 0 8px var(--aris-gold)}.toplink{color:#ddbd67;border-color:rgba(245,187,53,.12)}\n    .intro,.section{position:relative;border:1px solid var(--aris-line);background:rgba(255,253,248,.96);box-shadow:0 20px 55px rgba(30,50,39,.08);overflow:hidden}.intro:before,.section:before{content:\"\";position:absolute;inset:0 auto auto 0;width:160px;height:3px;background:var(--gold-gradient)}.intro{padding:30px 32px;border-radius:24px}.intro-grid{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:24px;align-items:center}.intro-kicker{display:inline-flex;align-items:center;gap:8px;color:var(--aris-gold-dark);font-size:.76rem;font-weight:700;letter-spacing:.04em}.intro-kicker:before{content:\"\";width:22px;height:1px;background:var(--aris-gold)}.intro h2{margin:5px 0 7px;color:var(--aris-green);font-size:1.28rem}.intro p{color:#59655e}.intro-badge{position:relative;display:grid;place-items:center;min-height:118px;border:1px solid #eadcb9;border-radius:18px;background:radial-gradient(circle at 50% 35%,#fff7db,#f3e7c7);text-align:center;overflow:hidden}.intro-badge:before{content:\"A\";position:absolute;color:rgba(154,102,16,.07);font:700 8rem/1 Georgia}.intro-badge b{position:relative;display:block;font-size:2rem;color:var(--aris-green);line-height:1.2}.intro-badge span{position:relative;color:#89703a;font-size:.75rem}\n    .section{padding:31px;border-radius:24px}.section-head{position:relative;align-items:center;margin-bottom:22px;padding-bottom:20px;border-color:#ebe4d3}.section-no{position:relative;width:52px;height:52px;border-radius:16px;background:linear-gradient(145deg,var(--aris-green-2),#081c13);color:var(--aris-gold-2);border:1px solid rgba(245,187,53,.28);box-shadow:0 10px 24px rgba(13,44,32,.18)}.section-no:after{content:\"\";position:absolute;inset:5px;border:1px solid rgba(245,187,53,.13);border-radius:11px}.section h2{color:var(--aris-green);letter-spacing:-.015em}.section-kicker{color:#9a7a2f;font-weight:700}.section-head:after{content:\"ARIS ACADEMY\";position:absolute;left:0;bottom:18px;color:#cbbf9f;font:600 .64rem/1 Georgia,serif;letter-spacing:.16em}\n    .terms{gap:12px}.term{padding:20px 21px 20px 20px;border-color:#e6dfcf;border-radius:17px;background:linear-gradient(135deg,#fffefb,#faf7ef);box-shadow:0 5px 18px rgba(19,49,34,.025);transition:.25s}.term:before{content:\"\";position:absolute;right:0;top:18px;bottom:18px;width:3px;border-radius:3px;background:linear-gradient(var(--aris-gold-2),var(--aris-gold-dark));opacity:.65}.term:hover{transform:translateY(-2px);border-color:#d7c38d;box-shadow:0 14px 34px rgba(31,54,42,.08)}.term h3{color:var(--aris-green);font-size:1.08rem}.term h3 .num{min-width:39px;color:var(--aris-gold-dark);font-weight:800}.term p{color:#414d46}.example{position:relative;margin-top:12px!important;padding:12px 16px!important;border:0!important;border-radius:12px!important;background:linear-gradient(90deg,#fff4ce,#faf1d8)!important;color:#544625!important}.example:before{content:\"✦\";color:#ad730c;margin-left:7px}.simple{color:var(--aris-green)}\n    .mistakes{gap:13px}.mistake{position:relative;border-color:#e7ddc6;background:linear-gradient(145deg,#fffefa,#faf5e9);overflow:hidden;transition:.25s}.mistake:hover{transform:translateY(-3px);border-color:#d6be82;box-shadow:0 12px 30px rgba(32,52,41,.07)}.mistake:after{content:counter(mistake,\"persian\");position:absolute;left:9px;bottom:-15px;color:rgba(24,63,45,.055);font:700 5rem/1 Tahoma}.mistake h3:before{display:inline-grid;place-items:center;width:28px;height:28px;margin-left:7px;border-radius:9px;background:#f7e7b6;color:#805308}\n    .principle{border:1px solid #e4dcc8;background:linear-gradient(90deg,#f9f3e4,#fffdf8)}.principle:before{background:linear-gradient(145deg,var(--aris-green-2),#07170f);color:var(--aris-gold-2);border:1px solid rgba(245,187,53,.25)}.final-note{position:relative;background:linear-gradient(135deg,#081a12,#123a29);border:1px solid rgba(245,187,53,.28);color:#f2ede0;box-shadow:0 18px 40px rgba(8,31,21,.18);overflow:hidden}.final-note:after{content:\"A\";position:absolute;left:18px;top:-28px;color:rgba(245,187,53,.07);font:700 8rem/1 Georgia}\n    .footer{position:relative;padding:54px 20px 46px;background:linear-gradient(180deg,#07100c,#020302);color:#7e9286;border-top:1px solid rgba(245,187,53,.18)}.footer-brand{display:block;width:min(460px,80vw);max-height:90px;object-fit:contain;margin:0 auto 18px;filter:drop-shadow(0 0 13px rgba(245,187,53,.12))}.footer p{margin:0}.footer:before{content:\"\";position:absolute;top:0;left:50%;width:min(620px,75vw);height:1px;transform:translateX(-50%);background:var(--gold-gradient);box-shadow:0 0 18px rgba(245,187,53,.35)}\n    .copy-toast{border:1px solid rgba(245,187,53,.4);background:#07130d;color:#fae5aa;box-shadow:0 14px 35px rgba(0,0,0,.28)}\n    @media(max-width:1000px){.hero-inner{grid-template-columns:1fr 330px;gap:22px}.logo-stage{width:320px}.layout{grid-template-columns:275px minmax(0,1fr)}}\n    @media(max-width:900px){body{background:linear-gradient(180deg,#07100c 0 950px,var(--aris-ivory) 950px)}.hero{min-height:auto;padding-bottom:120px}.brandbar{min-height:84px}.hero-inner{grid-template-columns:1fr;padding-top:52px}.hero-copy{text-align:center}.hero h1,.hero .lead{margin-left:auto;margin-right:auto}.hero-actions,.hero-stats{justify-content:center}.hero-visual{min-height:340px}.logo-stage{width:310px}.layout{grid-template-columns:1fr}.sidebar{position:relative}.section-head:after{display:none}}\n    @media(max-width:560px){body{background:linear-gradient(180deg,#07100c 0 900px,var(--aris-ivory) 900px)}.hero{padding:0 16px 105px}.brandbar{min-height:74px}.brand-banner{width:64vw;max-height:54px}.channel-link{padding:8px 10px;font-size:.74rem}.channel-link span{display:none}.hero-inner{padding-top:42px}.hero h1{font-size:2.15rem}.hero .lead{font-size:.95rem}.logo-stage{width:250px}.orbit-label{font-size:.68rem;padding:5px 8px}.orbit-label.l1{right:-4%}.orbit-label.l3{left:-5%}.intro-grid{grid-template-columns:1fr}.intro-badge{min-height:88px;grid-template-columns:auto auto;gap:7px}.layout{margin-top:-55px}.section{padding:22px 16px}.section-no{width:43px;height:43px}.term{padding:17px 15px}.mini-brand{padding:15px}.nav{grid-template-columns:1fr 1fr}}\n    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}}\n    @media print{body{background:#fff}.brandbar,.hero-visual,.hero-actions,.hero-grid{display:none}.hero{min-height:0;padding:26px;background:#fff}.hero h1{color:#111;-webkit-text-fill-color:#111;text-shadow:none}.hero .lead{color:#333}.section-head:after{display:none}.section:before,.intro:before{display:none}}\n  \n\n    \n    \n    body,button,input,select{font-family:\"ArisSans\",Tahoma,\"Segoe UI\",sans-serif}.mini-mark,.mini-brand strong{font-family:Georgia,\"ArisSans\",serif}\n    .hero-logo{width:88%;border-radius:0;object-fit:contain;mix-blend-mode:normal}\n    .skip-link{position:fixed;z-index:300;right:16px;top:-60px;padding:10px 16px;border-radius:0 0 12px 12px;background:var(--aris-gold);color:#161005;text-decoration:none;font-weight:800;transition:.2s}.skip-link:focus{top:0}\n    :focus-visible{outline:3px solid rgba(245,187,53,.65);outline-offset:3px}\n    .search-tools{display:grid;grid-template-columns:1fr auto;gap:8px;margin:-4px 0 12px}.category-filter{min-width:0;border:1px solid rgba(255,255,255,.09);border-radius:10px;background:#101a15;color:#cad6cf;padding:7px 9px;font-size:.76rem}.clear-search{display:grid;place-items:center;width:36px;border:1px solid rgba(255,255,255,.09);border-radius:10px;background:rgba(255,255,255,.04);color:#d8c27d;cursor:pointer}.clear-search:disabled{opacity:.35;cursor:default}\n    .nav a.active{color:#fff;background:linear-gradient(90deg,rgba(245,187,53,.14),rgba(245,187,53,.035));border-color:rgba(245,187,53,.25);box-shadow:inset -3px 0 var(--aris-gold),0 7px 20px rgba(0,0,0,.12)}.nav a.active:before{background:var(--aris-gold);box-shadow:0 0 10px var(--aris-gold)}\n    .section-no{padding:0}.section-no svg{position:relative;z-index:1;width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.icon-index{position:absolute;z-index:2;left:-5px;bottom:-6px;display:grid;place-items:center;min-width:20px;height:20px;padding:0 4px;border-radius:7px;background:var(--gold-gradient);color:#161006;border:2px solid #fffdf8;font-size:.62rem;font-weight:900;box-shadow:0 4px 10px rgba(0,0,0,.16)}\n    .section-count{display:inline-block;margin-right:7px;padding:2px 8px;border-radius:999px;background:#f5ead0;color:#76540d;font-size:.68rem;font-weight:700}\n    .content-tools{position:sticky;z-index:15;top:10px;display:flex;align-items:center;justify-content:space-between;gap:14px;margin:0 0 18px;padding:10px 12px;border:1px solid rgba(218,197,144,.8);border-radius:15px;background:rgba(255,253,248,.9);box-shadow:0 10px 30px rgba(21,47,34,.09);backdrop-filter:blur(14px)}.content-tools-label{display:flex;align-items:center;gap:9px;color:#526159;font-size:.8rem}.content-tools-label:before{content:\"✦\";color:var(--aris-gold-dark)}.content-tools-actions{display:flex;gap:7px}.mini-btn{border:1px solid #e0d2af;border-radius:10px;background:#fffaf0;color:#624c1d;padding:7px 11px;cursor:pointer;font-size:.76rem;font-weight:700;transition:.2s}.mini-btn:hover{border-color:#bc9135;background:#f8ebc9;transform:translateY(-1px)}\n    .term{padding:0!important;overflow:hidden}.term:before{top:12px;bottom:12px}.term-head{position:relative;display:flex;align-items:center;gap:12px;padding:17px 18px 17px 16px;cursor:pointer;user-select:none}.term-head:hover{background:linear-gradient(90deg,rgba(246,225,170,.2),transparent)}.term h3{flex:1;margin:0!important}.term-actions{display:flex;align-items:center;gap:7px}.term-link{display:grid;place-items:center;width:34px;height:34px;border:1px solid #e8dcc0;border-radius:10px;background:#fffaf0;color:#85610f;cursor:pointer;opacity:.72;transition:.2s}.term-link:hover{opacity:1;border-color:#c79b3d;background:#f9e8ba}.term-link svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.term-chevron{position:relative;display:block;width:28px;height:28px;border-radius:9px;background:#f1e7ce}.term-chevron:before,.term-chevron:after{content:\"\";position:absolute;left:8px;right:8px;top:13px;height:2px;border-radius:2px;background:#765712;transition:.25s}.term-chevron:after{transform:rotate(90deg)}.term[data-open=\"true\"] .term-chevron:after{transform:rotate(0)}.term[data-open=\"true\"] .term-head{background:linear-gradient(90deg,rgba(245,225,170,.24),transparent)}\n    .term-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .3s ease}.term[data-open=\"true\"] .term-body{grid-template-rows:1fr}.term-body-inner{min-height:0;overflow:hidden;padding:0 20px}.term[data-open=\"true\"] .term-body-inner{padding:0 20px 18px;border-top:1px solid #eee6d5}.term-body-inner>p:first-child,.term-body-inner>ul:first-child{margin-top:14px}.term-nav{display:flex;justify-content:space-between;gap:10px;margin-top:15px;padding-top:12px;border-top:1px dashed #dfd4ba}.term-nav button{border:0;background:transparent;color:#7e641f;cursor:pointer;font-size:.75rem}.term-nav button:disabled{opacity:.25;cursor:default}.term-nav button:hover:not(:disabled){color:var(--aris-green);text-decoration:underline}\n    .term-result-section{display:none;margin-right:7px;padding:2px 7px;border-radius:999px;background:#e5eee8;color:#305c46;font-size:.66rem;font-weight:700}.is-searching .term:not(.hidden) .term-result-section{display:inline-block}.term.search-match{border-color:#cda84e;box-shadow:0 10px 28px rgba(151,103,12,.1)}mark{color:inherit;background:#ffe39a;box-shadow:0 0 0 2px #ffe39a;border-radius:4px}\n    .section.reveal{opacity:0;transform:translateY(18px)}.section.reveal.visible{opacity:1;transform:none;transition:opacity .55s ease,transform .55s ease}\n    .share-panel{position:relative;margin:24px 0;padding:28px;border-radius:24px;border:1px solid rgba(245,187,53,.27);background:radial-gradient(circle at 10% 20%,rgba(245,187,53,.12),transparent 14rem),linear-gradient(135deg,#07130d,#102e21);color:#fff;overflow:hidden;box-shadow:0 22px 55px rgba(6,24,16,.17)}.share-panel:after{content:\"A\";position:absolute;left:20px;top:-38px;color:rgba(245,187,53,.06);font:700 11rem/1 Georgia}.share-panel h2{position:relative;margin:0 0 4px;color:#fff;font-size:1.25rem}.share-panel p{position:relative;margin:0;color:#9fb1a7;font-size:.9rem}.share-actions{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:9px;margin-top:18px}.share-action{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(245,187,53,.22);border-radius:12px;background:rgba(255,255,255,.045);color:#f5ead0;padding:10px 14px;text-decoration:none;cursor:pointer;font:700 .82rem Tahoma,sans-serif;transition:.2s}.share-action.primary{background:var(--gold-gradient);color:#171006;border:0}.share-action:hover{transform:translateY(-2px);border-color:rgba(245,187,53,.6)}.share-action svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n    .mobile-bar,.mobile-sheet,.sheet-backdrop{display:none}.mobile-bar{position:fixed;z-index:90;right:10px;left:10px;bottom:10px;height:62px;align-items:center;justify-content:space-around;border:1px solid rgba(245,187,53,.3);border-radius:18px;background:rgba(5,15,10,.94);box-shadow:0 15px 45px rgba(0,0,0,.35);backdrop-filter:blur(16px)}.mobile-action{display:grid;place-items:center;gap:2px;min-width:58px;border:0;background:transparent;color:#a9bbb1;font-size:.66rem;cursor:pointer}.mobile-action svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.mobile-action:hover,.mobile-action.active{color:var(--aris-gold-2)}.reading-percent{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:conic-gradient(var(--aris-gold) var(--read),rgba(255,255,255,.1) 0);position:relative}.reading-percent:after{content:\"\";position:absolute;inset:4px;border-radius:50%;background:#09140f}.reading-percent b{position:relative;z-index:1;color:#fff;font-size:.62rem;direction:ltr}\n    .sheet-backdrop{position:fixed;z-index:98;inset:0;background:rgba(0,0,0,.52);backdrop-filter:blur(3px)}.mobile-sheet{position:fixed;z-index:99;right:10px;left:10px;bottom:82px;max-height:min(72vh,620px);padding:17px;border:1px solid rgba(245,187,53,.27);border-radius:22px;background:linear-gradient(160deg,#0b1812,#07100c);box-shadow:0 25px 70px rgba(0,0,0,.5);overflow:auto;transform:translateY(30px);opacity:0;transition:.24s}.mobile-sheet.open{display:block;transform:none;opacity:1}.sheet-backdrop.open{display:block}.sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px}.sheet-head strong{color:#fff}.sheet-close{display:grid;place-items:center;width:34px;height:34px;border:1px solid rgba(255,255,255,.1);border-radius:10px;background:rgba(255,255,255,.05);color:#fff;cursor:pointer}.mobile-search{width:100%;margin-bottom:12px;border:1px solid rgba(245,187,53,.2);border-radius:12px;background:rgba(255,255,255,.055);color:#fff;padding:10px 12px}.mobile-sheet .nav{max-height:none;grid-template-columns:1fr 1fr}\n    .copy-toast{bottom:88px}\n    @media(max-width:900px){.mobile-bar{display:flex}.footer{padding-bottom:118px}.content-tools{top:6px}.sidebar .nav{display:none}.sidebar .toplink{display:none}}\n    @media(max-width:560px){.content-tools-label{display:none}.content-tools{justify-content:center}.content-tools-actions{width:100%}.mini-btn{flex:1}.term-head{padding:15px 14px}.term h3{font-size:.98rem}.term-link{width:32px;height:32px}.term-body-inner,.term[data-open=\"true\"] .term-body-inner{padding-left:15px;padding-right:15px}.share-actions{display:grid;grid-template-columns:1fr}.share-action{justify-content:center}.section-count{display:block;width:max-content;margin:4px 0 0}.mobile-sheet .nav{grid-template-columns:1fr}}\n    @media print{.mobile-bar,.mobile-sheet,.sheet-backdrop,.content-tools,.share-panel,.term-link,.term-nav{display:none!important}.term-body{display:block!important}.term-body-inner{overflow:visible!important;padding:0 20px 18px!important}.term-chevron{display:none}.term{break-inside:avoid}}\n  \n\n    .mini-mark svg{width:33px;height:33px;fill:none;stroke:#1a1305;stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round}\n    .hero-logo{width:92%}.orbit-labels{display:contents}.orbit-label{white-space:nowrap}.orbit-label.l1{top:7%;right:-24%}.orbit-label.l2{right:-20%;bottom:5%}.orbit-label.l3{top:47%;left:-25%}.orbit-label:after{content:\"\";position:absolute;top:50%;width:24px;height:1px;background:linear-gradient(90deg,rgba(245,187,53,.12),rgba(245,187,53,.72))}.orbit-label.l1:after,.orbit-label.l2:after{left:-24px}.orbit-label.l3:after{right:-24px;transform:rotate(180deg)}\n    .search-tools{grid-template-columns:1fr auto auto}.clear-search,.favorites-filter{display:grid;place-items:center;min-width:36px;border:1px solid rgba(255,255,255,.09);border-radius:10px;background:rgba(255,255,255,.04);color:#d8c27d;cursor:pointer}.favorites-filter{padding:0 9px;grid-auto-flow:column;gap:4px}.favorites-filter.active{color:#161005;background:var(--gold-gradient);border-color:transparent}.favorites-filter b{font-size:.66rem}\n    .term-favorite{display:grid;place-items:center;width:34px;height:34px;border:1px solid #e8dcc0;border-radius:10px;background:#fffaf0;color:#a59670;cursor:pointer;opacity:.72;transition:.2s;font-size:1.1rem}.term-favorite:hover{opacity:1;border-color:#c79b3d;background:#f9e8ba}.term-favorite[aria-pressed=\"true\"]{opacity:1;color:#9b6500;background:#ffe5a0;border-color:#c8962d;text-shadow:0 1px #fff}\n    .related-box{margin-top:15px;padding:12px 13px;border:1px solid #e5dac0;border-radius:13px;background:#fbf7ec}.related-box strong{display:block;margin-bottom:7px;color:#516158;font-size:.75rem}.related-links{display:flex;flex-wrap:wrap;gap:6px}.related-link{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:#e7efe9;color:#27553f;text-decoration:none;font-size:.7rem;font-weight:700}.related-link:before{content:\"↗\";color:#a97814}.related-link:hover{background:#d7e7dc;color:#153e2b}\n    .compare-section{position:relative;margin:0 0 20px;padding:28px;border:1px solid var(--aris-line);border-radius:24px;background:linear-gradient(150deg,#fffdf8,#f6efdc);box-shadow:0 18px 48px rgba(30,50,39,.07);overflow:hidden}.compare-section:before{content:\"\";position:absolute;right:-55px;top:-80px;width:180px;height:180px;border:1px solid rgba(160,111,19,.13);border-radius:50%;box-shadow:0 0 0 28px rgba(160,111,19,.035),0 0 0 56px rgba(160,111,19,.025)}.compare-head{position:relative;display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:17px}.compare-head h2{margin:0;color:var(--aris-green);font-size:1.25rem}.compare-head p{margin:0;color:#78847d;font-size:.78rem}.compare-grid{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.compare-card{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;padding:14px;border:1px solid #e7dbc0;border-radius:15px;background:rgba(255,255,255,.72)}.compare-side b{display:block;color:#173c2b;font-size:.85rem}.compare-side span{display:block;color:#66736b;font-size:.72rem;line-height:1.75}.compare-vs{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--gold-gradient);color:#241705;font-size:.62rem;font-weight:900}.compare-card a{color:inherit;text-decoration:none}.compare-card a:hover b{color:#9a6811}\n    .mobile-favorites{width:100%;margin:-3px 0 12px;padding:9px;border:1px solid rgba(245,187,53,.2);border-radius:11px;background:rgba(245,187,53,.06);color:#e7cf8e;cursor:pointer}.mobile-favorites.active{background:var(--gold-gradient);color:#151006}\n    .resume-badge{position:fixed;z-index:89;left:18px;bottom:22px;display:none;align-items:center;gap:9px;padding:10px 13px;border:1px solid rgba(245,187,53,.3);border-radius:13px;background:#09150f;color:#ecdfbc;box-shadow:0 16px 40px rgba(0,0,0,.28);font-size:.76rem}.resume-badge.show{display:flex}.resume-badge button{border:0;border-radius:8px;background:var(--gold-gradient);color:#171006;padding:5px 8px;cursor:pointer;font-weight:700}.resume-badge .dismiss{background:transparent;color:#a6b6ad;padding:3px}\n    @media(max-width:768px){.compare-grid{grid-template-columns:1fr}.resume-badge{bottom:84px;left:10px;right:10px;justify-content:center}}\n    @media(max-width:900px){.logo-stage{margin-bottom:58px}.orbit-labels{position:absolute;z-index:6;right:-7%;left:-7%;bottom:-54px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.orbit-label.l1,.orbit-label.l2,.orbit-label.l3{position:relative;inset:auto;display:flex;align-items:center;justify-content:center;min-width:0;width:100%;transform:none;padding:7px 6px;text-align:center}.orbit-label:after{display:none}}\n    @media(max-width:390px){.orbit-labels{right:-10%;left:-10%;gap:8px}.orbit-label{font-size:.62rem!important;padding:6px 4px!important}}\n    @media(max-width:560px){.term-favorite{width: