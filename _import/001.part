t-fill-color:#111;text-shadow:none}.hero .lead{color:#333}.section-head:after{display:none}.section:before,.intro:before{display:none}}\n  \n\n    \n    \n    body,button,input,select{font-family:\"ArisSans\",Tahoma,\"Segoe UI\",sans-serif}.mini-mark,.mini-brand strong{font-family:Georgia,\"ArisSans\",serif}\n    .hero-logo{width:88%;border-radius:0;object-fit:contain;mix-blend-mode:normal}\n    .skip-link{position:fixed;z-index:300;right:16px;top:-60px;padding:10px 16px;border-radius:0 0 12px 12px;background:var(--aris-gold);color:#161005;text-decoration:none;font-weight:800;transition:.2s}.skip-link:focus{top:0}\n    :focus-visible{outline:3px solid rgba(245,187,53,.65);outline-offset:3px}\n    .search-tools{display:grid;grid-template-columns:1fr auto;gap:8px;margin:-4px 0 12px}.category-filter{min-width:0;border:1px solid rgba(255,255,255,.09);border-radius:10px;background:#101a15;color:#cad6cf;padding:7px 9px;font-size:.76rem}.clear-search{display:grid;place-items:center;width:36px;border:1px solid rgba(255,255,255,.09);border-radius:10px;background:rgba(255,255,255,.04);color:#d8c27d;cursor:pointer}.clear-search:disabled{opacity:.35;cursor:default}\n    .nav a.active{color:#fff;background:linear-gradient(90deg,rgba(245,187,53,.14),rgba(245,187,53,.035));border-color:rgba(245,187,53,.25);box-shadow:inset -3px 0 var(--aris-gold),0 7px 20px rgba(0,0,0,.12)}.nav a.active:before{background:var(--aris-gold);box-shadow:0 0 10px var(--aris-gold)}\n    .section-no{padding:0}.section-no svg{position:relative;z-index:1;width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.icon-index{position:absolute;z-index:2;left:-5px;bottom:-6px;display:grid;place-items:center;min-width:20px;height:20px;padding:0 4px;border-radius:7px;background:var(--gold-gradient);color:#161006;border:2px solid #fffdf8;font-size:.62rem;font-weight:900;box-shadow:0 4px 10px rgba(0,0,0,.16)}\n    .section-count{display:inline-block;margin-righ