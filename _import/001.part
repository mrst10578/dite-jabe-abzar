ch input:focus{border-color:#e5b63e;box-shadow:0 0 0 4px rgba(229,182,62,.11)}.aris-article-search__submit{position:absolute;inset:5px auto 5px 5px;min-width:76px;border:0;border-radius:9px;background:linear-gradient(145deg,#f2ca64,#bd8720);color:#171108;font-weight:800;cursor:pointer}.aris-article-search__meta{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:29px;margin-top:5px}.aris-article-search-status{color:#aaa292;font-size:11px}.aris-article-search-nav{display:flex;gap:4px}.aris-article-search-nav[hidden]{display:none}.aris-article-search-nav button{min-width:34px;height:28px;border:1px solid rgba(229,182,62,.2);border-radius:8px;background:rgba(229,182,62,.06);color:#e7c873;cursor:pointer}.aris-search-hit{padding:0 2px;border-radius:4px;background:#80651d;color:#fff8dc}.aris-search-hit.is-current{background:#ffd66d;color:#171108;box-shadow:0 0 0 3px rgba(255,214,109,.18)}\n.aris-toc{min-width:170px}.aris-toc summary{min-height:46px;display:flex;align-items:center;justify-content:center;padding:8px 14px;border:1px solid rgba(143,164,115,.28);border-radius:12px;color:#c8d9aa;background:rgba(102,115,74,.08);cursor:pointer;font-size:13px}.aris-toc[open] summary{border-radius:12px 12px 0 0}.aris-toc__list{display:grid;gap:3px;max-height:280px;overflow:auto;margin:0;padding:10px;border:1px solid rgba(143,164,115,.24);border-top:0;border-radius:0 0 12px 12px;background:#0b0d0a;list-style:none}.aris-toc__list a{display:block;padding:8px 9px;border-radius:8px;color:#d7d0c1;text-decoration:none;font-size:12px;line-height:1.7}.aris-toc__list a:hover{color:#ffe09a;background:rgba(229,182,62,.07)}\n.aris-validity{display:flex;align-items:flex-start;gap:10px;margin-top:12px;padding:12px 13px;border:1px solid rgba(229,182,62,.22);border-radius:12px;background:rgba(229,182,62,.055);color:#d8cfbc;font-size:12px;line-height:1.9}.aris-validity b{flex:0 0 auto;color:#f0c65d}.aris-validity--stable{border-color:rgba(143,164,115,.23);background:rgba(102,115,74,.06)}.aris-validity--stable b{color:#b7c995}\n#mainContent{display:block!important;width:100%!important;max-width:none!important;margin:0!important;padding:0!important;color:#f5f0e5!important}#mainContent,#mainContent button,#mainContent input,#mainContent select,#mainContent textarea,#mainContent a{font-family:\"Vazirmatn\",Tahoma,\"Segoe UI\",sans-serif!important}\n#mainContent>.intro:first-child{margin-top:0!important}#mainContent .intro,#mainContent .section,#mainContent .compare-section{border:1px solid rgba(229,182,62,.2)!important;border-radius:20px!important;background:linear-gradient(145deg,rgba(21,22,18,.98),rgba(13,14,12,.99))!important;box-shadow:0 16px 44px rgba(0,0,0,.22)!important}\n#mainContent .term,#mainContent .mistake,#mainContent .principle,#mainContent .professor-card,#mainContent .benefit-card,#mainContent .compare-card,#mainContent .compare-side,#mainContent .research-box,#mainContent .summary-row,#mainContent .mini-compare>div,#mainContent .map-card{border-color:rgba(143,164,115,.22)!important;background:rgba(102,115,74,.055)!important;color:#f1ecdf!important;box-shadow:none!important}\n#mainContent .term{padding:20px 30px 20px 20px!important}\n#mainContent .section-intro,#mainContent .topic-note,#mainContent .editorial-note,#mainContent .example{border-color:rgba(229,182,62,.2)!important;background:rgba(229,182,62,.055)!important;color:#e1d9c9!important}\n#mainContent .visual-summary,#mainContent .final-note,#mainContent .formula-box,#mainContent .subgroup-label{background:linear-gradient(145deg,#172017,#0d120e)!important;border:1px solid rgba(143,164,115,.24)!important;color:#f5f0e5!important}\n#mainContent h2,#mainContent h3,#mainContent h4,#mainContent b,#mainContent strong{color:#edc96f!important}#mainContent p,#mainContent li,#mainContent small,#mainContent .university,#mainContent .section-kicker,#mainContent .intro-kicker{color:#ddd6c9!important}#mainContent p,#mainContent li{font-size:clamp(17px,2.1vw,19px)!important;line-height:2.05!important}#mainContent h2{font-size:clamp(24px,4vw,33px)!important;line-height:1.55!important}#mainContent h3{font-size:clamp(19px,3vw,23px)!important;line-height:1.7!important}\n#mainContent .section-head{border-bottom-color:rgba(229,182,62,.18)!important}#mainContent .section-no,#mainContent .intro-badge,#mainContent .num{color:#f3cf75!important}#mainContent .section-no{background:#26321f!important}#mainContent a{color:#e7c46c!important}#mainContent [id]{scroll-margin-top:18px}\n.aris-related{margin:24px 0 10px;padding:20px;border:1px solid rgba(143,164,115,.25);border-radius:20px;background:linear-gradient(145deg,rgba(20,24,18,.97),rgba(12,14,11,.99))}.aris-related__eyebrow{margin:0;color:#9eb183;font-size:12px}.aris-related h2{margin:5px 0 15px;color:#f0cb72;font-size:22px}.aris-related__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.aris-related button{padding:14px;border:1px solid rgba(229,182,62,.18);border-radius:13px;background:rgba(229,182,62,.04);color:#f4eee1;text-align:right;cursor:pointer;font-size:14px;line-height:1.8}.aris-related button:hover{border-color:rgba(229,182,62,.5);background:rgba(229,182,62,.08)}\n@media(max-width:620px){.aris-article-shell{padding:10px}.aris-article-tools{padding:12px;border-radius:15px}.aris-article-tools__row{grid-template-columns:1fr}.aris-toc{min-width:0}.aris-related__grid{grid-template-columns:1fr}#mainContent .intro,#mainContent .section,#mainContent .compare-section{padding:20px 15px!important;border-radius:16px!important}#mainContent .term{padding:18px 25px 18px 17px!important}#mainContent p,#mainContent li{font-size:17px!important;line-height:2!important}}\n</style><style data-aris-reader-refinement=\"17\">\n/* Shell 17: compact collapsible in-article search + softer highlight card. */\n.aris-search-disclosure{\n  width:100%;\n  min-height:42px;\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:10px;\n  padding:8px 12px;\n  border:1px solid rgba(224,169,47,.18);\n  border-radius:11px;\n  background:rgba(224,169,47,.04);\n  color:#d9bd83;\n  cursor:pointer;\n  font:inherit;\n  font-size:.8rem;\n  font-weight:700;\n}\n.aris-search-disclosure::after{\n  content:\"⌕\";\n  color:#e0a92f;\n  font-size:1rem;\n}\n.aris-search-disclosure[aria-expanded=\"true\"]{\n  border-color:rgba(224,169,47,.34);\n  background:rgba(224,169,47,.075);\n}\n.aris-search-disclosure[aria-expanded=\"true\"]::after{\n  content:\"×\";\n}\n.aris-search-disclosure + .aris-article-search{\n  margin-top:10px;\n}\n.aris-article-search[hidden]{\n  display:none!important;\n}\n.aris-article-tools__row{\n  gap:9px!important;\n}\n.aris-validity{\n  padding:10px 12px!important;\n  border-color:rgba(224,169,47,.13)!important;\n  background:rgba(224,169,47,.025)!important;\n}\n.aris-validity b{\n  font-size:.75rem!important;\n}\n.aris-validity span{\n  font-size:.76rem!important;\n  line-height:1.85!important;\n}\n.intro-badge{\n  border-color:#cbb37b!important;\n  background:radial-gradient(circle at 50% 34%,#eee0bb,#d8c59b)!important;\n}\n.intro-badge b{\n  color:#153c2b!important;\n}\n.intro-badge span{\n  color:#735d2d!important;\n}\n@media(max-width:560px){\n  .aris-search-disclosure{\n    min-height:40px;\n    padding:7px 10px;\n    font-size:.76rem;\n  }\n  .aris-validity{\n    padding:9px 10px!important;\n  }\n}\n</style></head><body><h1 class=\"aris-doc-title-sr\" style=\"position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0\">مهارت‌های جانبی رشته‌های دانشگاهی</h1><div class=\"aris-article-shell\"><aside aria-label=\"ابزارهای مطالعه\" class=\"aris-article-tools\"><div class=\"aris-article-tools__row\"><button aria-controls=\"aris-article-search-form\" aria-expanded=\"false\" class=\"aris-search-disclosure\" type=\"button\">جست‌وجو داخل همین مطلب</button><form class=\"aris-article-search\" hidden=\"\" id=\"aris-article-search-form\" role=\"search\"><div class=\"aris-article-search__field\"><input aria-label=\"جست‌وجو داخل مطلب\" autocomplete=\"off\" id=\"aris-article-search-input\" placeholder=\"جست‌وجو داخل همین مطلب…\" type=\"search\"/><button class=\"aris-article-search__submit\" type=\"submit\">پیدا کن</button></div><div class=\"aris-article-search__meta\"><span aria-live=\"polite\" class=\"aris-article-search-status\" id=\"aris-article-search-status\"></span><span class=\"aris-article-search-nav\" hidden=\"\" id=\"aris-article-search-nav\"><button aria-label=\"نتیجه قبلی\" id=\"aris-search-prev\" type=\"button\">↑</button><button aria-label=\"نتیجه بعدی\" id=\"aris-search-next\" type=\"button\">↓</button></span></div></form><details class=\"aris-toc\"><summary>در این راهنما</summary><ol class=\"aris-toc__list\"><li><a href=\"#aris-article-section-1\">بازار کار فقط مدرک تو را ارزیابی نمی‌کند</a></li><li><a href=\"#aris-article-section-2\">مهارت‌های جانبی موردنیاز رشته‌های دانشگاهی</a></li><li><a href=\"#aris-article-section-3\">۱. مهارت جانبی چیست؟</a></li><li><a href=\"#aris-article-section-4\">۲. مهارت‌های رشته‌های پزشکی و پیراپزشکی</a></li><li><a href=\"#aris-article-section-5\">۳. مهارت‌های رشته‌های مهندسی</a></li><li><a href=\"#aris-article-section-6\">۴. مهارت‌های کامپیوتر و فناوری اطلاعات</a></li><li><a href=\"#aris-article-section-7\">۵. مهارت‌های رشته‌های انسانی</a></li><li><a href=\"#aris-article-section-8\">۶. مهارت‌های مدیریت، حسابداری و اقتصاد</a></li><li><a href=\"#aris-article-section-9\">۷. مهارت‌های رشته‌های هنر</a></li><li><a href=\"#aris-article-section-10\">۸. مهارت‌های معماری</a></li><li><a href=\"#aris-article-section-11\">۹. مهارت‌های رشته‌های زبان</a></li><li><a href=\"#aris-article-section-12\">۱۰. مهارت نرم چیست؟</a></li><li><a href=\"#aris-article-section-13\">۱۱. چگونه مهارت‌های واقعی یک رشته را بشناسیم؟</a></li><li><a href=\"#aris-article-section-14\">۱۲. سؤال مهم قبل از انتخاب رشته</a></li><li><a href=\"#aris-article-section-15\">۱۳. فرمول آمادگی شغلی</a></li></ol></details></div><div class=\"aris-validity aris-validity--stable\"><b>نوع محتوا</b><span>این مطلب ماهیت آموزشی و مفهومی دارد؛ برای تصمیم نهایی، آن را با شرایط شخصی و اطلاعات رسمی روز ترکیب کن.</span></div></aside><main id=\"mainContent\"><section class=\"intro split-intro\" id=\"guide-intro\"><div class=\"intro-grid\"><div><span class=\"intro-kicker\">مقدمه</span><h2 id=\"aris-article-section-1\">بازار کار فقط مدرک تو را ارزیابی نمی‌کند</h2><p>دانشگاه چارچوب علمی رشته را آموزش می‌دهد، اما توانایی انجام کار واقعی با تمرین، پروژه، کارآموزی و تجربه ساخته می‌شود. به همین دلیل دو فارغ‌التحصیل با مدرک یکسان می‌توانند آمادگی شغلی کاملاً متفاوتی داشته باشند.</p><p>در این راهنما مهارت‌های مهم هر خانواده رشته‌ای، نقش مهارت‌های نرم و روش‌های ساده برای کشف توانایی‌های واقعی موردنیاز بازار کار معرفی شده‌اند.</p></div><div class=\"intro-badge\"><b>۱۳</b><span>موضوع کاربردی</span></div></div><div class=\"intro-points\"><span><i>۱</i>مهارت‌های تخصصی</span><span><i>۲</i>تجربه و نمونه‌کار</span><span><i>۳</i>مهارت‌های نرم</span></div></section><section class=\"section searchable-section\" data-icon=\"consulting\" id=\"skills\"><div class=\"section-head\"><div class=\"section-no\">۱</div><div><span class=\"section-kicker\">مدرک، آغاز مسیر است</span><h2 id=\"aris-article-section-2\">مهارت‌های جانبی موردنیاز رشته‌های دانشگاهی</h2></div></div><p class=\"section-intro\">دانشگاه دانش پایه و چارچوب علمی را می‌آموزد؛ اما آمادگی شغلی با مهارت‌آموزی، تمرین، کارآموزی و تجربه واقعی ساخته می‌شود.</p><div class=\"terms\"><article class=\"term guide-topic\" id=\"term-1\"><h3 id=\"aris-article-section-3\"><span class=\"num\">۱.</span> مهارت جانبی چیست؟</h3><p>توانایی‌ای است که در کنار مدرک کمک می‌کند بهتر درس بخوان، وارد بازار کار شو یا سریع‌تر پیشرفت کن. مهارت‌های عمومی عبارت‌اند از:</p><ul><li>زبان انگلیسی</li><li>کار با کامپیوتر</li><li>جست‌وجو و تحقیق</li><li>نگارش حرفه‌ای</li><li>فن بیان و ارائه</li><li>کار تیمی</li><li>مدیریت زمان</li><li>حل مسئله</li><li>ساخت رزومه</li><li>ارتباط حرفه‌ای و شبکه‌سازی</li><li>یادگیری مستمر</li></ul></article><article class=\"term guide-topic\" id=\"term-2\"><h3 id=\"aris-article-section-4\"><span class=\"num\">۲.</span> مهارت‌های رشته‌های پزشکی و پیراپزشکی</h3><ul><li>ارتباط مناسب با بیمار و خانواده</li><li>تحمل خون، زخم و شرایط بحرانی</li><li>دقت و مسئولیت‌پذیری</li><li>توانایی کار شیفتی و شبانه</li><li>کنترل استرس و تصمیم‌گیری سریع</li><li>کار تیمی و آمادگی جسمی</li><li>رعایت اصول بهداشتی و ایمنی</li><li>اصطلاحات انگلیسی پزشکی</li><li>ثبت دقیق اطلاعات بیمار</li></ul><div class=\"topic-note\"><span>نکته</span><p>رتبه خوب به‌تنهایی کافی نیست؛ سازگاری با محیط بیمارستان و ارتباط مستقیم با بیمار را بررسی کن.</p></div></article><article class=\"term guide-topic\" id=\"term-3\"><h3 id=\"aris-article-section-5\"><span class=\"num\">۳.</span> مهارت‌های رشته‌های مهندسی</h3><ul><li>نرم‌افزارهای تخصصی</li><li>برنامه‌نویسی</li><li>طراحی و مدل‌سازی</li><li>تحلیل داده</li><li>نقشه‌خوانی</li><li>گزارش‌نویسی فنی</li><li>کار با تجهیزات آزمایشگاهی</li><li>زبان انگلیسی تخصصی</li><li>مدیریت پروژه</li><li>کارآموزی صنعتی</li><li>حل مسائل واقعی</li></ul><div class=\"topic-note\"><span>نکته</span><p>در بعضی موقعیت‌ها پروژه، کارآموزی و حل مسئله از معدل مهم‌ترند.</p></div></article><article class=\"term guide-topic\" id=\"term-4\"><h3 id=\"aris-article-section-6\"><span class=\"num\">۴.</span> مهارت‌های کامپیوتر و فناوری اطلاعات</h3><ul><li>برنامه‌نویسی</li><li>حل مسئله و الگوریتم</li><li>پایگاه داده</li><li>شبکه و سیستم‌عامل</li><li>ابزارهای کنترل نسخه</li><li>خواندن مستندات انگلیسی</li><li>ساخت پروژه واقعی</li><li>کارآموزی</li><li>رزومه و نمونه‌کار</li><li>امنیت اطلاعات</li><li>به‌روزرسانی مداوم دانش</li></ul><div class=\"topic-note\"><span>نکته</span><p>مدرک کامپیوتر بدون پروژه واقعی معمولاً آمادگی کافی برای بازار کار ایجاد نمی‌کند.</p></div></article><article class=\"term guide-topic\" id=\"term-5\"><h3 id=\"aris-article-section-7\"><span class=\"num\">۵.</span> مهارت‌های رشته‌های انسانی</h3><ul><li>مطالعه و تحلیل متن</li><li>نگارش قوی</li><li>سخنرانی و ارائه</li><li>مذاکره و مصاحبه</li><li>تحلیل داده‌های آماری</li><li>نرم‌افزارهای پژوهشی</li><li>زبان انگلیسی</li><li>شناخت قوانین و مقررات</li><li>ارتباط حرفه‌ای</li><li>تفکر انتقادی</li><li>شنیدن و درک افراد</li></ul><div class=\"topic-note\"><span>نکته</span><p>در حقوق، روان‌شناسی و مشاوره ممکن است آزمون، مجوز، کارآموزی یا تحصیلات تکمیلی نیز لازم باشد.</p></div></article><article class=\"term guide-topic\" id=\"term-6\"><h3 id=\"aris-article-section-8\"><span class=\"num\">۶.</span> مهارت‌های مدیریت، حسابداری و اقتصاد</h3><ul><li>اکسل</li><li>نرم‌افزارهای حسابداری</li><li>تحلیل مالی</li><li>گزارش‌نویسی</li><li>مالیات و بیمه</li><li>مذاکره و فروش</li><li>تحلیل داده</li><li>ارائه حرفه‌ای</li><li>کارآموزی در شرکت‌ها</li><li>مدیریت ارتباط با مشتری</li><li>شناخت فرایندهای سازمانی</li></ul><div class=\"topic-note\"><span>نکته</span><p>داشتن مدرک مدیریت به معنی مدیرشدن نیست؛ مسیر معمولاً از موقعیت‌های کارشناسی و اجرایی آغاز می‌شود.</p></div></article><article class=\"term guide-topic\" id=\"term-7\"><h3 id=\"aris-article-section-9\"><span class=\"num\">۷.</span> مهارت‌های رشته‌های هنر</h3><ul><li>طراحی و خلاقیت</li><li>رنگ و ترکیب‌بندی</li><li>نرم‌افزارهای تخصصی</li><li>ساخت پورتفولیو</li><li>عکاسی و تولید محتوا</li><li>ارائه و دفاع از اثر</li><li>قیمت‌گذاری</li><li>بازاریابی و برندسازی شخصی</li><li>ارتباط با مشتری</li><li>فعالیت پروژه‌ای</li><li>مدیریت زمان تحویل</li></ul><div class=\"topic-note\"><span>نکته</span><p>نمونه‌کار در هنر اهمیت زیادی دارد و مدرک بدون تمرین مستمر کافی نیست.</p></div></article><article class=\"term guide-topic\" id=\"term-8\"><h3 id=\"aris-article-section-10\"><span class=\"num\">۸.</span> مهارت‌های معماری</h3><ul><li>طراحی دستی</li><li>نرم‌افزارهای طراحی و مدل‌سازی</li><li>ساخت ماکت</li><li>نقشه‌کشی</li><li>شناخت مصالح</li><li>ارائه پروژه</li><li>خلاقیت فضایی</li><li>مدیریت زمان</li><li>تحمل پروژه‌های سنگین</li><li>کار تیمی</li></ul></article><article class=\"term guide-topic\" id=\"term-9\"><h3 id=\"aris-article-section-11\"><span class=\"num\">۹.</span> مهارت‌های رشته‌های زبان</h3><ul><li>خواندن متون تخصصی</li><li>نوشتن</li><li>ترجمه</li><li>دستور زبان</li><li>تلفظ و شنیدن</li><li>تحقیق و ارائه</li><li>فرهنگ و ادبیات</li><li>تمرین مستمر خارج از دانشگاه</li></ul></article><article class=\"term guide-topic\" id=\"term-10\"><h3 id=\"aris-article-section-12\"><span class=\"num\">۱۰.</span> مهارت نرم چیست؟</h3><p>مهارت‌های نرم توانایی‌های رفتاری و ارتباطی هستند:</p><ul><li>مسئولیت‌پذیری</li><li>وقت‌شناسی</li><li>کار تیمی</li><li>ارتباط مؤثر</li><li>مدیریت تعارض</li><li>انعطاف‌پذیری</li><li>پذیرش انتقاد</li><li>کنترل استرس</li><li>حل مسئله</li></ul><div class=\"topic-note\"><span>نکته</span><p>دو نفر با مدرک و معدل مشابه می‌توانند به‌دلیل تفاوت مهارت‌های نرم، عملکرد کاملاً متفاوتی در مصاحبه و محیط کار داشته باشند.</p></div></article><article class=\"term guide-topic\" id=\"term-11\"><h3 id=\"aris-article-section-13\"><span class=\"num\">۱۱.</span> چگونه مهارت‌های واقعی یک رشته را بشناسیم؟</h3><ul><li>آگهی‌های استخدام را بررسی کن</li><li>با فارغ‌التحصیلان و دانشجویان سال آخر صحبت کن</li><li>سرفصل درسی و محیط کاری را ببین</li><li>رزومه افراد موفق را بررسی کن</li><li>در یک دوره مقدماتی شرکت کن</li><li>یک پروژه کوتاه آزمایشی انجام بده</li><li>از کارفرمایان سؤال کن</li><li>نرم‌افزارهای پرکاربرد رشته را بشناس</li></ul></article><article class=\"term guide-topic\" id=\"term-12\"><h3 id=\"aris-article-section-14\"><span class=\"num\">۱۲.</span> سؤال مهم قبل از انتخاب رشته</h3><blockquote>فقط نپرس «این رشته بازار کار دارد؟»؛ بپرس «برای ورود به بازار کار این رشته چه مهارت‌هایی لازم است و آیا حاضر هستم برای یادگیری آن‌ها وقت و هزینه صرف کنم؟»</blockquote></article><article class=\"term guide-topic\" id=\"term-13\"><h3 id=\"aris-article-section-15\"><span class=\"num\">۱۳.</span> فرمول آمادگی شغلی</h3><div class=\"formula-box\">مدرک + مهارت + تجربه + ارتباط حرفه‌ای + استمرار در یادگیری</div></article></div></section></main>\n<section aria-label=\"مرز اعتبار مثال‌ها\" class=\"section aris-scope-note\"><h2>مرز اعتبار پیشنهادهای مهارتی</h2><p>مهارت‌های این صفحه نمونه‌هایی برای شناخت جنس مهارت مکمل هر خانواده رشته‌اند، نه فهرست ثابت و تضمینی. برای رشته مشخص، مهارت‌های موردنیاز را با آگهی‌های شغلی روز، شرح شغل‌ها و مرجع حرفه‌ای همان حوزه تطبیق بده.</p></section><section aria-label=\"کنترل نهایی راهنما\" class=\"section aris-standard-close\"><h2>قبل از حساب‌کردن روی مدرک</h2><div class=\"terms\"><article class=\"term\"><h3>خطای رایج</h3><p>انتظار اینکه صرف گرفتن مدرک، بدون ساختن مهارت‌های مکمل، برای ورود به بازار کار کافی باشد.</p></article><article class=\"term\"><h3>جمع‌بندی</h3><p>دانشگاه پایه علمی می‌دهد؛ اما کیفیت مسیر شغلی در بسیاری از حوزه‌ها به مهارت‌های مکمل و تجربه هم وابسته است.</p></article><article class=\"term\"><h3>اقدام بعدی</h3><p>برای هر رشته دو مهارت جانبی مهم انتخاب کن و ببین آیا واقعاً حاضر به یادگیری و تمرین آن‌ها در کنار دانشگاه هستی.</p></article></div></section><section class=\"aris-related\"><p class=\"aris-related__eyebrow\">قدم بعدی</p><h2>راهنماهای مرتبط</h2><div class=\"aris-related__grid\"><button data-related-guide=\"emkan-ya-zaroorat-edame-tahsil\" type=\"button\">امکان یا ضرورت ادامه تحصیل؟ <span aria-hidden=\"true\">←</span></button><button data-related-guide=\"bartarin-ostadan-iran\" type=\"button\">۲۰۰ استاد شاخص ایران برای شناخت مسیرهای علمی <span aria-hidden=\"true\">←</span></button></div></section></div><script>\n(function(){\nvar form=document.getElementById('aris-article-search-form'),input=document.getElementById('aris-article-search-input'),status=document.getElementById('aris-article-search-status'),nav=document.getElementById('aris-article-search-nav'),previous=document.getElementById('aris-search-prev'),next=document.getElementById('aris-search-next'),hits=[],current=-1,lastQuery='';\nfunction normalize(value){return String(value||'').toLowerCase().replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/[أإ]/g,'ا').replace(/ة/g,'ه').replace(/\\u200c/g,' ')}\nfunction clearHits(){document.querySelectorAll('mark.aris-search-hit').forEach(function(mark){var parent=mark.parentNode;parent.replaceChild(document.createTextNode(mark.textContent),mark);parent.normalize()});hits=[];current=-1;if(nav)nav.hidden=true}\nfunction collect(query){var root=document.getElementById('mainContent'),walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode:function(node){var parent=node.parentElement;return parent&&!parent.closest('script,style,mark.aris-search-hit')&&normalize(node.nodeValue).indexOf(query)>-1?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_REJECT}}),nodes=[],node;while((node=walker.nextNode())&&nodes.length<200)nodes.push(node);nodes.forEach(function(textNode){if(hits.length>=200)return;var source=textNode.nodeValue,normalized=normalize(source),from=0,index,fragment=document.createDocumentFragment();while((index=normalized.indexOf(query,from))>-1&&hits.length<200){if(index>from)fragment.appendChild(document.createTextNode(source.slice(from,index)));var mark=document.createElement('mark');mark.className='aris-search-hit';mark.textContent=source.slice(index,index+query.length);fragment.appendChild(mark);hits.push(mark);from=index+query.length}if(from<source.length)fragment.appendChild(document.createTextNode(source.slice(from)));textNode.parentNode.replaceChild(fragment,textNode)})}\nfunction show(index){if(!hits.length)return;hits.forEach(function(hit){hit.classList.remove('is-current')});current=(index+hits.length)%hits.length;hits[current].classList.add('is-current');hits[current].scrollIntoView({behavior:'smooth',block:'center'});status.textContent=hits.length+' نتیجه · '+(current+1)+' از '+hits.length;if(nav)nav.hidden=false}\nfunction runSearch(){var query=normalize(input.value.trim());if(!query){clearHits();lastQuery='';status.textContent='یک واژه یا عبارت بنویس.';return}if(query===lastQuery&&hits.length){show(current+1);return}clearHits();lastQuery=query;collect(query);if(hits.length)show(0);else status.textContent='عبارتی با این عنوان در مطلب پیدا نشد.'}\nif(form&&input){form.addEventListener('submit',function(event){event.preventDefault();runSearch()});input.addEventListener('input',function(){if(!input.value.trim()){clearHits();lastQuery='';status.textContent=''}});if(previous)previous.addEventListener('click',function(){show(current-1)});if(next)next.addEventListener('click',function(){show(current+1)})}\ndocument.querySelectorAll('[data-related-guide]').forEach(function(button){button.addEventListener('click',function(){parent.postMessage({type:'aris-guide-open',id:button.dataset.relatedGuide},'*')})});\n}());\n<\/script><script data-aris-search-disclosure=\"17\">\n(function(){\n  var disclosure=document.querySelector('.aris-search-disclosure');\n  var form=document.getElementById('aris-article-search-form');\n  if(!disclosure||!form)return;\n  disclosure.addEventListener('click',function(){\n    var open=disclosure.getAttribute('aria-expanded')==='true';\n    disclosure.setAttribute('aria-expanded',String(!open));\n    form.hidden=open;\n    if(!open){\n      var input=document.getElementById('aris-article-search-input');\n      setTimeout(function(){if(input)input.focus({preventScroll:true})},0);\n    }\n  });\n}());\n<\/script></body></html>","keywords":["مهارت جانبی","مهارت مکمل","مهارت بازار کار","رزومه","مهارت شغلی"]},{"id":"bartarin-ostadan-iran","title":"دایرکتوری ۲۰۰ استاد و پژوهشگر شاخص ایران","eyebrow":"دایرکتوری علمی","category":"future","categoryLabel":"مسیر علمی و شغلی","description":"دایرکتوری جست‌وجویی ۲۰۰ استاد و پژوهشگر در حوزه‌های مختلف؛ برای پیدا کردن شاخه‌های علمی، نهادهای مرتبط و مسیر راستی‌آزمایی در دامنه رسمی.","minutes":46,"words":8639,"dynamic":true,"document":"<!doctype html>\n<html dir=\"rtl\" lang=\"fa\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width,initial-scale=1,viewport-fit=cover\" name=\"viewport\"/><title>دایرکتوری ۲۰۰ استاد و پژوهشگر شاخص ایران</title><style>\n    :root{--ink:#17211d;--muted:#64726b;--paper:#fbfaf6;--card:#fff;--green:#12372a;--green2:#245943;--mint:#dfece4;--gold:#e0a92f;--line:#dce4df;--shadow:0 16px 42px rgba(18,55,42,.09)}\n    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:linear-gradient(180deg,#eff5f1 0,#fbfaf6 520px);color:var(--ink);font-family:Tahoma,\"Vazirmatn\",\"Segoe UI\",sans-serif;line-height:2}\n    button,input{font:inherit}.progress{position:fixed;inset:0 0 auto;z-index:99;height:4px;background:transparent}.progress span{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--gold),#f2cf79)}\n    .hero{position:relative;overflow:hidden;background:var(--green);color:white;padding:72px 24px 102px}.hero:before,.hero:after{content:\"\";position:absolute;border-radius:50%;background:rgba(255,255,255,.045)}.hero:before{width:360px;height:360px;left:-100px;top:-160px}.hero:after{width:240px;height:240px;right:-80px;bottom:-100px}.hero-inner{position:relative;max-width:1120px;margin:auto}.eyebrow{display:inline-flex;gap:8px;align-items:center;padding:7px 13px;border:1px solid rgba(255,255,255,.22);border-radius:999px;color:#dfece4;font-size:.85rem}.eyebrow:before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--gold)}h1{max-width:830px;margin:22px 0 12px;font-size:clamp(2rem,5vw,4.1rem);line-height:1.35;letter-spacing:-.04em}.lead{max-width:790px;margin:0;color:#d6e3dc;font-size:1.08rem}.hero-stats{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.hero-stats span{padding:7px 13px;border-radius:10px;background:rgba(255,255,255,.09);font-size:.88rem}\n    .layout{max-width:1180px;margin:-58px auto 80px;padding:0 22px;display:grid;grid-template-columns:285px minmax(0,1fr);gap:28px;align-items:start}.sidebar{position:sticky;top:20px;background:var(--card);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);padding:18px}.sidebar h2{font-size:1rem;margin:0 0 12px}.search{position:relative;margin-bottom:14px}.search input{width:100%;border:1px solid var(--line);border-radius:12px;background:#f8faf8;padding:10px 38px 10px 10px;outline:none;color:var(--ink)}.search input:focus{border-color:var(--green2);box-shadow:0 0 0 3px rgba(36,89,67,.1)}.search:before{content:\"⌕\";position:absolute;right:13px;top:4px;font-size:1.35rem;color:var(--muted)}.count{font-size:.78rem;color:var(--muted);margin:-6px 2px 10px}.nav{display:grid;gap:4px;max-height:58vh;overflow:auto;padding-left:4px}.nav a{color:#415049;text-decoration:none;border-radius:10px;padding:7px 9px;font-size:.85rem;line-height:1.6}.nav a:hover{background:var(--mint);color:var(--green)}.toplink{display:block;text-align:center;margin-top:12px;padding:8px;border-top:1px solid var(--line);color:var(--green2);text-decoration:none;font-size:.84rem}\n    main{min-width:0}.intro,.section{background:var(--card);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.intro{padding:28px 30px;margin-bottom:24px}.intro p{margin:0}.section{padding:30px;margin-bottom:24px}.section-head{display:flex;align-items:flex-start;gap:15px;margin-bottom:20px;padding-bottom:18px;border-bottom:1px solid var(--line)}.section-no{flex:0 0 auto;display:grid;place-items:center;width:44px;height:44px;border-radius:14px;background:var(--green);color:white;font-weight:700}.section h2{margin:0;font-size:1.45rem;line-height:1.6}.section-kicker{font-size:.8rem;color:var(--muted)}.terms{display:grid;gap:14px}.term{position:relative;border:1px solid var(--line);border-radius:16px;padding:19px 20px;background:linear-gradient(135deg,#fff,#fbfcfb)}.term:hover{border-color:#b7cbc0;box-shadow:0 8px 24px rgba(18,55,42,.06)}.term h3{margin:0 0 6px;color:var(--green);font-size:1.05rem;line-height:1.7}.term h3 .num{display:inline-block;min-width:32px;color:var(--gold);font-variant-numeric:tabular-nums}.term p{margin:5px 0}.term ul{margin:7px 0 0;padding-right:22px}.example{margin-top:10px!important;padding:10px 13px;border-right:3px solid var(--gold);background:#fff8e7;border-radius:10px;color:#544825;font-size:.93rem}.simple{color:var(--green2);font-weight:700}.hidden{display:none!important}.empty{display:none;background:#fff;border:1px dashed #b7c6bd;border-radius:18px;padding:30px;text-align:center;color:var(--muted)}mark{background:#ffe59e;border-radius:4px;padding:0 2px}\n    .mistakes{counter-reset:mistake;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.mistake{counter-increment:mistake;border:1px solid var(--line);border-radius:15px;padding:17px;background:#fff}.mistake h3{margin:0 0 5px;font-size:1rem}.mistake h3:before{content:counter(mistake,\"persian\") \". \";color:var(--gold)}.mistake p{margin:0;color:#3f4c46;font-size:.93rem}.principles{display:grid;gap:10px;counter-reset:principle}.principle{counter-increment:principle;display:flex;gap:13px;align-items:flex-start;padding:14px;border-radius:14px;background:#f4f8f5}.principle:before{content:counter(principle,\"persian\");display:grid;place-items:center;flex:0 0 34px;height:34px;border-radius:10px;background:var(--green);color:#fff;font-weight:700}.final-note{margin-top:22px;padding:18px 20px;border-radius:16px;background:var(--green);color:#eef7f1;font-size:1.05rem}.footer{text-align:center;color:var(--muted);padding:10px 20px 42px;font-size:.82rem}\n    .mobile-tools{display:none}.copy-toast{position:fixed;z-index:120;left:50%;bottom:28px;transform:translate(-50%,20px);padding:9px 16px;background:#17211d;color:white;border-radius:999px;opacity:0;pointer-events:none;transition:.25s}.copy-toast.show{opacity:1;transform:translate(-50%,0)}\n    @media(max-width:900px){.layout{grid-template-columns:1fr;margin-top:-54px}.sidebar{position:relative;top:0}.nav{grid-template-columns:repeat(2,minmax(0,1fr));max-height:none}.toplink{display:none}.hero{padding-top:54px}.mistakes{grid-template-columns:1fr}}\n    @media(max-width:560px){body{line-height:1.9}.hero{padding:42px 18px 86px}h1{font-size:2rem}.lead{font-size:.98rem}.layout{padding:0 12px;gap:16px}.sidebar,.intro,.section{border-radius:18px}.section,.intro{padding:21px 17px}.nav{grid-template-columns:1fr 1fr}.nav a{font-size:.78rem;padding:6px}.term{padding:16px 14px}.section-head{gap:10px}.section-no{width:38px;height:38px;border-radius:12px}.section h2{font-size:1.2rem}}\n    @media print{body{background:#fff}.progress,.sidebar{display:none}.hero{padding:30px;background:#fff;color:#111;border-bottom:2px solid #111}.hero .lead,.eyebrow{color:#333}.layout{display:block;margin:0;padding:0}.intro,.section{box-shadow:none;border:0;border-radius:0;break-inside:auto}.term{break-inside:avoid}.section{break-before:page}.hero-stats{color:#111}.final-note{background:#eee;color:#111}.footer{display:none}}\n  \n    .professor-intro{overflow:hidden}.benefit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:24px}.benefit-card{display:grid;grid-template-columns:34px minmax(0,1fr);grid-template-rows:auto auto;column-gap:12px;row-gap:8px;align-items:center;padding:18px;border:1px solid rgba(25,89,65,.11);border-radius:17px;background:linear-gradient(145deg,#fff,#f4f8f4);box-shadow:0 12px 30px rgba(12,48,34,.055);font-family:Tahoma,Arial,sans-serif}.benefit-card>span{position:static;grid-column:1;grid-row:1;display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:linear-gradient(145deg,#173d2e,#0a241a);color:#f6c64d;font-family:Tahoma,Arial,sans-serif;font-weight:600;font-size:.78rem}.benefit-card h3{grid-column:2;grid-row:1;margin:0;font-family:Tahoma,Arial,sans-serif;font-size:.96rem;font-weight:600;line-height:1.75;color:#173d2e}.benefit-card p{grid-column:1/-1;grid-row:2;margin:0;font-family:Tahoma,Arial,sans-serif;font-weight:400;color:#5d6b64;font-size:.83rem;line-height:2}.editorial-note{margin-top:18px;padding:19px 20px;border:1px solid rgba(245,187,53,.34);border-radius:18px;background:linear-gradient(135deg,rgba(245,187,53,.12),rgba(26,86,63,.055));position:relative}.editorial-note:before{content:\"\";position:absolute;right:0;top:16px;bottom:16px;width:4px;border-radius:4px;background:var(--gold-gradient)}.editorial-note b{color:#9b6811}.editorial-note p{margin:5px 0 0;color:#46564d}.professor-card .university{display:inline-flex;align-items:center;gap:7px;width:max-content;max-width:100%;margin:0 0 13px;padding:6px 11px;border-radius:999px;background:rgba(30,94,69,.075);border:1px solid rgba(30,94,69,.12);color:#236044;font-size:.8rem;font-weight:700}.professor-card .university span{color:#b88620;font-size:1rem}.professor-card h3{padding-left:15px}.professor-card .term-result-section{display:none}.is-searching .professor-card .term-result-section{display:inline-flex}.section-count:after{content:\" استاد\"}.professor-card.search-match{border-color:rgba(245,187,53,.55);box-shadow:0 14px 40px rgba(188,134,21,.10)}\n    @media(max-width:700px){.benefit-grid{grid-template-columns:1fr}.benefit-card{padding:16px;grid-template-columns:36px minmax(0,1fr);column-gap:13px}.benefit-card>span{width:36px;height:36px}.benefit-card h3{font-size:.94rem;line-height:1.7}.benefit-card p{font-size:.82rem;line-height:2.05}.editorial-note{padding:17px 18px}.professor-card .university{white-space:normal}}\n  \n\n    :root{\n      --aris-black:#050706;--aris-black-2:#0b100d;--aris-green:#0d2c20;--aris-green-2:#173f2e;\n      --aris-emerald:#2e7653;--aris-gold:#f5bb35;--aris-gold-2:#ffdf7d;--aris-gold-dark:#9a6610;\n      --aris-ivory:#f8f4e9;--aris-paper:#fffdf8;--aris-ink:#18211c;--aris-line:#e4dcc7;\n      --gold-gradient:linear-gradient(135deg,#8d5b09 0%,#f2af1f 27%,#fff0a5 49%,#e19a0d 68%,#8c5908 100%);\n    }\n    body{background:\n      radial-gradient(circle at 13% 8%,rgba(230,173,38,.09),transparent 24rem),\n      linear-gradient(180deg,#07100c 0 690px,var(--aris-ivory) 690px 100%);color:var(--aris-ink)}\n    body:before{content:\"\";position:fixed;inset:0;z-index:-1;opacity:.32;pointer-events:none;background-image:linear-gradient(rgba(17,61,43,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(17,61,43,.035) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,transparent 400px,#000 780px)}\n    .progress{height:5px;background:#0a1711}.progress span{position:relative;background:var(--gold-gradient);box-shadow:0 0 14px rgba(245,187,53,.85)}\n    .hero{min-height:690px;padding:0 24px 120px;background:\n      radial-gradient(circle at 78% 43%,rgba(245,187,53,.16),transparent 21rem),\n      radial-gradient(circle at 18% 20%,rgba(41,116,80,.2),transparent 26rem),\n      linear-gradient(135deg,#030504 0%,#08110d 45%,#0b2118 100%);border-bottom:1px solid rgba(245,187,53,.3)}\n    .hero:before{width:640px;height:640px;left:-260px;top:-320px;border:1px solid rgba(245,187,53,.1);background:repeating-radial-gradient(circle,transparent 0 28px,rgba(245,187,53,.025) 29px 30px)}\n    .hero:after{width:580px;height:580px;right:-180px;bottom:-350px;border:1px solid rgba(245,187,53,.13);background:repeating-radial-gradient(circle,transparent 0 38px,rgba(245,187,53,.025) 39px 40px)}\n    .hero-grid{position:absolute;inset:0;opacity:.2;pointer-events:none;background-image:linear-gradient(rgba(255,220,115,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(255,220,115,.09) 1px,transparent 1px);background-size:68px 68px;mask-image:linear-gradient(90deg,transparent,#000 35%,#000 70%,transparent)}\n    .brandbar{position:relative;z-index:4;max-width:1180px;margin:auto;min-height:96px;display:flex;align-items:center;justify-content:space-between;gap:26px;border-bottom:1px solid rgba(245,187,53,.15)}\n    .brand-banner{display:block;width:min(420px,48vw);max-height:70px;object-fit:contain;object-position:right center;filter:drop-shadow(0 0 12px rgba(245,187,53,.2))}\n    .channel-link{display:inline-flex;align-items:center;gap:9px;color:#f9eac0;text-decoration:none;padding:10px 14px;border:1px solid rgba(245,187,53,.26);border-radius:999px;background:rgba(255,255,255,.035);font-size:.86rem;transition:.25s}.channel-link:hover{border-color:var(--aris-gold);background:rgba(245,187,53,.1);transform:translateY(-2px)}.channel-link b{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:var(--gold-gradient);color:#171006}\n    .hero-inner{display:grid;grid-template-columns:minmax(0,1.14fr) minmax(330px,.86fr);gap:60px;align-items:center;padding-top:72px}\n    .hero-copy{position:relative;z-index:2}.hero .eyebrow{border-color:rgba(245,187,53,.34);background:rgba(245,187,53,.06);color:#f8deb0;backdrop-filter:blur(10px)}.hero .eyebrow:before{box-shadow:0 0 16px var(--aris-gold)}\n    .hero h1{max-width:790px;margin-top:20px;font-size:clamp(2.25rem,4.6vw,4.7rem);line-height:1.28;background:linear-gradient(180deg,#fff 0,#fbf5e7 62%,#d9c9a0 100%);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 18px 55px rgba(0,0,0,.28)}\n    .hero .lead{max-width:720px;color:#bdc9c2;font-size:1.08rem}.hero .lead strong{color:var(--aris-gold-2)}\n    .hero-actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:26px}.hero-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:11px 18px;border-radius:12px;text-decoration:none;font-weight:700;font-size:.92rem;transition:.25s}.hero-btn.primary{background:var(--gold-gradient);color:#171006;box-shadow:0 12px 34px rgba(226,159,21,.2),inset 0 1px rgba(255,255,255,.55)}.hero-btn.primary:hover{transform:translateY(-3px);box-shadow:0 17px 38px rgba(226,159,21,.3)}.hero-btn.secondary{color:#dce7e0;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.035)}.hero-btn.secondary:hover{border-color:rgba(245,187,53,.45);color:#fff}\n    .hero-stats{gap:9px;margin-top:30px}.hero-stats span{position:relative;padding:8px 13px 8px 14px;color:#d0dbd4;border:1px solid rgba(255,255,255,.085);background:rgba(255,255,255,.035);backdrop-filter:blur(8px)}.hero-stats span:before{content:\"\";display:inline-block;width:5px;height:5px;margin-left:7px;border-radius:50%;background:var(--aris-gold);box-shadow:0 0 9px var(--aris-gold)}\n    .hero-visual{position:relative;display:grid;place-items:center;min-height:410px}.logo-stage{position:relative;display:grid;place-items:center;width:min(390px,34vw);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(245,187,53,.13),rgba(13,44,32,.1) 55%,transparent 70%)}\n    .logo-stage:before,.logo-stage:after{content:\"\";position:absolute;border-radius:50%;border:1px solid rgba(245,187,53,.27)}.logo-stage:before{inset:4%;box-shadow:0 0 55px rgba(245,187,53,.09),inset 0 0 45px rgba(245,187,53,.06)}.logo-stage:after{inset:-8%;border-style:dashed;animation:orbit 34s linear infinite}\n    .hero-logo{position:relative;z-index:2;width:78%;aspect-ratio:1;object-fit:cover;border-radius:50%;mix-blend-mode:screen;filter:contrast(1.08) drop-shadow(0 17px 45px rgba(0,0,0,.6)) drop-shadow(0 0 18px rgba(245,187,53,.18))}\n    .spark{position:absolute;z-index:3;width:8px;height:8px;background:var(--aris-gold-2);transform:rotate(45deg);box-shadow:0 0 17px 5px rgba(245,187,53,.34);animation:pulse 2.8s ease-in-out infinite}.spark.s1{top:11%;right:14%}.spark.s2{bottom:17%;left:10%;animation-delay:-1.2s}.spark.s3{top:45%;left:-2%;width:5px;height:5px;animation-delay:-2s}\n    .orbit-label{position:absolute;z-index:5;padding:7px 12px;border:1px solid rgba(245,187,53,.24);border-radius:999px;background:rgba(5,11,8,.8);color:#e9e3d2;font-size:.78rem;box-shadow:0 10px 28px rgba(0,0,0,.32);backdrop-filter:blur(8px)}.orbit-label.l1{top:18%;right:-5%}.orbit-label.l2{bottom:14%;right:5%}.orbit-label.l3{top:45%;left:-7%}.orbit-label:before{content:\"✦\";color:var(--aris-gold);margin-left:6px}\n    @keyframes orbit{to{transform:rotate(360deg)}}@keyframes pulse{50%{opacity:.35;transform:rotate(45deg) scale(.55)}}\n    .layout{max-width:1210px;margin:-68px auto 90px;grid-template-columns:300px minmax(0,1fr);gap:30px}.sidebar{top:18px;border-color:rgba(245,187,53,.24);border-radius:24px;padding:0;overflow:hidden;background:linear-gradient(160deg,#0a1510,#08100d);box-shadow:0 28px 70px rgba(6,21,14,.22),inset 0 1px rgba(255,255,255,.04)}\n    .mini-brand{position:relative;display:flex;align-items:center;gap:12px;padding:18px 18px 15px;border-bottom:1px solid rgba(245,187,53,.14);overflow:hidden}.mini-brand:after{content:\"\";position:absolute;width:90px;height:90px;left:-28px;top:-44px;border-radius:50%;background:rgba(245,187,53,.08);filter:blur(5px)}.mini-mark{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:var(--gold-gradient);color:#151006;font-family:Georgia,serif;font-size:1.65rem;font-weight:700;box-shadow:0 9px 24px rgba(230,168,34,.22)}.mini-brand strong{display:block;color:#fff;font-family:Georgia,Tahoma,serif;letter-spacing:.04em}.mini-brand small{display:block;color:#8fa197;font-size:.7rem;line-height:1.4}.sidebar-content{padding:16px}.sidebar h2{color:#f3ead1}.search input{border-color:rgba(255,255,255,.09);background:rgba(255,255,255,.045);color:#fff}.search input::placeholder{color:#73857b}.search input:focus{border-color:var(--aris-gold);box-shadow:0 0 0 3px rgba(245,187,53,.09)}.search:before{color:var(--aris-gold)}.count{color:#778a7f}.nav{padding-left:5px}.nav a{position:relative;color:#9eb0a6;padding:8px 11px;border:1px solid transparent}.nav a:hover{color:#fff;background:rgba(245,187,53,.07);border-color:rgba(245,187,53,.12);padding-right:15px}.nav a:before{content:\"\";display:inline-block;width:4px;height:4px;border-radius:50%;margin-left:8px;background:#466556}.nav a:hover:before{background:var(--aris-gold);box-shadow:0 0 8px var(--aris-gold)}.toplink{color:#ddbd67;border-color:rgba(245,187,53,.12)}\n    .intro,.section{position:relative;border:1px solid var(--aris-line);background:rgba(255,253,248,.96);box-shadow:0 20px 55px rgba(30,50,39,.08);overflow:hidden}.intro:before,.section:before{content:\"\";position:absolute;inset:0 auto auto 0;width:160px;height:3px;background:var(--gold-gradient)}.intro{padding:30px 32px;border-radius:24px}.intro-grid{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:24px;align-items:center}.intro-kicker{display:inline-flex;align-items:center;gap:8px;color:var(--aris-gold-dark);font-size:.76rem;font-weight:700;letter-spacing:.04em}.intro-kicker:before{content:\"\";width:22px;height:1px;background:var(--aris-gold)}.intro h2{margin:5px 0 7px;color:var(--aris-green);font-size:1.28rem}.intro p{color:#59655e}.intro-badge{position:relative;display:grid;place-items:center;min-height:118px;border:1px solid #eadcb9;border-radius:18px;background:radial-gradient(circle at 50% 35%,#fff7db,#f3e7c7);text-align:center;overflow:hidden}.intro-badge:before{content:\"A\";position:absolute;color:rgba(154,102,16,.07);font:700 8rem/1 Georgia}.intro-badge b{position:relative;display:block;font-size:2rem;color:var(--aris-green);line-height:1.2}.intro-badge span{position:relative;color:#89703a;font-size:.75rem}\n    .section{padding:31px;border-radius:24px}.section-head{position:relative;align-items:center;margin-bottom:22px;padding-bottom:20px;border-color:#ebe4d3}.section-no{position:relative;width:52px;height:52px;border-radius:16px;background:linear-gradient(145deg,var(--aris-green-2),#081c13);color:var(--aris-gold-2);border:1px solid rgba(245,187,53,.28);box-shadow:0 10px 24px rgba(13,44,32,.18)}.section-no:after{content:\"\";position:absolute;inset:5px;border:1px solid rgba(245,187,53,.13);border-radius:11px}.section h2{color:var(--aris-green);letter-spacing:-.015em}.section-kicker{color:#9a7a2f;font-weight:700}.section-head:after{content:\"ARIS ACADEMY\";position:absolute;left:0;bottom:18px;color:#cbbf9f;font:600 .64rem/1 Georgia,serif;letter-spacing:.16em}\n    .terms{gap:12px}.term{padding:20px 21px 20px 20px;border-color:#e6dfcf;border-radius:17px;background:linear-gradient(135deg,#fffefb,#faf7ef);box-shadow:0 5px 18px rgba(19,49,34,.025);transition:.25s}.term:before{content:\"\";position:absolute;right:0;top:18px;bottom:18px;width:3px;border-radius:3px;background:linear-gradient(var(--aris-gold-2),var(--aris-gold-dark));opacity:.65}.term:hover{transform:translateY(-2px);border-color:#d7c38d;box-shadow:0 14px 34px rgba(31,54,42,.08)}.term h3{color:var(--aris-green);font-size:1.08rem}.term h3 .num{min-width:39px;color:var(--aris-gold-dark);font-weight:800}.term p{color:#414d46}.example{position:relative;margin-top:12px!important;padding:12px 16px!important;border:0!important;border-radius:12px!important;background:linear-gradient(90deg,#fff4ce,#faf1d8)!important;color:#544625!important}.example:before{content:\"✦\";color:#ad730c;margin-left:7px}.simple{color:var(--aris-green)}\n    .mistakes{gap:13px}.mistake{position:relative;border-color:#e7ddc6;background:linear-gradient(145deg,#fffefa,#faf5e9);overflow:hidden;transition:.25s}.mistake:hover{transform:translateY(-3px);border-color:#d6be82;box-shadow:0 12px 30px rgba(32,52,41,.07)}.mistake:after{content:counter(mistake,\"persian\");position:absolute;left:9px;bottom:-15px;color:rgba(24,63,45,.055);font:700 5rem/1 Tahoma}.mistake h3:before{display:inline-grid;place-items:center;width:28px;height:28px;margin-left:7px;border-radius:9px;background:#f7e7b6;color:#805308}\n    .principle{border:1px solid #e4dcc8;background:linear-gradient(90deg,#f9f3e4,#fffdf8)}.principle:before{background:linear-gradient(145deg,var(--aris-green-2),#07170f);color:var(--aris-gold-2);border:1px solid rgba(245,187,53,.25)}.final-note{position:relative;background:linear-gradient(135deg,#081a12,#123a29);border:1px solid rgba(245,187,53,.28);color:#f2ede0;box-shadow:0 18px 40px rgba(8,31,21,.18);overflow:hidden}.final-note:after{content:\"A\";position:absolute;left:18px;top:-28px;color:rgba(245,187,53,.07);font:700 8rem/1 Georgia}\n    .footer{position:relative;padding:54px 20px 46px;background:linear-gradient(180deg,#07100c,#020302);color:#7e9286;border-top:1px solid rgba(245,187,53,.18)}.footer-brand{display:block;width:min(460px,80vw);max-height:90px;object-fit:contain;margin:0 auto 18px;filter:drop-shadow(0 0 13px rgba(245,187,53,.12))}.footer p{margin:0}.footer:before{content:\"\";position:absolute;top:0;left:50%;width:min(620p