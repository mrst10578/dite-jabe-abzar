:hover{opacity:1;border-color:#c79b3d;background:#f9e8ba}.term-favorite[aria-pressed=\"true\"]{opacity:1;color:#9b6500;background:#ffe5a0;border-color:#c8962d;text-shadow:0 1px #fff}\n    .related-box{margin-top:15px;padding:12px 13px;border:1px solid #e5dac0;border-radius:13px;background:#fbf7ec}.related-box strong{display:block;margin-bottom:7px;color:#516158;font-size:.75rem}.related-links{display:flex;flex-wrap:wrap;gap:6px}.related-link{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:#e7efe9;color:#27553f;text-decoration:none;font-size:.7rem;font-weight:700}.related-link:before{content:\"↗\";color:#a97814}.related-link:hover{background:#d7e7dc;color:#153e2b}\n    .compare-section{position:relative;margin:0 0 20px;padding:28px;border:1px solid var(--aris-line);border-radius:24px;background:linear-gradient(150deg,#fffdf8,#f6efdc);box-shadow:0 18px 48px rgba(30,50,39,.07);overflow:hidden}.compare-section:before{content:\"\";position:absolute;right:-55px;top:-80px;width:180px;height:180px;border:1px solid rgba(160,111,19,.13);border-radius:50%;box-shadow:0 0 0 28px rgba(160,111,19,.035),0 0 0 56px rgba(160,111,19,.025)}.compare-head{position:relative;display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:17px}.compare-head h2{margin:0;color:var(--aris-green);font-size:1.25rem}.compare-head p{margin:0;color:#78847d;font-size:.78rem}.compare-grid{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.compare-card{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;padding:14px;border:1px solid #e7dbc0;border-radius:15px;background:rgba(255,255,255,.72)}.compare-side b{display:block;color:#173c2b;font-size:.85rem}.compare-side span{display:block;color:#66736b;font-size:.72rem;line-height:1.75}.compare-vs{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--gold-gradient);color:#241705;font-size:.62rem;font-weight:900}.compare-card a{color:inherit;text-decoration:none}.compare-card a:hover b{color:#9a6811}\n    .mobile-favorites{width:100%;margin:-3px 0 12px;padding:9px;border:1px solid rgba(245,187,53,.2);border-radius:11px;background:rgba(245,187,53,.06);color:#e7cf8e;cursor:pointer}.mobile-favorites.active{background:var(--gold-gradient);color:#151006}\n    .resume-badge{position:fixed;z-index:89;left:18px;bottom:22px;display:none;align-items:center;gap:9px;padding:10px 13px;border:1px solid rgba(245,187,53,.3);border-radius:13px;background:#09150f;color:#ecdfbc;box-shadow:0 16px 40px rgba(0,0,0,.28);font-size:.76rem}.resume-badge.show{display:flex}.resume-badge button{border:0;border-radius:8px;background:var(--gold-gradient);color:#171006;padding:5px 8px;cursor:pointer;font-weight:700}.resume-badge .dismiss{background:transparent;color:#a6b6ad;padding:3px}\n    @media(max-width:768px){.compare-grid{grid-template-columns:1fr}.resume-badge{bottom:84px;left:10px;right:10px;justify-content:center}}\n    @media(max-width:900px){.logo-stage{margin-bottom:58px}.orbit-labels{position:absolute;z-index:6;right:-7%;left:-7%;bottom:-54px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.orbit-label.l1,.orbit-label.l2,.orbit-label.l3{position:relative;inset:auto;display:flex;align-items:center;justify-content:center;min-width:0;width:100%;transform:none;padding:7px 6px;text-align:center}.orbit-label:after{display:none}}\n    @media(max-width:390px){.orbit-labels{right:-10%;left:-10%;gap:8px}.orbit-label{font-size:.62rem!important;padding:6px 4px!important}}\n    @media(max-width:560px){.term-favorite{width:32px;height:32px}.compare-section{padding:22px 16px}.compare-head{display:block}.compare-head p{margin-top:3px}.compare-card{grid-template-columns:1fr}.compare-vs{width:auto;height:22px;border-radius:7px}.related-links{display:grid}.related-link{justify-content:center}}\n    @media(max-width:390px){.hero h1{font-size:1.9rem}.brand-banner{width:61vw}.channel-link{padding:7px}.layout{padding:0 9px}.term-head{gap:7px}.term-actions{gap:4px}.term-link,.term-favorite{width:29px;height:29px}.term-chevron{width:25px;height:25px}.mobile-bar{right:6px;left:6px;bottom:6px}.compare-card{padding:12px}}\n    @media(min-width:1440px){.layout{max-width:1260px}.hero-inner,.brandbar{max-width:1240px}.section{padding:34px}.term h3{font-size:1.11rem}}\n    @media print{.compare-section{break-inside:avoid}.term-favorite,.related-box,.resume-badge{display:none!important}}\n  \n\nhtml{scroll-padding-top:22px;background:#070806;color-scheme:dark}body{min-width:0;margin:0;background:radial-gradient(circle at 50% -10%,rgba(229,182,62,.09),transparent 28rem),linear-gradient(180deg,#090a08,#050605)!important;color:#f5f0e5!important;font-family:\"Vazirmatn\",Tahoma,\"Segoe UI\",sans-serif!important;overflow-x:hidden}\nbody:before,.progress,.share-section,.footer{display:none!important}.aris-article-shell{width:min(100%,1020px);margin:0 auto;padding:clamp(14px,3.5vw,34px)}\n.aris-article-tools{position:relative;margin:0 0 16px;padding:16px;border:1px solid rgba(229,182,62,.26);border-radius:18px;background:linear-gradient(145deg,rgba(25,25,20,.96),rgba(14,15,12,.98));box-shadow:0 18px 50px rgba(0,0,0,.26)}\n.aris-article-tools__row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:start}.aris-article-search{position:relative}.aris-article-search__field{position:relative}.aris-article-search input{width:100%;height:46px;padding:0 14px 0 88px;border:1px solid rgba(229,182,62,.2);border-radius:12px;background:#090a08;color:#fff8e7;outline:0;font-size:15px}.aris-article-search input:focus{border-color:#e5b63e;box-shadow:0 0 0 4px rgba(229,182,62,.11)}.aris-article-search__submit{position:absolute;inset:5px auto 5px 5px;min-width:76px;border:0;border-radius:9px;background:linear-gradient(145deg,#f2ca64,#bd8720);color:#171108;font-weight:800;cursor:pointer}.aris-article-search__meta{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:29px;margin-top:5px}.aris-article-search-status{color:#aaa292;font-size:11px}.aris-article-search-nav{display:flex;gap:4px}.aris-article-search-nav[hidden]{display:none}.aris-article-search-nav button{min-width:34px;height:28px;border:1px solid rgba(229,182,62,.2);border-radius:8px;background:rgba(229,182,62,.06);color:#e7c873;cursor:pointer}.aris-search-hit{padding:0 2px;border-radius:4px;background:#80651d;color:#fff8dc}.aris-search-hit.is-current{background:#ffd66d;color:#171108;box-shadow:0 0 0 3px rgba(255,214,109,.18)}\n.aris-toc{min-width:170px}.aris-toc summary{min-height:46px;display:flex;align-items:center;justify-content:center;padding:8px 14px;border:1px solid rgba(143,164,115,.28);border-radius:12px;color:#c8d9aa;background:rgba(102,115,74,.08);cursor:pointer;font-size:13px}.aris-toc[open] summary{border-radius:12px 12px 0 0}.aris-toc__list{display:grid;gap:3px;max-height:280px;overflow:auto;margin:0;padding:10px;border:1px solid rgba(143,164,115,.24);border-top:0;border-radius:0 0 12px 12px;background:#0b0d0a;list-style:none}.aris-toc__list a{display:block;padding:8px 9px;border-radius:8px;color:#d7d0c1;text-decoration:none;font-size:12px;line-height:1.7}.aris-toc__list a:hover{color:#ffe09a;background:rgba(229,182,62,.07)}\n.aris-validity{display:flex;align-items:flex-start;gap:10px;margin-top:12px;padding:12px 13px;border:1px solid rgba(229,182,62,.22);border-radius:12px;background:rgba(229,182,62,.055);color:#d8cfbc;font-size:12px;line-height:1.9}.aris-validity b{flex:0 0 auto;color:#f0c65d}.aris-validity--stable{border-color:rgba(143,164,115,.23);background:rgba(102,115,74,.06)}.aris-validity--stable b{color:#b7c995}\n#mainContent{display:block!important;width:100%!important;max-width:none!important;margin:0!important;padding:0!important;color:#f5f0e5!important}#mainContent,#mainContent button,#mainContent input,#mainContent select,#mainContent textarea,#mainContent a{font-family:\"Vazirmatn\",Tahoma,\"Segoe UI\",sans-serif!important}\n#mainContent>.intro:first-child{margin-top:0!important}#mainContent .intro,#mainContent .section,#mainContent .compare-section{border:1px solid rgba(229,182,62,.2)!important;border-radius:20px!important;background:linear-gradient(145deg,rgba(21,22,18,.98),rgba(13,14,12,.99))!important;box-shadow:0 16px 44px rgba(0,0,0,.22)!important}\n#mainContent .term,#mainContent .mistake,#mainContent .principle,#mainContent .professor-card,#mainContent .benefit-card,#mainContent .compare-card,#mainContent .compare-side,#mainContent .research-box,#mainContent .summary-row,#mainContent .mini-compare>div,#mainContent .map-card{border-color:rgba(143,164,115,.22)!important;background:rgba(102,115,74,.055)!important;color:#f1ecdf!important;box-shadow:none!important}\n#mainContent .term{padding:20px 30px 20px 20px!important}\n#mainContent .section-intro,#mainContent .topic-note,#mainContent .editorial-note,#mainContent .example{border-color:rgba(229,182,62,.2)!important;background:rgba(229,182,62,.055)!important;color:#e1d9c9!important}\n#mainContent .visual-summary,#mainContent .final-note,#mainContent .formula-box,#mainContent .subgroup-label{background:linear-gradient(145deg,#172017,#0d120e)!important;border:1px solid rgba(143,164,115,.24)!important;color:#f5f0e5!important}\n#mainContent h2,#mainContent h3,#mainContent h4,#mainContent b,#mainContent strong{color:#edc96f!important}#mainContent p,#mainContent li,#mainContent small,#mainContent .university,#mainContent .section-kicker,#mainContent .intro-kicker{color:#ddd6c9!important}#mainContent p,#mainContent li{font-size:clamp(17px,2.1vw,19px)!important;line-height:2.05!important}#mainContent h2{font-size:clamp(24px,4vw,33px)!important;line-height:1.55!important}#mainContent h3{font-size:clamp(19px,3vw,23px)!important;line-height:1.7!important}\n#mainContent .section-head{border-bottom-color:rgba(229,182,62,.18)!important}#mainContent .section-no,#mainContent .intro-badge,#mainContent .num{color:#f3cf75!important}#mainContent .section-no{background:#26321f!important}#mainContent a{color:#e7c46c!important}#mainContent [id]{scroll-margin-top:18px}\n.aris-related{margin:24px 0 10px;padding:20px;border:1px solid rgba(143,164,115,.25);border-radius:20px;background:linear-gradient(145deg,rgba(20,24,18,.97),rgba(12,14,11,.99))}.aris-related__eyebrow{margin:0;color:#9eb183;font-size:12px}.aris-related h2{margin:5px 0 15px;color:#f0cb72;font-size:22px}.aris-related__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.aris-related button{padding:14px;border:1px solid rgba(229,182,62,.18);border-radius:13px;background:rgba(229,182,62,.04);color:#f4eee1;text-align:right;cursor:pointer;font-size:14px;line-height:1.8}.aris-related button:hover{border-color:rgba(229,182,62,.5);background:rgba(229,182,62,.08)}\n@media(max-width:620px){.aris-article-shell{padding:10px}.aris-article-tools{padding:12px;border-radius:15px}.aris-article-tools__row{grid-template-columns:1fr}.aris-toc{min-width:0}.aris-related__grid{grid-template-columns:1fr}#mainContent .intro,#mainContent .section,#mainContent .compare-section{padding:20px 15px!important;border-radius:16px!important}#mainContent .term{padding:18px 25px 18px 17px!important}#mainContent p,#mainContent li{font-size:17px!important;line-height:2!important}}\n\n.aris-source-standard{margin:24px 0 4px;padding:18px 20px;border:1px solid rgba(30,84,64,.16);border-radius:17px;background:linear-gradient(145deg,#f4f8f5,#fffaf0);box-shadow:0 10px 28px rgba(18,55,42,.05)}\n.aris-source-standard h2{margin:0 0 8px!important;color:#173d2e!important;font-size:1.02rem!important}.aris-source-standard p{margin:5px 0!important;color:#5d6b64;font-size:.86rem;line-height:1.9}.aris-source-meta{display:flex;flex-wrap:wrap;gap:7px;margin:10px 0 12px}.aris-source-meta span{padding:5px 9px;border-radius:8px;background:#123b2b;color:#f5d16b;font-size:.72rem}.aris-source-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.aris-source-links a{display:inline-flex;align-items:center;gap:5px;padding:7px 10px;border:1px solid rgba(28,88,65,.16);border-radius:9px;background:#fff;color:#1c5841;text-decoration:none;font-size:.78rem}.aris-source-links a:hover{border-color:#c89b33;color:#8a6414}.aris-source-warning{margin-top:12px!important;padding:10px 12px;border-right:3px solid #d2a432;border-radius:10px;background:#fff7df!important;color:#5f542f!important}\n\n</style><style>\n.aris-source-docs{display:grid;gap:10px;margin:14px 0}.aris-source-doc{padding:13px 14px;border:1px solid rgba(28,88,65,.13);border-radius:12px;background:#f8faf8}.aris-source-doc b{display:block;color:#174a35;font-size:.84rem}.aris-source-doc p{margin:4px 0!important;color:#5e6b64;font-size:.78rem;line-height:1.85}.aris-source-doc a{display:inline-flex;margin-top:7px;color:#9b6d15;text-decoration:none;font-size:.74rem;font-weight:700}.aris-source-note{margin-top:10px!important;padding:10px 12px;border-radius:10px;background:#fff8e8;color:#65583a!important;font-size:.78rem!important}\n</style><style data-aris-reader-refinement=\"17\">\n/* Shell 17: compact collapsible in-article search + softer highlight card. */\n.aris-search-disclosure{\n  width:100%;\n  min-height:42px;\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:10px;\n  padding:8px 12px;\n  border:1px solid rgba(224,169,47,.18);\n  border-radius:11px;\n  background:rgba(224,169,47,.04);\n  color:#d9bd83;\n  cursor:pointer;\n  font:inherit;\n  font-size:.8rem;\n  font-weight:700;\n}\n.aris-search-disclosure::after{\n  content:\"⌕\";\n  color:#e0a92f;\n  font-size:1rem;\n}\n.aris-search-disclosure[aria-expanded=\"true\"]{\n  border-color:rgba(224,169,47,.34);\n  background:rgba(224,169,47,.075);\n}\n.aris-search-disclosure[aria-expanded=\"true\"]::after{\n  content:\"×\";\n}\n.aris-search-disclosure + .aris-article-search{\n  margin-top:10px;\n}\n.aris-article-search[hidden]{\n  display:none!important;\n}\n.aris-article-tools__row{\n  gap:9px!important;\n}\n.aris-validity{\n  padding:10px 12px!important;\n  border-color:rgba(224,169,47,.13)!important;\n  background:rgba(224,169,47,.025)!important;\n}\n.aris-validity b{\n  font-size:.75rem!important;\n}\n.aris-validity span{\n  font-size:.76rem!important;\n  line-height:1.85!important;\n}\n.intro-badge{\n  border-color:#cbb37b!important;\n  background:radial-gradient(circle at 50% 34%,#eee0bb,#d8c59b)!important;\n}\n.intro-badge b{\n  color:#153c2b!important;\n}\n.intro-badge span{\n  color:#735d2d!important;\n}\n@media(max-width:560px){\n  .aris-search-disclosure{\n    min-height:40px;\n    padding:7px 10px;\n    font-size:.76rem;\n  }\n  .aris-validity{\n    padding:9px 10px!important;\n  }\n}\n</style></head><body><h1 class=\"aris-doc-title-sr\" style=\"position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0\">اصطلاحات انتخاب رشته کنکور سراسری</h1><div class=\"aris-article-shell\"><aside aria-label=\"ابزارهای مطالعه\" class=\"aris-article-tools\"><div class=\"aris-article-tools__row\"><button aria-controls=\"aris-article-search-form\" aria-expanded=\"false\" class=\"aris-search-disclosure\" type=\"button\">جست‌وجو داخل همین مطلب</button><form class=\"aris-article-search\" hidden=\"\" id=\"aris-article-search-form\" role=\"search\"><div class=\"aris-article-search__field\"><input aria-label=\"جست‌وجو داخل مطلب\" autocomplete=\"off\" id=\"aris-article-search-input\" placeholder=\"جست‌وجو داخل همین مطلب…\" type=\"search\"/><button class=\"aris-article-search__submit\" type=\"submit\">پیدا کن</button></div><div class=\"aris-article-search__meta\"><span aria-live=\"polite\" class=\"aris-article-search-status\" id=\"aris-article-search-status\"></span><span class=\"aris-article-search-nav\" hidden=\"\" id=\"aris-article-search-nav\"><button aria-label=\"نتیجه قبلی\" id=\"aris-search-prev\" type=\"button\">↑</button><button aria-label=\"نتیجه بعدی\" id=\"aris-search-next\" type=\"button\">↓</button></span></div></form><details class=\"aris-toc\"><summary>در این راهنما</summary><ol class=\"aris-toc__list\"><li><a href=\"#aris-article-section-1\">هر اصطلاح، یک قدم به انتخاب مطمئن‌تر</a></li><li><a href=\"#compareTitle\">مفهوم‌هایی که معمولاً با هم اشتباه می‌شوند</a></li><li><a href=\"#aris-article-section-3\">اصطلاحات مهم کارنامه کنکور</a></li><li><a href=\"#aris-article-section-4\">اصطلاحات اصلی انتخاب رشته</a></li><li><a href=\"#aris-article-section-5\">بومی‌گزینی</a></li><li><a href=\"#aris-article-section-6\">سهمیه‌ها</a></li><li><a href=\"#aris-article-section-7\">انواع دوره‌ها و دانشگاه‌ها</a></li><li><a href=\"#aris-article-section-8\">شیوه‌های پذیرش</a></li><li><a href=\"#aris-article-section-9\">تعهدها و محدودیت‌ها</a></li><li><a href=\"#aris-article-section-10\">هزینه‌ها و امکانات دانشگاه</a></li><li><a href=\"#aris-article-section-11\">اصطلاحات رایج مشاوران انتخاب رشته</a></li><li><a href=\"#aris-article-section-12\">بخش‌های مهم دفترچه انتخاب رشته</a></li><li><a href=\"#aris-article-section-13\">اشتباهات رایج در انتخاب رشته</a></li><li><a href=\"#aris-article-section-14\">پنج اصل یک انتخاب رشته درست</a></li></ol></details></div><div class=\"aris-validity\"><b>اطلاعات متغیر</b><span>تعریف‌ها و ضوابط ممکن است در دفترچه هر سال تغییر کنند. مرجع نهایی، دفترچه و اطلاعیه رسمی همان سال است.</span></div></aside><main id=\"mainContent\">\n<section class=\"intro\">\n<div class=\"intro-grid\">\n<div><span class=\"intro-kicker\">قبل از شروع</span><h2 id=\"aris-article-section-1\">هر اصطلاح، یک قدم به انتخاب مطمئن‌تر</h2><p>مهم‌ترین اصطلاحات انتخاب رشته به زبان ساده و در ده مسیر موضوعی چیده شده‌اند. برای پیداکردن سریع هر موضوع، از جست‌وجو یا فهرست بخش‌ها کمک بگیر.</p></div>\n<div class=\"intro-badge\"><b>۱۰۰</b><span>مفهوم ضروری</span></div>\n</div>\n</section>\n<section aria-labelledby=\"compareTitle\" class=\"compare-section\" id=\"quickCompare\">\n<div class=\"compare-head\"><div><span class=\"intro-kicker\">مقایسه در یک نگاه</span><h2 id=\"compareTitle\">مفهوم‌هایی که معمولاً با هم اشتباه می‌شوند</h2></div><p>برای توضیح کامل روی عنوان هر مفهوم بزن.</p></div>\n<div class=\"compare-grid\">\n<article class=\"compare-card\"><a class=\"compare-side\" href=\"#term-1\"><b>درصد</b><span>مقدار امتیاز خام هر درس</span></a><span class=\"compare-vs\">VS</span><a class=\"compare-side\" href=\"#term-2\"><b>تراز</b><span>جایگاه عملکرد نسبت به دیگران</span></a></article>\n<article class=\"compare-card\"><a class=\"compare-side\" href=\"#term-9\"><b>رتبه کشوری</b><span>جایگاه میان کل داوطلبان</span></a><span class=\"compare-vs\">VS</span><a class=\"compare-side\" href=\"#term-10\"><b>رتبه در سهمیه</b><span>جایگاه میان سهمیه مشابه</span></a></article>\n<article class=\"compare-card\"><a class=\"compare-side\" href=\"#term-15\"><b>رشته</b><span>موضوعی که در دانشگاه می‌خوانی</span></a><span class=\"compare-vs\">VS</span><a class=\"compare-side\" href=\"#term-19\"><b>رشته‌محل</b><span>ترکیب رشته، دانشگاه و محل</span></a></article>\n<article class=\"compare-card\"><a class=\"compare-side\" href=\"#term-49\"><b>روزانه</b><span>دوره اصلی دانشگاه دولتی</span></a><span class=\"compare-vs\">VS</span><a class=\"compare-side\" href=\"#term-50\"><b>نوبت دوم</b><span>دوره شهریه‌پرداز دانشگاه دولتی</span></a></article>\n<article class=\"compare-card\"><a class=\"compare-side\" href=\"#term-60\"><b>با آزمون</b><span>پذیرش با نمره کل و رتبه</span></a><span class=\"compare-vs\">VS</span><a class=\"compare-side\" href=\"#term-61\"><b>براساس سوابق</b><span>رقابت براساس سوابق تحصیلی</span></a></article>\n<article class=\"compare-card\"><a class=\"compare-side\" href=\"#term-74\"><b>انتقالی</b><span>تغییر دانشگاه اصلی دانشجو</span></a><span class=\"compare-vs\">VS</span><a class=\"compare-side\" href=\"#term-75\"><b>مهمانی</b><span>تحصیل موقت در دانشگاه دیگر</span></a></article>\n</div>\n</section>\n<section class=\"section searchable-section\" id=\"karname\">\n<div class=\"section-head\"><span class=\"section-no\">۱</span><div><div class=\"section-kicker\">اصطلاحات ۱ تا ۱۴</div><h2 id=\"aris-article-section-3\">اصطلاحات مهم کارنامه کنکور</h2></div></div>\n<div class=\"terms\">\n<article class=\"term\" id=\"term-1\"><h3><span class=\"num\">۱.</span> نمره خام یا درصد</h3><p>نمره خام همان درصدی است که در هر درس به دست آورده‌ای و با توجه به تعداد پاسخ‌های درست، غلط و نزده محاسبه می‌شود. به‌دلیل وجود نمره منفی، پاسخ غلط می‌تواند بخشی از امتیاز پاسخ‌های درست را از بین ببرد.</p><p class=\"example\">اگر درصد زیست‌شناسی تو ۴۵ باشد، لزوماً دقیقاً ۴۵ درصد سؤال‌ها را درست جواب نداده‌ای؛ پاسخ‌های غلط هم در نتیجه اثر داشته‌اند.</p></article>\n<article class=\"term\" id=\"term-2\"><h3><span class=\"num\">۲.</span> تراز</h3><p>تراز نمره‌ای است که سطح علمی تو را در مقایسه با سایر داوطلبان نشان می‌دهد و سختی آزمون و عملکرد کلی شرکت‌کنندگان را در نظر می‌گیرد.</p><p class=\"example\"><span class=\"simple\">به زبان ساده:</span> درصد می‌گوید چه مقدار از امتیاز درس را گرفته‌ای؛ تراز نشان می‌دهد نسبت به بقیه در چه سطحی قرار داری.</p></article>\n<article class=\"term\" id=\"term-3\"><h3><span class=\"num\">۳.</span> نمره کل آزمون اختصاصی</h3><p>امتیازی است که از عملکرد تو در درس‌های تخصصی ساخته می‌شود. این نمره میانگین ساده درصدها نیست؛ درصد هر درس با توجه به ضریب، دشواری آزمون و عملکرد سایر داوطلبان به نمره تراز تبدیل می‌شود.</p></article>\n<article class=\"term\" id=\"term-4\"><h3><span class=\"num\">۴.</span> سابقه تحصیلی</h3><p>منظور نمرات امتحانات نهایی مؤثر در نتیجه کنکور است. سابقه تحصیلی با معدل ساده کارنامه یکسان نیست؛ نمره هر درس، ضریب آن و نحوه ترازشدن نمرات اهمیت دارد.</p></article>\n<article class=\"term\" id=\"term-5\"><h3><span class=\"num\">۵.</span> نمره کل سابقه تحصیلی</h3><p>نمرات نهایی داوطلب با توجه به ضرایب درس‌ها و عملکرد سایر دانش‌آموزان به نمره‌ای استاندارد تبدیل می‌شود. بنابراین نمره کل سابقه تحصیلی همان معدل کتبی یا معدل دیپلم نیست.</p><p class=\"example\">دو داوطلب با معدل کتبی ۱۸ می‌توانند به‌دلیل تفاوت نمره درس‌هایشان، نمره کل سابقه تحصیلی متفاوتی داشته باشند.</p></article>\n<article class=\"term\" id=\"term-6\"><h3><span class=\"num\">۶.</span> ترمیم نمره یا ترمیم معدل</h3><p>فرصتی است که به داوطلب داده می‌شود تا دوباره در امتحان نهایی بعضی درس‌ها شرکت کند و نمره مناسب‌تری برای سابقه تحصیلی به دست آورد. در عمل نمره درس‌های مشخص اهمیت دارد، نه فقط معدل کلی.</p></article>\n<article class=\"term\" id=\"term-7\"><h3><span class=\"num\">۷.</span> ایجاد سابقه تحصیلی</h3><p>برخی داوطلبان برای تعدادی از درس‌های موردنیاز، نمره امتحان نهایی معتبر ندارند و باید با شرکت در امتحانات نهایی، سابقه تحصیلی ایجاد کنند. این موضوع برای دارندگان دیپلم قدیمی، دیپلم نامرتبط یا سابقه نهایی ناقص اهمیت بیشتری دارد.</p></article>\n<article class=\"term\" id=\"term-8\"><h3><span class=\"num\">۸.</span> نمره کل نهایی</h3><p>از ترکیب نمره آزمون اختصاصی و نمره کل سابقه تحصیلی به دست می‌آید و مبنای ساخت رتبه نهایی داوطلب با درنظرگرفتن سهمیه است.</p><p class=\"example\"><span class=\"simple\">دو جزء اصلی:</span> عملکرد در آزمون اختصاصی کنکور و عملکرد در امتحانات نهایی.</p></article>\n<article class=\"term\" id=\"term-9\"><h3><span class=\"num\">۹.</span> رتبه کشوری</h3><p>جایگاه تو را در مقایسه با تمام داوطلبان گروه آزمایشی در سراسر کشور نشان می‌دهد. رتبه کشوری ۱۲ هزار یعنی حدود ۱۱٬۹۹۹ نفر در محاسبه کشوری جلوتر از تو قرار گرفته‌اند.</p></article>\n<article class=\"term\" id=\"term-10\"><h3><span class=\"num\">۱۰.</span> رتبه در سهمیه</h3><p>جایگاه تو را میان داوطلبانی نشان می‌دهد که سهمیه مشابه تو دارند. برای مقایسه با قبولی‌های گذشته، بهتر است رتبه فردی را بررسی کن که سهمیه مشابه تو داشته است.</p></article>\n<article class=\"term\" id=\"term-11\"><h3><span class=\"num\">۱۱.</span> سهمیه نهایی</h3><p>سهمیه‌ای است که در گزینش داوطلب اعمال می‌شود؛ مانند منطقه ۱، منطقه ۲، منطقه ۳، ایثارگران یا رزمندگان. ثبت یک سهمیه به‌تنهایی به معنی تأیید آن نیست و اطلاعات باید توسط مرجع مربوط تأیید شود.</p></article>\n<article class=\"term\" id=\"term-12\"><h3><span class=\"num\">۱۲.</span> مجاز به انتخاب رشته</h3><p>یعنی اجازه داری کدرشته‌محل‌های مربوط به یک دوره را در فرم انتخاب رشته وارد کن. مجازشدن به معنی قبولی نیست و داوطلب ممکن است برای بعضی دوره‌ها مجاز و برای برخی دیگر غیرمجاز باشد.</p></article>\n<article class=\"term\" id=\"term-13\"><h3><span class=\"num\">۱۳.</span> غیرمجاز</h3><p>اگر برای یک دوره غیرمجاز باش، اجازه انتخاب کدرشته‌محل‌های همان دوره را نداری. ممکن است برای روزانه غیرمجاز باش اما امکان انتخاب پیام نور، غیرانتفاعی یا پذیرش براساس سوابق را داشته باش.</p></article>\n<article class=\"term\" id=\"term-14\"><h3><span class=\"num\">۱۴.</span> زیرگروه</h3><p>اصطلاحی مربوط به ساختار قدیمی کنکور است. رشته‌ها در چند زیرگروه قرار می‌گرفتند و ضرایب درس‌ها در هر زیرگروه متفاوت بود. زیرگروه‌ها در ساختار جدید حذف شده‌اند.</p></article>\n</div>\n</section>\n<section class=\"section searchable-section\" id=\"selection\">\n<div class=\"section-head\"><span class=\"section-no\">۲</span><div><div class=\"section-kicker\">اصطلاحات ۱۵ تا ۲۹</div><h2 id=\"aris-article-section-4\">اصطلاحات اصلی انتخاب رشته</h2></div></div>\n<div class=\"terms\">\n<article class=\"term\" id=\"term-15\"><h3><span class=\"num\">۱۵.</span> رشته</h3><p>موضوع و تخصصی است که در دانشگاه می‌خوانی؛ مانند حقوق، روان‌شناسی، پرستاری یا مهندسی کامپیوتر. علاوه بر نام رشته باید واحدهای درسی، توانایی‌های موردنیاز، محیط کاری و بازار کار آن را بررسی کن.</p></article>\n<article class=\"term\" id=\"term-16\"><h3><span class=\"num\">۱۶.</span> گرایش</h3><p>شاخه تخصصی‌تر یک رشته است. در برخی رشته‌ها گرایش از دوره کارشناسی مشخص می‌شود و در برخی دیگر دانشجو در مقاطع بالاتر گرایش خود را انتخاب می‌کند.</p></article>\n<article class=\"term\" id=\"term-17\"><h3><span class=\"num\">۱۷.</span> مقطع تحصیلی</h3><p>نشان می‌دهد در چه سطحی از آموزش عالی پذیرفته می‌شوی.</p><ul><li>کاردانی: دوره‌ای کوتاه‌تر از کارشناسی</li><li>کارشناسی: دوره لیسانس</li><li>کارشناسی پیوسته: ورود مستقیم از دیپلم</li><li>کارشناسی ناپیوسته: ویژه دارندگان کاردانی</li><li>دکترای حرفه‌ای: مانند پزشکی، دندان‌پزشکی و داروسازی</li></ul></article>\n<article class=\"term\" id=\"term-18\"><h3><span class=\"num\">۱۸.</span> محل</h3><p>به دانشگاه و شهری گفته می‌شود که رشته در آن ارائه شده است. انتخاب رشته در واقع انتخاب رشته، دانشگاه، شهر، نوع دوره و شرایط زندگی آینده است.</p></article>\n<article class=\"term\" id=\"term-19\"><h3><span class=\"num\">۱۹.</span> رشته‌محل</h3><p>از ترکیب رشته و محل تحصیل ساخته می‌شود. «روان‌شناسی دانشگاه تهران» و «روان‌شناسی دانشگاه تبریز» یک رشته اما دو رشته‌محل متفاوت‌اند و ممکن است ظرفیت، امکانات، شهریه و شرایط خوابگاه متفاوتی داشته باشند.</p></article>\n<article class=\"term\" id=\"term-20\"><h3><span class=\"num\">۲۰.</span> کدرشته‌محل</h3><p>هر رشته‌محل یک کد مشخص دارد که در فرم اینترنتی وارد می‌شود. بعد از واردکردن کد، نام رشته، دانشگاه و دوره نمایش‌داده‌شده در سامانه را با فهرست خود تطبیق بده.</p></article>\n<article class=\"term\" id=\"term-21\"><h3><span class=\"num\">۲۱.</span> فرم انتخاب رشته</h3><p>فهرست مرتب کدرشته‌محل‌های توست. انتخاب‌ها به همان ترتیبی که وارد کرده‌ای بررسی می‌شوند؛ بنابراین فرم نشان‌دهنده ترجیح واقعی توست.</p></article>\n<article class=\"term\" id=\"term-22\"><h3><span class=\"num\">۲۲.</span> اولویت</h3><p>میزان علاقه تو به یک انتخاب در مقایسه با انتخاب‌های دیگر است. انتخاب اول باید گزینه‌ای باشد که از همه بیشتر می‌خواهی. اولویت بالاتر امتیاز علمی اضافه ایجاد نمی‌کند.</p></article>\n<article class=\"term\" id=\"term-23\"><h3><span class=\"num\">۲۳.</span> نحوه بررسی انتخاب‌ها</h3><p>سیستم انتخاب‌ها را از بالا به پایین بررسی می‌کند. اگر در یک انتخاب پذیرفته شو، گزینه‌های پایین‌تر دیگر بررسی نمی‌شوند.</p><p class=\"example\">قراردادن یک انتخاب خوش‌بینانه در بالای فرم، شانس قبولی انتخاب‌های پایین‌تر را کم نمی‌کند.</p></article>\n<article class=\"term\" id=\"term-24\"><h3><span class=\"num\">۲۴.</span> ظرفیت</h3><p>تعداد دانشجویانی است که در یک کدرشته‌محل پذیرفته می‌شوند. ظرفیت می‌تواند میان سهمیه‌ها و ضوابط مختلف تقسیم شود. ظرفیت کم معمولاً رقابت را بیشتر می‌کند.</p></article>\n<article class=\"term\" id=\"term-25\"><h3><span class=\"num\">۲۵.</span> ظرفیت پذیرش زن و مرد</h3><p>بعضی کدرشته‌محل‌ها فقط زن، فقط مرد یا هر دو جنس را می‌پذیرند. هنگام بررسی رشته‌محل، ستون جنس پذیرش را با دقت بخوان.</p></article>\n<article class=\"term\" id=\"term-26\"><h3><span class=\"num\">۲۶.</span> نیمسال اول</h3><p>معمولاً به معنی شروع تحصیل از مهرماه است. زمان ثبت‌نام و شروع کلاس‌ها را دانشگاه اعلام می‌کند.</p></article>\n<article class=\"term\" id=\"term-27\"><h3><span class=\"num\">۲۷.</span> نیمسال دوم</h3><p>معمولاً به معنی شروع تحصیل از بهمن‌ماه است. پذیرش بهمن به معنی ضعیف‌تر یا بی‌اعتباربودن مدرک نیست؛ تفاوت اصلی در زمان شروع تحصیل است.</p></article>\n<article class=\"term\" id=\"term-28\"><h3><span class=\"num\">۲۸.</span> نوع گزینش</h3><p>نشان می‌دهد رقابت یک رشته‌محل در چه محدوده‌ای انجام می‌شود. گزینش می‌تواند کشوری، استانی، ناحیه‌ای یا قطبی باشد و بر شانس داوطلبان بومی و غیربومی اثر می‌گذارد.</p></article>\n<article class=\"term\" id=\"term-29\"><h3><span class=\"num\">۲۹.</span> محل تحصیل</h3><p>محل واقعی تشکیل کلاس‌هاست. گاهی نام دانشگاه یک شهر نوشته می‌شود اما کلاس‌ها در پردیس، دانشکده یا شهر دیگری تشکیل می‌شوند؛ بنابراین توضیحات رشته‌محل را بخوان.</p></article>\n</div>\n</section>\n<section class=\"section searchable-section\" id=\"boomi\">\n<div class=\"section-head\"><span class=\"section-no\">۳</span><div><div class=\"section-kicker\">اصطلاحات ۳۰ تا ۳۷</div><h2 id=\"aris-article-section-5\">بومی‌گزینی</h2></div></div>\n<div class=\"terms\">\n<article class=\"term\" id=\"term-30\"><h3><span class=\"num\">۳۰.</span> بومی‌گزینی</h3><p>یعنی در پذیرش بعضی رشته‌محل‌ها بخشی از ظرفیت به داوطلبان بومی یک محدوده جغرافیایی اختصاص پیدا می‌کند. بومی‌بودن براساس ضوابط پذیرش و اطلاعات تحصیلی داوطلب تعیین می‌شود، نه صرفاً محل زندگی فعلی.</p></article>\n<article class=\"term\" id=\"term-31\"><h3><span class=\"num\">۳۱.</span> استان بومی</h3><p>استانی است که براساس محل تحصیل و اخذ مدرک در سال‌های مشخصی از دوره متوسطه برای داوطلب تعیین می‌شود.</p></article>\n<article class=\"term\" id=\"term-32\"><h3><span class=\"num\">۳۲.</span> بومی استانی</h3><p>در رشته‌های بومی استانی، داوطلبان بومی همان استان از سهم بومی ظرفیت برخوردار می‌شوند. این موضوع قبولی داوطلب غیربومی را غیرممکن نمی‌کند، اما بخشی از ظرفیت در اختیار افراد بومی است.</p></article>\n<article class=\"term\" id=\"term-33\"><h3><span class=\"num\">۳۳.</span> بومی ناحیه‌ای</h3><p>چند استان در کنار هم یک ناحیه را تشکیل می‌دهند. داوطلب بومی یکی از استان‌های آن ناحیه، برای رشته‌محل‌های ناحیه خود بومی محسوب می‌شود.</p></article>\n<article class=\"term\" id=\"term-34\"><h3><span class=\"num\">۳۴.</span> بومی قطبی</h3><p>چند ناحیه یک قطب را تشکیل می‌دهند. محدوده رقابت قطبی بزرگ‌تر از محدوده ناحیه‌ای است و داوطلب در رشته‌های قطبی با داوطلبان بومی همان قطب رقابت می‌کند.</p></article>\n<article class=\"term\" id=\"term-35\"><h3><span class=\"num\">۳۵.</span> گزینش کشوری</h3><p>در این نوع گزینش، محل بومی نقش اصلی را ندارد و داوطلبان سراسر کشور در سطح گسترده‌تری با یکدیگر رقابت می‌کنند.</p></article>\n<article class=\"term\" id=\"term-36\"><h3><span class=\"num\">۳۶.</span> تفاوت قطب، ناحیه و استان</h3><p>استان کوچک‌ترین محدوده است، چند استان یک ناحیه و چند ناحیه یک قطب را تشکیل می‌دهند. هرچه محدوده گزینش گسترده‌تر باشد، تعداد داوطلبان حاضر در رقابت بیشتر می‌شود.</p></article>\n<article class=\"term\" id=\"term-37\"><h3><span class=\"num\">۳۷.</span> رشته‌های پرمتقاضی</h3><p>رشته‌هایی هستند که تعداد زیادی از داوطلبان آن‌ها را انتخاب می‌کنند و رقابت شدیدی دارند. نحوه توزیع ظرفیت در این رشته‌ها می‌تواند با رشته‌های دیگر متفاوت باشد.</p></article>\n</div>\n</section>\n<section class=\"section searchable-section\" id=\"sahmie\">\n<div class=\"section-head\"><span class=\"section-no\">۴</span><div><div class=\"section-kicker\">اصطلاحات ۳۸ تا ۴۸</div><h2 id=\"aris-article-section-6\">سهمیه‌ها</h2></div></div>\n<div class=\"terms\">\n<article class=\"term\" id=\"term-38\"><h3><span class=\"num\">۳۸.</span> سهمیه مناطق</h3><p>داوطلبان در یکی از مناطق ۱، ۲ یا ۳ قرار می‌گیرند تا تفاوت امکانات آموزشی مناطق مختلف تا حدی در رقابت در نظر گرفته شود. منطقه داوطلب صرفاً براساس محل سکونت فعلی تعیین نمی‌شود.</p></article>\n<article class=\"term\" id=\"term-39\"><h3><span class=\"num\">۳۹.</span> سهمیه منطقه ۱</h3><p>معمولاً شامل شهرها یا مناطق برخوردارتر است. داوطلبان این منطقه با افراد دارای سهمیه مشابه رقابت می‌کنند و رتبه آن‌ها نباید مستقیماً با مناطق ۲ و ۳ مقایسه شود.</p></article>\n<article class=\"term\" id=\"term-40\"><h3><span class=\"num\">۴۰.</span> سهمیه منطقه ۲</h3><p>معمولاً شامل شهرها و مناطقی با سطح متوسط امکانات آموزشی است و در بسیاری از گروه‌های آزمایشی جمعیت زیادی از داوطلبان را در بر می‌گیرد.</p></article>\n<article class=\"term\" id=\"term-41\"><h3><span class=\"num\">۴۱.</span> سهمیه منطقه ۳</h3><p>معمولاً شامل مناطق کم‌برخوردارتر است. منطقه ۳ بودن به معنی قبولی آسان یا تضمینی نیست و داوطلب باید در رقابت سهمیه خود رتبه مناسبی کسب کند.</p></article>\n<article class=\"term\" id=\"term-42\"><h3><span class=\"num\">۴۲.</span> سهمیه ایثارگران ۲۵ درصدی</h3><p>برای گروه‌های مشخصی از همسران و فرزندان شهدا، آزادگان و جانبازان در نظر گرفته می‌شود. بخشی از ظرفیت رشته‌محل‌ها به این سهمیه اختصاص دارد و کسب حدنصاب علمی الزامی است.</p></article>\n<article class=\"term\" id=\"term-43\"><h3><span class=\"num\">۴۳.</span> سهمیه ایثارگران ۵ درصدی</h3><p>برای گروه دیگری از ایثارگران و خانواده‌های آنان در نظر گرفته شده است. استفاده از آن نیازمند تأیید اطلاعات و کسب حدنصاب علمی است و به معنی قبولی خودکار نیست.</p></article>\n<article class=\"term\" id=\"term-44\"><h3><span class=\"num\">۴۴.</span> سهمیه رزمندگان</h3><p>برای رزمندگانی است که شرایط قانونی و مدت حضور تعیین‌شده را داشته باشند. اطلاعات داوطلب باید توسط ارگان مربوط تأیید شود.</p></article>\n<article class=\"term\" id=\"term-45\"><h3><span class=\"num\">۴۵.</span> سهمیه خانواده شهدا</h3><p>برای افراد واجد شرایط خانواده شهدا اعمال می‌شود و استفاده از آن به احراز شرایط و مدارک مربوط وابسته است.</p></article>\n<article class=\"term\" id=\"term-46\"><h3><span class=\"num\">۴۶.</span> سهمیه مناطق محروم</h3><p>بعضی ظرفیت‌ها به داوطلبان استان‌ها یا مناطق محروم اختصاص داده می‌شوند. قبولی در این رشته‌محل‌ها ممکن است با تعهد خدمت، محدودیت انتقال و الزام خدمت در منطقه تعیین‌شده همراه باشد.</p></article>\n<article class=\"term\" id=\"term-47\"><h3><span class=\"num\">۴۷.</span> سهمیه بهیاران</h3><p>در برخی رشته‌های حوزه سلامت برای بهیاران واجد شرایط در نظر گرفته می‌شود. سابقه کار، مدرک مرتبط و شرایط اختصاصی می‌تواند برای استفاده از آن ضروری باشد.</p></article>\n<article class=\"term\" id=\"term-48\"><h3><span class=\"num\">۴۸.</span> حدنصاب علمی سهمیه</h3><p>یعنی داوطلب سهمیه‌دار باید حداقل بخشی از نمره علمی لازم را کسب کند تا بتواند از سهمیه استفاده کند. سهمیه قرار نیست هر فاصله علمی‌ای را جبران کند.</p></article>\n</div>\n</section>\n<section class=\"section searchable-section\" id=\"universities\">\n<div class=\"section-head\"><span class=\"section-no\">۵</span><div><div class=\"section-kicker\">اصطلاحات ۴۹ تا ۵۹</div><h2 id=\"aris-article-section-7\">انواع دوره‌ها و دانشگاه‌ها</h2></div></div>\n<div class=\"terms\">\n<article class=\"term\" id=\"term-49\"><h3><span class=\"num\">۴۹.</span> دوره روزانه</h3><p>دوره اصلی دانشگاه‌های دولتی است و معمولاً شهریه آموزشی ندارد. هزینه خوابگاه، غذا، رفت‌وآمد، سنوات اضافه و برخی خدمات می‌تواند جداگانه دریافت شود و تحصیل رایگان نیز تعهدات قانونی خود را دارد.</p></article>\n<article class=\"term\" id=\"term-50\"><h3><span class=\"num\">۵۰.</span> دوره نوبت دوم یا شبانه</h3><p>در دانشگاه دولتی برگزار می‌شود اما دانشجو شهریه می‌پردازد. «شبانه» لزوماً به معنی برگزاری همه کلاس‌ها در عصر یا شب نیست و دانشگاه معمولاً تعهدی برای خوابگاه ندارد.</p></article>\n<article class=\"term\" id=\"term-51\"><h3><span class=\"num\">۵۱.</span> پردیس خودگردان</h3><p>دوره‌ای شهریه‌پرداز وابسته به دانشگاه‌های دولتی است. مبلغ شهریه معمولاً زیاد است و باید همراه با هزینه خوابگاه و زندگی محاسبه شود. کیفیت آموزش و محل تشکیل کلاس‌ها نیز باید جداگانه بررسی شوند.</p></article>\n<article class=\"term\" id=\"term-52\"><h3><span class=\"num\">۵۲.</span> ظرفیت مازاد</h3><p>نوعی پذیرش شهریه‌پرداز است که در بعضی دانشگاه‌ها یا رشته‌ها ارائه می‌شود. شرایط، شهریه، امکانات و محل تحصیل آن باید مستقل از دوره روزانه بررسی شود.</p></article>\n<article class=\"term\" id=\"term-53\"><h3><span class=\"num\">۵۳.</span> دانشگاه پیام نور</h3><p>دانشگاهی شهریه‌پرداز است که بخش زیادی از آموزش آن بر مطالعه شخصی و منابع مشخص درسی تکیه دارد. برای افراد دارای توان مطالعه مستقل یا شاغل می‌تواند مناسب باشد؛ وضعیت کلاس‌های عملی و امکانات هر مرکز اهمیت دارد.</p></article>\n<article class=\"term\" id=\"term-54\"><h3><span class=\"num\">۵۴.</span> دانشگاه یا مؤسسه غیرانتفاعی</h3><p>مرکز آموزش عالی غیردولتی و شهریه‌پرداز زیر نظر وزارت علوم است. کیفیت آموزشی، امکانات، اعضای هیئت علمی و ساختمان مؤسسات مختلف یکسان نیست.</p></article>\n<article class=\"term\" id=\"term-55\"><h3><span class=\"num\">۵۵.</span> دوره مجازی</h3><p>بخش عمده آموزش در آن اینترنتی است، اما امتحانات یا بعضی جلسات می‌توانند حضوری باشند. شیوه کلاس، سامانه آموزشی، امتحانات و شهریه از عوامل مهم بررسی این دوره‌اند.</p></article>\n<article class=\"term\" id=\"term-56\"><h3><span class=\"num\">۵۶.</span> دانشگاه فرهنگیان</h3><p>برای تربیت معلم فعالیت می‌کند و پذیرش آن شرایط ویژه‌ای مانند شرط سنی، نمره علمی، مصاحبه، معاینه پزشکی، صلاحیت عمومی، بومی‌بودن و تعهد خدمت دارد. دعوت به مصاحبه قبولی قطعی نیست.</p></article>\n<article class=\"term\" id=\"term-57\"><h3><span class=\"num\">۵۷.</span> دانشگاه تربیت دبیر شهید رجایی</h3><p>در زمینه تربیت دبیر فعالیت می‌کند و پذیرش آن معمولاً دارای شرایط اختصاصی، مصاحبه و تعهد خدمت است.</p></article>\n<article class=\"term\" id=\"term-58\"><h3><span class=\"num\">۵۸.</span> دانشگاه آزاد اسلامی</h3><p>انتخاب رشته بیشتر رشته‌های دانشگاه آزاد در سامانه جداگانه این دانشگاه انجام می‌شود و برای ورود ممکن است کد دسترسی کارنامه لازم باشد. انتخاب برخی رشته‌های پزشکی می‌تواند از طریق فرم سازمان سنجش انجام شود.</p></article>\n<article class=\"term\" id=\"term-59\"><h3><span class=\"num\">۵۹.</span> دانشگاه‌های دارای شرایط خاص</h3><p>علاوه بر رتبه علمی، ممکن است مصاحبه، معاینه، محدودیت سنی، شرط معدل، تعهد خدمت یا ضوابط انضباطی اختصاصی داشته باشند.</p></article>\n</div>\n</section>\n<section class=\"section searchable-section\" id=\"admission\">\n<div class=\"section-head\"><span class=\"section-no\">۶</span><div><div class=\"section-kicker\">اصطلاحات ۶۰ تا ۶۹</div><h2 id=\"aris-article-section-8\">شیوه‌های پذیرش</h2></div></div>\n<div class=\"terms\">\n<article class=\"term\" id=\"term-60\"><h3><span class=\"num\">۶۰.</span> پذیرش با آزمون</h3><p>در آن نمره کل نهایی، رتبه، سهمیه، ظرفیت، بومی‌گزینی و ترتیب انتخاب‌ها بر نتیجه اثر دارند و سابقه تحصیلی نیز در نمره کل نهایی اعمال می‌شود.</p></article>\n<article class=\"term\" id=\"term-61\"><h3><span class=\"num\">۶۱.</span> پذیرش صرفاً براساس سوابق تحصیلی</h3><p>آزمون تستی ملاک اصلی نیست و داوطلبان براساس سوابق تحصیلی رقابت می‌کنند. این شیوه «بدون کنکور» نامیده می‌شود، اما بدون رقابت نیست.</p></article>\n<article class=\"term\" id=\"term-62\"><h3><span class=\"num\">۶۲.</span> رشته بدون کنکور</h3><p>رشته‌ای است که پذیرش آن صرفاً براساس سوابق تحصیلی انجام می‌شود. بدون کنکوربودن به معنی بی‌اعتباربودن رشته نیست؛ کیفیت دانشگاه و امکانات باید جداگانه سنجیده شوند.</p></article>\n<article class=\"term\" id=\"term-63\"><h3><span class=\"num\">۶۳.</span> پذیرش متمرکز</h3><p>نتیجه داوطلب براساس نمره، رتبه، سهمیه و ترتیب انتخاب‌ها مشخص می‌شود و معمولاً مرحله جداگانه‌ای مانند مصاحبه یا آزمون عملی ندارد.</p></article>\n<article class=\"term\" id=\"term-64\"><h3><span class=\"num\">۶۴.</span> رشته دارای شرایط خاص</h3><p>رتبه به‌تنهایی برای قبولی آن کافی نیست و داوطلب ممکن است وارد مرحله‌ای مانند مصاحبه، آزمون عملی، معاینه یا بررسی صلاحیت شود.</p></article>\n<article class=\"term\" id=\"term-65\"><h3><span class=\"num\">۶۵.</span> معرفی چندبرابر ظرفیت</h3><p>دانشگاه برای مصاحبه یا بررسی تکمیلی، تعداد بیشتری از ظرفیت نهایی را دعوت می‌کند.</p><p class=\"example\">اگر ظرفیت ۳۰ نفر باشد، ممکن است ۹۰ نفر برای مصاحبه معرفی شوند. دعوت به مصاحبه قبولی قطعی نیست.</p></article>\n<article class=\"term\" id=\"term-66\"><h3><span class=\"num\">۶۶.</span> آزمون عملی</h3><p>بعضی رشته‌ها، به‌ویژه برخی رشته‌های هنر و علوم ورزشی، آزمون عملی دارند. شرکت‌نکردن در آزمون می‌تواند امکان قبولی در آن رشته را از بین ببرد.</p></article>\n<article class=\"term\" id=\"term-67\"><h3><span class=\"num\">۶۷.</span> مصاحبه</h3><p>ممکن است برای بررسی انگیزه، توانایی ارتباطی، اطلاعات عمومی، ویژگی‌های شخصیتی، شرایط شغلی یا تناسب داوطلب با رشته انجام شود.</p></article>\n<article class=\"term\" id=\"term-68\"><h3><span class=\"num\">۶۸.</span> معاینه پزشکی</h3><p>در برخی رشته‌ها و دانشگاه‌ها، سلامت جسمی یا توانایی انجام وظایف رشته بررسی می‌شود؛ مانند بینایی، شنوایی، گفتار یا توانایی حرکتی. وجود مشکل جسمی همیشه به معنی ردشدن نیست.</p></article>\n<article class=\"term\" id=\"term-69\"><h3><span class=\"num\">۶۹.</span> گزینش نهایی</h3><p>مرحله‌ای است که در آن رتبه، سهمیه، ظرفیت، ترتیب انتخاب‌ها و نتایج مراحل تکمیلی بررسی و قبولی نهایی مشخص می‌شود.</p></article>\n</div>\n</section>\n<section class=\"section searchable-section\" id=\"commitments\">\n<div class=\"section-head\"><span class=\"section-no\">۷</span><div><div class=\"section-kicker\">اصطلاحات ۷۰ تا ۷۸</div><h2 id=\"aris-article-section-9\">تعهدها و محدودیت‌ها</h2></div></div>\n<div class=\"terms\">\n<article class=\"term\" id=\"term-70\"><h3><span class=\"num\">۷۰.</span> رشته تعهدی</h3><p>رشته‌ای است که داوطلب با قبولی در آن متعهد می‌شود پس از فارغ‌التحصیلی برای مدت مشخصی در محل تعیین‌شده خدمت کند. نباید با فرض امکان حتمی تغییر محل یا خرید تعهد انتخاب شود.</p></article>\n<article class=\"term\" id=\"term-71\"><h3><span class=\"num\">۷۱.</span> تعهد خدمت</h3><p>قراردادی قانونی است که دانشجو را موظف می‌کند پس از پایان تحصیل، برای مدت مشخصی در یک سازمان یا منطقه خدمت کند. ادامه تحصیل، دریافت مدرک یا انتخاب محل کار می‌تواند محدود شود.</p></article>\n<article class=\"term\" id=\"term-72\"><h3><span class=\"num\">۷۲.</span> تعهد خدمت مناطق محروم</h3><p>دانشجو پس از پایان تحصیل در استان یا مناطق تعیین‌شده خدمت می‌کند. این انتخاب برای فردی مناسب است که آمادگی زندگی و کار در همان محل را داشته باشد.</p></article>\n<article class=\"term\" id=\"term-73\"><h3><span class=\"num\">۷۳.</span> تعهد آموزش رایگان</h3><p>دانشجویان روزانه از آموزش رایگان استفاده می‌کنند و برای آزادسازی یا ارائه اصل مدرک ممکن است مشمول مقررات تعهد آموزش رایگان باشند.</p></article>\n<article class=\"term\" id=\"term-74\"><h3><span class=\"num\">۷۴.</span> انتقالی</h3><p>یعنی دانشجو از دانشگاه مبدأ به دانشگاه دیگری منتقل شود و تحصیل را در مقصد ادامه دهد. انتقالی حق قطعی نیست و به موافقت دانشگاه‌ها، ظرفیت و شرایط آموزشی بستگی دارد.</p></article>\n<article class=\"term\" id=\"term-75\"><h3><span class=\"num\">۷۵.</span> مهمانی</h3><p>دانشجو معمولاً دانشجوی دانشگاه مبدأ باقی می‌ماند اما یک یا چند نیمسال را در دانشگاه دیگری درس می‌خواند. مهمانی نیز قطعی نیست و شرایط خود را دارد.</p></article>\n<article class=\"term\" id=\"term-76\"><h3><span class=\"num\">۷۶.</span> ممنوعیت انتقال یا مهمانی</h3><p>بعضی رشته‌محل‌های تعهدی، مناطق محروم، بورسیه‌ای یا دارای شرایط خاص، انتقال و مهمانی را ممنوع یا بسیار محدود می‌کنند.</p></article>\n<article class=\"term\" id=\"term-77\"><h3><span class=\"num\">۷۷.</span> انصراف از تحصیل</h3><p>یعنی دانشجو رسماً از ادامه تحصیل صرف‌نظر کند. انصراف می‌تواند با هزینه، تسویه‌حساب، محدودیت ثبت‌نام یا آثار اداری دیگر همراه باشد.</p></article>\n<article class=\"term\" id=\"term-78\"><h3><span class=\"num\">۷۸.</span> محرومیت از کنکور یا انتخاب رشته بعدی</h3><p>برخی قبولی‌ها، انصراف‌ها یا وضعیت‌های تحصیلی می‌توانند بر امکان شرکت مجدد یا انتخاب رشته بعدی اثر بگذارند.</p></article>\n</div>\n</section>\n<section class=\"section searchable-section\" id=\"costs\">\n<div class=\"section-head\"><span class=\"section-no\">۸</span><div><div class=\"section-kicker\">اصطلاحات ۷۹ تا ۸۴</div><h2 id=\"aris-article-section-10\">هزینه‌ها و امکانات دانشگاه</h2></div></div>\n<div class=\"terms\">\n<article class=\"term\" id=\"term-79\"><h3><span class=\"num\">۷۹.</span> شهریه ثابت</h3><p>مبلغی است که معمولاً در هر نیمسال دریافت می‌شود و مستقیماً به تعداد واحدهای انتخاب‌شده وابسته نیست. مبلغ آن می‌تواند براساس سال ورود و مصوبات دانشگاه افزایش پیدا کند.</p></article>\n<article class=\"term\" id=\"term-80\"><h3><span class=\"num\">۸۰.</span> شهریه متغیر</h3><p>براساس تعداد و نوع واحدهای درسی محاسبه می‌شود. واحدهای عملی، آزمایشگاهی، کارگاهی یا بالینی معمولاً هزینه بیشتری از واحدهای نظری دارند.</p></article>\n<article class=\"term\" id=\"term-81\"><h3><span class=\"num\">۸۱.</span> خوابگاه دولتی</h3><p>معمولاً با هزینه کمتر در اختیار دانشجویان واجد شرایط قرار می‌گیرد، اما ظرفیت محدود است. قبولی در دانشگاه به معنی دریافت قطعی خوابگاه نیست.</p></article>\n<article class=\"term\" id=\"term-82\"><h3><span class=\"num\">۸۲.</span> خوابگاه خودگردان</h3><p>معمولاً هزینه بیشتری از خوابگاه دولتی دارد و ممکن است توسط بخش خصوصی یا تحت نظارت دانشگاه اداره شود. کیفیت، فاصله و امکانات آن متفاوت است.</p></article>\n<article class=\"term\" id=\"term-83\"><h3><span class=\"num\">۸۳.</span> عدم تعهد خوابگاه</h3><p>یعنی نباید روی دریافت خوابگاه از دانشگاه حساب قطعی باز کن و باید هزینه خوابگاه خصوصی یا اجاره خانه را نیز در تصمیم خود وارد کن.</p></article>\n<article class=\"term\" id=\"term-84\"><h3><span class=\"num\">۸۴.</span> امکانات رفاهی</h3><p>شامل خوابگاه، غذاخوری، سرویس رفت‌وآمد، کتابخانه، سالن ورزشی، اینترنت و خدمات درمانی است. امکانات تمام پردیس‌ها و دانشکده‌های یک دانشگاه لزوماً یکسان نیست.</p></article>\n</div>\n</section>\n<section class=\"section searchable-section\" id=\"consulting\">\n<div class=\"section-head\"><span class=\"section-no\">۹</span><div><div class=\"section-kicker\">اصطلاحات ۸۵ تا ۹۵</div><h2 id=\"aris-article-section-11\">اصطلاحات رایج مشاوران انتخاب رشته</h2></div></div>\n<div class=\"terms\">\n<article class=\"term\" id=\"term-85\"><h3><span class=\"num\">۸۵.</span> انتخاب خوش‌بینانه یا رویایی</h3><p>رشته‌محلی است که با توجه به رتبه‌های قبولی، شانس پذیرش در آن کم به نظر می‌رسد اما داوطلب علاقه زیادی به آن دارد. این گزینه‌ها می‌توانند در بالای فرم قرار بگیرند.</p></article>\n<article class=\"term\" id=\"term-86\"><h3><span class=\"num\">۸۶.</span> انتخاب منطقی</h3><p>گزینه‌ای است که رتبه داوطلب به محدوده قبولی آن نزدیک است. احتمال قبولی معقول است، اما تضمینی نیست.</p></article>\n<article class=\"term\" id=\"term-87\"><h3><span class=\"num\">۸۷.</span> انتخاب مطمئن یا اطمینانی</h3><p>رشته‌محلی است که براساس اطلاعات قبولی‌ها، احتمال پذیرش داوطلب در آن بیشتر است. «مطمئن» یک تخمین است، نه تضمین قطعی.</p></article>\n<article class=\"term\" id=\"term-88\"><h3><span class=\"num\">۸۸.</span> انتخاب بدبینانه</h3><p>گزینه‌ای با احتمال قبولی بالاست که شاید علاقه داوطلب به آن کمتر باشد. این انتخاب‌ها معمولاً در انتهای فرم قرار می‌گیرند و فقط باید شامل گزینه‌هایی باشند که حاضر به ثبت‌نام در آن‌ها هستی.</p></article>\n<article class=\"term\" id=\"term-89\"><h3><span class=\"num\">۸۹.</span> کف قبولی</h3><p>معمولاً رتبه آخرین فرد پذیرفته‌شده در یک رشته‌محل است. این عدد می‌تواند با سهمیه، جنسیت، بومی‌بودن و نیمسال تفاوت داشته باشد و قبولی فرد دیگری را تضمین نمی‌کند.</p></article>\n<article class=\"term\" id=\"term-90\"><h3><span class=\"num\">۹۰.</span> محدوده قبولی</h3><p>بازه تقریبی رتبه‌هایی است که در یک رشته‌محل پذیرفته شده‌اند. استفاده از بازه بهتر از تکیه بر یک رتبه خاص است و باید سهمیه و نوع گزینش مشابه باشند.</p></article>\n<article class=\"term\" id=\"term-91\"><h3><span class=\"num\">۹۱.</span> شانس قبولی</h3><p>یک تخمین آماری است، نه نتیجه رسمی. معمولاً با مقایسه رتبه داوطلب و داده‌های قبولی به دست می‌آید و امکان تضمین صددرصدی ندارد.</p></article>\n<article class=\"term\" id=\"term-92\"><h3><span class=\"num\">۹۲.</span> چینش انتخاب‌ها</h3><p>یعنی مرتب‌کردن کدرشته‌محل‌ها از محبوب‌ترین تا کم‌علاقه‌ترین گزینه.</p><p class=\"example\">اگر در دو انتخاب امکان قبولی داشته باش، واقعاً کدام را ترجیح می‌دهی؟ همان گزینه باید بالاتر قرار بگیرد.</p></article>\n<article class=\"term\" id=\"term-93\"><h3><span class=\"num\">۹۳.</span> انتخاب رشته متوازن</h3><p>فرمی است که فقط از انتخاب‌های رویایی یا فقط از گزینه‌های مطمئن تشکیل نشده و ترکیبی از انتخاب‌های خوش‌بینانه، منطقی و مطمئن را در بر می‌گیرد.</p></article>\n<article class=\"term\" id=\"term-94\"><h3><span class=\"num\">۹۴.</span> اولویت رشته یا دانشگاه</h3><p>بعضی داوطلبان رشته را مهم‌تر می‌دانند و برخی دانشگاه یا شهر را. برای تصمیم‌گیری باید علاقه، کیفیت دانشگاه، شهر، هزینه، فاصله، بازار کار، ادامه تحصیل و شرایط جسمی و روحی را کنار هم سنجید.</p></article>\n<article class=\"term\" id=\"term-95\"><h3><span class=\"num\">۹۵.</span> کارنامه سبز</h3><p>نام رایج کارنامه علمی پس از اعلام نتایج نهایی است. می‌تواند وضعیت داوطلب در انتخاب‌ها را نشان دهد، اما به‌تنهایی مجوز انتقال یا تغییر رشته نیست.</p></article>\n</div>\n</section>\n<section class=\"section searchable-section\" id=\"booklet\">\n<div class=\"section-head\"><span class=\"section-no\">۱۰</span><div><div class=\"section-kicker\">اصطلاحات ۹۶ تا ۱۰۰</div><h2 id=\"aris-article-section-12\">بخش‌های مهم دفترچه انتخاب رشته</h2></div></div>\n<div class=\"terms\">\n<article class=\"term\" id=\"term-96\"><h3><span class=\"num\">۹۶.</span> دفترچه انتخاب رشته</h3><p>شامل قوانین، شرایط، رشته‌محل‌ها، ظرفیت‌ها، نوع دوره، جنس پذیرش، نوع گزینش و توضیحات دانشگاه‌هاست. خواندن فقط جدول رشته‌ها کافی نیست.</p></article>\n<article class=\"term\" id=\"term-97\"><h3><span class=\"num\">۹۷.</span> دفترچه پیوست</h3><p>اطلاعات تکمیلی دانشگاه‌ها و شرایط پذیرش را ارائه می‌کند؛ از جمله وضعیت خوابگاه، آدرس دانشگاه، تعهد خدمت، شهریه، امکانات، محدودیت انتقال، شرایط جسمی و محل واقعی تحصیل.</p></article>\n<article class=\"term\" id=\"term-98\"><h3><span class=\"num\">۹۸.</span> اصلاحیه دفترچه</h3><p>اطلاعیه‌ای است که تغییرات دفترچه را اعلام می‌کند؛ مانند اضافه یا حذف‌شدن رشته‌محل، تغییر ظرفیت، جنس پذیرش، محل تحصیل یا شرایط پذیرش.</p></article>\n<article class=\"term\" id=\"term-99\"><h3><span class=\"num\">۹۹.</span> توضیحات اختصاصی کدرشته‌محل</h3><p>در کنار بعضی کدرشته‌ها توره یا علامتی وجود دارد که به توضیحات تکمیلی اشاره می‌کند. این توضیحات می‌توانند شامل نداشتن خوابگاه، تعهد خدمت، شهریه، مصاحبه یا تحصیل در شهری دیگر باشند.</p></article>\n<article class=\"term\" id=\"term-100\"><h3><span class=\"num\">۱۰۰.</span> رسید انتخاب رشته</h3><p>پس از ثبت نهایی، سامانه رسید یا کد پیگیری ارائه می‌کند. بهتر است نسخه نهایی انتخاب‌ها، رسید و کد پیگیری را ذخیره کن و از صفحه نهایی تصویر بگیر.</p></article>\n</div>\n</section>\n<section class=\"section\" id=\"mistakes\">\n<div class=\"section-head\"><span class=\"section-no\">!</span><div><div class=\"section-kicker\">پیش از ثبت نهایی بررسی کن</div><h2 id=\"aris-article-section-13\">اشتباهات رایج در انتخاب رشته</h2></div></div>\n<div class=\"mistakes\">\n<article class=\"mistake\"><h3>چیدن رشته‌ها براساس احتمال قبولی</h3><p>انتخاب‌ها باید براساس علاقه واقعی مرتب شوند. اگر نمره انتخاب بالاتر را نداشته باش، سیستم سراغ انتخاب بعدی می‌رود.</p></article>\n<article class=\"mistake\"><h3>انتخاب فقط براساس رتبه</h3><p>علاقه، استعداد، شرایط مالی، شهر، دانشگاه و بازار کار نیز در تصمیم‌گیری اهمیت دارند.</p></article>\n<article class=\"mistake\"><h3>اعتماد کامل به رتبه‌های قبولی</h3><p>رتبه‌های ثبت‌شده ابزار تخمین هستند و نتیجه قطعی تو را مشخص نمی‌کنند.</p></article>\n<article class=\"mistake\"><h3>انتخاب رشته‌ای که حاضر نیستی برو</h3><p>هر رشته واردشده در فرم می‌تواند قبولی نهایی تو باشد؛ فقط گزینه‌های قابل‌قبول را ثبت کن.</p></article>\n<article class=\"mistake\"><h3>امید قطعی به انتقال یا تغییر رشته</h3><p>انتقال و تغییر رشته محدودیت دارند. گزینه‌ای را انتخاب کن که بدون انتقال هم بتوانی در آن ادامه تحصیل کنی.</p></article>\n<article class=\"mistake\"><h3>بی‌توجهی به شهریه و هزینه زندگی</h3><p>اجاره، خوابگاه، غذا، رفت‌وآمد، تجهیزات، کتاب و سفر بین شهرها را در کنار شهریه محاسبه کن.</p></article>\n<article class=\"mistake\"><h3>نخواندن توضیحات دفترچه</h3><p>تعهد خدمت، وضعیت خوابگاه و محل تشکیل کلاس‌ها ممکن است در توضیحات رشته‌محل نوشته شده باشند.</p></article>\n<article class=\"mistake\"><h3>اعتماد به قبولی تضمینی</h3><p>هیچ مشاور یا نرم‌افزاری نمی‌تواند انتخاب سایر داوطلبان و نتیجه نهایی را با قطعیت پیش‌بینی کند.</p></article>\n<article class=\"mistake\"><h3>توجه فقط به نام دانشگاه</h3><p>رشته، دانشکده، استادان، امکانات، محل تحصیل و شرایط شخصی را نیز در نظر بگیر.</p></article>\n<article class=\"mistake\"><h3>ثبت‌نکردن نهایی فرم</h3><p>واردکردن کدها کافی نیست؛ ثبت نهایی را انجام بده و رسید یا کد پیگیری بگیر.</p></article>\n</div>\n</section>\n<section class=\"section\" id=\"principles\">\n<div class=\"section-head\"><span class=\"section-no\">۵</span><div><div class=\"section-kicker\">جمع‌بندی نهایی</div><h2 id=\"aris-article-section-14\">پنج اصل یک انتخاب رشته درست</h2></div></div>\n<div class=\"principles\">\n<div class=\"principle\">انتخاب‌ها را براساس علاقه واقعی مرتب کن، نه احتمال قبولی.</div>\n<div class=\"principle\">رتبه خود را با داوطلبان دارای سهمیه و شرایط مشابه مقایسه کن.</div>\n<div class=\"principle\">هیچ رشته‌محلی را که حاضر نیستی در آن ثبت‌نام کن وارد فرم نکن.</div>\n<div class=\"principle\">شهریه، خوابگاه، شهر، فاصله، تعهد خدمت و محدودیت انتقال را جدی بگیر.</div>\n<div class=\"principle\">دفترچه، پیوست و اصلاحیه‌ها را کامل و با دقت بخوان.</div>\n</div>\n<div class=\"final-note\">انتخاب رشته خوب فقط انتخاب یک اسم نیست؛ یعنی انتخاب چند سال تحصیل، یک شهر، یک سبک زندگی و تا حدی مسیر شغلی آینده.</div>\n</section>\n<section aria-label=\"کنترل نهایی راهنما\" class=\"section aris-standard-close\"><h2>اصطلاحات را این‌طور ببند</h2><div class=\"terms\"><article class=\"term\"><h3>خطای رایج</h3><p>حفظ‌کردن تعریف اصطلاحات بدون دیدن کاربرد آن‌ها در همان کدرشته‌محل و دفترچه سال جاری.</p></article><article class=\"term\"><h3>جمع‌بندی</h3><p>اصطلاحات زمانی ارزش دارند که بتوانی اثرشان را روی انتخاب واقعی خودت تشخیص بدهی.</p></article><article class=\"term\"><h3>اقدام بعدی</h3><p>هر اصطلاح مبهم در کارنامه یا دفترچه را قبل از تصمیم کنار همان انتخاب یادداشت و از متن رسمی همان سال تطبیق بده.</p></article></div></section><section aria-label=\"منابع و اعتبار اطلاعات\" class=\"aris-source-standard\"><h2>منابع و اعتبار اطلاعات</h2><div class=\"aris-source-meta\"><span>آخرین بازبینی: ۱۷ شهریور ۱۴۰۵</span><span>مرجع: سند رسمی + سامانه اجرایی</span><span>اطلاعات متغیر</span></div><p>منابع این راهنما به دو دسته تفکیک شده‌اند: سند سالانه‌ای که باید برای مقررات همان سال خوانده شود، و سامانه/مرجع رسمی‌ای که مسیر اجرایی یا اطلاعات روز را ارائه می‌کند.</p><div class=\"aris-source-docs\"><div class=\"aris-source-doc\"><b>دفترچه راهنمای انتخاب رشته آزمون سراسری ۱۴۰۵</b><p>تعریف دوره‌ها، اصطلاحات اجرایی، سهمیه‌ها، بومی‌گزینی و قواعد انتخاب رشته</p><a href=\"https://www.sanjesh.org/\" rel=\"noopener noreferrer\" target=\"_blank\">درگاه رسمی انتشار دفترچه ↗</a><small class=\"aris-source-type\">سند سالانه</small></div><div class=\"aris-source-doc\"><b>سامانه جامع آزمون سراسری</b><p>کارنامه ملاک انتخاب رشته، وضعیت مجاز و خدمات حساب داوطلب</p><a href=\"https://my.sanjesh.org/\" rel=\"noopener noreferrer\" target=\"_blank\">ورود مستقیم به سامانه ↗</a><small class=\"aris-source-type\">لینک مستقیم سامانه</small></div><div class=\"aris-source-doc\"><b>پیوست‌ها و اصلاحیه‌های انتخاب رشته ۱۴۰۵</b><p>شرایط دانشگاه‌ها و تغییرات بعد از انتشار دفترچه اصلی</p><a href=\"https://www.sanjesh.org/\" rel=\"noopener noreferrer\" target=\"_blank\">درگاه رسمی اطلاعیه‌ها ↗</a><small class=\"aris-source-type\">اطلاعیه سالانه</small></div></div><p class=\"aris-source-note\">اگر فایل یا اطلاعیه سالانه در درگاه رسمی جابه‌جا شده بود، عنوان دقیق سند بالا را در همان مرجع رسمی پیدا کن. لینک سامانه‌های اجرایی تا حد امکان مستقیم است؛ لینک انتشار دفترچه‌ها ممکن است سال‌به‌سال تغییر کند.</p></section>\n</main>\n<section class=\"aris-related\"><p class=\"aris-related__eyebrow\">قدم بعدی</p><h2>راهنماهای مرتبط</h2><div class=\"aris-related__grid\"><button data-related-guide=\"pazireheshaye-khas-va-sharayet-vijeh\" type=\"button\">پذیرش‌های خاص و شرایط ویژه <span aria-hidden=\"true\">←</span></button><button data-related-guide=\"az-sabt-form-ta-elam-natayej\" type=\"button\">از ثبت فرم تا اعلام نتیجه <span aria-hidden=\"true\">←</span></button></div></section></div><script>\n(function(){\nvar form=document.getElementById('aris-article-search-form'),input=document.getElementById('aris-article-search-input'),status=document.getElementById('aris-article-search-status'),nav=document.getElementById('aris-article-search-nav'),previous=document.getElementById('aris-search-prev'),next=document.getElementById('aris-search-next'),hits=[],current=-1,lastQuery='';\nfunction normalize(value){return String(value||'').toLowerCase().replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/[أإ]/g,'ا').replace(/ة/g,'ه').replace(/\\u200c/g,' ')}\nfunction clearHits(){document.querySelectorAll('mark.aris-search-hit').forEach(function(mark){var parent=mark.parentNode;parent.replaceChild(document.createTextNode(mark.textContent),mark);parent.normalize()});hits=[];current=-1;if(nav)nav.hidden=true}\nfunction collect(query){var root=document.getElementById('mainContent'),walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode:function(node){var parent=node.parentElement;return parent&&!parent.closest('script,style,mark.aris-search-hit')&&normalize(node.nodeValue).indexOf(query)>-1?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_REJECT}}),nodes=[],node;while((node=walker.nextNode())&&nodes.length<200)nodes.push(node);nodes.forEach(function(textNode){if(hits.length>=200)return;var source=textNode.nodeValue,normalized=normalize(source),from=0,index,fragment=document.createDocumentFragment();while((index=normalized.indexOf(query,from))>-1&&hits.length<200){if(index>from)fragment.appendChild(document.createTextNode(source.slice(from,index)));var mark=document.createElement('mark');mark.className='aris-search-hit';mark.textContent=source.slice(index,index+query.length);fragment.appendChild(mark);hits.push(mark);from=index+query.length}if(from<source.length)fragment.appendChild(document.createTextNode(source.slice(from)));textNode.parentNode.replaceChild(fragment,textNode)})}\nfunction show(index){if(!hits.length)return;hits.forEach(function(hit){hit.classList.remove('is-current')});current=(index+hits.length)%hits.length;hits[current].classList.add('is-current');hits[current].scrollIntoView({behavior:'smooth',block:'center'});status.textContent=hits.length+' نتیجه · '+(current+1)+' از '+hits.length;if(nav)nav.hidden=false}\nfunction runSearch(){var query=normalize(input.value.trim());if(!query){clearHits();lastQuery='';status.textContent='یک واژه یا عبارت بنویس.';return}if(query===lastQuery&&hits.length){show(current+1);return}clearHits();lastQuery=query;collect(query);if(hits.length)show(0);else status.textContent='عبارتی با این عنوان در مطلب پیدا نشد.'}\nif(form&&input){form.addEventListener('submit',function(event){event.preventDefault();runSearch()});input.addEventListener('input',function(){if(!input.value.trim()){clearHits();lastQuery='';status.textContent=''}});if(previous)previous.addEventListener('click',function(){show(current-1)});if(next)next.addEventListener('click',function(){show(current+1)})}\ndocument.querySelectorAll('[data-related-guide]').forEach(function(button){button.addEventListener('click',function(){parent.postMessage({type:'aris-guide-open',id:button.dataset.relatedGuide},'*')})});\n}());\n<\/script><script data-aris-search-disclosure=\"17\">\n(function(){\n  var disclosure=document.querySelector('.aris-search-disclosure');\n  var form=document.getElementById('aris-article-search-form');\n  if(!disclosure||!form)return;\n  disclosure.addEventListener('click',function(){\n    var open=disclosure.getAttribute('aria-expanded')==='true';\n    disclosure.setAttribute('aria-expanded',String(!open));\n    form.hidden=open;\n    if(!open){\n      var input=document.getElementById('aris-article-search-input');\n      setTimeout(function(){if(input)input.focus({preventScroll:true})},0);\n    }\n  });\n}());\n<\/script></body></html>","keywords":["اصطلاحات","واژه نامه","بومی گزینی","دوره روزانه","نوبت دوم","پردیس"]},{"id":"entekhab-reshte-sarasari-va-azad","title":"تفاوت انتخاب رشته سراسری و آزاد","eyebrow":"فرم‌ها و سامانه‌ها","category":"rules","categoryLabel":"قوانین و فرم‌ها","description":"تفاوت فرم‌ها، سامانه‌ها، اولویت‌ها، شهریه و نتیجه انتخاب رشته سراسری و دانشگاه آزاد را دقیق و ساده بشناسید.","minutes":6,"words":977,"dynamic":true,"document":"<!doctype html>\n<html dir=\"rtl\" lang=\"fa\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width,initial-scale=1,viewport-fit=cover\" name=\"viewport\"/><title>تفاوت انتخاب رشته سراسری و آزاد</title><style>\n    :root{--ink:#17211d;--muted:#64726b;--paper:#fbfaf6;--card:#fff;--green:#12372a;--green2:#245943;--mint:#dfece4;--gold:#e0a92f;--line:#dce4df;--shadow:0 16px 42px rgba(18,55,42,.09)}\n    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:linear-gradient(180deg,#eff5f1 0,#fbfaf6 520px);color:var(--ink);font-family:Tahoma,\"Vazirmatn\",\"Segoe UI\",sans-serif;line-height:2}\n    button,input{font:inherit}.progress{position:fixed;inset:0 0 auto;z-index:99;height:4px;background:transparent}.progress span{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--gold),#f2cf79)}\n    .hero{position:relative;overflow:hidden;background:var(--green);color:white;padding:72px 24px 102px}.hero:before,.hero:after{content:\"\";position:absolute;border-radius:50%;background:rgba(255,255,255,.045)}.hero:before{width:360px;height:360px;left:-100px;top:-160px}.hero:after{width:240px;height:240px;right:-80px;bottom:-100px}.hero-inner{position:relative;max-width:1120px;margin:auto}.eyebrow{display:inline-flex;gap:8px;align-items:center;padding:7px 13px;border:1px solid rgba(255,255,255,.22);border-radius:999px;color:#dfece4;font-size:.85rem}.eyebrow:before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--gold)}h1{max-width:830px;margin:22px 0 12px;font-size:clamp(2rem,5vw,4.1rem);line-height:1.35;letter-spacing:-.04em}.lead{max-width:790px;margin:0;color:#d6e3dc;font-size:1.08rem}.hero-stats{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.hero-stats span{padding:7px 13px;border-radius:10px;background:rgba(255,255,255,.09);font-size:.88rem}\n    .layout{max-width:1180px;margin:-58px auto 80px;padding:0 22px;display:grid;grid-template-columns:285px minmax(0,1fr);gap:28px;align-items:start}.sidebar{position:sticky;top:20px;background:var(--card);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);padding:18px}.sidebar h2{font-size:1rem;margin:0 0 12px}.search{position:relative;margin-bottom:14px}.search input{width:100%;border:1px solid var(--line);border-radius:12px;background:#f8faf8;padding:10px 38px 10px 10px;outline:none;color:var(--ink)}.search input:focus{border-color:var(--green2);box-shadow:0 0 0 3px rgba(36,89,67,.1)}.search:before{content:\"⌕\";position:absolute;right:13px;top:4px;font-size:1.35rem;color:var(--muted)}.count{font-size:.78rem;color:var(--muted);margin:-6px 2px 10px}.nav{display:grid;gap:4px;max-height:58vh;overflow:auto;padding-left:4px}.nav a{color:#415049;text-decoration:none;border-radius:10px;padding:7px 9px;font-size:.85rem;line-height:1.6}.nav a:hover{background:var(--mint);color:var(--green)}.toplink{display:block;text-align:center;margin-top:12px;padding:8px;border-top:1px solid var(--line);color:var(--green2);text-decoration:none;font-size:.84rem}\n    main{min-width:0}.intro,.section{background:var(--card);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.intro{padding:28px 30px;margin-bottom:24px}.intro p{margin:0}.section{padding:30px;margin-bottom:24px}.section-head{display:flex;align-items:flex-start;gap:15px;margin-bottom:20px;padding-bottom:18px;border-bottom:1px solid var(--line)}.section-no{flex:0 0 auto;display:grid;place-items:center;width:44px;height:44px;border-radius:14px;background:var(--green);color:white;font-weight:700}.section h2{margin:0;font-size:1.45rem;line-height:1.6}.section-kicker{font-size:.8rem;color:var(--muted)}.terms{display:grid;gap:14px}.term{position:relative;border:1px solid var(--line);border-radius:16px;padding:19px 20px;background:linear-gradient(135deg,#fff,#fbfcfb)}.term:hover{border-color:#b7cbc0;box-shadow:0 8px 24px rgba(18,55,42,.06)}.term h3{margin:0 0 6px;color:var(--green);font-size:1.05rem;line-height:1.7}.term h3 .num{display:inline-block;min-width:32px;color:var(--gold);font-variant-numeric:tabular-nums}.term p{margin:5px 0}.term ul{margin:7px 0 0;padding-right:22px}.example{margin-top:10px!important;padding:10px 13px;border-right:3px solid var(--gold);background:#fff8e7;border-radius:10px;color:#544825;font-size:.93rem}.simple{color:var(--green2);font-weight:700}.hidden{display:none!important}.empty{display:none;background:#fff;border:1px dashed #b7c6bd;border-radius:18px;padding:30px;text-align:center;color:var(--muted)}mark{background:#ffe59e;border-radius:4px;padding:0 2px}\n    .mistakes{counter-reset:mistake;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.mistake{counter-increment:mistake;border:1px solid var(--line);border-radius:15px;padding:17px;background:#fff}.mistake h3{margin:0 0 5px;font-size:1rem}.mistake h3:before{content:counter(mistake,\"persian\") \". \";color:var(--gold)}.mistake p{margin:0;color:#3f4c46;font-size:.93rem}.principles{display:grid;gap:10px;counter-reset:principle}.principle{counter-increment:principle;display:flex;gap:13px;align-items:flex-start;padding:14px;border-radius:14px;background:#f4f8f5}.principle:before{content:counter(principle,\"persian\");display:grid;place-items:center;flex:0 0 34px;height:34px;border-radius:10px;background:var(--green);color:#fff;font-weight:700}.final-note{margin-top:22px;padding:18px 20px;border-radius:16px;background:var(--green);color:#eef7f1;font-size:1.05rem}.footer{text-align:center;color:var(--muted);padding:10px 20px 42px;font-size:.82rem}\n    .mobile-tools{display:none}.copy-toast{position:fixed;z-index:120;left:50%;bottom:28px;transform:translate(-50%,20px);padding:9px 16px;background:#17211d;color:white;border-radius:999px;opacity:0;pointer-events:none;transition:.25s}.copy-toast.show{opacity:1;transform:translate(-50%,0)}\n    @media(max-width:900px){.layout{grid-template-columns:1fr;margin-top:-54px}.sidebar{position:relative;top:0}.nav{grid-template-columns:repeat(2,minmax(0,1fr));max-height:none}.toplink{display:none}.hero{padding-top:54px}.mistakes{grid-template-columns:1fr}}\n    @media(max-width:560px){body{line-height:1.9}.hero{padding:42px 18px 86px}h1{font-size:2rem}.lead{font-size:.98rem}.layout{padding:0 12px;gap:16px}.sidebar,.intro,.section{border-radius:18px}.section,.intro{padding:21px 17px}.nav{grid-template-columns:1fr 1fr}.nav a{font-size:.78rem;padding:6px}.term{padding:16px 14px}.section-head{gap:10px}.section-no{width:38px;height:38px;border-radius:12px}.section h2{font-size:1.2rem}}\n    @media print{body{background:#fff}.progress,.sidebar{display:none}.hero{padding:30px;background:#fff;color:#111;border-bottom:2px solid #111}.hero .lead,.eyebrow{color:#333}.layout{display:block;margin:0;padding:0}.intro,.section{box-shadow:none;border:0;border-radius:0;break-inside:auto}.term{break-inside:avoid}.section{break-before:page}.hero-stats{color:#111}.final-note{background:#eee;color:#111}.footer{display:none}}\n  \n  .guide-intro{overflow:hidden}.guide-map{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin-top:23px}.map-card{display:grid;grid-template-columns:38px minmax(0,1fr);gap:12px;align-items:center;padding:15px;border:1px solid rgba(25,89,65,.12);border-radius:16px;background:linear-gradient(145deg,#fff,#f5f8f5);color:inherit;text-decoration:none;font-family:Tahoma,Arial,sans-serif;transition:.2s}.map-card:hover{transform:translateY(-2px);border-color:rgba(181,128,24,.42);box-shadow:0 12px 28px rgba(14,53,37,.08)}.map-card>span{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:linear-gradient(145deg,#173d2e,#091f16);color:#f6c64d;font-weight:600}.map-card b{display:block;color:#173d2e;font-size:.9rem;font-weight:600;line-height:1.7}.map-card small{display:block;color:#718078;font-size:.73rem;line-height:1.6}.decision-strip{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 22px;padding:20px 22px;border:1px solid rgba(245,187,53,.23);border-radius:22px;background:linear-gradient(140deg,#091a12,#123525);color:#fff;box-shadow:0 18px 42px rgba(9,32,22,.14)}.decision-strip div{display:grid;gap:2px}.decision-strip span{color:#dcae3d;font:600 .66rem Tahoma}.decision-strip b{font-size:.82rem}.decision-strip small{color:#8fa197;font-size:.68rem}.decision-strip i{width:32px;height:1px;background:linear-gradient(90deg,transparent,#c9982c,transparent)}.section-intro{margin:-3px 0 19px;padding:13px 15px;border-radius:13px;background:#f6f2e7;color:#66726b;font-size:.88rem;line-height:1.9}.guide-topic .term-body-inner>p{margin:7px 0}.guide-topic ul,.guide-topic ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px 18px;margin:13px 0;padding:0;list-style:none}.guide-topic li{position:relative;padding-right:18px;color:#536159;font-size:.9rem;line-height:1.9}.guide-topic ul li:before{content:\"\";position:absolute;right:2px;top:.86em;width:6px;height:6px;border-radius:50%;background:#d5a52f;box-shadow:0 0 0 3px rgba(213,165,47,.12)}.guide-topic ol{counter-reset:item}.guide-topic ol li{counter-increment:item}.guide-topic ol li:before{content:counter(item,decimal);position:absolute;right:0;top:.26em;color:#a87816;font-weight:700;font-size:.74rem}.guide-topic .long-list{grid-template-columns:repeat(3,minmax(0,1fr))}.topic-note{display:flex;align-items:flex-start;gap:10px;margin-top:13px;padding:13px 14px;border:1px solid rgba(197,143,29,.2);border-radius:13px;background:#fff8e8}.topic-note span{flex:0 0 auto;padding:3px 8px;border-radius:7px;background:#dfaa31;color:#251904;font:700 .7rem Tahoma}.topic-note p{margin:0!important;color:#5e563f}.guide-topic .example{display:grid;grid-template-columns:auto 1fr;gap:9px;align-items:start}.guide-topic .example b{color:#a06e13}.guide-topic blockquote{margin:12px 0 0;padding:17px 18px;border:1px solid rgba(28,88,65,.14);border-right:4px solid #1c5841;border-radius:14px;background:#f3f8f5;color:#173d2e;font-weight:700;line-height:2}.formula-box{margin-top:13px;padding:18px;border-radius:14px;background:linear-gradient(135deg,#0b2419,#174a35);color:#f7d474;text-align:center;font-weight:800;line-height:2;box-shadow:inset 0 1px rgba(255,255,255,.06)}.mini-compare{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:13px}.mini-compare>div{padding:15px;border:1px solid rgba(27,82,62,.13);border-radius:14px;background:#f7faf8}.mini-compare>div>b{display:block;padding-bottom:8px;color:#173d2e;border-bottom:1px solid #dde8e1}.mini-compare ul{grid-template-columns:1fr;margin-bottom:0}.section-count:after{content:\" موضوع\"}\n  @media(max-width:700px){.guide-map{grid-template-columns:1fr}.decision-strip{display:grid;grid-template-columns:1fr 1fr}.decision-strip i{display:none}.guide-topic ul,.guide-topic ol,.guide-topic .long-list{grid-template-columns:1fr}.mini-compare{grid-template-columns:1fr}.map-card{grid-template-columns:40px minmax(0,1fr)}.map-card b{font-size:.86rem}.decision-strip div{padding:8px;border-bottom:1px solid rgba(255,255,255,.06)}}\n.split-intro{overflow:hidden}.split-intro .intro-grid>div:first-child{max-width:730px}.split-intro .intro-grid p{margin:8px 0 0;line-height:2;color:#647169}.intro-points{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:22px}.intro-points span{display:flex;align-items:center;gap:9px;padding:12px 13px;border:1px solid rgba(28,88,65,.12);border-radius:13px;background:linear-gradient(145deg,#fff,#f4f8f5);color:#355247;font:500 .78rem Tahoma,Arial,sans-serif}.intro-points i{display:grid;place-items:center;flex:0 0 auto;width:26px;height:26px;border-radius:8px;background:#123b2b;color:#f2c655;font-style:normal;font-weight:600}@media(max-width:620px){.intro-points{grid-template-columns:1fr}.split-intro .intro-grid{display:block}.split-intro .intro-badge{margin-top:18px}}\n\n\n    :root{\n      --aris-black:#050706;--aris-black-2:#0b100d;--aris-green:#0d2c20;--aris-green-2:#173f2e;\n      --aris-emerald:#2e7653;--aris-gold:#f5bb35;--aris-gold-2:#ffdf7d;--aris-gold-dark:#9a6610;\n      --aris-ivory:#f8f4e9;--aris-paper:#fffdf8;--aris-ink:#18211c;--aris-line:#e4dcc7;\n      --gold-gradient:linear-gradient(135deg,#8d5b09 0%,#f2af1f 27%,#fff0a5 49%,#e19a0d 68%,#8c5908 100%);\n    }\n    body{background:\n      radial-gradient(circle at 13% 8%,rgba(230,173,38,.09),transparent 24rem),\n      linear-gradient(180deg,#07100c 0 690px,var(--aris-ivory) 690px 100%);color:var(--aris-ink)}\n    body:before{content:\"\";position:fixed;inset:0;z-index:-1;opacity:.32;pointer-events:none;background-image:linear-gradient(rgba(17,61,43,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(17,61,43,.035) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,transparent 400px,#000 780px)}\n    .progress{height:5px;background:#0a1711}.progress span{position:relative;background:var(--gold-gradient);box-shadow:0 0 14px rgba(245,187,53,.85)}\n    .hero{min-height:690px;padding:0 24px 120px;background:\n      radial-gradient(circle at 78% 43%,rgba(245,187,53,.16),transparent 21rem),\n      radial-gradient(circle at 18% 20%,rgba(41,116,80,.2),transparent 26rem),\n      linear-gradient(135deg,#030504 0%,#08110d 45%,#0b2118 100%);border-bottom:1px solid rgba(245,187,53,.3)}\n    .hero:before{width:640px;height:640px;left:-260px;top:-320px;border:1px solid rgba(245,187,53,.1);background:repeating-radial-gradient(circle,transparent 0 28px,rgba(245,187,53,.025) 29px 30px)}\n    .hero:after{width:580px;height:580px;right:-180px;bottom:-350px;border:1px solid rgba(245,187,53,.13);background:repeating-radial-gradient(circle,transparent 0 38px,rgba(245,187,53,.025) 39px 40px)}\n    .hero-grid{position:absolute;inset:0;opacity:.2;pointer-events:none;background-image:linear-gradient(rgba(255,220,115,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(255,220,115,.09) 1px,transparent 1px);background-size:68px 68px;mask-image:linear-gradient(90deg,transparent,#000 35%,#000 70%,transparent)}\n    .brandbar{position:relative;z-index:4;max-width:1180px;margin:auto;min-height:96px;display:flex;align-items:center;justify-content:space-between;gap:26px;border-bottom:1px solid rgba(245,187,53,.15)}\n    .brand-banner{display:block;width:min(420px,48vw);max-height:70px;object-fit:contain;object-position:right center;filter:drop-shadow(0 0 12px rgba(245,187,53,.2))}\n    .channel-link{display:inline-flex;align-items:center;gap:9px;color:#f9eac0;text-decoration:none;padding:10px 14px;border:1px solid rgba(245,187,53,.26);border-radius:999px;background:rgba(255,255,255,.035);font-size:.86rem;transition:.25s}.channel-link:hover{border-color:var(--aris-gold);background:rgba(245,187,53,.1);transform:translateY(-2px)}.channel-link b{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:var(--gold-gradient);color:#171006}\n    .hero-inner{display:grid;grid-template-columns:minmax(0,1.14fr) minmax(330px,.86fr);gap:60px;align-items:center;padding-top:72px}\n    .hero-copy{position:relative;z-index:2}.hero .eyebrow{border-color:rgba(245,187,53,.34);background:rgba(245,187,53,.06);color:#f8deb0;backdrop-filter:blur(10px)}.hero .eyebrow:before{box-shadow:0 0 16px var(--aris-gold)}\n    .hero h1{max-width:790px;margin-top:20px;font-size:clamp(2.25rem,4.6vw,4.7rem);line-height:1.28;background:linear-gradient(180deg,#fff 0,#fbf5e7 62%,#d9c9a0 100%);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 18px 55px rgba(0,0,0,.28)}\n    .hero .lead{max-width:720px;color:#bdc9c2;font-size:1.08rem}.hero .lead strong{color:var(--aris-gold-2)}\n    .hero-actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:26px}.hero-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:11px 18px;border-radius:12px;text-decoration:none;font-weight:700;font-size:.92rem;transition:.25s}.hero-btn.primary{background:var(--gold-gradient);color:#171006;box-shadow:0 12px 34px rgba(226,159,21,.2),inset 0 1px rgba(255,255,255,.55)}.hero-btn.primary:hover{transform:translateY(-3px);box-shadow:0 17px 38px rgba(226,159,21,.3)}.hero-btn.secondary{color:#dce7e0;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.035)}.hero-btn.secondary:hover{border-color:rgba(245,187,53,.45);color:#fff}\n    .hero-stats{gap:9px;margin-top:30px}.hero-stats span{position:relative;padding:8px 13px 8px 14px;color:#d0dbd4;border:1px solid rgba(255,255,255,.085);background:rgba(255,255,255,.035);backdrop-filter:blur(8px)}.hero-stats span:before{content:\"\";display:inline-block;width:5px;height:5px;margin-left:7px;border-radius:50%;background:var(--aris-gold);box-shadow:0 0 9px var(--aris-gold)}\n    .hero-visual{position:relative;display:grid;place-items:center;min-height:410px}.logo-stage{position:relative;display:grid;place-items:center;width:min(390px,34vw);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(245,187,53,.13),rgba(13,44,32,.1) 55%,transparent 70%)}\n    .logo-stage:before,.logo-stage:after{content:\"\";position:absolute;border-radius:50%;border:1px solid rgba(245,187,53,.27)}.logo-stage:before{inset:4%;box-shadow:0 0 55px rgba(245,187,53,.09),inset 0 0 45px rgba(245,187,53,.06)}.logo-stage:after{inset:-8%;border-style:dashed;animation:orbit 34s linear infinite}\n    .hero-logo{position:relative;z-index:2;width:78%;aspect-ratio:1;object-fit:cover;border-radius:50%;mix-blend-mode:screen;filter:contrast(1.08) drop-shadow(0 17px 45px rgba(0,0,0,.6)) drop-shadow(0 0 18px rgba(245,187,53,.18))}\n    .spark{position:absolute;z-index:3;width:8px;height:8px;background:var(--aris-gold-2);transform:rotate(45deg);box-shadow:0 0 17px 5px rgba(245,187,53,.34);animation:pulse 2.8s ease-in-out infinite}.spark.s1{top:11%;right:14%}.spark.s2{bottom:17%;left:10%;animation-delay:-1.2s}.spark.s3{top:45%;left:-2%;width:5px;height:5px;animation-delay:-2s}\n    .orbit-label{position:absolute;z-index:5;padding:7px 12px;border:1px solid rgba(245,187,53,.24);border-radius:999px;background:rgba(5,11,8,.8);color:#e9e3d2;font-size:.78rem;box-shadow:0 10px 28px rgba(0,0,0,.32);backdrop-filter:blur(8px)}.orbit-label.l1{top:18%;right:-5%}.orbit-label.l2{bottom:14%;right:5%}.orbit-label.l3{top:45%;left:-7%}.orbit-label:before{content:\"✦\";color:var(--aris-gold);margin-left:6px}\n    @keyframes orbit{to{transform:rotate(360deg)}}@keyframes pulse{50%{opacity:.35;transform:rotate(45deg) scale(.55)}}\n    .layout{max-width:1210px;margin:-68px auto 90px;grid-template-columns:300px minmax(0,1fr);gap:30px}.sidebar{top:18px;border-color:rgba(245,187,53,.24);border-radius:24px;padding:0;overflow:hidden;background:linear-gradient(160deg,#0a1510,#08100d);box-shadow:0 28px 70px rgba(6,21,14,.22),inset 0 1px rgba(255,255,255,.04)}\n    .mini-brand{position:relative;display:flex;align-items:center;gap:12px;padding:18px 18px 15px;border-bottom:1px solid rgba(245,187,53,.14);overflow:hidden}.mini-brand:after{content:\"\";position:absolute;width:90px;height:90px;left:-28px;top:-44px;border-radius:50%;background:rgba(245,187,53,.08);filter:blur(5px)}.mini-mark{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:var(--gold-gradient);color:#151006;font-family:Georgia,serif;font-size:1.65rem;font-weight:700;box-shadow:0 9px 24px rgba(230,168,34,.22)}.mini-brand strong{display:block;color:#fff;font-family:Georgia,Tahoma,serif;letter-spacing:.04em}.mini-brand small{display:block;color:#8fa197;font-size:.7rem;line-height:1.4}.sidebar-content{padding:16px}.sidebar h2{color:#f3ead1}.search input{border-color:rgba(255,255,255,.09);background:rgba(255,255,255,.045);color:#fff}.search input::placeholder{color:#73857b}.search input:focus{border-color:var(--aris-gold);box-shadow:0 0 0 3px rgba(245,187,53,.09)}.search:before{color:var(--aris-gold)}.count{color:#778a7f}.nav{padding-left:5px}.nav a{position:relative;color:#9eb0a6;padding:8px 11px;border:1px solid transparent}.nav a:hover{color:#fff;background:rgba(245,187,53,.07);border-color:rgba(245,187,53,.12);padding-right:15px}.nav a:before{content:\"\";display:inline-block;width:4px;height:4px;border-radius:50%;margin-left:8px;background:#466556}.nav a:hover:before{background:var(--aris-gold);box-shadow:0 0 8px var(--aris-gold)}.toplink{color:#ddbd67;border-color:rgba(245,187,53,.12)}\n    .intro,.section{position:relative;border:1px solid var(--aris-line);background:rgba(255,253,248,.96);box-shadow:0 20px 55px rgba(30,50,39,.08);overflow:hidden}.intro:before,.section:before{content:\"\";position:absolute;inset:0 auto auto 0;width:160px;height:3px;background:var(--gold-gradient)}.intro{padding:30px 32px;border-radius:24px}.intro-grid{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:24px;align-items:center}.intro-kicker{display:inline-flex;align-items:center;gap:8px;color:var(--aris-gold-dark);font-size:.76rem;font-weight:700;letter-spacing:.04em}.intro-kicker:before{content:\"\";width:22px;height:1px;background:var(--aris-gold)}.intro h2{margin:5px 0 7px;color:var(--aris-green);font-size:1.28rem}.intro p{color:#59655e}.intro-badge{position:relative;display:grid;place-items:center;min-height:118px;border:1px solid #eadcb9;border-radius:18px;background:radial-gradient(circle at 50% 35%,#fff7db,#f3e7c7);text-align:center;overflow:hidden}.intro-badge:before{content:\"A\";position:absolute;color:rgba(154,102,16,.07);font:700 8rem/1 Georgia}.intro-badge b{position:relative;display:block;font-size:2rem;color:var(--aris-green);line-height:1.2}.intro-badge span{position:relative;color:#89703a;font-size:.75rem}\n    .section{padding:31px;border-radius:24px}.section-head{position:relative;align-items:center;margin-bottom:22px;padding-bottom:20px;border-color:#ebe4d3}.section-no{position:relative;width:52px;height:52px;border-radius:16px;background:linear-gradient(145deg,var(--aris-green-2),#081c13);color:var(--aris-gold-2);border:1px solid rgba(245,187,53,.28);box-shadow:0 10px 24px rgba(13,44,32,.18)}.section-no:after{content:\"\";position:absolute;inset:5px;border:1px solid rgba(245,187,53,.13);border-radius:11px}.section h2{color:var(--aris-green);letter-spacing:-.015em}.section-kicker{color:#9a7a2f;font-weight:700}.section-head:after{content:\"ARIS ACADEMY\";position:absolute;left:0;bottom:18px;color:#cbbf9f;font:600 .64rem/1 Georgia,serif;letter-spacing:.16em}\n    .terms{gap:12px}.term{padding:20px 21px 20px 20px;border-color:#e6dfcf;border-radius:17px;background:linear-gradient(135deg,#fffefb,#faf7ef);box-shadow:0 5px 18px rgba(19,49,34,.025);transition:.25s}.term:before{content:\"\";position:absolute;right:0;top:18px;bottom:18px;width:3px;border-radius:3px;background:linear-gradient(var(--aris-gold-2),var(--aris-gold-dark));opacity:.65}.term:hover{transform:translateY(-2px);border-color:#d7c38d;box-shadow:0 14px 34px rgba(31,54,42,.08)}.term h3{color:var(--aris-green);font-size:1.08rem}.term h3 .num{min-width:39px;color:var(--aris-gold-dark);font-weight:800}.term p{color:#414d46}.example{position:relative;margin-top:12px!important;padding:12px 16px!important;border:0!important;border-radius:12px!important;background:linear-gradient(90deg,#fff4ce,#faf1d8)!important;color:#544625!important}.example:before{content:\"✦\";color:#ad730c;margin-left:7px}.simple{color:var(--aris-green)}\n    .mistakes{gap:13px}.mistake{position:relative;border-color:#e7ddc6;background:linear-gradient(145deg,#fffefa,#faf5e9);overflow:hidden;transition:.25s}.mistake:hover{transform:translateY(-3px);border-color:#d6be82;box-shadow:0 12px 30px rgba(32,52,41,.07)}.mistake:after{content:counter(mistake,\"persian\");position:absolute;left:9px;bottom:-15px;color:rgba(24,63,45,.055);font:700 5rem/1 Tahoma}.mistake h3:before{display:inline-grid;place-items:center;width:28px;height:28px;margin-left:7px;border-radius:9px;background:#f7e7b6;color:#805308}\n    .principle{border:1px solid #e4dcc8;background:linear-gradient(90deg,#f9f3e4,#fffdf8)}.principle:before{background:linear-gradient(145deg,var(--aris-green-2),#07170f);color:var(--aris-gold-2);border:1px solid rgba(245,187,53,.25)}.final-note{position:relative;background:linear-gradient(135deg,#081a12,#123a29);border:1px solid rgba(245,187,53,.28);color:#f2ede0;box-shadow:0 18px 40px rgba(8,31,21,.18);overflow:hidden}.final-note:after{content:\"A\";position:absolute;left:18px;top:-28px;color:rgba(245,187,53,.07);font:700 8rem/1 Georgia}\n    .footer{position:relative;padding:54px 20px 46px;background:linear-gradient(180deg,#07100c,#020302);color:#7e9286;border-top:1px solid rgba(245,187,53,.18)}.footer-brand{display:block;width:min(460px,80vw);max-height:90px;object-fit:contain;margin:0 auto 18px;filter:drop-shadow(0 0 13px rgba(245,187,53,.12))}.footer p{margin:0}.footer:before{content:\"\";position:absolute;top:0;left:50%;width:min(620px,75vw);height:1px;transform:translateX(-50%);background:var(--gold-gradient);box-shadow:0 0 18px rgba(245,187,53,.35)}\n    .copy-toast{border:1px solid rgba(245,187,53,.4);background:#07130d;color:#fae5aa;box-shadow:0 14px 35px rgba(0,0,0,.28)}\n    @media(max-width:1000px){.hero-inner{grid-template-columns:1fr 330px;gap:22px}.logo-stage{width:320px}.layout{grid-template-columns:275px minmax(0,1fr)}}\n    @media(max-width:900px){body{background:linear-gradient(180deg,#07100c 0 950px,var(--aris-ivory) 950px)}.hero{min-height:auto;padding-bottom:120px}.brandbar{min-height:84px}.hero-inner{grid-template-columns:1fr;padding-top:52px}.hero-copy{text-align:center}.hero h1,.hero .lead{margin-left:auto;margin-right:auto}.hero-actions,.hero-stats{justify-content:center}.hero-visual{min-height:340px}.logo-stage{width:310px}.layout{grid-template-columns:1fr}.sidebar{position:relative}.section-head:after{display:none}}\n    @media(max-width:560px){body{background:linear-gradient(180deg,#07100c 0 900px,var(--aris-ivory) 900px)}.hero{padding:0 16px 105px}.brandbar{min-height:74px}.brand-banner{width:64vw;max-height:54px}.channel-link{padding:8px 10px;font-size:.74rem}.channel-link span{display:none}.hero-inner{padding-top:42px}.hero h1{font-size:2.15rem}.hero .lead{font-size:.95re