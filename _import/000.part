ont-family:"Vazirmatn",Tahoma,Arial,sans-serif;font-size:14px;line-height:1.9;background:linear-gradient(125deg,rgba(40,37,19,.5),rgba(13,19,10,.38));box-shadow:inset 0 1px 0 rgba(255,255,255,.04)}.aris-footer-main{display:flex;align-items:flex-start;gap:22px}.aris-footer-mark{width:40px;height:50px;flex:0 0 40px;color:#e5b63e}.aris-footer-copy{min-width:0;flex:1}.aris-dossier-footer .aris-footer-eyebrow{margin:0 0 6px;color:#a8b789;font-size:12px}.aris-dossier-footer .aris-footer-title{margin:0 0 9px;padding:0;border:0;color:#f0e2bb;font-size:clamp(19px,3vw,24px);line-height:1.6}.aris-dossier-footer .aris-footer-description{max-width:680px;margin:0;color:#c7c2ae;font-size:14px;line-height:2}.aris-footer-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;margin-top:20px}.aris-dossier-footer .aris-footer-join{min-height:46px;padding:10px 18px;border:1px solid rgba(239,206,112,.66);border-radius:12px;display:inline-flex;align-items:center;justify-content:center;gap:12px;color:#1b1a0d;background:linear-gradient(135deg,#efd17a,#cca337);font-size:14px;font-weight:800;line-height:1.7;text-decoration:none}.aris-dossier-footer .aris-footer-join:hover{background:#f2d887}.aris-dossier-footer .aris-footer-handle{color:#b4c493;font-size:13px;text-decoration:none}.aris-footer-bottom{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 20px;margin-top:26px;padding-top:16px;border-top:1px solid rgba(229,182,62,.13)}.aris-footer-credit{font-size:12px;color:#9e9986}.aris-footer-tools{display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px}.aris-footer-tools button{min-height:44px;padding:7px 0;border:0;background:transparent;color:#d6ceb7;font:inherit;font-size:12px;cursor:pointer}.aris-footer-tools button:hover{color:#f5d981}.aris-inline-invite a:focus-visible,.aris-dossier-footer a:focus-visible,.aris-footer-tools button:focus-visible{outline:2px solid #efd17a;outline-offset:4px}.aris-home-footer{position:relative;z-index:1;width:min(100% - 32px,1120px);margin:0 auto 26px;padding-top:20px;border-top:1px solid rgba(229,182,62,.13);text-align:center;color:#aaa493;font-size:12px;line-height:2}.aris-home-footer p{margin:4px 0}.aris-home-footer a{color:#c7b775;text-underline-offset:4px}.has-major-viewer .aris-home-footer,.has-province-viewer .aris-home-footer{display:none}@media (max-width:680px){.site-header{gap:10px;padding-inline:max(12px,env(safe-area-inset-left,0px))}.site-header .brand-lockup{gap:7px}.site-header .brand-lockup__copy{display:block}.site-header .brand-lockup__name{font-size:10px;letter-spacing:.04em}.site-header .brand-lockup__descriptor{font-size:7px;letter-spacing:.05em}.site-header .header-actions{gap:6px}.site-header .sound-toggle{width:44px;padding:0}.site-header .sound-label{display:none}.site-header .channel-link{padding-inline:9px;font-size:11px}#major-search,#province-search{font-size:16px}.search-field,.province-search-field{min-height:70px;padding:8px 9px;gap:7px}.search-icon,.province-search-icon{width:22px;height:22px;flex:0 0 22px}.search-submit,.province-search-submit{width:50px;height:50px;flex:0 0 50px;border-radius:15px}.clear-button,.province-search-clear{width:32px;height:44px;flex:0 0 32px;padding:0}.major-document .aris-quick-nav{flex-direction:row;align-items:center;padding:6px}.major-document .aris-quick-nav>span{display:none}.major-document .aris-quick-nav button{min-height:44px}.major-viewer__title,.province-viewer__title{font-size:.86rem}.aris-inline-invite{flex-direction:column;align-items:flex-start;gap:4px;padding:16px}.aris-footer-main{gap:12px}.aris-footer-mark{width:28px;height:36px;flex-basis:28px}.aris-footer-actions{gap:12px}}@media (max-width:420px){.site-header .brand-lockup__descriptor{display:none}.site-header .brand-monogram{width:26px;height:34px;flex-basis:26px}.site-header .channel-link span{display:none}.site-header .channel-link::after{content:"کانال آریس"}.aris-footer-main{display:block}.aris-footer-mark{display:none}.aris-footer-actions{align-items:flex-start;flex-direction:column}}</style>
<style>
/* Header message refinement */
.site-header {
    display: grid;
    grid-template-columns: minmax(0,1fr) auto minmax(0,1fr);
    align-items: center;
    column-gap: clamp(10px,2.4vw,28px);
}
.site-header .brand-lockup { justify-self: start; }
.site-header .header-actions { justify-self: end; }
.header-promise {
    justify-self: center;
    margin: 0;
    color: #e8d79f;
    font-family: "Vazirmatn",Tahoma,Arial,sans-serif;
    font-size: clamp(12px,1.25vw,15px);
    font-weight: 700;
    line-height: 1.6;
    text-align: center;
    white-space: nowrap;
}
.header-promise::before,.header-promise::after {
    content: "";
    display: inline-block;
    width: clamp(12px,2vw,28px);
    height: 1px;
    margin-inline: 9px;
    vertical-align: middle;
    background: linear-gradient(90deg,transparent,rgba(229,182,62,.58));
}
.header-promise::after { transform: scaleX(-1); }
@media (max-width:760px) {
    .site-header {
        display: grid;
        grid-template-columns: minmax(78px,1fr) auto minmax(78px,1fr);
        justify-items: stretch;
        column-gap: 7px;
    }
    .site-header .brand-lockup { justify-self: start; }
    .site-header .header-actions { justify-self: end; }
    .header-promise {
        max-width: 112px;
        font-size: 10px;
        line-height: 1.55;
        white-space: normal;
    }
    .header-promise::before,.header-promise::after { display: none; }
}
@media (max-width:420px) {
    .site-header { grid-template-columns: minmax(72px,1fr) auto minmax(72px,1fr); }
    .site-header .brand-lockup__descriptor {
        display: block;
        margin-top: 2px;
        font-size: 5.8px;
        letter-spacing: .025em;
        white-space: nowrap;
    }
    .site-header .brand-lockup__name { font-size: 9px; }
    .header-promise { max-width: 92px; font-size: 9px; }
}
@media (max-width:680px) {
    .site-header {
        grid-template-columns: auto minmax(0,1fr);
        grid-template-areas:
            "actions brand"
            "promise promise";
        column-gap: 12px;
        row-gap: 4px;
        padding: calc(8px + env(safe-area-inset-top,0px)) max(12px,env(safe-area-inset-left,0px)) 7px;
    }
    .site-header .brand-lockup {
        grid-area: brand;
        justify-self: end;
        max-width: 100%;
    }
    .site-header .header-actions {
        grid-area: actions;
        justify-self: start;
        gap: 6px;
    }
    .site-header .sound-toggle,
    .site-header .channel-link {
        width: 44px;
        min-width: 44px;
        height: 44px;
        min-height: 44px;
        padding: 0;
        border-radius: 13px;
        justify-content: center;
    }
    .site-header .sound-label,
    .site-header .channel-link span { display: none; }
    .site-header .channel-link::after { content: none; }
    .header-promise {
        grid-area: promise;
        justify-self: stretch;
        width: 100%;
        max-width: none;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        color: #d8c88f;
        font-size: 10.5px;
        line-height: 1.45;
        white-space: nowrap;
    }
    .header-promise::before,
    .header-promise::after {
        display: block;
        width: min(12vw,42px);
        margin: 0;
        flex: 0 1 42px;
    }
}
@media (max-width:370px) {
    .site-header { column-gap: 8px; padding-inline: 10px; }
    .site-header .brand-monogram { width: 25px; height: 32px; flex-basis: 25px; }
    .site-header .brand-lockup__name { font-size: 9px; }
    .site-header .brand-lockup__descriptor { font-size: 5.5px; }
    .header-promise { font-size: 10px; }
}

/* Runtime performance: same visuals, smaller repaint and layout regions. */
.ambient-scene { contain: layout paint style; }
.province-chapter {
    content-visibility: auto;
    contain-intrinsic-size: auto 900px;
}
.province-chapter:first-child { content-visibility: visible; }
</style>
<meta content="integration-ready-1+audited-v3-8-17" name="aris-selection-module-version"/>
<style data-aris-safe-home-refinement="v3-8-16-fixed">
/* CSS-only homepage refinement. No search/viewer/module DOM is moved or wrapped. */
.hero{
  min-height:auto;
  padding-top:clamp(44px,6.5vh,72px);
  padding-bottom:clamp(92px,10vh,116px);
}
.hero-sigil{
  transform:scale(.94);
  transform-origin:center;
}
.sigil-floor-glow{opacity:.82}
.hero h1{
  max-width:860px;
  font-size:clamp(31px,4.7vw,52px);
  line-height:1.42;
}
.hero__lead{
  max-width:700px;
  margin-top:13px;
  color:#aeb5ad;
  line-height:1.95;
}
.search-stage{
  width:min(100%,830px);
  margin-top:clamp(27px,4vh,40px);
}
.search-field{
  min-height:74px;
  border-radius:21px;
}
.search-icon{
  width:49px;
  height:49px;
  flex-basis:49px;
}
.search-input{height:54px}
.search-submit{
  width:58px;
  height:58px;
  flex-basis:58px;
  border-radius:17px;
}
.search-help{margin-top:10px}
.province-lookup{
  margin-top:23px;
  padding-top:23px;
  border-top-color:rgba(105,170,132,.16);
}
.province-lookup .lookup-caption strong{color:#a9cbb8}
.province-lookup .lookup-caption strong::before{
  background:#78b493;
  box-shadow:0 0 13px rgba(120,180,147,.55);
}
.province-search-field{
  min-height:74px;
  border-radius:21px;
  border-color:rgba(105,170,132,.38);
}
.province-search-icon{color:#87bea1}
.province-search-submit{
  width:58px;
  height:58px;
  flex-basis:58px;
  border-radius:17px;
  border-color:rgba(158,205,177,.55);
  background:linear-gradient(145deg,#bedbc9,#7db294);
  box-shadow:inset 0 1px rgba(255,255,255,.42),0 9px 24px rgba(78,135,101,.16);
}
.channel-pulse{margin-top:12px}
#aris-selection-module{
  margin:-24px auto 0 !important;
}
#aris-selection-module .guide-reader{z-index:320}
@media(max-width:760px){
  .hero{
    padding-top:36px;
    padding-bottom:76px;
  }
  .hero-sigil{transform:scale(.90)}
  .search-stage{
    width:min(100%,680px);
    margin-top:24px;
  }
  .province-lookup{
    margin-top:18px;
    padding-top:18px;
  }
  #aris-selection-module{margin:-16px auto 0 !important}
}
@media(max-width:560px){
  .hero{
    padding-top:28px;
    padding-bottom:62px;
  }
  .hero h1{
    font-size:clamp(29px,9vw,38px);
    line-height:1.46;
  }
  .hero__lead{
    margin-top:9px;
    font-size:13.5px;
    line-height:1.9;
  }
  .search-stage{margin-top:19px}
  .search-field,
  .province-search-field{
    min-height:64px;
    border-radius:17px;
  }
  .search-icon{
    width:40px;
    height:40px;
    flex-basis:40px;
  }
  .search-input{
    height:48px;
    font-size:14px;
  }
  .search-submit,
  .province-search-submit{
    width:48px;
    height:48px;
    flex-basis:48px;
    border-radius:14px;
  }
  .search-help{
    margin:7px 4px 0;
    font-size:10.5px;
  }
  #aris-selection-module{margin:-10px auto 0 !important}
}
</style>


<style data-aris-release-fixes="v3-8-17">
/* Release QA fixes: narrow reflow + search result stacking */
html,body{min-width:0!important}
body.search-engaged .search-stage{z-index:80!important}
.search-shell[data-open="true"]{z-index:5!important}
</style>


<style id="aris-compass-host-styles">
body.aris-compass-open{overflow:hidden!important}
body.aris-compass-open>.sky,body.aris-compass-open>.site-bg{visibility:hidden}
#aris-compass-dialog{position:fixed;inset:0;margin:0;padding:0;width:100%;height:100vh;height:100dvh;max-width:none;max-height:none;border:0;border-radius:0;background:#030302;color:#f4f1e8;font-family:"Vazirmatn",Tahoma,Arial,sans-serif;overflow:hidden;overscroll-behavior:contain;z-index:2147483000}
#aris-compass-dialog:not([open]){display:none}
#aris-compass-dialog[open]{display:flex;flex-direction:column}
#aris-compass-dialog::backdrop{background:#030302}
.aris-compass-bar{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;min-width:0;min-height:60px;padding:8px max(14px,env(safe-area-inset-right)) 8px max(14px,env(safe-area-inset-left));padding-top:max(8px,env(safe-area-inset-top));border-bottom:1px solid rgba(255,216,120,.22);background:linear-gradient(100deg,#090705,#171006)}
.aris-compass-bar__title{min-width:0;margin:0;color:#ffdc8a;font-size:14px;line-height:1.8;font-weight:800}
.aris-compass-close,.aris-compass-retry{font:inherit;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:8px 14px;border:1px solid rgba(255,216,120,.35);border-radius:12px;background:rgba(255,216,120,.07);color:#ffe5aa;font-size:12px;font-weight:750;line-height:1.6;cursor:pointer;flex-shrink:0}
.aris-compass-close:focus-visible,.aris-compass-retry:focus-visible{outline:3px solid #ffd878;outline-offset:3px}
.aris-compass-close svg{width:18px;height:18px;flex:none}
.aris-compass-stage{flex:1;min-height:0;min-width:0;position:relative;overflow:hidden}
#aris-compass-frame{display:block;width:100%;height:100%;border:0;background:#030302;color-scheme:dark}
#aris-compass-frame[hidden],#aris-compass-loading[hidden],#aris-compass-retry[hidden]{display:none!important}
.aris-compass-loading{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:24px;text-align:center;font-size:14px;line-height:1.9;color:#e6d6ad;background:#030302}
.aris-compass-loading p{margin:0}
@media(max-width:480px){.aris-compass-bar{gap:8px;padding-inline:max(10px,env(safe-area-inset-right)) max(10px,env(safe-area-inset-left))}.aris-compass-bar__title{font-size:12px}.aris-compass-close{padding:8px 10px;font-size:11px;gap:5px}}
@media(max-width:320px){.aris-compass-bar{flex-wrap:wrap;justify-content:center;gap:4px;padding-block:6px}.aris-compass-bar__title{text-align:center;flex-basis:100%}}
</style>


<style id="__ARYO_ARIS_OWNERSHIP__styles">
:root{--__aryo-aris-ownership-fingerprint:"81436d38-445a-4e0d-9c8d-8a9b6f9aed48"}
html.__ARYO_ARIS_OWNERSHIP__locked{overflow:hidden!important}
#__ARYO_ARIS_OWNERSHIP__panel{position:fixed;inset:0;box-sizing:border-box;width:min(680px,calc(100% - 24px));max-width:calc(100% - 24px);max-height:calc(100vh - 24px);max-height:calc(100dvh - 24px);margin:auto;padding:0;border:1px solid rgba(255,216,120,.38);border-radius:18px;background:#0b0905;color:#f5eedc;box-shadow:0 25px 90px #0009;overflow:auto;overscroll-behavior:contain;font:14px/1.85 "Vazirmatn",Tahoma,Arial,sans-serif;text-align:right;direction:rtl;z-index:2147483646}
#__ARYO_ARIS_OWNERSHIP__panel:not([open]){display:none!important}
#__ARYO_ARIS_OWNERSHIP__panel::backdrop{background:rgba(0,0,0,.78)}
#__ARYO_ARIS_OWNERSHIP__panel *{box-sizing:border-box}
#__ARYO_ARIS_OWNERSHIP__panel .__ARYO_ARIS_OWNERSHIP__bar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 18px;border-bottom:1px solid #ffd87830;background:#171107}
#__ARYO_ARIS_OWNERSHIP__panel h2{margin:0;font-size:18px;line-height:1.6;color:#ffdc8a}
#__ARYO_ARIS_OWNERSHIP__panel .__ARYO_ARIS_OWNERSHIP__content{padding:18px}
#__ARYO_ARIS_OWNERSHIP__panel .__ARYO_ARIS_OWNERSHIP__note{margin:8px 0 15px;color:#cabc9e;font-size:12px;line-height:1.9}
#__ARYO_ARIS_OWNERSHIP__panel .__ARYO_ARIS_OWNERSHIP__details{margin:14px 0}
#__ARYO_ARIS_OWNERSHIP__panel .__ARYO_ARIS_OWNERSHIP__details>div{display:grid;grid-template-columns:minmax(120px,1fr) minmax(0,1.8fr);gap:10px;padding:9px 0;border-bottom:1px solid #ffffff12}
#__ARYO_ARIS_OWNERSHIP__panel dt{color:#c9b789;font-size:12px}
#__ARYO_ARIS_OWNERSHIP__panel dd{margin:0;font-size:12px;overflow-wrap:anywhere}
#__ARYO_ARIS_OWNERSHIP__panel bdi{unicode-bidi:isolate}
#__ARYO_ARIS_OWNERSHIP__panel button{font:inherit;min-height:44px;padding:9px 13px;border:1px solid #ffd87855;border-radius:10px;background:#ffd87813;color:#ffe5a5;cursor:pointer;line-height:1.6}
#__ARYO_ARIS_OWNERSHIP__panel button:disabled{opacity:.55;cursor:wait}
#__ARYO_ARIS_OWNERSHIP__panel input{display:block;max-width:100%;min-width:0;width:100%;min-height:44px;margin:7px 0;padding:9px 11px;border:1px solid #ffd87844;border-radius:10px;background:#060503;color:#f5eedc;font:inherit}
#__ARYO_ARIS_OWNERSHIP__panel input[type=file]{font-size:12px;direction:rtl}
#__ARYO_ARIS_OWNERSHIP__panel :is(input,button):focus-visible{outline:3px solid #ffd878;outline-offset:3px}
#__ARYO_ARIS_OWNERSHIP__panel .__ARYO_ARIS_OWNERSHIP__actions{display:flex;flex-wrap:wrap;gap:8px}
#__ARYO_ARIS_OWNERSHIP__panel .__ARYO_ARIS_OWNERSHIP__filecheck{margin-top:22px;padding-top:16px;border-top:1px solid #ffd87830}
#__ARYO_ARIS_OWNERSHIP__panel [data-aryo-aris-ownership-status="VALID"],#__ARYO_ARIS_OWNERSHIP__panel [data-aryo-aris-ownership-status="AUTHORIZED"]{color:#9de3b5}
#__ARYO_ARIS_OWNERSHIP__panel [data-aryo-aris-ownership-status="INVALID"]{color:#ffb2a9}
#__ARYO_ARIS_OWNERSHIP__panel [data-aryo-aris-ownership-status="UNCONFIGURED"]{color:#f4ce7c}
#__ARYO_ARIS_OWNERSHIP__message{min-height:28px;margin:14px 0 4px}
@media(max-width:480px){#__ARYO_ARIS_OWNERSHIP__panel .__ARYO_ARIS_OWNERSHIP__details>div{grid-template-columns:1fr;gap:3px}#__ARYO_ARIS_OWNERSHIP__panel .__ARYO_ARIS_OWNERSHIP__content{padding:14px}#__ARYO_ARIS_OWNERSHIP__panel h2{font-size:16px}}
@media print{#__ARYO_ARIS_OWNERSHIP__panel{display:none!important}html.__ARYO_ARIS_OWNERSHIP__locked{overflow:visible!important}}
</style>
</head>
<body>
<a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
<svg aria-hidden="true" class="sr-only" focusable="false">
<symbol id="aris-sigil-shape" viewbox="0 0 120 148">
<path class="sigil-arch" d="M20 108V63C20 34 37 15 60 6c23 9 40 28 40 57v45"></path>
<path class="sigil-a" d="m39 103 21-61 22 61M48 79h25"></path>
<path class="sigil-book sigil-olive" d="M14 112c17-6 32-2 46 10 14-12 29-16 46-10"></path>
<path class="sigil-book" d="M14 120c17-5 32-1 46 10 14-11 29-15 46-10M60 122v8"></path>
<path class="sigil-detail" d="M25 108h25M70 108h25"></path>
<path class="sigil-star" d="m60 8 2.2 6.1 6.1 2.2-6.1 2.2-2.2 6.1-2.2-6.1-6.1-2.2 6.1-2.2L60 8Z"></path>
</symbol>
</svg>
<div aria-hidden="true" class="ambient-scene">
<div aria-hidden="true" class="page-glow"></div>
<div aria-hidden="true" class="page-grid"></div>
<canvas aria-hidden="true" class="starfield" id="starfield"></canvas>
<div aria-hidden="true" class="ambient-lights">
<span class="ambient-light ambient-light--gold"></span>
<span class="ambient-light ambient-light--olive"></span>
</div>
<span aria-hidden="true" class="shooting-star"></span>
<div aria-hidden="true" class="signature-stars">
<span class="spark-star spark-star--1"></span>
<span class="spark-star spark-star--2"></span>
<span class="spark-star spark-star--3"></span>
<span class="spark-star spark-star--4"></span>
<span class="spark-star spark-star--5"></span>
<span class="spark-star spark-star--6"></span>
<span class="spark-star spark-star--7"></span>
<span class="spark-star spark-star--8"></span>
<span class="spark-star spark-star--9"></span>
<span class="spark-star spark-star--10"></span>
<span class="spark-star spark-star--11"></span>
<span class="spark-star spark-star--12"></span>
<span class="spark-star spark-star--13"></span>
<span class="spark-star spark-star--14"></span>
<span class="spark-star spark-star--15"></span>
</div>
</div>
<header aria-label="سربرگ آریس آکادمی" class="site-header">
<a aria-label="آریس آکادمی؛ بازگشت به صفحهٔ جست‌وجو" class="brand-lockup" href="#main-content">
<span aria-hidden="true" class="brand-monogram">
<svg viewbox="0 0 120 148"><use href="#aris-sigil-shape"></use></svg>
</span>
<span aria-hidden="true" class="brand-lockup__copy">
<span class="brand-lockup__name">ARIS ACADEMY</span>
<span class="brand-lockup__descriptor" dir="ltr" lang="en">UNIVERSITY MAJOR SELECTION</span>
</span>
</a>
<p class="header-promise">انتخاب رشته‌ات را به ما بسپار</p>
<div class="header-actions">
<button aria-label="در حال آماده‌سازی موسیقی پس‌زمینه" aria-pressed="false" class="sound-toggle" data-state="loading" disabled="" id="sound-toggle" type="button">
<span aria-hidden="true" class="sound-bars"><i></i><i></i><i></i><i></i></span>
<span class="sound-label">صدای فضا</span>
</button>
<a aria-label="کانال تلگرام آریس آکادمی" class="channel-link" href="https://t.me/ArisAcademy" rel="noopener noreferrer" target="_blank">
<svg aria-hidden="true" fill="none" viewbox="0 0 24 24">
<path d="M20.7 3.6 3.9 10.1c-1.1.4-1.1 1.1-.2 1.4l4.3 1.4 1.6 5c.2.7.1 1 .8 1 .5 0 .8-.2 1-.4l2.1-2 4.4 3.2c.8.4 1.4.2 1.6-.8l2.8-13.4c.3-1.2-.4-1.8-1.6-1.4Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"></path>
<path d="m8 12.9 10.4-6.4M9.6 17.9l.2-4.2 8.6-7.2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
</svg>
<span>@ArisAcademy</span>
</a>
</div>
<div aria-hidden="true" class="aris-reading-progress"><i id="aris-reading-progress"></i></div>
</header>
<main class="main" id="main-content" tabindex="-1">
<section aria-labelledby="page-title" class="hero">
<div aria-hidden="true" class="hero-sigil">
<span class="sigil-orbit sigil-orbit--outer"><i></i></span>
<span class="sigil-orbit sigil-orbit--inner"><i></i></span>
<span class="sigil-core">
<svg viewbox="0 0 120 148"><use href="#aris-sigil-shape"></use></svg>
</span>
</div>
<span aria-hidden="true" class="sigil-floor-glow"></span>
<p class="eyebrow">راهنمای انتخاب رشته و محل تحصیل</p>
<h1 id="page-title">رشته‌ات را پیدا کن، <span class="title-accent">محل تحصیلت را بشناس.</span></h1>
<p class="hero__lead">
            برای شناخت رشته، نام یا علاقه‌ات را بنویس؛ برای شناخت محل تحصیل، استان، شهر یا دانشگاه را جست‌وجو کن.
        </p>
<div class="search-stage" id="search-stage">
<!-- ARIS MAJOR LOOKUP CAPTION -->
<div class="lookup-caption"><strong>رشته‌شناسی</strong><span>چی بخونم؟</span></div>
<div class="search-shell" data-open="false" id="search-shell">
<form class="search-form" id="search-form" novalidate="" role="search">
<label class="sr-only" for="major-search">جست‌وجوی رشته دانشگاهی</label>
<div class="search-field">
<span aria-hidden="true" class="search-icon">
<svg fill="none" viewbox="0 0 24 24">
<circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.65"></circle>
<path d="m16 16 4.1 4.1" stroke="currentColor" stroke-linecap="round" stroke-width="1.65"></path>
</svg>
</span>
<input aria-autocomplete="list" aria-controls="major-results" aria-describedby="search-help" aria-expanded="false" aria-haspopup="listbox" autocapitalize="off" autocomplete="off" class="search-input" enterkeyhint="search" id="major-search" inputmode="search" name="q" placeholder="رشته یا علاقه‌ات…" role="combobox" spellcheck="false" type="search"/>
<span aria-hidden="true" class="search-mode" id="search-mode">نام · علاقه · محیط کار</span>
<button aria-label="پاک کردن جست‌وجو" class="clear-button" hidden="" id="clear-search" type="button">
<svg aria-hidden="true" fill="none" viewbox="0 0 24 24">
<path d="m7 7 10 10M17 7 7 17" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"></path>
</svg>
</button>
<button aria-label="جست‌وجوی رشته" class="search-submit" type="submit">
<svg aria-hidden="true" fill="none" viewbox="0 0 24 24">
<path d="M5 12h13M13 7l5 5-5 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
</svg>
</button>
</div>
</form>
<div class="suggestion-panel" hidden="" id="suggestion-panel">
<div class="panel-head">
<p class="panel-title" id="panel-title">روش‌های جست‌وجو</p>
<div class="panel-actions">
<span class="panel-status" id="panel-status"></span>
<button aria-controls="filter-panel" aria-expanded="false" aria-label="فیلتر حوزه رشته" class="filter-toggle" id="filter-toggle" type="button">
<svg aria-hidden="true" fill="none" viewbox="0 0 24 24">
<path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"></path>
</svg>
<span class="filter-toggle__label">فیلتر حوزه</span>
<span class="filter-count" id="filter-count">همه</span>
</button>
<button aria-label="بستن پیشنهادهای جست‌وجو" class="panel-close" id="close-suggestions" title="بستن پیشنهادها" type="button">
<svg aria-hidden="true" fill="none" viewbox="0 0 24 24">
<path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"></path>
</svg>
</button>
</div>
</div>
<div class="filter-panel" hidden="" id="filter-panel">
<div class="filter-panel__head">
<span>یک یا چند حوزه را هم‌زمان انتخاب کن.</span>
<button class="filter-clear" hidden="" id="clear-filters" type="button">حذف فیلترها</button>
</div>
<div aria-label="حوزه‌های رشته" class="filter-options" id="filter-options" role="group"></div>
</div>
<div class="guide-state" id="guide-state">
<p class="guide-state__title">هر کدام از این سه مدل را می‌توانی امتحان کنی:</p>
<div class="guide-grid">
<button class="guide-item" data-query="مهندسی کامپیوتر" type="button">
<span class="guide-item__number">01</span>
