<style id="aris-smart-tools-styles">
#aris-smart-tools{position:relative;margin-top:clamp(24px,4vw,38px);padding-top:clamp(20px,3vw,28px);border-top:1px solid rgba(229,182,62,.13)}
#aris-smart-tools .smart-tools__head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:16px}
#aris-smart-tools .smart-tools__eyebrow{display:block;margin-bottom:4px;color:#b99c67;font-size:10px;font-weight:800;letter-spacing:.03em}
#aris-smart-tools .smart-tools__title{margin:0;color:#eee4c8;font-size:clamp(18px,2.7vw,24px);font-weight:850;line-height:1.65}
#aris-smart-tools .smart-tools__subtitle{max-width:540px;margin:0;color:#aaa493;font-size:11px;line-height:1.9;text-align:left}
#aris-smart-tools .smart-tool{position:relative;min-width:0;overflow:hidden;border:1px solid rgba(229,182,62,.15);border-radius:20px;background:linear-gradient(145deg,rgba(24,22,16,.78),rgba(8,10,7,.92));box-shadow:0 14px 34px rgba(0,0,0,.17),inset 0 1px 0 rgba(255,255,255,.035)}
#aris-smart-tools .smart-tool:before{content:"";position:absolute;inset:-95px auto auto -75px;width:190px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(229,182,62,.09),transparent 70%);pointer-events:none}
#aris-smart-tools .smart-tool--beta{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:center;padding:21px 22px;border-color:rgba(229,182,62,.31);background:linear-gradient(135deg,rgba(50,40,18,.58),rgba(11,12,8,.96) 55%,rgba(102,115,74,.055));box-shadow:0 20px 46px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,240,190,.045)}
#aris-smart-tools .smart-tool--beta:after{content:"";position:absolute;inset:auto -70px -110px auto;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(229,182,62,.08),transparent 68%);pointer-events:none}
#aris-smart-tools .smart-tool__beta-main{position:relative;z-index:1;min-width:0}
#aris-smart-tools .smart-tool__top{position:relative;display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
#aris-smart-tools .smart-tool--beta .smart-tool__top{justify-content:flex-start;margin-bottom:10px}
#aris-smart-tools .smart-tool__icon{display:grid;place-items:center;width:44px;height:44px;flex:0 0 44px;border:1px solid rgba(229,182,62,.2);border-radius:14px;color:#e7c66d;background:rgba(229,182,62,.055)}
#aris-smart-tools .smart-tool--beta .smart-tool__icon{width:48px;height:48px;flex-basis:48px;border-color:rgba(239,209,122,.28);background:rgba(229,182,62,.075);box-shadow:0 0 28px rgba(229,182,62,.07)}
#aris-smart-tools .smart-tool__icon svg{width:24px;height:24px}
#aris-smart-tools .smart-tool--beta .smart-tool__icon svg{width:27px;height:27px}
#aris-smart-tools .smart-tool__state{display:inline-flex;align-items:center;justify-content:center;min-height:23px;padding:3px 7px;border:1px solid rgba(255,91,91,.72);border-radius:5px;background:rgba(128,20,20,.78);color:#ffd7d7;font:900 8px/1.2 Arial,sans-serif;letter-spacing:.09em;direction:ltr;box-shadow:0 0 0 1px rgba(255,90,90,.05) inset}
#aris-smart-tools .smart-tool__soon-copy{display:inline-flex;align-items:center;gap:6px;color:#b6ad98;font-size:9px;font-weight:750}
#aris-smart-tools .smart-tool h3{position:relative;margin:0 0 7px;color:#efe4c8;font-size:14px;font-weight:820;line-height:1.85}
#aris-smart-tools .smart-tool--beta h3{margin:0 0 7px;font-size:clamp(16px,2.2vw,20px);line-height:1.75;color:#f4e6c8}
#aris-smart-tools .smart-tool p{position:relative;margin:0;color:#aaa493;font-size:11px;line-height:1.95}
#aris-smart-tools .smart-tool--beta p{max-width:760px;color:#b9b19f;font-size:11.5px;line-height:2}
#aris-smart-tools .smart-tool__micro{position:relative;display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
#aris-smart-tools .smart-tool__micro span{padding:4px 8px;border:1px solid rgba(229,182,62,.13);border-radius:999px;background:rgba(229,182,62,.035);color:#bdaa82;font-size:9px;font-weight:750}
#aris-smart-tools .smart-tool__action{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:12px;min-width:190px;min-height:48px;padding:10px 13px;border:1px solid rgba(229,182,62,.31);border-radius:13px;color:#efd17a;background:linear-gradient(135deg,rgba(229,182,62,.095),rgba(229,182,62,.045));font:800 11px/1.7 "Vazirmatn",Tahoma,Arial,sans-serif;cursor:pointer;text-align:right;transition:transform .2s ease,border-color .2s ease,background .2s ease,box-shadow .2s ease}
#aris-smart-tools .smart-tool__action:hover{transform:translateY(-2px);border-color:rgba(239,209,122,.5);background:rgba(229,182,62,.12);box-shadow:0 10px 24px rgba(0,0,0,.16)}
#aris-smart-tools .smart-tool__action:focus-visible{outline:3px solid rgba(239,209,122,.48);outline-offset:3px}
#aris-smart-tools .smart-tool__action b{font-size:16px;font-weight:500;direction:ltr}
#aris-smart-tools .smart-tools__divider{display:flex;align-items:center;gap:12px;margin:20px 2px 13px;color:#9f9787;font-size:9px;font-weight:800;letter-spacing:.02em}
#aris-smart-tools .smart-tools__divider:before,#aris-smart-tools .smart-tools__divider:after{content:"";height:1px;flex:1;background:linear-gradient(90deg,transparent,rgba(229,182,62,.19),transparent)}
#aris-smart-tools .smart-tools__divider span{white-space:nowrap;padding:0 3px}
#aris-smart-tools .smart-tools__soon-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
#aris-smart-tools .smart-tool--soon{min-height:190px;padding:17px;background:linear-gradient(145deg,rgba(20,19,15,.68),rgba(8,9,7,.9));border-color:rgba(229,182,62,.11)}
#aris-smart-tools .smart-tool--soon:after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 0 68%,rgba(255,255,255,.012));pointer-events:none}
#aris-smart-tools .smart-tool__future{position:relative;display:inline-flex;align-items:center;gap:6px;margin-top:14px;color:#8f8a7c;font-size:10px;font-weight:700}
#aris-smart-tools .smart-tool__future:before{content:"";width:5px;height:5px;border-radius:50%;background:#a73131;box-shadow:0 0 0 4px rgba(167,49,49,.09)}
@media(max-width:900px){#aris-smart-tools .smart-tools__subtitle{display:none}#aris-smart-tools .smart-tool--beta{grid-template-columns:1fr;gap:14px}#aris-smart-tools .smart-tool__action{width:100%;min-width:0}}
@media(max-width:600px){#aris-smart-tools{margin-top:20px;padding-top:18px}#aris-smart-tools .smart-tools__head{align-items:flex-start}#aris-smart-tools .smart-tool--beta{padding:17px}#aris-smart-tools .smart-tools__soon-grid{grid-template-columns:1fr;gap:9px}#aris-smart-tools .smart-tool--soon{min-height:auto;padding:15px}#aris-smart-tools .smart-tool__top{margin-bottom:12px}#aris-smart-tools .smart-tool h3{font-size:13px}#aris-smart-tools .smart-tool--beta h3{font-size:16px}#aris-smart-tools .smart-tool p{font-size:10.5px}#aris-smart-tools .smart-tools__divider{margin:18px 0 12px}}
@media(prefers-reduced-motion:reduce){#aris-smart-tools .smart-tool__action{transition:none}}
</style>
<section aria-labelledby="aris-smart-tools-title" class="smart-tools" id="aris-smart-tools">
  <div class="smart-tools__head">
    <div>
      <span class="smart-tools__eyebrow">ابزارهای تصمیم‌یار آریس</span>
      <h2 class="smart-tools__title" id="aris-smart-tools-title">انتخاب رشته فقط پیدا کردن اسم یک رشته نیست.</h2>
    </div>
    <p class="smart-tools__subtitle">خودت را بهتر بشناس، محدودیت‌های واقعی انتخابت را ببین و بعد گزینه‌ها را دقیق‌تر مقایسه کن.</p>
  </div>

  <article class="smart-tool smart-tool--beta">
    <div class="smart-tool__beta-main">
      <div class="smart-tool__top">
        <span class="smart-tool__icon" aria-hidden="true"><svg fill="none" viewBox="0 0 24 24"><path d="M9.1 4.6A3.4 3.4 0 0 0 5.7 8c0 .5.1 1 .3 1.4A3.5 3.5 0 0 0 7.4 16c.2 2 1.8 3.5 3.8 3.5h.8V4.6H9.1ZM14.9 4.6A3.4 3.4 0 0 1 18.3 8c0 .5-.1 1-.3 1.4a3.5 3.5 0 0 1-1.4 6.6c-.2 2-1.8 3.5-3.8 3.5H12V4.6h2.9Z" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.4 10.2c1 .1 1.8.7 2.2 1.5M15.6 10.2c-1 .1-1.8.7-2.2 1.5M8.4 15.2c.9-.1 1.7-.5 2.2-1.2M15.6 15.2c-.9-.1-1.7-.5-2.2-1.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/></svg></span>
        <span class="smart-tool__state">BETA</span>
      </div>
      <h3>قطب نمای انتخاب رشته آریس</h3>
      <p>قبل از اینکه بین رشته‌ها تصمیم بگیری، تصویری منظم‌تر از علایق، ویژگی‌های شخصیتی، ارزش‌ها و ترجیحات خودت بساز. این آزمون قرار نیست به‌جای تو رشته انتخاب کند؛ کمک می‌کند بفهمی چه مسیرهایی با خودِ واقعی تو سازگاری بیشتری دارند و کدام انتخاب‌ها ارزش بررسی عمیق‌تر دارند.</p>
      <div class="smart-tool__micro" aria-label="محورهای آزمون"><span>خودشناسی</span><span>علایق و ترجیحات</span><span>شخصیت و ارزش‌ها</span><span>تصمیم‌یار انتخاب رشته</span></div>
    </div>
    <button class="smart-tool__action" id="aris-psych-test-launch" type="button" aria-haspopup="dialog" aria-controls="aris-compass-dialog" aria-expanded="false"><span>شروع آزمون خودشناسی</span><b aria-hidden="true">←</b></button>
  </article>

  <div class="smart-tools__divider" aria-hidden="true"><span>قابلیت‌های بعدی آریس</span></div>

  <div class="smart-tools__soon-grid">
    <article class="smart-tool smart-tool--soon">
      <div class="smart-tool__top">
        <span class="smart-tool__icon" aria-hidden="true"><svg fill="none" viewBox="0 0 24 24"><path d="M6 19.5c2.7-2.2 4.9-3.5 7.2-4.4 2.3-.9 3.7-2.1 4.8-4.6" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"/><path d="M7.5 5.2a2.7 2.7 0 1 1-5.4 0 2.7 2.7 0 0 1 5.4 0ZM21.9 8.8a2.7 2.7 0 1 1-5.4 0 2.7 2.7 0 0 1 5.4 0Z" stroke="currentColor" stroke-width="1.45"/><path d="M4.8 8v4.1M19.2 11.5v3.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></span>
        <span class="smart-tool__soon-copy">به‌زودی <span class="smart-tool__state">SOON</span></span>
      </div>
      <h3>مسیرشناسی دانشگاه</h3>
      <p>مبدأ و دانشگاه مقصدت را مشخص کن تا فاصله، زمان تقریبی سفر و مسیرهای واقعی رفت‌وآمد را یک‌جا ببینی؛ از جاده و اتوبوس تا قطار، پرواز و مسیرهای ترکیبی. برای اینکه قبل از انتخاب یک شهر، واقعاً بدانی رفت‌وآمدش چقدر منطقی است.</p>
      <span class="smart-tool__future">در حال توسعه برای آریس آکادمی</span>
    </article>

    <article class="smart-tool smart-tool--soon">
      <div class="smart-tool__top">
        <span class="smart-tool__icon" aria-hidden="true"><svg fill="none" viewBox="0 0 24 24"><path d="M4 18.5V14m5.3 4.5V9.8m5.4 8.7V6.3m5.3 12.2V3.8" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"/><path d="m3.8 10.5 5.1-3.8 4.5 1.6 6.4-5.1" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="smart-tool__soon-copy">به‌زودی <span class="smart-tool__state">SOON</span></span>
      </div>
      <h3>تخمین قبولی رشته‌محل</h3>
      <p>رتبه، سهمیه و اطلاعات نتیجه‌ات را وارد کن تا گزینه‌های قابل بررسی را در چند سناریو ببینی: خوش‌بینانه، منطقی و محافظه‌کارانه. هدف، ساختن محدوده انتخاب واقع‌بینانه‌تر است؛ نه تولید یک درصد ساختگی یا تضمین قبولی.</p>
      <span class="smart-tool__future">مدل تخمین در حال آماده‌سازی است</span>
    </article>
  </div>
  <p class="sr-only" id="aris-smart-tools-status" aria-live="polite"></p>
</section>
<script id="aris-smart-tools-script">
(function(){
  var launch=document.getElementById('aris-psych-test-launch');
  if(!launch)return;
  function notify(message){
    var status=document.getElementById('aris-smart-tools-status');
    if(status)status.textContent=message;
    var toast=document.getElementById('selection-toast');
    var toastText=document.getElementById('toast-text');
    if(toast&&toastText){
      toastText.textContent=message;
      toast.dataset.visible='true';
      window.setTimeout(function(){toast.dataset.visible='false'},2400);
    }
  }
  launch.addEventListener('click',function(){
    if(window.ArisPsychologyTest&&typeof window.ArisPsychologyTest.open==='function'){
      window.ArisPsychologyTest.open();
      return;
    }
    var event;
    try{event=new CustomEvent('aris:psych-test-request',{cancelable:true})}
    catch(e){event=document.createEvent('Event');event.initEvent('aris:psych-test-request',true,true)}
    var unhandled=document.dispatchEvent(event);
    if(unhandled)notify('قطب‌نما هنوز آماده نشده؛ چند لحظه دیگر دوباره امتحان کن.');
  });
}());
</script>
<!-- ARIS SMART DECISION TOOLS END -->

