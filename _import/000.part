<section aria-labelledby="province-search-title" class="province-lookup" id="province-search-section">
<div class="lookup-caption"><strong id="province-search-title">استان‌شناسی</strong><span>کجا درس بخونم؟</span></div>
<div class="province-search-shell">
<form class="province-search-form" id="province-search-form" novalidate="" role="search">
<label class="sr-only" for="province-search">جست‌وجوی استان، شهر یا دانشگاه</label>
<div class="province-search-field">
<span aria-hidden="true" class="province-search-icon"><svg fill="none" viewbox="0 0 24 24"><path d="M12 21s6.5-5.6 6.5-11.5a6.5 6.5 0 1 0-13 0C5.5 15.4 12 21 12 21Z" stroke="currentColor" stroke-width="1.6"></path><circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.6"></circle></svg></span>
<input aria-autocomplete="list" aria-controls="province-results" aria-describedby="province-search-help" aria-expanded="false" autocapitalize="off" autocomplete="off" class="province-search-input" enterkeyhint="search" id="province-search" inputmode="search" placeholder="استان، شهر یا دانشگاه…" role="combobox" spellcheck="false" type="search"/>
<button aria-label="پاک کردن جست‌وجوی استان" class="province-search-clear" hidden="" id="province-search-clear" type="button"><svg aria-hidden="true" fill="none" viewbox="0 0 24 24"><path d="m7 7 10 10M17 7 7 17" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"></path></svg></button>
<button aria-label="باز کردن راهنمای استان" class="province-search-submit" type="submit"><svg aria-hidden="true" fill="none" viewbox="0 0 24 24"><path d="M19 12H6m5-5-5 5 5 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9"></path></svg></button>
</div>
</form>
