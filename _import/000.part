<style id="aris-selection-module-styles">/* ARIS Selection Module — integration-safe bundle */
body.aris-selection-reader-open{overflow:hidden}
#aris-selection-module{--guide-accent:#d5aa72;--guide-accent-soft:rgba(213,170,114,.1);--guide-border:rgba(213,170,114,.3)}
#aris-selection-module .guide-hub{margin-top:22px;padding-top:20px;border-top:1px solid rgba(229,182,62,.12)}
#aris-selection-module .guide-hub__shell{position:relative;padding:clamp(16px,3vw,24px);border:1px solid var(--guide-border);border-radius:var(--radius-lg);background:linear-gradient(145deg,rgba(19,17,14,.95),rgba(10,11,9,.98));box-shadow:0 18px 55px rgba(0,0,0,.24);overflow:hidden}
#aris-selection-module .guide-hub__shell:before{content:"";position:absolute;inset:-100px auto auto -80px;width:250px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(213,170,114,.12),transparent 67%);pointer-events:none}
#aris-selection-module .guide-hub__head{position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:18px}
#aris-selection-module .guide-hub__identity{display:flex;gap:12px;align-items:flex-start}#aris-selection-module .guide-hub__icon{display:grid;place-items:center;flex:0 0 42px;width:42px;height:42px;border:1px solid var(--guide-border);border-radius:13px;color:#efd3ac;background:rgba(213,170,114,.07)}#aris-selection-module .guide-hub__icon svg{width:23px;height:23px}
#aris-selection-module .guide-hub__title{margin:0;color:#f2d5ad;font-size:16px;font-weight:850}#aris-selection-module .guide-hub__subtitle{display:block;margin-top:4px;color:var(--aris-muted);font-size:12px;line-height:1.8}
#aris-selection-module .guide-hub__question{flex:0 0 auto;color:#c9a778;font-size:13px;padding-top:4px}
#aris-selection-module .guide-path{position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-bottom:17px}
#aris-selection-module .guide-path__step{min-width:0;padding:12px;border:1px solid rgba(213,170,114,.16);border-radius:13px;color:var(--aris-text);background:rgba(255,255,255,.025);text-align:right;cursor:pointer;transition:.2s}
#aris-selection-module .guide-path__step:hover{transform:translateY(-2px);border-color:var(--guide-border);background:var(--guide-accent-soft)}#aris-selection-module .guide-path__step:focus-visible{outline:3px solid var(--aris-focus);outline-offset:2px}
#aris-selection-module .guide-path__number{display:block;color:var(--guide-accent);font:700 10px Georgia,serif;letter-spacing:.08em}#aris-selection-module .guide-path__label{display:block;margin-top:5px;font-size:12px;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#aris-selection-module .guide-tools{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;margin-bottom:14px}
#aris-selection-module .guide-search{position:relative}#aris-selection-module .guide-search svg{position:absolute;inset-inline-start:13px;top:50%;width:19px;height:19px;color:var(--guide-accent);transform:translateY(-50%);pointer-events:none}
#aris-selection-module .guide-search input{width:100%;height:46px;padding:0 44px 0 14px;border:1px solid rgba(213,170,114,.22);border-radius:13px;color:var(--aris-text);background:rgba(5,6,5,.68);outline:0}#aris-selection-module .guide-search input::placeholder{color:var(--aris-muted-2)}#aris-selection-module .guide-search input:focus{border-color:var(--guide-accent);box-shadow:0 0 0 4px rgba(213,170,114,.1)}
#aris-selection-module .guide-count{color:var(--aris-muted);font-size:12px;white-space:nowrap}#aris-selection-module .guide-filters{position:relative;display:flex;gap:7px;overflow:auto;padding:1px 0 10px;scrollbar-width:none}#aris-selection-module .guide-filters::-webkit-scrollbar{display:none}
#aris-selection-module .guide-filter{min-height:36px;padding:6px 12px;border:1px solid rgba(213,170,114,.16);border-radius:999px;color:var(--aris-muted);background:rgba(255,255,255,.02);white-space:nowrap;cursor:pointer;font-size:12px}#aris-selection-module .guide-filter[aria-pressed="true"]{border-color:var(--guide-border);color:#f4d7ae;background:var(--guide-accent-soft)}#aris-selection-module .guide-filter:focus-visible{outline:3px solid var(--aris-focus);outline-offset:2px}
#aris-selection-module .selection-guide-grid{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}#aris-selection-module .guide-card{position:relative;min-width:0;padding:16px 16px 15px;border:1px solid rgba(213,170,114,.16);border-radius:16px;color:inherit;background:linear-gradient(145deg,rgba(255,255,255,.035),rgba(255,255,255,.012));text-align:right;cursor:pointer;transition:transform .2s ease,border-color .2s ease,background-color .2s ease}#aris-selection-module .guide-card:hover{transform:translateY(-3px);border-color:var(--guide-border);background:rgba(213,170,114,.06)}#aris-selection-module .guide-card__hit{position:absolute;inset:0;z-index:2;width:100%;height:100%;padding:0;border:0;border-radius:inherit;background:transparent;cursor:pointer}#aris-selection-module .guide-card__hit:focus-visible{outline:3px solid var(--aris-focus);outline-offset:2px}
#aris-selection-module .guide-card>span,#aris-selection-module .guide-card>h3,#aris-selection-module .guide-card>p{position:relative;z-index:1;pointer-events:none}#aris-selection-module .guide-card__top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}#aris-selection-module .guide-card__category{color:#d5b282;font-size:10px;font-weight:750}#aris-selection-module .guide-card__time{color:var(--aris-muted-2);font-size:10px;direction:rtl}#aris-selection-module .guide-card__title{margin:0;color:var(--aris-text);font-size:14px;line-height:1.75}#aris-selection-module .guide-card__desc{display:-webkit-box;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical;margin:6px 0 13px;color:var(--aris-muted);font-size:11px;line-height:1.85}#aris-selection-module .guide-card__foot{display:flex;align-items:center;justify-content:space-between;gap:10px;color:#e5bf89;font-size:11px}#aris-selection-module .guide-card__arrow{font-size:15px;direction:ltr}
#aris-selection-module .guide-card__validity{display:inline-flex;margin-inline-start:7px;padding:2px 6px;border:1px solid rgba(143,164,115,.18);border-radius:999px;color:#aabd8d;font-size:8px}#aris-selection-module .guide-card__validity[data-dynamic="true"]{border-color:rgba(229,182,62,.2);color:#d7b36e}
#aris-selection-module .guide-reveal{display:flex;align-items:center;justify-content:center;width:100%;min-height:45px;margin-top:12px;border:1px solid rgba(213,170,114,.22);border-radius:13px;color:#edcc9d;background:rgba(213,170,114,.045);cursor:pointer;font-size:12px;font-weight:750}#aris-selection-module .guide-reveal:hover{border-color:var(--guide-border);background:rgba(213,170,114,.09)}#aris-selection-module .guide-reveal[hidden]{display:none}
#aris-selection-module .guide-empty{padding:28px 16px;border:1px dashed rgba(213,170,114,.23);border-radius:15px;color:var(--aris-muted);text-align:center;font-size:13px}#aris-selection-module .guide-empty[hidden]{display:none}
#aris-selection-module .guide-reader{position:fixed;inset:0;z-index:300;width:100%;height:100%;max-width:none;max-height:none;margin:0;padding:0;border:0;background:#080907;color:var(--aris-text)}#aris-selection-module .guide-reader:not([open]){display:none}#aris-selection-module .guide-reader[open]{display:grid;grid-template-rows:auto 3px minmax(0,1fr)}#aris-selection-module .guide-reader::backdrop{background:#050505}
#aris-selection-module .guide-reader__bar{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:12px;min-height:68px;padding:max(10px,env(safe-area-inset-top)) clamp(12px,3vw,28px) 10px;border-bottom:1px solid rgba(229,182,62,.18);background:rgba(8,9,7,.97);backdrop-filter:blur(18px)}
#aris-selection-module .guide-reader__close,#aris-selection-module .guide-reader__nav{min-width:44px;min-height:44px;border:1px solid rgba(229,182,62,.22);border-radius:12px;color:var(--aris-gold-light);background:rgba(255,255,255,.035);cursor:pointer}#aris-selection-module .guide-reader__close:hover,#aris-selection-module .guide-reader__nav:hover{background:rgba(229,182,62,.08)}#aris-selection-module .guide-reader__close:focus-visible,#aris-selection-module .guide-reader__nav:focus-visible{outline:3px solid var(--aris-focus);outline-offset:2px}
#aris-selection-module .guide-reader__copy{min-width:0}#aris-selection-module .guide-reader__kicker{display:block;color:#bca06f;font-size:10px}#aris-selection-module .guide-reader__title{display:block;overflow:hidden;margin-top:2px;color:var(--aris-text);font-size:14px;font-weight:800;white-space:nowrap;text-overflow:ellipsis}#aris-selection-module .guide-reader__actions{display:flex;gap:6px;direction:ltr}#aris-selection-module .guide-reader__nav:disabled{opacity:.3;cursor:default}
#aris-selection-module .guide-reader__progress{height:3px;background:#171811}#aris-selection-module .guide-reader__progress span{display:block;width:0;height:100%;background:linear-gradient(90deg,#8fa473,#e5b63e);transition:width .12s linear}
#aris-selection-module .guide-reader__frame{display:block;width:100%;height:100%;border:0;background:#070806}
@media(max-width:760px){#aris-selection-module .guide-path{grid-template-columns:repeat(2,minmax(0,1fr))}#aris-selection-module .selection-guide-grid{grid-template-columns:1fr}#aris-selection-module .guide-tools{grid-template-columns:1fr}#aris-selection-module .guide-count{display:none}#aris-selection-module .guide-hub__question{font-size:12px}#aris-selection-module .guide-card{padding:15px}#aris-selection-module .guide-reader__bar{grid-template-columns:auto minmax(0,1fr) auto;gap:8px}#aris-selection-module .guide-reader__actions{display:flex;gap:4px}#aris-selection-module .guide-reader__nav{min-width:40px;min-height:40px}}
@media(max-width:480px){#aris-selection-module .guide-hub{margin-top:16px;padding-top:16px}#aris-selection-module .guide-hub__shell{padding:14px;border-radius:18px}#aris-selection-module .guide-hub__head{gap:8px}#aris-selection-module .guide-hub__icon{width:38px;height:38px;flex-basis:38px}#aris-selection-module .guide-hub__question{display:none}#aris-selection-module .guide-path__step{padding:10px}#aris-selection-module .guide-path__label{font-size:11px}#aris-selection-module .guide-reader__bar{padding-left:8px;padding-right:8px;gap:6px}#aris-selection-module .guide-reader__title{font-size:11px}#aris-selection-module .guide-reader__kicker{font-size:9px}#aris-selection-module .guide-reader__close,#aris-selection-module .guide-reader__nav{min-width:36px;min-height:36px;border-radius:10px}#aris-selection-module .guide-reader__actions{gap:3px}}





#aris-selection-module{
  --aris-text:#f4efe5;--aris-muted:#a7aaa0;--aris-muted-2:#7e837b;--aris-gold-light:#f4d7a7;--aris-focus:#f0c264;
  --radius-lg:24px;--guide-accent:#d5aa72;--guide-accent-soft:rgba(213,170,114,.1);--guide-border:rgba(213,170,114,.3);
  position:relative;width:100%;color:var(--aris-text);font-family:"Vazirmatn",Tahoma,"Segoe UI",sans-serif;isolation:isolate
}
#aris-selection-module,#aris-selection-module *{box-sizing:border-box}
#aris-selection-module .guide-hub{width:min(100%,960px);margin:0 auto;padding:0;border:0}
#aris-selection-module .guide-hub__shell{padding:clamp(18px,3vw,28px);border:1px solid rgba(213,170,114,.20);border-radius:24px;background:linear-gradient(145deg,rgba(18,16,13,.94),rgba(9,10,8,.97));box-shadow:0 22px 70px rgba(0,0,0,.24)}
#aris-selection-module .guide-path{gap:10px;margin-bottom:18px}
#aris-selection-module .guide-path__step{border-color:transparent!important;background:rgba(255,255,255,.035)!important;box-shadow:none!important}
#aris-selection-module .guide-path__step:hover,#aris-selection-module .guide-path__step[aria-pressed="true"]{border-color:rgba(213,170,114,.24)!important;background:rgba(213,170,114,.075)!important}
#aris-selection-module .selection-guide-grid{gap:12px}
#aris-selection-module .guide-card{border-color:rgba(213,170,114,.12);background:linear-gradient(145deg,rgba(255,255,255,.03),rgba(255,255,255,.012))}
#aris-selection-module .guide-card--featured{grid-column:1/-1;min-height:150px;padding:21px 22px 19px;border-color:rgba(229,182,62,.28);background:radial-gradient(circle at 10% 20%,rgba(229,182,62,.08),transparent 34%),linear-gradient(145deg,rgba(30,24,15,.76),rgba(12,12,9,.97));box-shadow:inset 0 1px rgba(255,255,255,.025),0 14px 38px rgba(0,0,0,.16)}
#aris-selection-module .guide-card--featured .guide-card__title{color:#f4d9b0;font-size:16px}
#aris-selection-module .guide-card--featured .guide-card__desc{max-width:720px;-webkit-line-clamp:3}
#aris-selection-module .guide-card__category,#aris-selection-module .guide-card__time{font-size:11px}
#aris-selection-module .guide-card__validity{font-size:9.5px;padding:2px 7px}
#aris-selection-module .guide-card__title{font-size:14.5px}
#aris-selection-module .guide-card__desc{font-size:12px;line-height:1.9}
#aris-selection-module .guide-card__foot{font-size:11.5px}
#aris-selection-module .sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
@media(max-width:680px){
 #aris-selection-module .guide-hub__shell{padding:15px;border-radius:19px}
 #aris-selection-module .guide-path{gap:7px}
 #aris-selection-module .guide-path__step{padding:9px 10px!important}
 #aris-selection-module .guide-card{padding:16px!important}
 #aris-selection-module .guide-card--featured{min-height:0;padding:18px!important}
 #aris-selection-module .guide-filters{display:flex;flex-wrap:wrap;gap:6px;overflow:visible;padding-bottom:4px}
 #aris-selection-module .guide-filter{flex:1 1 calc(50% - 4px);min-width:0;justify-content:center}
 #aris-selection-module .guide-filter:first-child{flex-basis:100%}
}



/* Mother-file integration contract */
#aris-selection-module{
  width:100%;
  margin:-58px auto 0;
  padding:0 var(--page-inline) 92px;
  position:relative;
  z-index:20;
}
#aris-selection-module .guide-hub{
  width:min(100%,960px);
  margin-inline:auto;
}
#aris-selection-module .guide-hub__shell{
  box-shadow:
    0 24px 72px rgba(0,0,0,.30),
    0 0 0 1px rgba(229,182,62,.025) inset;
}
#aris-selection-module .guide-reader{
  z-index:320;
}
body.aris-selection-reader-open .site-header{
  visibility:hidden;
  pointer-events:none;
}
@media(max-width:760px){
  #aris-selection-module{
    margin:-44px auto 0;
    padding-inline:clamp(12px,4vw,20px);
    padding-bottom:64px;
  }
}
@media(max-width:480px){
  #aris-selection-module{
    margin:-34px auto 0;
    padding-bottom:52px;
  }
}

#aris-selection-module .boomi-spotlight{position:relative;margin:0 0 16px}
#aris-selection-module .boomi-spotlight__button{position:relative;width:100%;overflow:hidden;display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;align-items:center;gap:14px;padding:15px 16px;border:1px solid rgba(229,182,62,.26);border-radius:18px;background:linear-gradient(135deg,rgba(229,182,62,.105),rgba(20,18,13,.9) 45%,rgba(102,115,74,.08));color:var(--aris-text);text-align:right;cursor:pointer;box-shadow:0 16px 38px rgba(0,0,0,.2),inset 0 1px 0 rgba(255,235,180,.045);transition:border-color .2s ease,transform .2s ease,background .2s ease}
#aris-selection-module .boomi-spotlight__button:before{content:"";position:absolute;width:210px;height:210px;inset:-125px auto auto -45px;border-radius:50%;background:radial-gradient(circle,rgba(229,182,62,.16),transparent 68%);pointer-events:none}
#aris-selection-module .boomi-spotlight__button:hover{transform:translateY(-2px);border-color:rgba(239,209,122,.42);background:linear-gradient(135deg,rgba(229,182,62,.145),rgba(20,18,13,.92) 45%,rgba(102,115,74,.1))}
#aris-selection-module .boomi-spotlight__button:focus-visible{outline:3px solid rgba(239,209,122,.5);outline-offset:3px}
#aris-selection-module .boomi-spotlight__icon{position:relative;display:grid;place-items:center;width:48px;height:48px;border:1px solid rgba(239,209,122,.3);border-radius:15px;background:rgba(229,182,62,.075);color:#efd17a;box-shadow:0 0 24px rgba(229,182,62,.07)}
#aris-selection-module .boomi-spotlight__icon svg{width:27px;height:27px}
#aris-selection-module .boomi-spotlight__copy{position:relative;min-width:0;display:grid;gap:2px}
#aris-selection-module .boomi-spotlight__eyebrow{color:#c9a778;font-size:10px;font-weight:800}
#aris-selection-module .boomi-spotlight__copy strong{color:#f4dfbb;font-size:14px;line-height:1.7}
#aris-selection-module .boomi-spotlight__copy>span:last-child{color:var(--aris-muted);font-size:11px;line-height:1.8}
#aris-selection-module .boomi-spotlight__stats{position:relative;display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}
#aris-selection-module .boomi-spotlight__stats i{font-style:normal;white-space:nowrap;padding:5px 8px;border:1px solid rgba(229,182,62,.16);border-radius:999px;background:rgba(229,182,62,.045);color:#cbb890;font-size:9px;font-weight:750}
#aris-selection-module .boomi-spotlight__cta{position:relative;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;color:#efd17a;font-size:11px;font-weight:850}
@media(max-width:760px){#aris-selection-module .boomi-spotlight__button{grid-template-columns:auto minmax(0,1fr);gap:11px;padding:14px}#aris-selection-module .boomi-spotlight__stats{grid-column:1/-1;justify-content:flex-start;padding-inline-start:59px}#aris-selection-module .boomi-spotlight__cta{grid-column:1/-1;padding-inline-start:59px}.boomi-spotlight__copy>span:last-child{display:block}}
@media(max-width:460px){#aris-selection-module .boomi-spotlight__stats{padding-inline-start:0}#aris-selection-module .boomi-spotlight__cta{padding-inline-start:0}#aris-selection-module .boomi-spotlight__copy strong{font-size:13px}}

</style>
<section aria-labelledby="guide-hub-title" class="guide-hub" id="selection-guide-hub">
<div class="guide-hub__shell">
<div class="guide-hub__head">
<div class="guide-hub__identity">
<span aria-hidden="true" class="guide-hub__icon"><svg fill="none" viewbox="0 0 24 24"><path d="M5 4.5h9.5A2.5 2.5 0 0 1 17 7v12.5H7.5A2.5 2.5 0 0 1 5 17V4.5Z" stroke="currentColor" stroke-width="1.55"></path><path d="M17 7h2v12.5h-2M8.5 9h5M8.5 12.5h5" stroke="currentColor" stroke-linecap="round" stroke-width="1.55"></path></svg></span>
<div><h2 class="guide-hub__title" id="guide-hub-title">راهنمای انتخاب رشته</h2><span class="guide-hub__subtitle">از خواندن کارنامه تا چیدمان نهایی؛ هر چیزی که باید قبل از ثبت انتخاب‌ها بدانی.</span></div>
</div>
<span class="guide-hub__question">چطور انتخاب کنم؟</span>
</div>

<div class="boomi-spotlight" id="boomi-guide-spotlight-wrap">
  <button class="boomi-spotlight__button" id="boomi-guide-spotlight" type="button" aria-label="بازکردن راهنمای کامل بومی‌گزینی">
    <span class="boomi-spotlight__icon" aria-hidden="true">
      <svg fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="5.2" stroke="currentColor" stroke-width="1.5" opacity=".8"/><circle cx="12" cy="12" r="2.2" fill="currentColor"/><path d="M12 2.6v2.1M21.4 12h-2.1M12 21.4v-2.1M2.6 12h2.1" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"/></svg>
    </span>
    <span class="boomi-spotlight__copy">
      <span class="boomi-spotlight__eyebrow">راهنمای ویژه · مرجع ۱۴۰۴</span>
      <strong>بومی‌گزینی را قبل از چینش انتخاب‌ها درست بفهم</strong>
      <span>استان بومی، ۹ ناحیه، ۵ قطب، درصد ظرفیت و ابزار بررسی وضعیت بومی — همه در یک راهنما.</span>
    </span>
    <span class="boomi-spotlight__stats" aria-hidden="true"><i>۳۱ استان</i><i>۹ ناحیه</i><i>۵ قطب</i></span>
    <span class="boomi-spotlight__cta">بازکردن راهنما <b aria-hidden="true">←</b></span>
  </button>
</div>
<div aria-label="انتخاب راهنما براساس سؤال" class="guide-path">
<button class="guide-path__step" data-guide-category="start" type="button"><span class="guide-path__number">سؤال ۰۱</span><span class="guide-path__label">از کجا شروع کنم؟</span></button>
<button class="guide-path__step" data-guide-category="rules" type="button"><span class="guide-path__number">سؤال ۰۲</span><span class="guide-path__label">کارنامه و قوانینش چیه؟</span></button>
<button class="guide-path__step" data-guide-category="reality" type="button"><span class="guide-path__number">سؤال ۰۳</span><span class="guide-path__label">هزینه و تعهداتش چقدره؟</span></button>
<button class="guide-path__step" data-guide-category="future" type="button"><span class="guide-path__number">سؤال ۰۴</span><span class="guide-path__label">آینده علمی و شغلیش چیه؟</span></button>
</div>
<div class="guide-tools">
<label class="guide-search"><svg aria-hidden="true" fill="none" viewbox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6"></circle><path d="m15.5 15.5 4.2 4.2" stroke="currentColor" stroke-linecap="round" stroke-width="1.6"></path></svg><input aria-label="جست‌وجو در راهنماهای انتخاب رشته" autocomplete="off" id="guide-search" placeholder="مثلاً: سهمیه، نظام وظیفه، شهریه یا دانشگاه آزاد…" type="search"/></label>
<span class="guide-count" id="guide-count">۲۲ راهنمای کاربردی</span>
</div>
<div aria-label="دسته‌بندی راهنماها" class="guide-filters" id="guide-filters" role="group"></div>
<div class="selection-guide-grid" id="guide-grid"></div>
